From 03deada84c4e73ba68f2ece862e9a25b99f172aa Mon Sep 17 00:00:00 2001
From: OpenCode <opencode@localhost>
Date: Thu, 5 Nov 2026 09:11:45 +0530
Subject: [PATCH 2/2] xnu 0197: AW882xx speaker amp ID probe on QUP0 SE4
 (sweetamp=1, read only)

Audio milestone 3 groundwork: SE4 clocks/pins (gcc-sm7150 wrap0 s4, TLMM WEST
gpio53/54 qup04), each amp briefly out of reset (gpio64 TOP 0x34, gpio72 BOT
0x35), chip ID and status read, then reset and pins restored. Nothing is
written to the amps. The GENI I2C engine is the haptic driver's.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/xnu/patches/0197-sweet-speaker-amp-probe.patch b/xnu/patches/0197-sweet-speaker-amp-probe.patch
new file mode 100644
index 0000000..d6258ea
--- /dev/null
+++ b/xnu/patches/0197-sweet-speaker-amp-probe.patch
@@ -0,0 +1,501 @@
+diff --git a/bsd/conf/files b/bsd/conf/files
+index 770d7c7..2956123 100644
+--- a/bsd/conf/files
++++ b/bsd/conf/files
+@@ -120,6 +120,7 @@ bsd/dev/flame_wlan.c		standard
+ bsd/dev/sweet_bt.c			standard
+ bsd/dev/sweet_bt_hci.c			standard
+ bsd/dev/sweet_haptic.c			standard
++bsd/dev/sweet_amp.c			standard
+ bsd/dev/sweet_audiohal.c		standard
+ bsd/dev/sweet_files.c			standard
+ bsd/dev/sweet_gpu.c			standard
+diff --git a/bsd/dev/sweet_amp.c b/bsd/dev/sweet_amp.c
+new file mode 100644
+index 0000000..94ce0ec
+--- /dev/null
++++ b/bsd/dev/sweet_amp.c
+@@ -0,0 +1,463 @@
++/*
++ * 0197: speaker amplifier probe (audio milestone 3 groundwork, docs/audio-plan.md). Read only.
++ *
++ * Sweet's two Awinic AW882xx smart PAs (Xiaomi DT aw882xx_smartpa@34 "TOP" and @35 "BOT", channel 0
++ * and 1) sit on QUP0 SE4 (qupv3_se4_i2c, i2c@0x890000, SDA/SCL GPIO 53/54 = qup04), resets on TLMM
++ * GPIO 64 and 72 (low = reset), interrupts GPIO 93 and 56. The I2S/MI2S audio comes from the ADSP
++ * (not booted by this kernel), so nothing can be heard yet: this only checks that the bus and the
++ * amps answer, as the step before the AFE/MI2S path.
++ *
++ *   sweetamp=1  about 50 s after boot: SE4 clocks + pins, each amp out of reset for 20 ms, chip ID
++ *               (reg 0x00, 16 bit) and status registers 0x01..0x05 read, then back into reset, the
++ *               pins restored to what the bootloader left. Nothing is written to the amps (after a
++ *               reset they power up in power-down state: no output stage running).
++ *
++ * The GENI I2C engine is a copy of bsd/dev/sweet_haptic.c's (Linux i2c-qcom-geni FIFO mode). The
++ * probe stops at the first unexpected state (SE4 without I2C firmware, a busy engine, an I2C error).
++ */
++#if defined(ARM64_BOARD_CONFIG_SWEET)
++#include <sys/param.h>
++#include <sys/systm.h>
++#include <sys/errno.h>
++#include <kern/clock.h>
++#include <kern/thread.h>
++#include <kern/sched_prim.h>
++#include <machine/machine_routines.h>
++#include <pexpert/pexpert.h>
++#include <sys/conf.h>
++#include <sys/uio.h>
++#include <miscfs/devfs/devfs.h>
++#include <mach/mach_time.h>
++
++extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
++extern kern_return_t thread_terminate(thread_t);
++void sweet_amp_init(void);
++
++#define AMP_SE_PA        0x00890000u   /* QUP0 SE4: qupv3_se4_i2c, i2c@0x890000 */
++#define AMP_GCC_PA       0x00100000u
++#define AMP_NORTH_PA     0x03900000u   /* TLMM NORTH tile: GPIO 64, 72 (amp resets), 93 */
++#define AMP_WEST_PA      0x03500000u   /* TLMM WEST tile: GPIO 53, 54 (SE4 I2C, qup04 = mux 2), 56 */
++#define AMP_GCC_VOTE     0x5200cu
++#define AMP_RCG          0x174f4u      /* gcc_qupv3_wrap0_s4_clk_src (gcc-sm7150.c) */
++#define AMP_CBCR         0x174f0u      /* gcc_qupv3_wrap0_s4_clk, vote bit 14 */
++#define AMP_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
++#define AMP_GPIO_IO(n)   (AMP_GPIO_CFG(n) + 4u)
++
++#define SE_STATUS       0x040u
++#define SE_MCLK         0x048u
++#define SE_FW           0x068u
++#define SE_CLK_SEL      0x07cu
++#define SE_DMA          0x258u
++#define SE_TX_LEN       0x26cu
++#define SE_RX_LEN       0x270u
++#define SE_SCL          0x278u
++#define SE_CMD          0x600u
++#define SE_CTRL         0x604u
++#define SE_IRQ          0x610u
++#define SE_IRQ_EN       0x614u
++#define SE_IRQ_CLR      0x618u
++#define SE_TX           0x700u
++#define SE_RX           0x780u
++#define SE_TX_COUNT     0x800u
++#define SE_RX_COUNT     0x804u
++#define SE_HW_TX        0xe24u
++#define SE_HW_RX        0xe28u
++#define SE_TX_WM        0x80cu
++#define SE_RX_WM_IRQ    (1u << 26)
++#define SE_RX_LAST      (1u << 27)
++#define SE_TX_WM_IRQ    (1u << 30)
++#define SE_DONE         (1u << 0)
++#define SE_NACK         (1u << 10)
++#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
++                         (1u << 13) | (3u << 24) | (3u << 28))
++#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
++/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
++ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
++#define SE_PACK0        0x0007f8feu
++#define SE_PACK1        0x000ffefeu
++
++
++static struct {
++	vm_offset_t se, gcc, gpio;
++	bool started, dead, probing;
++	uint32_t irq_status, irq_last;
++	unsigned sent, got;
++	int stage;
++} as;
++static int amp_sleep_chan;
++
++static uint32_t
++amp_rd(vm_offset_t base, uint32_t off)
++{
++	uint32_t v = *(volatile uint32_t *)(base + off);
++	__asm__ volatile("dmb oshld" ::: "memory");
++	return v;
++}
++
++static void
++amp_wr(vm_offset_t base, uint32_t off, uint32_t val)
++{
++	__asm__ volatile("dmb oshst" ::: "memory");
++	*(volatile uint32_t *)(base + off) = val;
++	__asm__ volatile("dsb osh" ::: "memory");
++}
++
++static void
++amp_wait(unsigned ms)
++{
++	uint64_t deadline;
++	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
++	(void)assert_wait_deadline(&amp_sleep_chan, THREAD_UNINT, deadline);
++	thread_block(THREAD_CONTINUE_NULL);
++}
++
++static bool
++amp_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
++{
++	for (unsigned i = 0; i < 5000; ++i) {
++		if (!(amp_rd(base, off) & mask)) {
++			return true;
++		}
++		delay(1);
++	}
++	return false;
++}
++
++static void
++amp_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
++{
++	uint32_t off = AMP_GPIO_CFG(pin);
++	uint32_t cfg = amp_rd(as.gpio, off);
++	if (out) {
++		/* Set the desired latch before enabling output (reset is active low). */
++		amp_wr(as.gpio, AMP_GPIO_IO(pin),
++		    (amp_rd(as.gpio, AMP_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
++	}
++	cfg &= ~0x3ffu;
++	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
++	amp_wr(as.gpio, off, cfg);
++}
++
++/* Called only for a transfer started by this driver, including a stretched TX. */
++static void
++amp_abort(void)
++{
++	amp_wr(as.se, SE_CTRL, 2); /* abort M command, release held bus */
++	bool done = false;
++	for (unsigned i = 0; i < 5000; ++i) {
++		if (amp_rd(as.se, SE_IRQ) & (1u << 5)) {
++			done = true;
++			break;
++		}
++		delay(1);
++	}
++	if (!done || !amp_wait_clear(as.se, SE_STATUS, 1u)) {
++		as.dead = true;
++		printf("SWEET AMP: abort failed status=%#x irq=%#x; stopping\n",
++		    amp_rd(as.se, SE_STATUS), amp_rd(as.se, SE_IRQ));
++	}
++	/* Bound drain even if the hardware reports an impossible FIFO count. */
++	for (unsigned i = 0; i < 64 && (amp_rd(as.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
++		(void)amp_rd(as.se, SE_RX);
++	}
++	amp_wr(as.se, SE_IRQ_CLR, 0xffffffffu);
++	if (amp_rd(as.se, SE_TX_COUNT) & 0xfffffffu) {
++		as.dead = true;
++		printf("SWEET AMP: TX FIFO not empty after abort; stopping\n");
++	}
++}
++
++/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
++static uint32_t
++amp_irq(void)
++{
++	as.irq_last = amp_rd(as.se, SE_IRQ);
++	as.irq_status |= as.irq_last;
++	return as.irq_last;
++}
++
++/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
++static int
++amp_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
++    unsigned nr, bool stretch)
++{
++	if (as.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
++		return EIO;
++	}
++	if (!amp_wait_clear(as.se, SE_STATUS, 1u)) {
++		as.dead = true; /* no other SE4 owner is supported */
++		return EBUSY;
++	}
++	amp_wr(as.se, SE_IRQ_CLR, 0xffffffffu);
++	amp_wr(as.se, SE_TX_WM, nt ? 1u : 0u);
++	amp_wr(as.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
++	amp_wr(as.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
++	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
++	int err = ETIMEDOUT;
++	for (unsigned i = 0; i < 20000; ++i) {
++		uint32_t irq = amp_irq();
++		if (irq & SE_ERRORS) {
++			err = (irq & SE_NACK) ? ENXIO : EIO;
++			/* A completed NACK is normal during address probing. Aborting an
++			 * idle sequencer may never produce ABORT_DONE. Wait for completion
++			 * and leave a clean idle engine available for the other IC. */
++			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
++				delay(1);
++				irq = amp_irq();
++			}
++			if ((irq & SE_DONE) && !(amp_rd(as.se, SE_STATUS) & 1u) &&
++			    !(amp_rd(as.se, SE_TX_COUNT) & 0xfffffffu) &&
++			    !(amp_rd(as.se, SE_RX_COUNT) & 0x1ffffffu)) {
++				amp_wr(as.se, SE_IRQ_CLR, irq);
++				return err;
++			}
++			break;
++		}
++		if (nt && !as.sent && (irq & SE_TX_WM_IRQ)) {
++			uint32_t word = 0;
++			for (unsigned j = 0; j < nt; ++j) {
++				word |= (uint32_t)tx[j] << (8u * j);
++			}
++			amp_wr(as.se, SE_TX, word);
++			as.sent = nt;
++			amp_wr(as.se, SE_TX_WM, 0);
++		}
++		uint32_t count = amp_rd(as.se, SE_RX_COUNT) & 0x1ffffffu;
++		if (count > 64 || count > (nr - as.got + 3u) / 4u) {
++			err = EIO;
++			break;
++		}
++		while (count--) {
++			uint32_t word = amp_rd(as.se, SE_RX);
++			for (unsigned j = 0; j < 4 && as.got < nr; ++j) {
++				rx[as.got++] = (uint8_t)(word >> (8u * j));
++			}
++		}
++		/* DONE is checked after draining RX, so final short words aren't lost. */
++		if (irq & SE_DONE) {
++			/* Re-sample after the final drain; a late error must beat DONE. */
++			irq = amp_irq();
++			if (irq & SE_ERRORS) {
++				continue;
++			}
++			amp_wr(as.se, SE_IRQ_CLR, irq);
++			if (as.got == nr && as.sent == nt) {
++				return 0;
++			}
++			err = EIO;
++			break;
++		}
++		/* Preserve DONE/errors if they arrive during this iteration. */
++		amp_wr(as.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
++		delay(1);
++	}
++	amp_abort();
++	return err;
++}
++
++static int
++amp_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
++    unsigned nr, bool stretch)
++{
++	as.irq_status = as.irq_last = 0;
++	as.sent = as.got = 0;
++	int err = amp_msg_run(addr, tx, nt, rx, nr, stretch);
++	if (as.probing) {
++		printf("SWEET AMP: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
++		    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
++		    err, as.irq_last, as.irq_status, as.sent, as.got,
++		    amp_rd(as.se, SE_STATUS));
++	}
++	return err;
++}
++
++static int
++amp_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
++{
++	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
++	int err = amp_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
++	    NULL, 0, true);
++	if (err) {
++		return err;
++	}
++	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
++	return amp_msg(addr, NULL, 0, buf, len, false);
++}
++
++static bool
++amp_clocks(void)
++{
++	/* wrapper0 m_ahb/s_ahb/core/core2x (bits 6-9) and wrap0 s4 (bit 14); BT votes 6, 7 and s3 */
++	uint32_t mask = (0x0fu << 6) | (1u << 14);
++	amp_wr(as.gcc, AMP_GCC_VOTE, amp_rd(as.gcc, AMP_GCC_VOTE) | mask);
++	uint32_t dfs = amp_rd(as.gcc, AMP_RCG + 0x14u);
++	uint32_t cfg = amp_rd(as.gcc, AMP_RCG + 4u);
++	printf("SWEET AMP: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
++	    amp_rd(as.gcc, AMP_GCC_VOTE), amp_rd(as.gcc, AMP_RCG), cfg, dfs);
++	if (dfs & 1u) {
++		cfg = amp_rd(as.gcc, AMP_RCG + 0x1cu);
++		if ((cfg & 0x371fu) != 1u) {
++			printf("SWEET AMP: DFS level0=%#x is not XO/1; stop\n", cfg);
++			return false;
++		}
++	} else {
++		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;   /* XO, divider 1: 19.2 MHz */
++		amp_wr(as.gcc, AMP_RCG + 4u, cfg);
++		amp_wr(as.gcc, AMP_RCG, amp_rd(as.gcc, AMP_RCG) | 1u);
++		if (!amp_wait_clear(as.gcc, AMP_RCG, 1u)) {
++			printf("SWEET AMP: RCG update timeout\n");
++			return false;
++		}
++	}
++	const uint32_t branches[] = {0x17004, 0x17008, 0x1700c, 0x17014, AMP_CBCR};
++	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
++		if (!amp_wait_clear(as.gcc, branches[i], 1u << 31)) {
++			printf("SWEET AMP: GCC branch %#x halted (%#x)\n", branches[i], amp_rd(as.gcc, branches[i]));
++			return false;
++		}
++	}
++	return true;
++}
++
++static bool
++amp_se_init(void)
++{
++	uint32_t fw = amp_rd(as.se, SE_FW);
++	uint32_t tx = amp_rd(as.se, SE_HW_TX), rx = amp_rd(as.se, SE_HW_RX);
++	printf("SWEET AMP: se9 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
++	    fw, (fw >> 8) & 0xffu, amp_rd(as.se, SE_STATUS), tx, rx);
++	if (((fw >> 8) & 0xffu) != 3u || (amp_rd(as.se, 0x64) & 1u) ||
++	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
++	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
++		printf("SWEET AMP: SE4 has no ABL-loaded I2C firmware / 32-bit FIFOs; stop\n");
++		return false;
++	}
++	if (amp_rd(as.se, SE_STATUS) & 0x1001u) {
++		printf("SWEET AMP: SE4 already busy; stop\n");
++		return false;
++	}
++	amp_wr(as.se, 0xe18, 0);
++	amp_wr(as.se, 0xe1c, 0);
++	amp_wr(as.se, 0x644, 0);
++	amp_wr(as.se, SE_IRQ_CLR, 0xffffffffu);
++	amp_wr(as.se, 0x648, 0xffffffffu);
++	amp_wr(as.se, SE_DMA, 0);
++	amp_wr(as.se, 0x28, amp_rd(as.se, 0x28) | 0x7fu);
++	amp_wr(as.se, 0xe30, amp_rd(as.se, 0xe30) | 0x0fu);
++	amp_wr(as.se, 0x24, 0x7f);
++	amp_wr(as.se, 0x20, 1);
++	amp_wr(as.se, SE_CLK_SEL, 0);
++	amp_wr(as.se, SE_MCLK, (7u << 4) | 1u);
++	amp_wr(as.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
++	amp_wr(as.se, 0x254, 0);
++	amp_wr(as.se, 0x260, SE_PACK0);
++	amp_wr(as.se, 0x264, SE_PACK1);
++	amp_wr(as.se, 0x284, SE_PACK0);
++	amp_wr(as.se, 0x288, SE_PACK1);
++	amp_wr(as.se, SE_TX_WM, 0);
++	amp_wr(as.se, 0x810, 0);
++	amp_wr(as.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
++	amp_wr(as.se, SE_IRQ_EN, SE_EVENTS);
++	if (amp_rd(as.se, 0x260) != SE_PACK0 || amp_rd(as.se, 0x264) != SE_PACK1 ||
++	    (amp_rd(as.se, SE_TX_COUNT) & 0xfffffffu) || (amp_rd(as.se, SE_RX_COUNT) & 0x1ffffffu)) {
++		printf("SWEET AMP: SE4 setup readback mismatch / inherited FIFO data; stop\n");
++		return false;
++	}
++	return true;
++}
++
++
++/* ---------------------------------------------------------------- AW882xx */
++
++static const struct {
++	const char *name;
++	uint8_t addr;
++	unsigned reset_gpio;
++} amp_chips[] = {
++	{"TOP", 0x34, 64},
++	{"BOT", 0x35, 72},
++};
++
++static void
++amp_thread(void *arg __unused, wait_result_t wr __unused)
++{
++	amp_wait(50000);    /* after the UI is up */
++	as.gcc = ml_io_map(AMP_GCC_PA, 0x90000);
++	as.gpio = ml_io_map(AMP_WEST_PA, 0x80000);   /* gpio 53/54 */
++	vm_offset_t north = ml_io_map(AMP_NORTH_PA, 0x80000);   /* gpio 64/72 */
++	as.se = ml_io_map(AMP_SE_PA, 0x4000);
++	if (!as.gcc || !as.gpio || !north || !as.se) {
++		printf("SWEET AMP: mapping failed\n");
++		goto out;
++	}
++	uint32_t cfg53 = amp_rd(as.gpio, AMP_GPIO_CFG(53)), cfg54 = amp_rd(as.gpio, AMP_GPIO_CFG(54));
++	uint32_t rcfg[2], rio[2];
++	for (unsigned i = 0; i < 2; i++) {
++		rcfg[i] = amp_rd(north, AMP_GPIO_CFG(amp_chips[i].reset_gpio));
++		rio[i] = amp_rd(north, AMP_GPIO_IO(amp_chips[i].reset_gpio));
++	}
++	printf("SWEET AMP: before: gpio53 cfg %#x gpio54 cfg %#x; reset gpio64 cfg %#x io %#x, gpio72 cfg %#x io %#x\n",
++	    cfg53, cfg54, rcfg[0], rio[0], rcfg[1], rio[1]);
++	if (!amp_clocks()) {
++		goto out;
++	}
++	/* I2C pins: function qup04 (mux 2), bias disabled (board pull-ups), 2 mA (DT qupv3_se4_i2c_active) */
++	amp_gpio(53, 2, 0, 0, false, false);
++	amp_gpio(54, 2, 0, 0, false, false);
++	if (!amp_se_init()) {
++		goto pins;
++	}
++	for (unsigned c = 0; c < 2 && !as.dead; c++) {
++		vm_offset_t keep = as.gpio;
++		as.gpio = north;
++		amp_gpio(amp_chips[c].reset_gpio, 0, 0, 0, true, false);   /* reset, then release */
++		amp_wait(2);
++		amp_gpio(amp_chips[c].reset_gpio, 0, 0, 0, true, true);
++		as.gpio = keep;
++		amp_wait(20);
++		uint8_t v[2] = {0, 0};
++		int err = amp_read(amp_chips[c].addr, 0x00, false, v, 2);
++		printf("SWEET AMP: %s @%#x: chip ID read -> %d, id %#06x\n", amp_chips[c].name, amp_chips[c].addr,
++		    err, (v[0] << 8) | v[1]);
++		if (!err) {
++			char line[96];
++			unsigned n = 0;
++			for (uint8_t r = 0x01; r <= 0x05 && n + 12 < sizeof(line); r++) {
++				uint8_t w[2] = {0, 0};
++				int e = amp_read(amp_chips[c].addr, r, false, w, 2);
++				n += (unsigned)snprintf(line + n, sizeof(line) - n, " %02x=%s%04x", r, e ? "err" : "",
++				    e ? 0 : (w[0] << 8) | w[1]);
++			}
++			printf("SWEET AMP: %s regs:%s\n", amp_chips[c].name, line);
++		}
++		as.dead = false;    /* a NACK on one amp must not hide the other */
++		as.gpio = north;
++		/* back to what the bootloader left (cfg, then the level) */
++		amp_wr(north, AMP_GPIO_IO(amp_chips[c].reset_gpio), rio[c]);
++		amp_wr(north, AMP_GPIO_CFG(amp_chips[c].reset_gpio), rcfg[c]);
++		as.gpio = keep;
++	}
++pins:
