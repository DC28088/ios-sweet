+    s=s.replace('    if(_nativeSurface)CFRelease(_nativeSurface);\n\t[super dealloc];', '    if(_nativeSurface)CFRelease(_nativeSurface);\n    free(_nativePlanarPixels);\n\t[super dealloc];')
