diff --git a/userspace/native-metal/frontend/SweetNV12.h b/userspace/native-metal/frontend/SweetNV12.h
new file mode 100644
index 0000000..5a5acb2
--- /dev/null
+++ b/userspace/native-metal/frontend/SweetNV12.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MIT
+ * Checked CPU fallback for combined 8-bit NV12 textures. Inspired by the
+ * ios-flame sunfish frontend's CPU fallback; no source pixels are modified.
+ */
+#ifndef SWEET_NV12_H
+#define SWEET_NV12_H
+#include <stdint.h>
+#include <stddef.h>
+struct sweet_nv12 {
+    const uint8_t *y, *uv;
+    size_t yrow, uvrow, yw, yh, uvw, uvh;
+    uintptr_t allocation;
+    size_t bytes;
+};
+static inline int sweet_nv12_range(const struct sweet_nv12 *s, const uint8_t *p,
+    size_t row, size_t width, size_t height) {
+    uintptr_t a=(uintptr_t)p;
+    if(!a || a<s->allocation || !width || !height || row<width)return 0;
+    size_t off=a-s->allocation;
+    return off<s->bytes && width<=s->bytes-off &&
+        height-1<=(s->bytes-off-width)/row;
+}
+static inline uint8_t sweet_nv12_byte(int x) {return (uint8_t)(x<0?0:x>255?255:x);}
+/* matrix: 1 BT.601, 2 BT.709, 3 BT.2020 non-constant luminance.
+ * Coefficients are 16.16, including the video-range scale when requested. */
+static inline int sweet_nv12_convert(const struct sweet_nv12 *s,size_t w,size_t h,
+    int video,unsigned matrix,uint8_t *dst,size_t length) {
+    if(!s || !dst || !w || !h || matrix<1 || matrix>3 || w>SIZE_MAX/4 ||
+       h>length/(w*4) || w>s->yw || h>s->yh ||
+       (w/2+w%2)>s->uvw || (h/2+h%2)>s->uvh ||
+       !sweet_nv12_range(s,s->y,s->yrow,w,h) ||
+       !sweet_nv12_range(s,s->uv,s->uvrow,(w/2+w%2)*2,h/2+h%2))return 0;
+    static const int c[3][2][5]={
+      {{65536,91881,22553,46802,116130},{76309,104597,25675,53279,132201}},
+      {{65536,103206,12276,30679,121609},{76309,117489,13975,34925,138438}},
+      {{65536,96639,10784,37444,123299},{76309,110014,12277,42626,140363}}
+    };
+    const int *k=c[matrix-1][video?1:0];
+    for(size_t y=0;y<h;y++) {
+        const uint8_t *ly=s->y+y*s->yrow,*uv=s->uv+(y/2)*s->uvrow;
+        uint8_t *out=dst+y*w*4;
+        for(size_t x=0;x<w;x++,out+=4) {
+            int Y=((int)ly[x]-(video?16:0))*k[0];
+            int U=(int)uv[(x/2)*2]-128,V=(int)uv[(x/2)*2+1]-128;
+            out[0]=sweet_nv12_byte((Y+k[1]*V+32768)>>16);
+            out[1]=sweet_nv12_byte((Y-k[2]*U-k[3]*V+32768)>>16);
+            out[2]=sweet_nv12_byte((Y+k[4]*U+32768)>>16);
+            out[3]=255;
+        }
+    }
+    return 1;
+}
+#endif
diff --git a/userspace/native-metal/frontend/SweetNativePlanar.inc b/userspace/native-metal/frontend/SweetNativePlanar.inc
new file mode 100644
index 0000000..dc0ae4e
--- /dev/null
+++ b/userspace/native-metal/frontend/SweetNativePlanar.inc
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT */
+- (BOOL)nativeRefreshPlanar {
+    if(!_nativePlanar)return YES;
+    IOSurfaceRef s=(IOSurfaceRef)_nativeSurface;
+    if(!s || IOSurfaceGetPlaneCount(s)!=2)return NO;
+    uint32_t seed=IOSurfaceGetSeed(s);
+    if(_nativePlanarValid && seed==_nativePlanarSeed)return YES;
+    const size_t w=_shape.width,h=_shape.height;
+    if(!w || !h || w>SIZE_MAX/4 || h>(64u<<20)/(w*4))return NO;
+    size_t bytes=w*h*4;
+    if(bytes!=_nativePlanarBytes) {
+        void *p=realloc(_nativePlanarPixels,bytes);
+        if(!p)return NO;
+        _nativePlanarPixels=p;_nativePlanarBytes=bytes;
+    }
+    if(IOSurfaceLock(s,kIOSurfaceLockReadOnly,NULL)!=0)return NO;
+    struct sweet_nv12 view={
+      IOSurfaceGetBaseAddressOfPlane(s,0),IOSurfaceGetBaseAddressOfPlane(s,1),
+      IOSurfaceGetBytesPerRowOfPlane(s,0),IOSurfaceGetBytesPerRowOfPlane(s,1),
+      IOSurfaceGetWidthOfPlane(s,0),IOSurfaceGetHeightOfPlane(s,0),
+      IOSurfaceGetWidthOfPlane(s,1),IOSurfaceGetHeightOfPlane(s,1),
+      (uintptr_t)IOSurfaceGetBaseAddress(s)&~(uintptr_t)16383,IOSurfaceGetAllocSize(s)
+    };
+    unsigned matrix=1; /* documented BT.601 fallback only when metadata absent */
+    if(&kIOSurfaceYCbCrMatrix && kIOSurfaceYCbCrMatrix) {
+        CFTypeRef value=IOSurfaceCopyValue(s,kIOSurfaceYCbCrMatrix);
+        if(value) {
+            if(CFGetTypeID(value)==CFStringGetTypeID()) {
+                if(CFEqual(value,CFSTR("ITU_R_709_2")))matrix=2;
+                else if(CFEqual(value,CFSTR("ITU_R_2020")))matrix=3;
+                else if(!CFEqual(value,CFSTR("ITU_R_601_4")))matrix=0;
+            }
+            CFRelease(value);
+        }
+    }
+    BOOL converted=IOSurfaceGetBytesPerElementOfPlane(s,0)==1 &&
+      IOSurfaceGetBytesPerElementOfPlane(s,1)==2 &&
+      sweet_nv12_convert(&view,w,h,IOSurfaceGetPixelFormat(s)=='420v',matrix,
+          _nativePlanarPixels,_nativePlanarBytes);
+    seed=IOSurfaceGetSeed(s);
+    IOSurfaceUnlock(s,kIOSurfaceLockReadOnly,NULL);
+    if(!converted)return NO;
+    unsigned origin[3]={0,0,0},size[3]={(unsigned)w,(unsigned)h,1};char why[256]={0};
+    if(mesa.texture_write(_texture,0,0,origin,size,_nativePlanarPixels,w*4,why,sizeof why)) {
+        static unsigned failures;if(failures++<8)rw_print("combined YUV upload failed: %s\n",why);return NO;
+    }
+    _nativePlanarSeed=seed;_nativePlanarValid=YES;
+    return YES;
+}
+- (void)nativeEnablePlanar {_nativePlanar=YES;_nativePlanarValid=NO;}
+
+- (struct rwa_texture *)nativeRenderTexture {
+    if(_nativePlanar){static unsigned refused;if(refused++<8)rw_print("combined YUV GPU writeback is not supported\n");return NULL;}
+    return _texture;
+}
