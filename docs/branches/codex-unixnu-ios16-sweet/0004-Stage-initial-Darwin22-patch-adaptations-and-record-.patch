index 0000000..96dd25b
--- /dev/null
+++ b/ports/UniXNU-sweet/kernel-port/README.md
@@ -0,0 +1,18 @@
+# Darwin22 source adaptation
+
+This directory stages replacements for the current UniXNU kernel patches on
+XNU8796.141.3. It is not wired into the generic kernel build: that build still
+needs a complete replacement patch module and matching archive/prelink scripts.
+The board readiness flag remains set.
+
+The first upstream patch, apple-only-cpu-tunables, rejects the iOS16 start.s
+context. Its replacement preserves the same non-Apple CPU guard using the
+actual iOS16 source layout. The archive-dependency replacement targets
+Darwin22's .unstripped link rule rather than Darwin23's .unstripped.noctf.
+Source application was checked; no kernel was compiled or executed.
+progress.json records the next unresolved patch. Do not
+interpret a patch applying cleanly as a working4KiB kernel or driver.
+
+Reference: UniXNU89801d6e9265ba9aa49e56de642565288d679f83 patches/xnu;
+Apple XNU1b191cb58250d0705d8a51287127505aa4bc0789. The source patch retains
+the Apple source's license and the upstream patch's attribution/provenance.
diff --git a/ports/UniXNU-sweet/kernel-port/apple-only-cpu-tunables.patch b/ports/UniXNU-sweet/kernel-port/apple-only-cpu-tunables.patch
new file mode 100644
index 0000000..6bc7ec0
--- /dev/null
+++ b/ports/UniXNU-sweet/kernel-port/apple-only-cpu-tunables.patch
@@ -0,0 +1,25 @@
+--- a/osfmk/arm64/start.s
++++ b/osfmk/arm64/start.s
+@@ -33,7 +33,9 @@
+ #include <mach_assert.h>
+ #include <machine/asm.h>
+ #include "assym.s"
++#if defined(APPLE_ARM64_ARCH_FAMILY)
+ #include <arm64/tunables/tunables.s>
++#endif
+ #include <arm64/exception_asm.h>
+ 
+ #if __ARM_KERNEL_PROTECT__
+@@ -774,10 +776,12 @@
+ 	// Initialization common to all non-virtual Apple targets
+ #endif  // APPLE_ARM64_ARCH_FAMILY
+ 
++#if defined(APPLE_ARM64_ARCH_FAMILY)
+ 	// Read MIDR before start of per-SoC tunables
+ 	mrs x12, MIDR_EL1
+ 
+ 	APPLY_TUNABLES x12, x13, x14
++#endif
+ 
+ 
+ #if HAS_CLUSTER
diff --git a/ports/UniXNU-sweet/kernel-port/external-archive-dependencies.patch b/ports/UniXNU-sweet/kernel-port/external-archive-dependencies.patch
new file mode 100644
index 0000000..94cbe40
--- /dev/null
+++ b/ports/UniXNU-sweet/kernel-port/external-archive-dependencies.patch
@@ -0,0 +1,12 @@
+--- a/makedefs/MakeInc.kernel
++++ b/makedefs/MakeInc.kernel
+@@ -143,6 +143,9 @@
+ 	$(_v)$(LIBTOOL) -static -csD -filelist link.filelist -o $@
+ 	$(_v)$(LN) $(call function_convert_build_config_to_objdir,$(CURRENT_BUILD_CONFIG))/lib$(KERNEL_FILE_NAME).a $(OBJROOT)/lib$(KERNEL_FILE_NAME).a
+ endif
++
++# Explicit external archives participate in incremental relinking (Darwin22 target).
++$(TARGET)/$(KERNEL_FILE_NAME).unstripped: $(XNU_EXTERNAL_KERNEL_ARCHIVES)
+ 
+ $(TARGET)/$(KERNEL_FILE_NAME).unstripped: $(addprefix $(TARGET)/,$(foreach component,$(COMPONENT_LIST),$(component)/$(CURRENT_KERNEL_CONFIG)/$(component).filelist)) lastkerneldataconst.o lastkernelconstructor.o nonlto.o $(SRCROOT)/config/version.c $(SRCROOT)/config/MasterVersion $(LDFILES_KERNEL_ONLY) .LDFLAGS $(filter %/MakeInc.kernel,$(MAKEFILE_LIST))
+ 	$(_v)${MAKE} -f $(firstword $(MAKEFILE_LIST)) version.o
