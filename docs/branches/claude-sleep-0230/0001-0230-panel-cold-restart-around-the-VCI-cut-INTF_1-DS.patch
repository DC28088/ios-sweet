++				}
+ 				e1 = bl->panelInit();
+ 				e2 = 0;
+ 				if (e1) {
+ 					sweet_panel_vci = 0;      /* keep VCI on from now on: plain 11/29 next time */
+ 				}
++				if (bl->fCtrlSaved) {
++					(void)bl->readDcs(0x0a, "after on-command, link idle");   /* 0x9c = booster, normal, awake, on */
++				}
+ 			} else {
++				if (bl->fCtrlSaved) {
++					bl->coldStart();         /* 0230: plain 11/29 need the stream (sendShort checks video) */
++				}
+ 				e1 = bl->sendShort(0x11);    /* sleep out */
+ 				IOSleep(120);
+ 				e2 = bl->sendShort(0x29);    /* display on */
+ 			}
++			if (bl->fCtrlSaved) {
++				bl->coldStart();             /* 0230: video last, as Linux */
++			}
+ 			bl->fSent = 0;               /* resend the brightness: the panel may have reset it */
+ 		}
+ 		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+@@ -777,6 +836,9 @@ AppleARMBacklight::applyCall(thread_call_param_t owner, thread_call_param_t)
+ 		}
+ 		if (sweet_panel_failed && bl->fPanelAsleep) {
+ 			/* never leave the panel asleep after a failure */
++			if (bl->fCtrlSaved) {
++				bl->coldStart();
++			}
+ 			if (sweet_panel_vci_off) {
+ 				(void)sweet_rpmh_panel_vci(true);
+ 				sweet_panel_vci_off = false;
+@@ -828,9 +890,8 @@ AppleARMBacklight::panelSleep(bool off)
+ int
+ AppleARMBacklight::sendPacket(uint8_t dtype, const uint8_t *data, unsigned len, bool hs)
+ {
+-	volatile uint32_t *dsi = fDsi;
+-	const uint32_t ctrl = dsi[DSI_REG_CTRL / 4];
+-	if ((ctrl & 3) != 3 || !len || len > 128) {
++	const uint32_t ctrl = fDsi[DSI_REG_CTRL / 4];
++	if (!(ctrl & 1u) || !len || len > 128) {   /* 0230: the video engine is off during a cold wake */
+ 		IOLog("SWEET PANEL: packet %#x len %u not sent (ctrl=%#x)\n", dtype, len, ctrl);
+ 		return ENODEV;
+ 	}
+@@ -848,6 +909,22 @@ AppleARMBacklight::sendPacket(uint8_t dtype, const uint8_t *data, unsigned len,
+ 			words[n] = w;
+ 		}
+ 	}
++	unsigned us;
++	uint32_t ack;
++	const int e = fifoDma(words, n, hs, &us, &ack);
++	if (e || ack) {
++		IOLog("SWEET PANEL: packet %#x reg %#x len %u %s: done=%d after %u us ack_err=%#x\n", dtype, data[0], len,
++		    hs ? "HS" : "LP", e == 0, us, ack);
++	}
