++/*
++ * 0230: 0229 + live pokes (/dev/pmem) on hardware: after a VCI cut or a reset the DDIC never comes back, whatever
++ * we send (LP or HS, whole on-command, after the reset pulse): it needs a cold link start. Linux (DT
++ * qcom,mdss-dsi-lp11-init) and the ABL stop the INTF timing engine and the DSI video engine, so the lanes sit in
++ * LP-11 while the panel is reset and the on-command goes out in command mode; only then does video start again.
++ * We kept the ABL's HS stream running through the reset. Live test: stopping only the DSI video engine while
++ * INTF_1 kept pushing overflowed the DSI FIFO (0xdddd....) and the stream never restarted: INTF must stop first and
++ * start last. sweetpanelcold=0 restores the 0229 sequence. sweetpanelcold bits (default per build):
++ *   1 stop/start INTF_1 + DSI video around the power cut, 2 DSI soft reset + ABL register snapshot restore before
++ *   video on, 4 CTL0 flush after INTF on.
++ */
++static int sweet_panel_cold = -1;
++static volatile bool sweet_panel_stream_off;   /* 0230: INTF_1 stopped: no beam waits */
+ 
+ class AppleCLCD : public IOMobileFramebuffer {
+ 	OSDeclareDefaultStructors(AppleCLCD);
+@@ -505,6 +527,16 @@ extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+ #define DSI_REG_DMA_LENGTH      0x04c
+ #define DSI_REG_ACK_ERR         0x068
+ #define DSI_REG_DMA_TRIGGER     0x090
++#define DSI_REG_STATUS          0x008   /* 0230 */
++#define DSI_REG_FIFO_STATUS     0x00c   /* error bits write-1-to-clear */
++#define DSI_REG_RDBK_DATA0      0x06c   /* RDBK_DATA0..3, then RDBK_DATATYPE0/1 */
++#define DSI_REG_LANE_STATUS     0x0a8
++#define DSI_REG_LANE_CTRL       0x0ac
++#define DSI_REG_DLN0_PHY_ERR    0x0b4
++#define DSI_REG_CLK_STATUS      0x120
++#define DSI_REG_SOFT_RESET      0x118
++#define DSI_REG_CLK_CTRL        0x11c
++#define DSI_REG_RDBK_DATA_CTRL  0x1d0   /* bits 31:16 bytes read back (the ABL's ID reads leave 0x29 here) */
+ #define DSI_REG_TIMEOUT_STATUS  0x0c0
+ #define DSI_REG_INT_CTRL        0x110
+ #define DSI_REG_TPG_CTRL        0x15c
+@@ -721,6 +753,16 @@ AppleARMBacklight::applyCall(thread_call_param_t owner, thread_call_param_t)
+ 				PE_parse_boot_argn("sweetpanelvci", &v, sizeof(v));
