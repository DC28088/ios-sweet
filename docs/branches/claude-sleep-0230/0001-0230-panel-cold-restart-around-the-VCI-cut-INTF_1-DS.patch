++				PE_parse_boot_argn("sweetpanelcold", &c, sizeof(c));
++				sweet_panel_cold = c;
++			}
++			if (!e1 && !e2 && sweet_panel_vci && (sweet_panel_cold & 1)) {
++				if (!bl->coldStop()) {
++					sweet_panel_vci = 0;   /* could not stop the stream: keep the panel powered (0225 sleep) */
++				}
++			}
+ 			if (!e1 && !e2 && sweet_panel_vci) {
+ 				/* 0229: like Linux dsi_panel_power_off: reset low, then the supply (pre-off 10 ms) */
+ 				sweet_panel_in_reset = sweet_spmi_panel_reset(0) == 0;
+@@ -753,16 +795,33 @@ AppleARMBacklight::applyCall(thread_call_param_t owner, thread_call_param_t)
+ 			if (reinit) {
+ 				/* 0228: VCI was off, the DDIC lost its setup (0227 hardware: 11/29 acked, screen
+ 				 * black): Xiaomi's whole on-command (sleep out ... DSC 9D/9E ... 53/51 ... 29) */
++				if (bl->fCtrlSaved) {
++					/* 0230: link idle (LP-11): clear stale DSI errors, then the on-command in command mode */
++					bl->fDsi[DSI_REG_FIFO_STATUS / 4] = bl->fDsi[DSI_REG_FIFO_STATUS / 4];
++					bl->fDsi[DSI_REG_ACK_ERR / 4] = bl->fDsi[DSI_REG_ACK_ERR / 4];
++					bl->fDsi[DSI_REG_TIMEOUT_STATUS / 4] = bl->fDsi[DSI_REG_TIMEOUT_STATUS / 4];
++					bl->fDsi[DSI_REG_DLN0_PHY_ERR / 4] = bl->fDsi[DSI_REG_DLN0_PHY_ERR / 4];
