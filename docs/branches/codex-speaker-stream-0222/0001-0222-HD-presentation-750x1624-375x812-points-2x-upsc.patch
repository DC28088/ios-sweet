From 2ea20b6fbc62862519edefb6c941f5c53d288f6f Mon Sep 17 00:00:00 2001
From: OpenCode <opencode@localhost>
Date: Sat, 7 Nov 2026 23:06:46 +0530
Subject: [PATCH 1/2] 0222: HD presentation 750x1624 (375x812 points @2x),
 upscaled onto the panel

AppleCLCD presents 750x1624 (sweetfb_mode=3, the same 375x812 point geometry
and aspect as the 1125x2436 presentation at 44% fewer pixels) and copyScaled()
nearest-neighbour-upscales onto the fixed 1080x2400 panel without a division
in the inner loop (64-bit stores fill 1-2 panel pixels). sweetfb_mode=4
presents the real iPhone XR panel 828x1792 as a status-bar fallback; the
general helpers work for either. mkadt: /chosen display-scale 2, disp0 canvas
750x1624.

Co-Authored-By: dipa-studio <183933817+dipa-studio@users.noreply.github.com>

diff --git a/tools/mkadt.py b/tools/mkadt.py
index 79e5e09..1bd148a 100644
--- a/tools/mkadt.py
+++ b/tools/mkadt.py
@@ -99,9 +99,11 @@ def build(seed=None, qemu=False, highmem=False):
         ('crypto-hash-method', cstr('sha2-384')),
         # MobileGestalt's screen class: display-scale (u32, default 0) comes
         # from /chosen, the pixel size from IOMobileFramebuffer. Scale 0 makes
-        # SpringBoard's FBSDisplayMode "infxinf@0x" invalid. 1080x2400 @3x =
-        # 360x800 points (like iPhone X class devices).
-        ('display-scale', u32(3)),
+        # SpringBoard's FBSDisplayMode "infxinf@0x" invalid. With the 0222 HD
