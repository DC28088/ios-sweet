Date: Fri, 30 Oct 2026 09:08:35 +0530
Subject: [PATCH 03/20] Bridge 0202: per-pass draw count, scissor coverage and
 pipelines for full-screen passes

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/userspace/metal2/bridge-patches/0202-sweet-render-pass-audit.patch b/userspace/metal2/bridge-patches/0202-sweet-render-pass-audit.patch
index 177f8f1..f69c702 100644
--- a/userspace/metal2/bridge-patches/0202-sweet-render-pass-audit.patch
+++ b/userspace/metal2/bridge-patches/0202-sweet-render-pass-audit.patch
@@ -1,5 +1,5 @@
 diff --git a/crates/metal2vulkan-runtime/src/render.rs b/crates/metal2vulkan-runtime/src/render.rs
-index 870bdb1..f9d255a 100644
+index 870bdb1..4653c4c 100644
 --- a/crates/metal2vulkan-runtime/src/render.rs
 +++ b/crates/metal2vulkan-runtime/src/render.rs
 @@ -3061,6 +3061,7 @@ impl RenderCommandEncoder {
@@ -10,7 +10,23 @@ index 870bdb1..f9d255a 100644
          if let Some(ds) = layout.depth_stencil.as_mut().filter(|ds| !ds.hidden) {
              let unknown = |aspect: Option<AspectTarget>| {
                  aspect.is_some_and(|a| a.store == StoreAction::Unknown)
-@@ -8536,3 +8537,63 @@ mod tests {
+@@ -5668,6 +5669,7 @@ impl RenderCommandEncoder {
+             self.degrade_extended_range_blends();
+         }
+         self.draw_calls += 1;
++        sweet_audit_draw(self.pipeline.as_ref().map(|p| (p.identifier_value(), p.label().map(str::to_string))));
+         self.command_encoded(reads);
+         self.called = true;
+         self.drew |= !empty && rasterizes;
+@@ -5684,6 +5686,7 @@ impl RenderCommandEncoder {
+                     let mut scissors = [vk::Rect2D::default(); MAX_VIEWPORTS];
+                     let rects = self.state.vk_scissors_in(selects, &mut scissors);
+                     self.drawn.add(rects);
++                    sweet_audit_rects(rects);
+                     // What it writes of each color, and blends, inside its Vulkan scissors
+                     // (`linear_attachment::Coverage`).
+                     // Of each pass color its draws store into: a state color where its routing
+@@ -8536,3 +8539,139 @@ mod tests {
          }
      }
  }
@@ -18,12 +34,14 @@ index 870bdb1..f9d255a 100644
 +/// Sweet: what Metal asked of each render pass, summed over 10 s and appended to
 +/// `/var/local/m2v-pass-audit.log` when `SWEET_M2V_PASS_AUDIT` is set (a profile of the pass mix, not a trace).
 +fn sweet_pass_audit(layout: &PassLayout, instances: usize, bounds: Option<[u32; 4]>) {
++    let details = sweet_audit_take();
 +    use std::collections::HashMap;
 +    use std::io::Write;
 +    use std::sync::{Mutex, OnceLock};
 +    use std::time::{Duration, Instant};
 +    static ON: OnceLock<bool> = OnceLock::new();
 +    static STATE: OnceLock<Mutex<(Instant, HashMap<String, (u64, u64)>)>> = OnceLock::new();
++    static LINES: OnceLock<Mutex<Vec<String>>> = OnceLock::new();
 +    if !*ON.get_or_init(|| std::env::var_os("SWEET_M2V_PASS_AUDIT").is_some()) {
 +        return;
 +    }
@@ -55,6 +73,26 @@ index 870bdb1..f9d255a 100644
 +        }
 +    };
 +    key += &format!(" {}", reach);
++    let detail = if layout.extent[0] >= 1000 && details.draws > 0 {
++        let mut pipes = details.pipes.clone();
++        pipes.sort_by(|a, b| b.2.cmp(&a.2));
++        let list: Vec<String> = pipes.iter().take(4).map(|(id, label, n)| format!("{:x}{}x{}", id, label.as_deref().map(|l| format!("({})", l)).unwrap_or_default(), n)).collect();
++        Some(format!(
++            "PASS {}x{} {} draws={} scissor-area-sum={:.2}x pipes={}/{} [{}]",
++            layout.extent[0], layout.extent[1],
++            layout.colors.first().and_then(|c| c.as_ref()).map_or(String::new(), |c| format!("{:?}/{:?}", c.load, c.store)),
++            details.draws, details.pixels as f64 / pixels.max(1) as f64, pipes.len(), details.draws, list.join(" ")
++        ))
++    } else {
++        None
++    };
++    if let Some(line) = detail {
++        if let Ok(mut lines) = LINES.get_or_init(|| Mutex::new(Vec::new())).lock() {
++            if lines.len() < 40 {
++                lines.push(line);
++            }
++        }
++    }
 +    let state = STATE.get_or_init(|| Mutex::new((Instant::now(), HashMap::new())));
 +    let Ok(mut state) = state.lock() else { return };
 +    let entry = state.1.entry(key).or_insert((0, 0));
@@ -67,6 +105,11 @@ index 870bdb1..f9d255a 100644
 +            let total: u64 = rows.iter().map(|r| r.1 .0).sum();
 +            let mpx: u64 = rows.iter().map(|r| r.1 .1).sum::<u64>() / 1_000_000;
 +            let _ = writeln!(file, "WINDOW passes={} Mpx={}", total, mpx);
++            if let Ok(mut lines) = LINES.get_or_init(|| Mutex::new(Vec::new())).lock() {
++                for line in lines.drain(..) {
++                    let _ = writeln!(file, "  {}", line);
++                }
++            }
 +            for (key, (count, pixels)) in rows.iter().take(14) {
 +                let _ = writeln!(file, "  n={} Mpx={} {}", count, pixels / 1_000_000, key);
 +            }
@@ -74,3 +117,52 @@ index 870bdb1..f9d255a 100644
 +        state.0 = Instant::now();
 +    }
 +}
++
++/// Sweet audit: the draws of the pass being encoded on this thread (reset when the pass ends).
++#[derive(Default, Clone)]
++struct SweetPassDetails {
++    draws: u32,
++    pixels: u64,
++    pipes: Vec<(u64, Option<String>, u32)>,
++}
++thread_local! {
++    static SWEET_PASS: std::cell::RefCell<SweetPassDetails> = std::cell::RefCell::new(SweetPassDetails::default());
++}
++fn sweet_audit_on() -> bool {
++    use std::sync::OnceLock;
++    static ON: OnceLock<bool> = OnceLock::new();
++    *ON.get_or_init(|| std::env::var_os("SWEET_M2V_PASS_AUDIT").is_some())
++}
++fn sweet_audit_draw(pipeline: Option<(u64, Option<String>)>) {
++    if !sweet_audit_on() {
++        return;
++    }
++    SWEET_PASS.with(|pass| {
++        let mut pass = pass.borrow_mut();
++        pass.draws += 1;
++        if let Some((id, label)) = pipeline {
++            if let Some(entry) = pass.pipes.iter_mut().find(|p| p.0 == id) {
++                entry.2 += 1;
++            } else if pass.pipes.len() < 64 {
++                pass.pipes.push((id, label, 1));
++            }
++        }
++    });
++}
++fn sweet_audit_rects(rects: &[vk::Rect2D]) {
++    if !sweet_audit_on() {
++        return;
++    }
++    SWEET_PASS.with(|pass| {
++        let mut pass = pass.borrow_mut();
++        for r in rects {
++            pass.pixels += r.extent.width as u64 * r.extent.height as u64;
++        }
++    });
++}
++fn sweet_audit_take() -> SweetPassDetails {
++    if !sweet_audit_on() {
++        return SweetPassDetails::default();
++    }
++    SWEET_PASS.with(|pass| std::mem::take(&mut *pass.borrow_mut()))
++}
