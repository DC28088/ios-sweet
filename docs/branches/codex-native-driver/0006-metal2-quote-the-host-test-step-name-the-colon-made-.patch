index 2ca2f73..94b998e 100644
--- a/.github/workflows/metal2.yml
+++ b/.github/workflows/metal2.yml
@@ -15,7 +15,7 @@ jobs:
           rustup toolchain install 1.98.0 --profile minimal
           rustup target add aarch64-apple-ios --toolchain 1.98.0
           python3 --version
-      - name: Host test: PM4 builder
