diff --git a/docs/ISERV_DIAGNOSTICS.md b/docs/ISERV_DIAGNOSTICS.md
new file mode 100644
index 0000000..fdf6a31
--- /dev/null
+++ b/docs/ISERV_DIAGNOSTICS.md
@@ -0,0 +1,29 @@
+# Native account and Store diagnostics
+
+Patch 0209 is diagnostic only. It changes no authentication, signing,
+keychain, activation, cryptographic validation, or Store result.
+
+With `sweetservtrace=1`, it records BSD syscall number and errno for `adid`
+and `fairplayd.H2`. It omits transient EINTR/EAGAIN and internal restart codes.
+Each daemon has a boot-wide cap of 256 errors and 32 exit-status records,
+including respawns. No file paths, buffers, account data, return pointers,
+device identifiers or cryptographic data are printed. Default is disabled.
+The exit event is logged before dispatch because exit does not return.
+Nonlocal syscall return paths and Mach traps are outside this first probe.
+
+The native reproduction reached HTTP 200 at both anisette provisioning
+endpoints, ADIProvisioningStart succeeded, and ADIProvisioningEnd returned
+-42410 (AKAnisetteError -8004 / AKUnderlyingADIErrors -42410). The meaning of
+-42410 has not been established. In the same test, appstored's bag did not
+finish loading (ASDErrorDomain 515) and fairplayd.H2 repeatedly started.
+These observations justify checking local OS failures; they do not establish
+an OS failure rather than cryptographic or activation requirements.
+
+Next test: use the same 0207 hardware configuration, add sweetservtrace=1,
+retain selective daemon logs, correct wall clock and connect Wi-Fi before
+one account reproduction. Keep raw captures local and publish aggregates only.
+Do not infer that a lack of syscall failures proves Apple's credentials or
+attestation requirements are satisfied.
+
+Local validation: patch apply check against the prepared 0207 source passed;
+whitespace check passed. A full kernel compile and hardware test remain pending.
diff --git a/xnu/patches/0209-sweet-iserv-syscall-diagnostics.patch b/xnu/patches/0209-sweet-iserv-syscall-diagnostics.patch
new file mode 100644
index 0000000..bfff523
--- /dev/null
+++ b/xnu/patches/0209-sweet-iserv-syscall-diagnostics.patch
@@ -0,0 +1,65 @@
+--- a/bsd/dev/arm/systemcalls.c
++++ b/bsd/dev/arm/systemcalls.c
+@@ -86,6 +86,48 @@
+  *
+  * Outputs:	none
+  */
++#if defined(SWEET)
++/* 0209: opt-in iServices diagnostics. No paths, payloads, registers or IDs.
++ * Only the two failing native daemons are selected. Errors and exits are
++ * independently capped per daemon for the whole boot, including respawns.
++ */
++static bool
++sweet_iserv_trace_selected(struct proc *p)
++{
++	unsigned int enabled = 0;
++	if (strcmp(p->p_comm, "adid") != 0 &&
++	    strcmp(p->p_comm, "fairplayd.H2") != 0) {
++		return false;
++	}
++	return PE_parse_boot_argn("sweetservtrace", &enabled, sizeof(enabled)) && enabled == 1;
++}
++
++static void
++sweet_iserv_trace(struct proc *p, unsigned int code, int error,
++    bool entering, uint64_t exit_status)
++{
++	static unsigned int errors[2], exits[2];
++	if (!sweet_iserv_trace_selected(p)) {
++		return;
++	}
++	unsigned int role = strcmp(p->p_comm, "adid") == 0 ? 0 : 1;
++	if (entering) {
++		if (code == SYS_exit &&
++		    __atomic_fetch_add(&exits[role], 1, __ATOMIC_RELAXED) < 32) {
++			printf("SWEET ISERV: %s exit status %d\n", p->p_comm, (int)exit_status);
++		}
++		return;
++	}
++	if (error <= 0 || error == EINTR || error == EAGAIN ||
++	    error == ERESTART || error == EJUSTRETURN) {
++		return;
++	}
++	if (__atomic_fetch_add(&errors[role], 1, __ATOMIC_RELAXED) < 256) {
++		printf("SWEET ISERV: %s syscall %u errno %d\n", p->p_comm, code, error);
++	}
++}
++#endif
++
+ void
+ unix_syscall(
+ 	struct arm_saved_state * state,
+@@ -178,7 +220,13 @@
+ #endif /* CONFIG_DEBUG_SYSCALL_REJECTION */
+ 
+ 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
++#if defined(SWEET)
++	sweet_iserv_trace(proc, code, 0, true, uthread->uu_arg[0]);
++#endif
+ 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
++#if defined(SWEET)
++	sweet_iserv_trace(proc, code, error, false, 0);
++#endif
+ 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
+ 
+ #if CONFIG_MACF
