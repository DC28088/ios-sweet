diff --git a/NOTES.md b/NOTES.md
index 20211d0..6a76107 100644
--- a/NOTES.md
+++ b/NOTES.md
@@ -1,3 +1,10 @@
+## 2026-11-06: native planar IOSurface row-stride bug confirmed; 0211 fix prepared
+- USER confirms Wi-Fi works and haptics are fine on recovered 0209; YouTube still fails and no sound. Fresh private capture: repeated mediaserverd SIGBUS at same H264SW decoder instruction, destination in RX shared cache. Audio device nodes remain absent. No claim that stride fix alone resolves the decoder fault.
+- Exact target iOS16 IOSurfaceClientGetBytesPerRowOfPlane reads client+0xe0+plane*0x80; plane records begin client+0xd0, so row is record+0x10. Kernel serializer currently writes it at +0x08. Width/height/offset/size/element fields verified separately against native getters.
+- Bounded native synthetic helper created its own 64x32 two-plane buffer with both row strides explicitly 64. iOS returned plane widths 64/32 correctly but row sizes 0/0, confirming the behavior on current hardware. Helper removed. No user content read. Initial malformed fixture omitted global bytes-per-element and was rejected; corrected fixture supplies 1 and creates successfully.
+- 0211 changes only planar row-stride result offset +0x08 -> +0x10. Full DT/haptic/network/hardware behavior unchanged. Exact serializer host fixture checks native planar offsets plus unchanged nonplanar fields; patch apply check passes. CI build/hardware validation pending.
+- Native helper, private capture and disassembly kept outside Git. Main DeepSeek/audio checkout untouched. Next: isolated kernel CI on codex/media-0211; package quiet boot args; test native fixture first, then Safari.
+
 ## 2026-11-06: 0209 recovery Wi-Fi interface published; USER requested SpringBoard restart
 - 0209 USB SSH + SpringBoard reached; UTC corrected. Fresh wland log confirms firmware/HTT READY, initial scan completed, and bridge hello/interface publication. User-facing connectivity and haptic feel still require confirmation. Unlike the failed 0208 boot, this boot passed first-scan publication. This supports an intermittent scan dependency, not a proven kernel regression.
 - Haptic kernel log: continuous mode prepared OK, serving configured 30 ms minimum taps. USER requested SpringBoard restart; identified process 26 was sent SIGTERM for launchd to relaunch it. No daemon, network profile, motor drive, DSP or partition settings changed.
diff --git a/tools/check-sweet-surface-result.py b/tools/check-sweet-surface-result.py
new file mode 100644
index 0000000..0c2b46b
--- /dev/null
+++ b/tools/check-sweet-surface-result.py
@@ -0,0 +1,33 @@
+from pathlib import Path
+import subprocess,tempfile,sys
+if len(sys.argv)!=2: raise SystemExit('Usage: check-sweet-surface-result.py PATH/TO/SweetSurface.cpp')
+src=Path(sys.argv[1]).read_text()
+start=src.index('static void\nsweet_surface_fill_result(');end=src.index('\nstatic IOReturn',start);fn=src[start:end]
+preamble='''#include <cstdint>
+#include <cstring>
+#include <cassert>
+#define SWEET_SURFACE_RESULT_SIZE 0xa68
+#define SWEET_SURFACE_TIMESTAMPS 0x800
+struct M { uint64_t address; uint64_t getAddress(){return address;} };
+struct SweetSurfaceRef { M *data, *state; };
+struct sweet_surface_plane {uint32_t width,height,bytesPerRow,offset,size;uint16_t bytesPerElement;uint8_t elementWidth,elementHeight;};
+struct SweetSurface {uint32_t id,allocSize,width,height,bytesPerRow,offset,pixelFormat,planeCount;uint16_t bytesPerElement;uint8_t elementWidth,elementHeight;uint32_t cacheMode,parentID;sweet_surface_plane planes[2];};
+static void put32(uint8_t*p,uint32_t off,uint32_t v){memcpy(p+off,&v,4);}
+static void put64(uint8_t*p,uint32_t off,uint64_t v){memcpy(p+off,&v,8);}
+static uint32_t get32(const uint8_t*p,unsigned off){uint32_t v;memcpy(&v,p+off,4);return v;}
+'''
+test='''
+int main(){
+ M data{0x110000000},state{0x120000000};SweetSurfaceRef ref{&data,&state};SweetSurface s{};
+ s.id=7;s.allocSize=3072;s.width=64;s.height=32;s.bytesPerRow=64;s.planeCount=2;s.bytesPerElement=1;s.elementWidth=s.elementHeight=1;
+ s.planes[0]={64,32,64,0,2048,1,1,1};s.planes[1]={32,16,64,2048,1024,2,1,1};
+ uint8_t out[SWEET_SURFACE_RESULT_SIZE];sweet_surface_fill_result(&s,&ref,out);
+ // Consumer offsets independently verified in the target iOS16 framework.
+ for(unsigned i=0;i<2;i++){unsigned p=0x68+i*0x80;assert(get32(out,p+0x10)==64);assert(get32(out,p+0x08)==0);assert(get32(out,p+0xc)==i*2048);}
+ assert(get32(out,0x1c)==3072 && get32(out,0x38)==2);
+ s.planeCount=0;s.bytesPerRow=256;sweet_surface_fill_result(&s,&ref,out);assert(get32(out,0x28)==256);assert(get32(out,0x38)==0);assert(get32(out,0x78)==0);
+}
+'''
+with tempfile.TemporaryDirectory() as d:
+ p=Path(d);(p/'test.cpp').write_text(preamble+fn+test);subprocess.run(['c++','-std=c++17','-Wall','-Wextra','-Werror',str(p/'test.cpp'),'-o',str(p/'test')],check=True);subprocess.run([str(p/'test')],check=True)
+ print('PASS: exact kernel serializer; 2-plane native consumer offsets and nonplanar layout')
diff --git a/xnu/patches/0211-sweet-iosurface-plane-row-abi.patch b/xnu/patches/0211-sweet-iosurface-plane-row-abi.patch
new file mode 100644
index 0000000..15f38fb
--- /dev/null
+++ b/xnu/patches/0211-sweet-iosurface-plane-row-abi.patch
@@ -0,0 +1,13 @@
+--- a/iokit/Kernel/arm/SweetSurface.cpp
++++ b/iokit/Kernel/arm/SweetSurface.cpp
+@@ -661,7 +661,9 @@
+ 		const struct sweet_surface_plane *pl = &s->planes[i];
+ 		put32(p, 0x00, pl->width);
+ 		put32(p, 0x04, pl->height);
+-		put32(p, 0x08, pl->bytesPerRow);
++		/* iOS 16 client +0xe0: plane base +0xd0, row stride +0x10.
++		 * +0x08 is reserved; writing there made native plane getters return 0. */
++		put32(p, 0x10, pl->bytesPerRow);
+ 		put32(p, 0x0c, pl->offset);
+ 		put32(p, 0x14, pl->size);
+ 		memcpy(p + 0x18, &pl->bytesPerElement, 2);
