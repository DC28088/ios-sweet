-+#define VSS_IMVM_CMD_SET_POLICY_DUAL_CONTROL           0x00011327u
-+#define VSS_IMVM_CMD_ATTACH_VOCPROC                    0x0001123Eu
-+#define VSS_IMVM_CMD_DETACH_VOCPROC                    0x0001123Fu
