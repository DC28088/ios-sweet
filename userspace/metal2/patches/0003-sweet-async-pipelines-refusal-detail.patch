+// Asynchronous constructors (ClockKit/NanoUniverse posters use them). Without
+// these the inherited _MTLDevice paths never reach the native runtime. Each
+// copies its descriptor and runs the synchronous native creation off the
+// caller's thread, then reports the actual result or error once.
+static dispatch_queue_t pipelineQueue() {
+ static dispatch_queue_t queue;static dispatch_once_t once;
+ dispatch_once(&once,^{queue=dispatch_queue_create("SweetMetal2.pipelines",DISPATCH_QUEUE_CONCURRENT);});
+ return queue;
+}
+- (void)newRenderPipelineStateWithDescriptor:(MTLRenderPipelineDescriptor *)d completionHandler:(MTLNewRenderPipelineStateCompletionHandler)handler {
+ MTLRenderPipelineDescriptor *copy=[d copy];id<MTLDevice> device=(id<MTLDevice>)self;
+ dispatch_async(pipelineQueue(),^{
+  NSError *error=nil;id<MTLRenderPipelineState> state=[device newRenderPipelineStateWithDescriptor:copy options:MTLPipelineOptionNone reflection:nil error:&error];
+  if(handler)handler(state,error);
+ });
+}
+- (void)newRenderPipelineStateWithDescriptor:(MTLRenderPipelineDescriptor *)d options:(MTLPipelineOption)options
+                           completionHandler:(MTLNewRenderPipelineStateWithReflectionCompletionHandler)handler {
+ MTLRenderPipelineDescriptor *copy=[d copy];id<MTLDevice> device=(id<MTLDevice>)self;
+ dispatch_async(pipelineQueue(),^{
+  NSError *error=nil;id<MTLRenderPipelineState> state=[device newRenderPipelineStateWithDescriptor:copy options:options reflection:nil error:&error];
+  if(handler)handler(state,nil,error);
+ });
+}
