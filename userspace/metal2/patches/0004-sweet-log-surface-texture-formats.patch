+// Sweet 0004: the garbled Control Center glyphs line up with SpringBoard's LA08 (2-byte luminance/alpha) surfaces. Log each
+// distinct (surface format, bytes per element, texture format, swizzle, usage) once, so the format CoreAnimation asks for is known.
+static void noteSurfaceTexture(MTLTextureDescriptor *d,IOSurfaceRef surface) {
+ static std::mutex lock;static std::set<std::string> seen;
+ const OSType f=IOSurfaceGetPixelFormat(surface);const MTLTextureSwizzleChannels w=d.swizzle;
+ char key[96];snprintf(key,sizeof key,"%08x/%zu/%lu/%02x%02x%02x%02x/%lx",(unsigned)f,IOSurfaceGetBytesPerElement(surface),(unsigned long)d.pixelFormat,
+  (unsigned)w.red,(unsigned)w.green,(unsigned)w.blue,(unsigned)w.alpha,(unsigned long)d.usage);
+ {std::lock_guard<std::mutex> guard(lock);if(seen.size()>=64 || !seen.insert(key).second)return;}
