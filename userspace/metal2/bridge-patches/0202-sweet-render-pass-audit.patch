+/// Sweet: what Metal asked of each render pass, summed over 10 s and appended to
+/// `/var/local/m2v-pass-audit.log` when `SWEET_M2V_PASS_AUDIT` is set (a profile of the pass mix, not a trace).
+fn sweet_pass_audit(layout: &PassLayout, instances: usize, bounds: Option<[u32; 4]>) {
+    let details = sweet_audit_take();
+    use std::collections::HashMap;
+    use std::io::Write;
+    use std::sync::{Mutex, OnceLock};
+    use std::time::{Duration, Instant};
+    static ON: OnceLock<bool> = OnceLock::new();
+    static STATE: OnceLock<Mutex<(Instant, HashMap<String, (u64, u64)>)>> = OnceLock::new();
+    static LINES: OnceLock<Mutex<Vec<String>>> = OnceLock::new();
+    if !*ON.get_or_init(|| std::env::var_os("SWEET_M2V_PASS_AUDIT").is_some()) {
+        return;
+    }
+    let mut key = format!("{}x{} s{} inst{}", layout.extent[0], layout.extent[1], layout.samples, instances);
+    for (index, color) in layout.colors.iter().enumerate() {
+        if let Some(color) = color {
+            key += &format!(" c{}[{:?}/{:?}{}]", index, color.load, color.store, if color.resolve.is_some() { "+resolve" } else { "" });
+        }
+    }
+    if let Some(ds) = layout.depth_stencil.as_ref().filter(|ds| !ds.hidden) {
+        key += &format!(
+            " ds[d {:?}/{:?} s {:?}/{:?}]",
+            ds.depth.map(|a| a.load),
+            ds.depth.map(|a| a.store),
+            ds.stencil.map(|a| a.load),
+            ds.stencil.map(|a| a.store)
+        );
+    } else if layout.depth_stencil.is_some() {
+        key += " hidden-ds";
+    }
+    let pixels = layout.extent[0] as u64 * layout.extent[1] as u64;
+    // How much of the pass the draws can reach (viewport within scissor, `DrawnArea::bounds`): the area a smaller render area would keep.
+    let reach = match bounds {
+        None => "reach-unbounded".to_string(),
+        Some([x0, y0, x1, y1]) => {
+            let area = x1.saturating_sub(x0) as u64 * y1.saturating_sub(y0) as u64;
+            let percent = if pixels == 0 { 0 } else { area * 100 / pixels };
+            format!("reach<={}%", ((percent + 9) / 10 * 10).min(100))
+        }
+    };
+    key += &format!(" {}", reach);
+    let detail = if layout.extent[0] >= 1000 && details.draws > 0 {
+        let mut pipes = details.pipes.clone();
+        pipes.sort_by(|a, b| b.2.cmp(&a.2));
+        let list: Vec<String> = pipes.iter().take(6).map(|(id, label, n)| format!("{:x} x{} {}", id, n, label.as_deref().unwrap_or(""))).collect();
+        Some(format!(
+            "PASS {}x{} {} draws={} scissor-area-sum={:.2}x pipes={}/{} [{}]",
+            layout.extent[0], layout.extent[1],
+            layout.colors.first().and_then(|c| c.as_ref()).map_or(String::new(), |c| format!("{:?}/{:?}", c.load, c.store)),
+            details.draws, details.pixels as f64 / pixels.max(1) as f64, pipes.len(), details.draws, list.join(" | ")
+        ))
+    } else {
+        None
+    };
+    if let Some(line) = detail {
+        if let Ok(mut lines) = LINES.get_or_init(|| Mutex::new(Vec::new())).lock() {
+            if lines.len() < 40 {
+                lines.push(line);
+            }
+        }
+    }
+    let state = STATE.get_or_init(|| Mutex::new((Instant::now(), HashMap::new())));
+    let Ok(mut state) = state.lock() else { return };
+    let entry = state.1.entry(key).or_insert((0, 0));
+    entry.0 += 1;
+    entry.1 += pixels;
+    if state.0.elapsed() >= Duration::from_secs(10) {
+        let mut rows: Vec<_> = state.1.drain().collect();
+        rows.sort_by(|a, b| b.1 .1.cmp(&a.1 .1));
+        if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open("/var/local/m2v-pass-audit.log") {
+            let total: u64 = rows.iter().map(|r| r.1 .0).sum();
+            let mpx: u64 = rows.iter().map(|r| r.1 .1).sum::<u64>() / 1_000_000;
+            let _ = writeln!(file, "WINDOW passes={} Mpx={}", total, mpx);
+            if let Ok(mut lines) = LINES.get_or_init(|| Mutex::new(Vec::new())).lock() {
+                for line in lines.drain(..) {
+                    let _ = writeln!(file, "  {}", line);
+                }
+            }
+            for (key, (count, pixels)) in rows.iter().take(14) {
+                let _ = writeln!(file, "  n={} Mpx={} {}", count, pixels / 1_000_000, key);
+            }
+        }
+        state.0 = Instant::now();
+    }
+}
+
+/// Sweet audit: the draws of the pass being encoded on this thread (reset when the pass ends).
+#[derive(Default, Clone)]
+struct SweetPassDetails {
+    draws: u32,
+    pixels: u64,
+    pipes: Vec<(u64, Option<String>, u32)>,
+}
+thread_local! {
+    static SWEET_PASS: std::cell::RefCell<SweetPassDetails> = std::cell::RefCell::new(SweetPassDetails::default());
+}
+fn sweet_audit_on() -> bool {
+    use std::sync::OnceLock;
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("SWEET_M2V_PASS_AUDIT").is_some())
+}
+fn sweet_audit_draw(pipeline: Option<&RenderPipelineState>) {
+    if !sweet_audit_on() {
+        return;
+    }
+    SWEET_PASS.with(|pass| {
+        let mut pass = pass.borrow_mut();
+        pass.draws += 1;
+        if let Some(state) = pipeline {
+            let id = state.identifier_value();
+            if let Some(entry) = pass.pipes.iter_mut().find(|p| p.0 == id) {
+                entry.2 += 1;
+            } else if pass.pipes.len() < 64 {
+                let what = match state.kind() {
+                    RenderStateKind::Graphics(graphics) => {
+                        graphics.descriptor().draw_at(0).trim_start_matches("a draw of ").to_string()
+                    }
+                    _ => "other".to_string(),
+                };
+                pass.pipes.push((id, Some(what), 1));
+            }
+        }
+    });
+}
+fn sweet_audit_rects(rects: &[vk::Rect2D]) {
+    if !sweet_audit_on() {
+        return;
+    }
+    SWEET_PASS.with(|pass| {
+        let mut pass = pass.borrow_mut();
+        for r in rects {
+            pass.pixels += r.extent.width as u64 * r.extent.height as u64;
+        }
+    });
+}
+fn sweet_audit_take() -> SweetPassDetails {
+    if !sweet_audit_on() {
+        return SweetPassDetails::default();
+    }
+    SWEET_PASS.with(|pass| std::mem::take(&mut *pass.borrow_mut()))
+}
+
+/// Sweet experiment (env `SWEET_M2V_SKIP_FRAGMENT=name`): a draw whose fragment function is `name` is dropped. Off unless set.
+fn sweet_skip_draw(pipeline: Option<&RenderPipelineState>) -> bool {
+    use std::collections::HashMap;
+    use std::sync::{Mutex, OnceLock};
+    static NAME: OnceLock<Option<String>> = OnceLock::new();
+    static CACHE: OnceLock<Mutex<HashMap<u64, bool>>> = OnceLock::new();
+    let Some(name) = NAME.get_or_init(|| std::env::var("SWEET_M2V_SKIP_FRAGMENT").ok()).as_ref() else {
+        return false;
+    };
+    let Some(state) = pipeline else { return false };
+    let id = state.identifier_value();
+    let Ok(mut cache) = CACHE.get_or_init(|| Mutex::new(HashMap::new())).lock() else {
+        return false;
+    };
+    *cache.entry(id).or_insert_with(|| match state.kind() {
+        RenderStateKind::Graphics(graphics) => graphics.descriptor().draw_at(0).contains(&format!("`{}`", name)),
+        _ => false,
+    })
+}
