+impl RenderCommandEncoder {
+    /// Sweet: a draw that cannot change any pixel is not recorded. It writes no color component of
+    /// any attachment, the pass has no depth or stencil attachment and no visibility buffer, and its
+    /// fragment function is one of CoreAnimation's fixed ones, which have no side effects. (Env
+    /// `SWEET_M2V_KEEP_NOOP_DRAWS` keeps them.)
+    fn sweet_noop_draw(&self) -> bool {
+        use std::sync::OnceLock;
+        static KEEP: OnceLock<bool> = OnceLock::new();
+        if *KEEP.get_or_init(|| std::env::var_os("SWEET_M2V_KEEP_NOOP_DRAWS").is_some()) {
+            return false;
+        }
+        if self.layout.visibility.is_some()
+            || self.layout.depth_stencil.as_ref().is_some_and(|ds| !ds.hidden)
+        {
+            return false;
+        }
+        let Some(state) = self.pipeline.as_ref() else { return false };
+        let RenderStateKind::Graphics(graphics) = state.kind() else { return false };
+        let descriptor = graphics.descriptor();
+        let known = ["fixed_frag_lph_cph", "attachment_clear_frag_lph"]
+            .iter()
+            .any(|name| descriptor.draw_at(0).contains(&format!("`{}`", name)));
+        known
+            && descriptor
+                .color_attachments()
+                .iter()
+                .flatten()
+                .all(|a| a.write_mask.is_empty())
+    }
+}
