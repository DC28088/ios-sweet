+/// Whether `half` results are rounded to the `half` grid after every operation (Metal's
+/// semantics, `narrow::round`): only with `SWEET_M2V_EXACT_HALF` set and neither empty nor `0`.
+/// ios-sweet bridge 0201: by default a `half` is held in its `f32` between operations and rounds
+/// only where it is stored (to bits, a texel, an attachment). 0157 hardware: CoreAnimation's
+/// `half`-heavy fragment shaders spent ~96% of the GPU frame in draws at ~300 Mpx/s on an Adreno
+/// 618, each `half` operation followed by a conversion to 16 bits and back behind a barrier.
+pub fn exact_half() -> bool {
+    std::env::var_os("SWEET_M2V_EXACT_HALF").is_some_and(|value| !value.is_empty() && value != "0")
+}
