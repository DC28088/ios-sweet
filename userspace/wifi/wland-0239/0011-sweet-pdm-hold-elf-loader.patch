+/* 0011 (iOS 26 Wi-Fi): on iOS 16 (0143) the modem announced QMI service 0x47 just before asking "kernel/elf_loader" and read
+ * wlanmdsp.mbn 14 ms after our answer; on iOS 26 the question comes first, 0x47 only ~100 ms later, and wlan_pd never starts.
+ * Test: hold the elf_loader answer until 0x47 is up (or 30 s). WLAND_PDM_NOHOLD=1 answers at once, as before. */
+static int svc47_up, held, hold_off = -1;
+static struct qrtr_hdr held_hdr;
+static uint8_t held_req[256];
+static uint32_t held_len;
+static uint64_t held_ms;
+static void answer(const struct qrtr_hdr *h, const uint8_t *d, uint32_t n);
+
+void pdmapper_new_server(uint32_t service)
+{
+	if (service != 0x47 || svc47_up)
+		return;
+	svc47_up = 1;
+	printf("[%6llu] pd-mapper: service 0x47 is up%s\n", (unsigned long long)link_ms(), held ? ": releasing the held elf_loader answer" : "");
+	if (held) {
+		held = 0;
+		answer(&held_hdr, held_req, held_len);
+	}
+}
+
+void pdmapper_poll(void)
+{
+	if (held && link_ms() - held_ms > 30000) {
+		held = 0;
+		printf("[%6llu] pd-mapper: no service 0x47 after 30 s: answering elf_loader anyway\n", (unsigned long long)link_ms());
+		answer(&held_hdr, held_req, held_len);
+	}
+}
