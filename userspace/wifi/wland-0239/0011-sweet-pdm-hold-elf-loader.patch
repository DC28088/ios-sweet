 void pdmapper_handle(const struct qrtr_hdr *h, const uint8_t *d, uint32_t n)
+{
+	if (hold_off < 0)
+		hold_off = getenv("WLAND_PDM_NOHOLD") != NULL;
+	struct qmi_msg m;
+	if (!hold_off && !svc47_up && !held && n <= sizeof(held_req) && !qmi_parse(d, n, &m) && m.type == QMI_REQUEST &&
+	    m.id == GET_DOMAIN_LIST) {
+		uint16_t l = 0;
+		const uint8_t *p = qmi_get(&m, 1, &l);
+		if (p && l == strlen("kernel/elf_loader") && !memcmp(p, "kernel/elf_loader", l)) {
+			held = 1;
+			held_hdr = *h;
+			memcpy(held_req, d, n);
+			held_len = n;
+			held_ms = link_ms();
+			printf("[%6llu] pd-mapper: \"kernel/elf_loader\" held until service 0x47 is up\n", (unsigned long long)held_ms);
+			return;
+		}
+	}
+	answer(h, d, n);
+}
+
