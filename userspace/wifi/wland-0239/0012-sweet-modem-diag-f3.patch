 	return best;
 }
 
+/* 0012: one small packet on a DIAG channel (control packets only; waits <= 1 s for a modem intent) */
+int link_diag_send(int ch, const void *data, uint32_t len)
+{
+	struct dchan *c = &dch[ch];
+	if (!c->ready || len > 8192)
+		return -1;
+	uint64_t end = now_ms() + 1000;
+	int i, asked = 0;
+	for (;;) {
+		int best = -1;
+		for (int k = 0; k < c->nri; k++)
+			if (!c->ri[k].busy && c->ri[k].size >= len && (best < 0 || c->ri[k].size < c->ri[best].size))
+				best = k;
+		if ((i = best) >= 0)
+			break;
+		if (!asked++)
+			glink_send(GLINK_CMD_RX_INTENT_REQ, c->lcid, len, NULL, 0);
+		if (now_ms() > end) {
+			printf("glink: %s: no modem intent for %u bytes\n", c->name, len);
+			return -1;
+		}
+		link_poll(1);
+	}
+	c->ri[i].busy = 1;
+	uint8_t b[8 + 8192];
+	uint32_t hdr[2] = { len, 0 };
+	memcpy(b, hdr, 8);
+	memcpy(b + 8, data, len);
+	while (glink_send(GLINK_CMD_TX_DATA, c->lcid, c->ri[i].iid, b, 8 + len)) {
+		if (now_ms() > end)
+			return -1;
+		link_poll(1);
+	}
+	return 0;
+}
