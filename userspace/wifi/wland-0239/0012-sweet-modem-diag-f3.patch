diff --git a/phone/wifi/diag.c b/phone/wifi/diag.c
new file mode 100644
index 0000000..1521989
--- /dev/null
+++ b/phone/wifi/diag.c
@@ -0,0 +1,207 @@
+/*
+ * 0012: the modem's own debug (F3) messages over DIAG (Linux drivers/char/diag: diagfwd_cntl, diag_masks).
+ * Off unless /var/local/diag.on exists. Everything goes to /var/local/diag.log (on the phone only: it can hold
+ * identifiers, never copy it into a repo); lines about the PD/elf loader/WLAN are echoed to stdout (wland.log).
+ */
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "diag.h"
+#include "link.h"
+
+#define DIAG_ON		"/var/local/diag.on"
+#define DIAG_LOG	"/var/local/diag.log"
+#define DIAG_CAP	(32L << 20)
+
+#define CTRL_REG	1
+#define CTRL_DIAGMODE	3
+#define CTRL_FEATURE	8
+#define CTRL_F3_MASK	11	/* DIAG_CTRL_MSG_F3_MASK(_V2) */
+#define MASK_ALL_ENABLED 2
+
+static FILE *out;
+static long out_bytes;
+static int want_masks;
+static unsigned n_msg, n_qsr, n_log, n_event, n_other, n_cntl, n_frames, n_dropped, masks_sent;
+static uint8_t frame[16384];
+static uint32_t flen;
+static int esc;
+
+static int interesting(const char *s)
+{
+	static const char *const k[] = { "loader", "Loader", "LOADER", "SPWAN", "spawn", "Spawn", "User PD", "user PD", "wlan", "WLAN",
+					 "RFS", "Respawn", "PD:", "pd_", "servreg", "SERVREG", NULL };
+	for (int i = 0; k[i]; i++)
+		if (strstr(s, k[i]))
+			return 1;
+	return 0;
+}
+
+static void emit(const char *line)
+{
+	if (out && out_bytes < DIAG_CAP) {
+		out_bytes += fprintf(out, "[%6llu] %s\n", (unsigned long long)link_ms(), line);
+		fflush(out);
+	} else
+		n_dropped++;
+	if (interesting(line))
+		printf("[%6llu] diag: %s\n", (unsigned long long)link_ms(), line);
+}
+
+static void send_masks(void)
+{
+	/* our features: only "feature mask supported" -> the modem HDLC-encodes its data as Linux expects by default */
+	struct __attribute__((packed)) { uint32_t id, len, mlen; uint8_t mask[4]; } fm = { CTRL_FEATURE, 8, 4, { 1, 0, 0, 0 } };
+	struct __attribute__((packed)) {
+		uint32_t id, len, version, sleep_vote, real_time, use_nrt, commit_thr, sleep_thr, sleep_time, drain, stale;
+	} dm = { CTRL_DIAGMODE, 36, 1, 0, 1, 0, 0, 0, 0, 0, 0 };
+	struct __attribute__((packed)) {
+		uint32_t id, len;
+		uint8_t stream, status, mode;
+		uint16_t first, last;
+		uint32_t size;
+	} mm = { CTRL_F3_MASK, 11, 1, MASK_ALL_ENABLED, 0, 0, 0, 0 };
+	int a = link_diag_send(0, &fm, sizeof(fm)), b = link_diag_send(0, &dm, sizeof(dm)), c = link_diag_send(0, &mm, sizeof(mm));
+	masks_sent++;
+	printf("[%6llu] diag: feature mask %d, real-time mode %d, all F3 messages on %d\n", (unsigned long long)link_ms(), a, b, c);
+}
+
+static uint32_t rd32(const uint8_t *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+static uint16_t rd16(const uint8_t *p) { return (uint16_t)(p[0] | p[1] << 8); }
+
+/* one DIAG packet (HDLC removed, CRC stripped) */
+static void packet(const uint8_t *p, uint32_t n)
+{
+	char line[1024];
+	n_frames++;
+	if (!n)
+		return;
+	if (p[0] == 0x79 && n >= 20) {		/* DIAG_EXT_MSG_F: fmt + file follow the args */
+		uint32_t na = p[2], o = 20 + 4 * na;
+		if (o >= n)
+			return;
+		const char *fmt = (const char *)p + o;
+		size_t fl = strnlen(fmt, n - o);
+		const char *file = o + fl + 1 < n ? fmt + fl + 1 : "";
+		size_t filel = o + fl + 1 < n ? strnlen(file, n - o - fl - 1) : 0;
+		int w = snprintf(line, sizeof(line), "ssid %u %.*s:%u: %.*s |", rd16(p + 14), (int)filel, file, rd16(p + 12),
+				 (int)(fl < 600 ? fl : 600), fmt);
+		for (uint32_t i = 0; i < na && w > 0 && w < (int)sizeof(line) - 12; i++)
+			w += snprintf(line + w, sizeof(line) - (size_t)w, " %#x", rd32(p + 20 + 4 * i));
+		for (char *c = line; *c; c++)
+			if (*c == '\n' || *c == '\r')
+				*c = ' ';
+		n_msg++;
+		emit(line);
+	} else if ((p[0] == 0x92 || p[0] == 0x99 || p[0] == 0x9c) && n >= 24) {	/* QShrink: a hash for qdsp6m.qdb */
+		uint32_t na = p[2];
+		int w = snprintf(line, sizeof(line), "qsr %#x ssid %u line %u hash %#x |", p[0], rd16(p + 14), rd16(p + 12), rd32(p + 20));
+		for (uint32_t i = 0; i < na && 24 + 4 * i + 4 <= n && w < (int)sizeof(line) - 12; i++)
+			w += snprintf(line + w, sizeof(line) - (size_t)w, " %#x", rd32(p + 24 + 4 * i));
+		n_qsr++;
+		if (out && out_bytes < DIAG_CAP)
+			out_bytes += fprintf(out, "[%6llu] %s\n", (unsigned long long)link_ms(), line);
+	} else if (p[0] == 0x10)
+		n_log++;
+	else if (p[0] == 0x60)
+		n_event++;
+	else {
+		if (n_other++ < 20) {
+			int w = snprintf(line, sizeof(line), "packet cmd %#x len %u:", p[0], n);
+			for (uint32_t i = 0; i < n && i < 24; i++)
+				w += snprintf(line + w, sizeof(line) - (size_t)w, " %02x", p[i]);
+			emit(line);
+		}
+	}
+}
+
+static void data_rx(const uint8_t *d, uint32_t n)
+{
+	/* non-HDLC framing: 0x7e, version 1, u16 length, payload, 0x7e */
+	if (n >= 5 && d[0] == 0x7e && d[1] == 1 && !flen) {
+		for (uint32_t o = 0; o + 4 <= n && d[o] == 0x7e && d[o + 1] == 1;) {
+			uint32_t l = rd16(d + o + 2);
+			if (o + 4 + l + 1 > n)
+				break;
+			packet(d + o + 4, l);
+			o += 4 + l + 1;
+		}
+		return;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint8_t b = d[i];
+		if (b == 0x7e) {
+			if (flen >= 3)
+				packet(frame, flen - 2);
+			flen = 0;
+			esc = 0;
+		} else if (b == 0x7d)
+			esc = 1;
+		else if (flen < sizeof(frame)) {
+			frame[flen++] = esc ? b ^ 0x20 : b;
+			esc = 0;
+		}
+	}
+}
+
+static void rx(int ch, const uint8_t *d, uint32_t n)
+{
+	if (ch == 1) {
+		data_rx(d, n);
+		return;
+	}
+	for (uint32_t o = 0; o + 8 <= n;) {	/* control packets: u32 id, u32 len, data */
+		uint32_t id = rd32(d + o), l = rd32(d + o + 4);
+		n_cntl++;
+		if (n_cntl <= 40) {
+			char line[160];
+			snprintf(line, sizeof(line), "control packet %u, %u bytes", id, l);
+			emit(line);
+		}
+		if (id == CTRL_FEATURE && masks_sent < 2)
+			want_masks = 1;	/* again after the modem's feature mask (the first goes out when the channel opens) */
+		if (o + 8 + l > n)
+			break;
+		o += 8 + l;
+	}
+}
+
+static void ready(int ch)
+{
+	printf("[%6llu] diag: channel %s ready\n", (unsigned long long)link_ms(), ch ? "DIAG" : "DIAG_CNTL");
+	if (!ch && !masks_sent)
+		want_masks = 1;	/* sent from diag_poll: this runs inside the glink RX handler, before its FIFO advance */
+}
+
+void diag_start(void)
+{
+	if (access(DIAG_ON, F_OK))
+		return;
+	rename(DIAG_LOG, DIAG_LOG ".prev");
+	out = fopen(DIAG_LOG, "w");
+	diag_rx_cb = rx;
+	diag_ready_cb = ready;
+	link_diag_open();
+}
+
+void diag_poll(void)
+{
+	static uint64_t last;
+	static int busy;
+	if (!diag_rx_cb || busy)
+		return;
+	if (want_masks) {
+		want_masks = 0;
+		busy = 1;	/* link_diag_send polls the link, which calls us again */
+		send_masks();
+		busy = 0;
+	}
+	uint64_t now = link_ms();
+	if (now - last < 30000)
+		return;
+	last = now;
+	printf("[%6llu] diag: %u frames: %u messages, %u QShrink, %u log, %u event, %u other, %u control; %u lines over the cap\n",
+	       (unsigned long long)now, n_frames, n_msg, n_qsr, n_log, n_event, n_other, n_cntl, n_dropped);
+}
