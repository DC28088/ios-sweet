+/* 0012: the modem's DIAG channels next to IPCRTR ("DIAG_CNTL" control, "DIAG" data), own state, so IPCRTR is untouched */
+#define DIAG_INTENT 16384
+static struct dchan {
+	const char *name;
+	uint16_t lcid;
+	uint32_t rcid;
+	int open_tx, open_acked, remote_open, ready;
+	struct { uint32_t size, iid; int busy; } ri[64];
+	int nri;
+	uint8_t *rx;
+	uint32_t rxoff;
+} dch[2] = { { .name = "DIAG_CNTL", .lcid = 2 }, { .name = "DIAG", .lcid = 3 } };
+void (*diag_rx_cb)(int ch, const uint8_t *d, uint32_t n);
+void (*diag_ready_cb)(int ch);
+
+static struct dchan *dchan_rcid(uint32_t id)
+{
+	for (int i = 0; i < 2; i++)
+		if (dch[i].remote_open && dch[i].rcid == id)
+			return &dch[i];
+	return NULL;
+}
+
+static void dchan_check(struct dchan *c)
+{
+	if (c->ready || !c->open_acked || !c->remote_open)
+		return;
+	c->ready = 1;
+	uint32_t p[8 * 2];
+	for (int i = 0; i < 8; i++) {
+		p[2 * i] = DIAG_INTENT;
+		p[2 * i + 1] = i + 1;
+	}
+	glink_send(GLINK_CMD_INTENT, c->lcid, 8, p, sizeof(p));
+	printf("[%6llu] glink: %s open (lcid %u rcid %u)\n", (unsigned long long)link_ms(), c->name, c->lcid, c->rcid);
+	if (diag_ready_cb)
+		diag_ready_cb((int)(c - dch));
+}
+
+void link_diag_open(void)
+{
+	for (int i = 0; i < 2; i++) {
+		struct dchan *c = &dch[i];
+		if (c->open_tx)
+			continue;
+		if (!c->rx && !(c->rx = malloc(65536)))
+			return;
+		uint32_t nl = (uint32_t)strlen(c->name) + 1;
+		glink_send(GLINK_CMD_OPEN, c->lcid, nl, c->name, nl);
+		c->open_tx = 1;
+	}
+	printf("[%6llu] glink: DIAG_CNTL + DIAG open sent\n", (unsigned long long)link_ms());
+}
+
