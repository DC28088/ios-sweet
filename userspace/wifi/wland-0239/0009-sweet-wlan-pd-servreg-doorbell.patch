+++ b/phone/wifi/servreg.h
@@ -0,0 +1,9 @@
+#ifndef SERVREG_H
+#define SERVREG_H
+#include "link.h"
+#define SERVREG_SERVICE	0x42	/* SERVREG_NOTIFIER (the modem's root PD) */
+#define SERVREG_PORT	0x21	/* our client port */
+void servreg_new_server(uint32_t service, uint32_t instance, uint32_t node, uint32_t port);
+void servreg_poll(void);
+void servreg_handle(const struct qrtr_hdr *h, const uint8_t *d, uint32_t n);
+#endif
