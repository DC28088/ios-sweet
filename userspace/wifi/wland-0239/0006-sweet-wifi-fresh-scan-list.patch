+/* sweet 0020: kern.sweet_display_dark (xnu 0200): 1 while the display is off. Read at most once a second. */
+static int display_lit(uint64_t now)
+{
+	static uint64_t at;
+	static int lit = 1;
+	if (!at || now - at >= 1000) {
+		int v = 0;
+		size_t len = sizeof(v);
+		at = now;
+		lit = sysctlbyname("kern.sweet_display_dark", &v, &len, NULL, 0) != 0 || v == 0;
+	}
+	return lit;
+}
 static int scan_started, scanning;
