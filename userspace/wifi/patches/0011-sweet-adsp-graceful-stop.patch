+/* 0011: a graceful ADSP stop: master-kernel bit 0 is the stop request, slave-kernel bit 3 the stop-ack. */
+static int adsp_shutdown(void)
+{
+	uint64_t pa;
+	uint32_t sz, v = 0;
+	if (!adsp_out_pa && !smem_get(SMEM_HOST_ADSP, SMP2P_ADSP_OUT, &pa, &sz))
+		adsp_out_pa = pa;
+	if (adsp_out_pa) {
+		wr32(adsp_out_pa + 36, rd32(adsp_out_pa + 36) | 1u);
+		__asm__ volatile("dsb sy" ::: "memory");
+		kick(IPC_ADSP_SMP2P);
+		unsigned i;
+		for (i = 0; i < 2000; i++) {
+			if (adsp_state(&v) == 0 && (v & 8))
+				break;
+			usleep(1000);
+		}
+		printf("adsp: stop request -> %s after %u ms (slave-kernel %x)\n", (v & 8) ? "acked" : "no ack", i, v);
+	}
+	uint64_t r1 = 0;
+	int64_t rc = scm(6, 1, PAS_ADSP, 0, 0, &r1);	/* PAS_SHUTDOWN */
+	if (adsp_out_pa) {
+		wr32(adsp_out_pa + 36, rd32(adsp_out_pa + 36) & ~1u);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	printf("adsp shutdown -> %lld/%llx\n", (long long)rc, (unsigned long long)r1);
+	return rc ? 1 : 0;
+}
