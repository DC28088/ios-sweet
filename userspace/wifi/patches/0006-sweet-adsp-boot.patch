+/*
+ * 0006: the ADSP (LPASS Q6, audio): stock DT qcom,lpass@62400000 (PAS 1, firmware "adsp", pil_adsp_region 0x95700000+0x2600000,
+ * proxy votes lcx/lmx, signal-aop) and qcom,smp2p-adsp (SMEM host 2, items 443 out / 429 in, APCS IPC bit 26; inbound
+ * slave-kernel bit 0 err-fatal, 1 ready). `wland adsp` boots it once, separately from the modem (milestone 1 of
+ * docs/audio-plan.md); the GLINK "lpass" edge and APR come next.
+ */
+#define PAS_ADSP	1
+#define ADSP_PA		0x95700000ull
+#define ADSP_SIZE	0x02600000ull
+#define ADSP_FW_DIR	"/var/local/fw/adsp"
+#define SMEM_HOST_ADSP	2
+#define SMP2P_ADSP_OUT	443
+#define SMP2P_ADSP_IN	429
+#define IPC_ADSP_SMP2P	26
+
+static int adsp_smp2p_create(void)
+{
+	uint64_t pa;
+	if (smem_alloc(SMEM_HOST_ADSP, SMP2P_ADSP_OUT, 20 + 16 * 20, &pa)) {
+		fprintf(stderr, "adsp: cannot allocate SMP2P item %u\n", SMP2P_ADSP_OUT);
+		return -1;
+	}
+	if (rd32(pa) != 0x504d5324) {
+		wr32(pa + 8, 0 | (2u << 16));		/* local pid 0, remote pid 2 (ADSP) */
+		wr32(pa + 12, 16 | (1u << 16));		/* total 16 entries, 1 valid */
+		wr32(pa + 16, 0);
+		wr_name(pa + 20, "master-kernel");
+		wr32(pa + 36, 0);
+		wr32(pa + 0, 0x504d5324);
+		__asm__ volatile("dsb sy" ::: "memory");
+		wr32(pa + 4, 1 | (1u << 8));
+	}
+	kick(IPC_ADSP_SMP2P);
+	printf("adsp: SMP2P item %u at %llx\n", SMP2P_ADSP_OUT, (unsigned long long)pa);
+	return 0;
+}
+
+static int adsp_state(uint32_t *v)
+{
+	uint64_t pa;
+	uint32_t sz;
+	if (smem_get(SMEM_HOST_ADSP, SMP2P_ADSP_IN, &pa, &sz))
+		return -1;
+	uint32_t n = rd32(pa + 12) >> 16;
+	for (uint32_t i = 0; i < n && i < 16; i++) {
+		uint64_t e = pa + 20 + 20ull * i;
+		char nm[17];
+		for (int k = 0; k < 16; k++)
+			nm[k] = (char)(rd32(e + (k & ~3)) >> (8 * (k & 3)));
+		nm[16] = 0;
+		if (!strcmp(nm, "slave-kernel")) {
+			*v = rd32(e + 16);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static int boot_adsp(void)
+{
+	uint32_t v = 0;
+	if (adsp_state(&v) == 0 && (v & 2) && !(v & 1)) {
+		printf("adsp: already up (slave-kernel %x)\n", v);
+		return 0;
+	}
+	/* proxy votes as the stock DT: the top LPI cx/mx levels (the kernel may refuse resources it does not know) */
+	int nl = levels("lcx.lvl", 0), nm = levels("lmx.lvl", 0);
+	printf("adsp: lcx %d levels, lmx %d levels\n", nl, nm);
+	if (nl > 0)
+		vote("lcx.lvl", (uint32_t)nl - 1);
+	if (nm > 0)
+		vote("lmx.lvl", (uint32_t)nm - 1);
+	if (adsp_smp2p_create())
+		return -1;
+	if (pas_load(PAS_ADSP, ADSP_FW_DIR, "adsp", ADSP_PA, ADSP_SIZE, "adsp"))
+		return -1;
+	for (int t = 0; t < 300; t++) {
+		if (adsp_state(&v) == 0 && (v & 2) && !(v & 1)) {
+			printf("adsp: READY after %d00 ms (slave-kernel %x)\n", t, v);
+			return 0;
+		}
+		if (t % 20 == 0)
+			printf("adsp: waiting, slave-kernel %s %x\n", adsp_state(&v) ? "absent" : "", v);
+		usleep(100000);
+	}
+	printf("adsp: no ready bit in 30 s\n");
+	return -1;
+}
