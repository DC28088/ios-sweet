+/*
+ * 0005, the IPA data path (xnu 0192): our outbound "ipa" entry (stock DT qcom,smp2p-ipa-1-out; Linux ipa_smp2p.c bit 0
+ * "ipa-clock-enabled-valid", bit 1 "ipa-clock-enabled") and the modem's inbound one (bit 0 "ipa-clock-query", bit 1
+ * "ipa-setup-ready"). Mainline answers the first clock query only, enabled before valid; the clock stays voted (the kernel).
+ */
+static int ipa_on;
+static uint64_t ipa_out_va;
+static uint32_t ipa_in_last = 0xffffffff;
+static int ipa_answered;
+
+static void smp2p_add_ipa(void)
+{
+	if (!smp2p_out_pa || ipa_out_va)
+		return;
+	uint32_t valid = rd32(smp2p_out_pa + 12) >> 16;
+	if (valid >= 16)
+		return;
+	uint64_t e = smp2p_out_pa + 20 + 20ull * valid;
+	wr_name(e, "ipa");
+	wr32(e + 16, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	wr32(smp2p_out_pa + 12, 16 | ((valid + 1) << 16));
+	ipa_out_va = e + 16;
+	kick(IPC_MODEM_SMP2P);
+	printf("smp2p: outbound entry \"ipa\" added (%u valid)\n", valid + 1);
+}
+
+static void smp2p_ipa_service(void)
+{
+	uint32_t v;
+	if (!ipa_out_va || smp2p_in_value("ipa", &v))
+		return;
+	if (v != ipa_in_last) {
+		printf("[%6llu] smp2p: modem ipa %x%s%s\n", (unsigned long long)link_ms(), v, v & 1 ? " clock-query" : "", v & 2 ? " setup-ready" : "");
+		ipa_in_last = v;
+	}
+	if ((v & 1) && !ipa_answered) {
+		wr32(ipa_out_va, 2);			/* enabled */
+		kick(IPC_MODEM_SMP2P);
+		wr32(ipa_out_va, 3);			/* then valid */
+		kick(IPC_MODEM_SMP2P);
+		ipa_answered = 1;
+		printf("[%6llu] smp2p: IPA clock query answered: enabled\n", (unsigned long long)link_ms());
+	}
+}
+
 /*
  * Keep the SMP2P side going: SSR ack (Linux qcom_smp2p_do_ssr_ack: after a
  * restart the modem flips RESTART_DONE, flags bit 0, and waits for the same
@@ -300,6 +346,7 @@ static void smp2p_service(void)
 		       v & 4 ? " handover" : "", v & 8 ? " stop-ack" : "");
 		modem_state = v;
 	}
+	smp2p_ipa_service();
 }
 
 static int smp2p_init(void)
@@ -413,6 +460,141 @@ static uint8_t *slurp(const char *path, size_t *len)
 
 struct phdr { uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align; };
 
+/*
+ * 0005: the IPA's GSI firmware (Android /vendor/firmware/ipa_fws.*, copied to /var/local/fw/ipa): TrustZone PAS 15 into the stock
+ * ips_fw_region, as Linux's qcom_mdt_load + qcom_scm_pas_auth_and_reset (mainline IPA_LOADER_SELF). Relocatable segments land at
+ * the region base plus their offset from the lowest one.
+ */
+#define PAS_IPA		15
+#define IPA_FW_PA	0x97f00000ull
+#define IPA_FW_SIZE	0x00010000ull
+#define IPA_FW_DIR	"/var/local/fw/ipa"
+
+static int ipa_fw_load(void)
+{
+	size_t mlen;
+	uint8_t *mdt = slurp(IPA_FW_DIR "/ipa_fws.mdt", &mlen);
+	if (!mdt || mlen < 0x34) {
+		fprintf(stderr, "ipa: no %s/ipa_fws.mdt\n", IPA_FW_DIR);
+		return -1;
+	}
+	uint32_t phoff, phnum = 0;
+	memcpy(&phoff, mdt + 0x1c, 4);
+	memcpy(&phnum, mdt + 0x2c, 2);
+	if (phoff + 32ull * phnum > mlen) {
+		fprintf(stderr, "ipa: bad program headers\n");
+		return -1;
+	}
+	struct phdr *ph = (struct phdr *)(mdt + phoff);
+	int hash = -1, reloc = 0;
+	uint64_t min_pa = ~0ull;
+	for (uint32_t i = 0; i < phnum; i++) {
+		if (((ph[i].flags >> 24) & 7) == 2)
+			hash = (int)i;
+		if (ph[i].type == 1 && ph[i].memsz && ((ph[i].flags >> 24) & 7) != 2) {
+			if (ph[i].paddr < min_pa)
+				min_pa = ph[i].paddr;
+			if (ph[i].flags & (1u << 27))
+				reloc = 1;
+		}
+	}
+	if (hash < 0 || min_pa == ~0ull) {
+		fprintf(stderr, "ipa: no hash or load segment\n");
+		return -1;
+	}
+	size_t ehsz = phoff + 32ull * phnum, meta_len = ehsz + ph[hash].filesz;
+	uint8_t *meta = malloc(meta_len);
+	memcpy(meta, mdt, ehsz);
+	if (ph[hash].offset + ph[hash].filesz <= mlen) {
+		memcpy(meta + ehsz, mdt + ph[hash].offset, ph[hash].filesz);
+	} else {
+		char path[128];
+		size_t hl;
+		snprintf(path, sizeof(path), IPA_FW_DIR "/ipa_fws.b%02d", hash);
+		uint8_t *h = slurp(path, &hl);
+		if (!h || hl < ph[hash].filesz) {
+			fprintf(stderr, "ipa: hash segment %s missing\n", path);
+			return -1;
+		}
+		memcpy(meta + ehsz, h, ph[hash].filesz);
+		free(h);
+	}
+	uint64_t meta_pa = pm_alloc(meta_len, 0x1000);
+	if (!meta_pa)
+		return -1;
+	pm_wr(meta_pa, meta, (meta_len + 3) & ~(size_t)3);
+	uint64_t r1 = 0;
+	int64_t rc = scm(1, 2 | (2u << 6), PAS_IPA, meta_pa, 0, &r1);
+	printf("ipa: init image (%zu bytes metadata) -> %lld/%llx\n", meta_len, (long long)rc, (unsigned long long)r1);
+	if (rc || r1)
+		return -1;
+	if (reloc) {
+		rc = scm(2, 3, PAS_IPA, IPA_FW_PA, IPA_FW_SIZE, &r1);
+		printf("ipa: mem setup %llx+%llx -> %lld/%llx\n", IPA_FW_PA, IPA_FW_SIZE, (long long)rc, (unsigned long long)r1);
+		if (rc || r1)
+			return -1;
+	}
+	static uint8_t zeros[0x4000];
+	uint64_t total = 0;
+	for (uint32_t i = 0; i < phnum; i++) {
+		if (ph[i].type != 1 || (int)i == hash || !ph[i].memsz || ((ph[i].flags >> 24) & 7) == 2)
+			continue;
+		uint64_t pa = reloc ? IPA_FW_PA + (ph[i].paddr - min_pa) : ph[i].paddr;
+		if (pa < IPA_FW_PA || pa + ph[i].memsz > IPA_FW_PA + IPA_FW_SIZE) {
+			fprintf(stderr, "ipa: segment %u at %llx outside the region\n", i, (unsigned long long)pa);
+			return -1;
+		}
+		if (ph[i].filesz) {
+			char path[128];
+			size_t sl;
+			snprintf(path, sizeof(path), IPA_FW_DIR "/ipa_fws.b%02u", i);
+			uint8_t *seg = slurp(path, &sl);
+			if (!seg || sl < ph[i].filesz) {
+				fprintf(stderr, "ipa: %s missing or short\n", path);
+				return -1;
+			}
+			uint8_t *pad = calloc(1, (ph[i].filesz + 3) & ~3u);
+			memcpy(pad, seg, ph[i].filesz);
+			pm_wr(pa, pad, (ph[i].filesz + 3) & ~3u);
+			free(pad);
+			free(seg);
+			total += ph[i].filesz;
+		}
+		for (uint64_t o = (ph[i].filesz + 3) & ~3ull; o < ph[i].memsz; o += sizeof(zeros)) {
+			uint64_t n = ph[i].memsz - o < sizeof(zeros) ? ph[i].memsz - o : sizeof(zeros);
+			pm_wr(pa + o, zeros, (n + 3) & ~3ull);
+		}
+	}
+	printf("ipa: %llu bytes of segments loaded at %llx\n", (unsigned long long)total, IPA_FW_PA);
+	rc = scm(5, 1, PAS_IPA, 0, 0, &r1);
+	printf("ipa: auth and reset -> %lld/%llx\n", (long long)rc, (unsigned long long)r1);
+	return rc || r1 ? -1 : 0;
+}
+
+/* configure (kernel), firmware (here), setup (kernel); everything stays off on the first failure */
+static void ipa_prepare(void)
+{
+	if (!access("/var/local/ipa.off", F_OK)) {
+		printf("ipa: off (/var/local/ipa.off)\n");
+		return;
+	}
+	int r = cell_ipa_step(7, 0, 3000);
+	if (r) {
+		printf("ipa: kernel configure -> %d: no cellular data path\n", r);
+		return;
+	}
+	const int fw = ipa_fw_load();
+	r = cell_ipa_step(8, fw ? 5 /* EIO */ : 0, 3000);
+	if (fw || r) {
+		printf("ipa: firmware %d, kernel setup %d: no cellular data path\n", fw, r);
+		return;
+	}
+	smp2p_add_ipa();
+	ipa_on = 1;
+	cell_ipa_enable();
+	printf("ipa: ready for the modem\n");
+}
