+/* ---------------------------------------------------------------- the IPA data path (0005, xnu 0192) */
+int cell_ipa_step(uint32_t type, uint32_t a, int ms)
+{
+	if (bb_fd < 0 && !access("/var/local/cell.nobb", F_OK))
+		return -1;
+	if (bb_fd < 0)
+		bb_fd = open(BB_DEV, O_RDWR | O_NONBLOCK);
+	if (bb_fd < 0) {
+		printf("ipa: no %s\n", BB_DEV);
+		return -1;
+	}
+	bb_record(type, a, 0, 0, 0, NULL, 0);
+	if (!ms)
+		return 0;
+	/* Before the modem boots nothing else is queued in the kernel (AppleBaseband waits for READY): only status records. */
+	for (int t = 0; t < ms; t += 10) {
+		ssize_t n = read(bb_fd, bb_buf, sizeof(bb_buf));
+		for (size_t at = 0; n > 0 && at + 24 <= (size_t)n;) {
+			uint32_t w[6];
+			memcpy(w, bb_buf + at, 24);
+			if (w[0] == 12 && w[1] == type) {
+				printf("ipa: kernel step %u -> %d\n", type, (int)w[2]);
+				return (int)w[2];
+			}
+			printf("ipa: record %u while waiting for step %u, dropped\n", w[0], type);
+			at += 24 + ((w[5] + 3u) & ~3u);
+		}
+		usleep(10000);
+	}
+	printf("ipa: no answer from the kernel for step %u\n", type);
+	return -1;
+}
+
+void cell_ipa_enable(void)
+{
+	ipa_enabled = 1;
+}
+
+void cell_ipa_link_up(void)
+{
+	if (!ipa_enabled)
+		return;
+	int r = qrtr_new_server(0x31, 1, 1, CELL_IPA_SRV_PORT);
+	printf("ipa: IPA QMI server (0x31 v1 instance 1) announced at port %#x -> %d\n", CELL_IPA_SRV_PORT, r);
+}
