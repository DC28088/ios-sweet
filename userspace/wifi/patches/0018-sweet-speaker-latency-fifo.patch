+/* 0018: jitter FIFO (sweet_pcm_fifo.h): drain the kernel ring every refill,
+ * play only real samples after a short prebuffer, trim unused backlog. */
+_Static_assert(SWEET_PCM_FIFO_PERIOD*4==SWEET_PCM_PERIOD,"FIFO period = DSP period");
+static struct sweet_pcm_fifo pcm_fifo;
+static unsigned pcm_prebuf_frames=1440;
+static int pcm_fifo_drain(int fd)
+{
+    for(unsigned i=0;i<128;i++){
+        uint8_t b[SWEET_PCM_PERIOD];
+        ssize_t got=read(fd,b,sizeof b);
+        if(got<0 && (errno==EAGAIN || errno==EWOULDBLOCK))return 0;
+        if(got<0 || (got&3))return -1;
+        if(!got)return 0;
+        sweet_pcm_fifo_push(&pcm_fifo,b,(uint32_t)got/4);
+        if((size_t)got<sizeof b)return 0;
+    }
+    return 0;
+}
+/* One DSP period from the FIFO (silence-padded). Bytes of real samples, or -1. */
+static ssize_t pcm_fifo_period(int fd,uint8_t *out,uint64_t now)
+{
+    if(pcm_fifo_drain(fd))return -1;
+    return (ssize_t)sweet_pcm_fifo_period(&pcm_fifo,out,now)*4;
+}
