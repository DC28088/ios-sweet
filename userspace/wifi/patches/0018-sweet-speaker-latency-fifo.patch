+/* 0018: while app audio plays, 1 ms poll sleeps took 17..33 ms with timer
+ * coalescing on (0221 measurement), so refills missed their 10 ms deadlines,
+ * the DSP consumed ~6% slow and the 1.36 s kernel ring sat full (= the 1-2 s
+ * start/stop lag, and drop-oldest overruns = stutter). Hold coalescing off only
+ * while the amps play; restore the saved value on idle, exit and SIGTERM/INT/HUP. */
+static int coalesce_saved=-1;
+static void coalesce_hold(int off)
+{
+    int v;size_t n=sizeof v;
+    if(off && coalesce_saved<0){
+        if(sysctlbyname("kern.timer.coalescing_enabled",&v,&n,NULL,0)){printf("pcm: timer coalescing state unavailable (%d)\n",errno);return;}
+        int zero=0;if(sysctlbyname("kern.timer.coalescing_enabled",NULL,NULL,&zero,sizeof zero)){printf("pcm: timer coalescing hold refused (%d)\n",errno);return;}
+        coalesce_saved=v;printf("pcm: timer coalescing off while playing (was %d)\n",v);
+    }else if(!off && coalesce_saved>=0){
+        v=coalesce_saved;coalesce_saved=-1;
+        if(sysctlbyname("kern.timer.coalescing_enabled",NULL,NULL,&v,sizeof v))printf("pcm: timer coalescing restore failed (%d)\n",errno);
+        else printf("pcm: timer coalescing restored to %d\n",v);
+    }
+}
+static void coalesce_signal(int sig)
+{
+    if(coalesce_saved>=0){int v=coalesce_saved;(void)sysctlbyname("kern.timer.coalescing_enabled",NULL,NULL,&v,sizeof v);}
+    signal(sig,SIG_DFL);raise(sig);
+}
