+/*
+ * 0007: the "lpass" GLINK edge (SMEM host 2, items 478/479/480, APCS IPC bit 24) with QRTR on IPCRTR, the pd-mapper (the ADSP
+ * asks it for its servreg domains) and the TFTP server (files the sensor PD reads), in this process: the modem's link state
+ * lives in the boot wland. 0195 boot: without them the ADSP's sensor PD stalled ("USER-PD DOG detects stalled initialization"),
+ * the ADSP went fatal and took the modem with it (glink_channel_migration.c:667).
+ */
+static void net_cb(const struct qrtr_hdr *h, const uint8_t *d, uint32_t n);
+static uint32_t adsp_last = 0xffffffff;
+static void adsp_idle(void)
+{
+	uint32_t v;
+	if (adsp_state(&v) == 0 && v != adsp_last) {
+		printf("[%6llu] adsp: slave-kernel %x%s%s\n", (unsigned long long)link_ms(), v, v & 1 ? " ERR-FATAL" : "", v & 2 ? " ready" : "");
+		adsp_last = v;
+	}
+}
+
+static int adsp_net(void)
+{
+	glink_edge(SMEM_HOST_ADSP, 24);
+	link_idle = adsp_idle;
+	if (link_up(net_cb, 10000)) {
+		printf("adsp: no GLINK link in 10 s\n");
+		return -1;
+	}
+	printf("adsp: IPCRTR up; remote node %u\n", link_remote_node);
+	if (pdmapper_init() || tftp_init())
+		printf("adsp: no pd-mapper/tftp\n");
+	for (uint64_t t0 = link_ms(), next = t0; ;) {
+		link_poll(100);
+		if (link_ms() >= next) {
+			adsp_idle();
+			uint64_t pa;
+			uint32_t sz;
+			printf("[%6llu] adsp: alive; SMEM 429 %s\n", (unsigned long long)link_ms(),
+			       smem_get(SMEM_HOST_ADSP, SMP2P_ADSP_IN, &pa, &sz) ? "absent" : "present");
+			next = link_ms() + 10000;
+		}
+		if (adsp_last != 0xffffffff && (adsp_last & 1))
+			return 1;
+	}
+}
+
