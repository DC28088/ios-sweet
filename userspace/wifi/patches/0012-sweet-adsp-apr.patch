 	       rd32(TX_TAIL), rd32(TX_HEAD), rd32(RX_TAIL), rd32(RX_HEAD));
 }
 
+void glink_resync(void)
+{
+	uint32_t rh = rd32(RX_HEAD), rt = rd32(RX_TAIL);
+	uint32_t tt = rd32(TX_TAIL);
+	if (rh >= rx_len)
+		rh = 0;
+	if (rt >= rx_len || rh < rt)
+		wr32(RX_TAIL, rh);	/* a backwards head means the pool was re-initialized: drop the stale ring */
+	if (tt >= tx_len)
+		tt = 0;
+	wr32(TX_HEAD, tt);		/* nothing sent in this session yet: start where the peer's tail is */
+	__asm__ volatile("dsb sy" ::: "memory");
+}
