+/* 0012: APR on apr_audio_svc: first checkpoint is AVCS_CMD_ADSP_EVENT_GET_STATE. */
+static int apr_sent;
+static void adsp_apr_rx(const uint8_t *p, size_t n)
+{
+	struct sweet_apr_msg m;
+	if (sweet_apr_parse(p, n, &m)) {
+		printf("apr: malformed packet, %zu bytes\n", n);
+		return;
+	}
+	printf("apr: opcode %#x token %u %u:%u -> %u:%u, %u bytes\n", m.opcode, m.token, m.src_domain, m.src_port,
+	       m.dest_domain, m.dest_port, m.payload_len);
+	if (m.opcode == AVCS_CMDRSP_ADSP_EVENT_GET_STATE) {
+		uint32_t st = 0;
+		if (m.payload_len >= 4)
+			memcpy(&st, m.payload, 4);
+		printf("apr: ADSP state %u (%s)\n", st, st == 1 ? "running" : "unexpected");
+	} else if (m.opcode == APR_BASIC_RSP_RESULT) {
+		uint32_t op, st;
+		if (!sweet_apr_basic_result(&m, &op, &st))
+			printf("apr: command %#x -> status %u\n", op, st);
+	}
+}
+
+static void adsp_apr_poll(void)
+{
+	if (apr_sent || !adspedge_apr_up())
+		return;
+	uint8_t b[64];
+	size_t n = sweet_apr_avcs_get_state(b, sizeof(b), 0x20, 1);
+	if (n && !adspedge_apr_send(b, n)) {
+		apr_sent = 1;
+		printf("apr: GET_STATE sent (%zu bytes)\n", n);
+	}
+}
