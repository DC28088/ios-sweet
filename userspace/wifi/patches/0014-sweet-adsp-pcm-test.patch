+/* 0014: optional bounded silent ASM/ADM playback test; never touches amplifiers.
+ * DMA stays allocated until reboot: PMEM_SMMU has no mapping teardown.
+ * Both DSP handles and SMMU page tables must stop referencing a page before reuse. */
+static struct sweet_pcm pcm_test;
+static int pcm_enabled, pcm_started, pcm_reported;
+static uint64_t pcm_pa;
+static void adsp_pcm_poll(void)
+{
+    if(!pcm_enabled || !adspedge_apr_up() || afe_step!=5)return;
+    if(!pcm_started) {
+        pcm_started=1;
+        pcm_pa=pm_alloc(SWEET_PCM_MAP_BYTES,4096);
+        if(!pcm_pa) {
+            printf("pcm: no coherent DMA allocation; not started\n");
+            pcm_enabled=0;return;
+        }
+        uint8_t zero[SWEET_PCM_STRIDE]={0};
+        for(unsigned i=0;i<SWEET_PCM_MAP_BYTES/SWEET_PCM_STRIDE;i++)if(pm_wr(pcm_pa+i*SWEET_PCM_STRIDE,zero,sizeof zero)) {
+            printf("pcm: zeroing DMA failed; not started\n");pm_free(pcm_pa);pcm_enabled=0;return;
+        }
+        struct pmem_smmu q;
+        memset(&q,0,sizeof q);q.op=2;q.nsid=1;q.sid[0]=0x1b21;
+        q.iova=0xa0000000ull;q.alias=1ull<<32;q.pa=pcm_pa;
+        q.len=SWEET_PCM_MAP_BYTES;
+        if(pm_smmu(&q)) {
+            printf("pcm: audio-ion SMMU mapping failed; buffer retained, no ASM commands\n");
+            pcm_enabled=0;return;
+        }
+        sweet_pcm_init(&pcm_test,q.iova|q.alias);
+        printf("pcm: silent test starts: 100 periods, 48 kHz stereo s16, PRI_MI2S; amps untouched\n");
+    }
+    sweet_pcm_poll(&pcm_test,link_ms());
+    for(unsigned i=0;i<SWEET_PCM_SLOTS;i++) {
+        uint8_t b[128];size_t n=sweet_pcm_next(&pcm_test,b,sizeof b,link_ms());
+        if(!n)break;
+        uint32_t op=(uint32_t)b[16]|(uint32_t)b[17]<<8|(uint32_t)b[18]<<16|(uint32_t)b[19]<<24;
+        if(op!=0x10dab)printf("pcm: command op=%#x step=%u\n",op,pcm_test.step);
+        if(adspedge_apr_send(b,n)){sweet_pcm_abort(&pcm_test,0xfffffffdu);break;}
+    }
+    if(pcm_test.done && !pcm_reported) {
+        pcm_reported=1;
+        printf("pcm: done failed=%u status=%#x sent=%u completed=%u mapped=%u stream=%u copp=%u\n",
+            pcm_test.failed,pcm_test.status,pcm_test.sent,pcm_test.completed,
+            pcm_test.mapped,pcm_test.stream_open,pcm_test.copp_open);
+        struct pmem_smmu q;
+        memset(&q,0,sizeof q);q.op=3;q.nsid=1;q.sid[0]=0x1b21;
+        if(pm_smmu(&q))printf("pcm: audio-ion fault status unavailable\n");
+        else printf("pcm: audio-ion FSR=%#x faultbits=%#x FSYNR=%#x\n",q.fsr,q.fsr&0xc00001feu,q.fsynr0);
+        /* PMEM_SMMU has no mapping teardown. Retain its 32 KiB backing even
+         * after DSP unmap, so a live page table never points at freed memory. */
+        printf("pcm: coherent DMA allocation retained for SMMU mapping until reboot\n");
+    }
+}
