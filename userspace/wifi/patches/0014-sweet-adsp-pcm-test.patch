+static int speaker_poll(const struct sweet_pcm *s)
+{
+    if(!speaker_wanted || speaker_fd<0)return 0;
+    if(ioctl(speaker_fd,SWEET_AMP_HEARTBEAT,0)){printf("speaker: heartbeat refused (%d)\n",errno);speaker_stop();return -1;}
+    if(s->failed || s->done || (s->sent==s->limit && !s->inflight)){
+        speaker_stop();return 0;
+    }
+    if(!speaker_on && s->completed && s->sent<s->limit){
+        struct sweet_amp_start start={3,24*8};
+        if(ioctl(speaker_fd,SWEET_AMP_START,&start)){printf("speaker: clock/fault gate refused output (%d)\n",errno);speaker_stop();return -1;}
