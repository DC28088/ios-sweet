 }
 
+/*
+ * 0013: AFE bring-up test (WLAND_AFE=1): PRI_MI2S_RX clock, I2S config and port start, the checkpoint of
+ * docs/audio-plan.md milestone 3 on the DSP side. The AFE service's APR token is the port *index* (40 for
+ * AFE_PORT_ID_PRIMARY_MI2S_RX), and Linux sends a param_hdr_v1 or v3 depending on the ADSP's instance-ID
+ * support; try v1 first (the harmless direction if the DSP expects v1) and fall back to v3.
+ */
+static int afe_on, afe_step = -1;
+static uint32_t afe_token = AFE_PORT_INDEX_PRIMARY_MI2S_RX;
+
+static void afe_send(void)
+{
+	uint8_t b[128];
+	size_t n = 0;
+	if (!afe_on || afe_step < 0 || !adspedge_apr_up())
+		return;
+	switch (afe_step) {
+	case 0:
+		n = sweet_apr_afe_clock(b, sizeof b, 0, afe_token, Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT, 1536000, 1);
+		break;
+	case 1:
+		n = sweet_apr_afe_clock_v2(b, sizeof b, 0, afe_token, Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT, 1536000, 1);
+		break;
+	case 2:
+		n = sweet_apr_afe_i2s_config(b, sizeof b, 0, afe_token, AFE_PORT_ID_PRIMARY_MI2S_RX, 48000, 16,
+					     AFE_PORT_I2S_SD0, AFE_PORT_I2S_STEREO);
+		break;
+	case 3:
+		n = sweet_apr_afe_i2s_config_v3(b, sizeof b, 0, afe_token, AFE_PORT_ID_PRIMARY_MI2S_RX, 48000, 16,
+						AFE_PORT_I2S_SD0, AFE_PORT_I2S_STEREO);
+		break;
+	case 4:
+		n = sweet_apr_afe_port(b, sizeof b, 0, afe_token, 1, AFE_PORT_ID_PRIMARY_MI2S_RX);
+		break;
+	default:
+		return;
+	}
+	if (!n) {
+		printf("afe: step %d: could not build the packet\n", afe_step);
+		return;
+	}
+	if (adspedge_apr_send(b, n)) {
+		printf("afe: step %d: send failed\n", afe_step);
+		return;
+	}
+	printf("afe: step %d: sent %zu bytes (token %u)\n", afe_step, n, afe_token);
+}
+
+static void afe_start(void)
+{
+	if (!afe_on || afe_step >= 0)
+		return;
+	printf("afe: starting PRI_MI2S bring-up (clock -> i2s config -> port start)\n");
+	afe_step = 0;
+	afe_send();
+}
+
+static void afe_result(uint32_t op, uint32_t st)
+{
+	if (!afe_on || afe_step < 0)
+		return;
+	switch (op) {
+	case AFE_SVC_CMD_SET_PARAM:		/* clock, param_hdr_v1 */
+		if (afe_step != 0)
+			break;
+		printf("afe: clock v1 -> status %u\n", st);
+		afe_step = st == 0 ? 2 : 1;
+		if (st)
+			printf("afe: v1 clock rejected; trying the v3 header\n");
+		afe_send();
+		break;
+	case AFE_SVC_CMD_SET_PARAM_V2:		/* clock, param_hdr_v3 */
+		if (afe_step != 1)
+			break;
+		printf("afe: clock v3 -> status %u\n", st);
+		afe_step = st == 0 ? 2 : -2;
+		if (st)
+			printf("afe: clock failed; stopping\n");
+		else
+			afe_send();
+		break;
+	case AFE_PORT_CMD_SET_PARAM_V2:		/* I2S config, param_hdr_v1 */
+		if (afe_step != 2)
+			break;
+		printf("afe: i2s config v1 -> status %u\n", st);
+		afe_step = st == 0 ? 4 : 3;
+		if (st)
+			printf("afe: v1 i2s config rejected; trying the v3 header\n");
+		afe_send();
+		break;
+	case AFE_PORT_CMD_SET_PARAM_V3:		/* I2S config, param_hdr_v3 */
+		if (afe_step != 3)
+			break;
+		printf("afe: i2s config v3 -> status %u\n", st);
+		afe_step = st == 0 ? 4 : -2;
+		if (st)
+			printf("afe: i2s config failed; stopping\n");
+		else
+			afe_send();
+		break;
+	case AFE_PORT_CMD_DEVICE_START:
+		if (afe_step != 4)
+			break;
+		printf("afe: PRI_MI2S_RX start -> status %u\n", st);
+		afe_step = st == 0 ? 5 : -2;
+		if (st == 0)
+			printf("afe: PRI_MI2S_RX is running (clock + port enabled)\n");
+		else
+			printf("afe: PRI_MI2S_RX start failed\n");
+		break;
+	default:
+		break;
+	}
+}
