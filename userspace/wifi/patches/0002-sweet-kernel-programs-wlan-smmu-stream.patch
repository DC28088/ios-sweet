 int smmu_wlan_identity(void)
 {
+	/* Sweet: on this phone a load from the apps SMMU stalls the CPU once the system is up, although the same registers read fine
+	 * from the kernel during bsd init. With boot-arg sweetsmmuwlan=1 the kernel (xnu patch 0153) programs this same stream there;
+	 * never touch the SMMU from here then. */
+	char args[1024] = "";
+	size_t len = sizeof(args) - 1;
+	if (!sysctlbyname("kern.bootargs", args, &len, NULL, 0) && strstr(args, "sweetsmmuwlan=1")) {
+		printf("smmu: WLAN %#x/%#x stream programmed by the kernel at boot (sweetsmmuwlan=1); not touching the apps SMMU\n",
+		       WLAN_SID, WLAN_SID_MASK);
+		smmu_done = 1;
+		return 0;
+	}
 	uint64_t s = SMMU_PA;
 	uint32_t id0 = rd32(s + 0x20), id1 = rd32(s + 0x24);
 	uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
