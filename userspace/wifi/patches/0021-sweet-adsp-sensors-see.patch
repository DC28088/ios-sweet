+static void adsp_sns_setup(void)
+{
+	const char *e = getenv("WLAND_SNS");
+	static char buf[256];
+	char *argv[16];
+	int argc = 0;
+	if (e && !strcmp(e, "0")) {
+		printf("adsp: sensors off (WLAND_SNS=0)\n");
+		return;
+	}
+	snprintf(buf, sizeof(buf), "%s", e && *e ? e : "--sns-motion --sns-secs 0");
+	for (char *t = strtok(buf, " "); t && argc < 15; t = strtok(NULL, " "))
+		argv[argc++] = t;
+	argv[argc] = NULL;
+	for (int i = 0; i < argc; i++)
+		if (sns_opt(argc, argv, &i) != 1)
+			printf("adsp: sensors option %s not understood\n", argv[i]);
+	printf("adsp: sensors %s (%s)\n", sns_wanted() ? "on" : "off", e && *e ? e : "default");
+}
