+ * sweet 0021: sensors (USER: "fix all the sensors"). The SEE client of sunfish (Pixel 4a, the same SM7150 ADSP;
+ * phone/sensors, from ios-redfin's sensd, MIT) runs inside the ADSP loop: the ADSP announces SNS (QMI 400) at
+ * 5:e, sns_service() starts it, sns_link gets the DATA of its ports, sns_tick() runs the streams and posts samples
+ * to /dev/redwood-motion (xnu 0237) for the sensor HID services. WLAND_SNS: the sns options (default
+ * "--sns-motion --sns-secs 0"; WLAND_SNS=0: off).
+ */
+static int adsp_sns_send(uint32_t lport, uint32_t node, uint32_t port, const void *d, size_t n)
+{
+	return qrtr_send(QRTR_TYPE_DATA, lport, node, port, d, (uint32_t)n);
+}
+
+static int adsp_sns_pump(void)
+{
+	return adspedge_pump_one();
+}
