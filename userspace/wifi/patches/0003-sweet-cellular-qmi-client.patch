+/* Cellular status over the modem's own QMI services (DMS, UIM, NAS, VOICE), on wland's QRTR link. */
+#ifndef CELL_H
+#define CELL_H
+#include <stdint.h>
+#include "link.h"
+
+#define CELL_PORT0	0x30	/* our client ports: 0x30 DMS, 0x31 UIM, 0x32 NAS, 0x33 VOICE */
+#define CELL_PORTS	4
+
+void cell_init(void);
+/* QRTR NEW_SERVER / DEL_SERVER from the modem (ctrl words 1-4) */
+void cell_new_server(uint32_t service, uint32_t version_instance, uint32_t node, uint32_t port);
+void cell_del_server(uint32_t service, uint32_t node, uint32_t port);
+static inline int cell_port(uint32_t port) { return port >= CELL_PORT0 && port < CELL_PORT0 + CELL_PORTS; }
+void cell_handle(const struct qrtr_hdr *h, const uint8_t *d, uint32_t n);
+void cell_poll(void);	/* every link poll round: periodic queries, /var/local/cell.cmd */
+
+#endif
