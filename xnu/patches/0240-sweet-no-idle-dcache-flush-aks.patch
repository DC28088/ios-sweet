diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index 73d9267..db42edf 100644
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -57,7 +57,8 @@ enum {
  * aks lock state bits (aks_get_lock_state): bit 2 is "unlocked since boot"
  * (MobileKeyBag MKBDeviceUnlockedSinceBoot); clear lock bits = unlocked.
  */
-#define SWEET_AKS_LOCK_STATE    0x4
+/* 0240 (ios-redfin 0910): also bit 1 "no passcode" + sls 3; with 0x4/0 coreduetd polled thousands of times a minute */
+#define SWEET_AKS_LOCK_STATE    0x6
 
 class AppleKeyStore : public IOService {
 	OSDeclareDefaultStructors(AppleKeyStore);
@@ -150,7 +151,7 @@ sweet_aks_device_state(IOExternalMethodArguments *args)
 		const char *key;
 		uint8_t value;
 	} fields[] = {
-		{ "ss", SWEET_AKS_LOCK_STATE }, { "sls", 0 }, { "sb", 0 }, { "sfa", 0 },
+		{ "ss", SWEET_AKS_LOCK_STATE }, { "sls", 3 }, { "sb", 0 }, { "sfa", 0 },
 		{ "sgs", 0 }, { "sas", 0 }, { "sgpe", 0 }, { "srcd", 0 },
 	};
 	uint8_t buf[128];
@@ -275,10 +276,13 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		break;
 	}
 
-	char name[32];
-	proc_selfname(name, sizeof(name));
-	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
-	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	static uint32_t logged[128];            /* 0240: a few lines per selector */
+	if (selector >= 128 || logged[selector]++ < 5) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	}
 	return ret;
 }
 #endif /* SWEET */
diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index b082a10..a934a40 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -568,7 +568,12 @@ cpu_idle(void)
 #endif /* MONOTONIC */
 
 	if (wfi) {
-#if !defined(APPLE_ARM64_ARCH_FAMILY)
+#if !defined(APPLE_ARM64_ARCH_FAMILY) && !defined(ARM64_BOARD_CONFIG_SWEET)
+		/*
+		 * 0240 (from ios-redfin 0910 / sailfish 0180): not on SWEET. This flushed the whole D-cache by set/way
+		 * (FlushPoU_Dcache) on every idle entry; the caches stay coherent and powered while a core waits in WFI,
+		 * and every wake-up started cold (redfin/sailfish measured idle CPU 133% -> 22%).
+		 */
 		platform_cache_idle_enter();
 #endif
 
