 	printf("SWEET SMMU: sCR0=%#x\n", scr0);
 	const uint32_t id0 = smmu[0x20 / 4], id1 = smmu[0x24 / 4], id2 = smmu[0x28 / 4];
 	printf("SWEET SMMU: ID0=%#x ID1=%#x ID2=%#x: %u SMRs, %u context banks\n", id0, id1, id2, id0 & 0xff, id1 & 0xff);
+	extern uint32_t sweet_pmem_probe_read(uint64_t pa);
+	printf("SWEET SMMU: reading ID0 through the /dev/pmem window path next\n");
