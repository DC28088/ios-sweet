+// Held binds go out in arrival order; a client released meanwhile (its slot no longer used) is skipped.
+static void bb_bind_release(const char *why)
+{
+  if (!bb_bind_count) return;
+  uint32_t sent = 0;
+  for (uint32_t i = 0; i < bb_bind_count; i++) {
+    bb_tx *t = &bb_bind_held[i];
+    const uint32_t slot = t->local_port - CBQ_PORT_BASE;
+    const uint32_t service = slot < CBQ_MAX_CLIENTS ? bb_qmux.client[slot].service : 0;
+    if (slot < CBQ_MAX_CLIENTS && bb_qmux.client[slot].used) { bb_send_fixed(service, t->local_port, t->node, t->port, t->data, t->len); sent++; }
+    IOFreeData(t->data, t->len);
+  }
+  bb_binds_released += sent;
+  printf("SWEET BB: data port: %u held bind(s) sent, %u dropped (%s); %u held in all\n", sent, bb_bind_count - sent, why, bb_binds_held_total);
+  bb_bind_count = 0;
