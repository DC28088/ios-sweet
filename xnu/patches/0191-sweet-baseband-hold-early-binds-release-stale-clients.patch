+// 0191: the modem itself never resets here (the bridge plays resets back to ABM), so the QMUX clients CommCenter held before the reset
+// stay allocated, and CommCenter takes new ones without releasing them. 0190c: after one ATCS reset the 64 slots were gone
+// (QMI_ERR_CLIENT_IDS_EXHAUSTED for UIM) and the SIM never came back. A new boot exchange on sahara starts a new baseband session:
+// free every host client (DEL_CLIENT for their QRTR ports follows through cbq_next_release); the bridge's own clients stay.
+static void bb_release_host_clients(void)
+{
+  uint32_t n = 0;
+  for (uint32_t i = 0; i < CBQ_MAX_CLIENTS; i++)
+    if (bb_qmux.client[i].used && bb_qmux.client[i].channel != CBQ_INTERNAL) { cbq_client_free(&bb_qmux, i); n++; }
+  for (uint32_t i = 0; i < bb_bind_count; i++) IOFreeData(bb_bind_held[i].data, bb_bind_held[i].len);
+  bb_bind_count = 0;
+  if (n) printf("SWEET BB: new baseband session: %u stale host QMUX client(s) released\n", n);
+}
