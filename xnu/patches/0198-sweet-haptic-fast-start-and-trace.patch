+/* 0198: the static part of aw8624_haptic_cont(), written once after init (the chip keeps it in standby) */
+static bool hap_prepared;
+
+static bool
+aw_cont_prepare(void)
+{
+	const unsigned f0_reg = 1000000000u / (2080u * 260u);   /* f0_pre 208.0 Hz, f0_coeff 260 */
+	hap_prepared = aw_wr(0x49, (uint8_t)(f0_reg >> 8)) && aw_wr(0x4a, (uint8_t)f0_reg) &&
+	    aw_bits(0x2b, (uint8_t)~(1u << 6), (3u << 6)) &&           /* DATCTRL: 1000 Hz LPF (vendor masks) */
+	    aw_bits(0x2b, (uint8_t)~(1u << 5), (1u << 5)) &&
+	    aw_wr(0x48, (uint8_t)((1u << 7) | (1u << 3) | (1u << 0))) &&   /* CONT_CTRL: ZC detect, closed loop, auto brake */
+	    aw_wr(0x4b, 0xf0) && aw_wr(0x4c, 0x6c) &&                  /* TD 0xf06c */
+	    aw_wr(0x4d, 0x11) &&
+	    aw_wr(0x72, 0x08) && aw_wr(0x73, 0xf8) &&
+	    aw_bits(0x78, (uint8_t)~0xfu, 3) &&                        /* BEMF_NUM: 3 brake periods */
+	    aw_wr(0x7a, 0x23) &&                                       /* TIME_NZC */
+	    aw_wr(0x7c, 0x9b);                                         /* overdrive level */
+	printf("SWEET HAPTIC: continuous mode prepared: %s\n", hap_prepared ? "ok" : "FAILED");
+	return hap_prepared;
+}
+
+/* 0198: per buzz only the dynamic part (mode, active, SYSINT clear, drive, GO) */
+static bool
+aw_cont_go(uint8_t drive)
+{
+	uint8_t clr = 0;
+	return aw_bits(0x04, (uint8_t)~((3u << 2) | 1u), (2u << 2)) &&   /* SYSCTRL: CONT, active */
+	    aw_rd(0x02, &clr) == 0 &&                                  /* clear SYSINT (aw8624_haptic_active) */
+	    aw_bits(0x03, (uint8_t)~(1u << 5), 0) &&                   /* UVLO interrupt on */
+	    aw_wr_raw(0x7b, drive) == 0 &&                             /* drive level (DT 0x6a) */
+	    aw_wr_raw(0x05, 0x01) == 0;                                /* GO */
+}
