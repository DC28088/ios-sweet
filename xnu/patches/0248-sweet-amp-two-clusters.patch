diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..1f0efef 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -25,6 +25,16 @@
  */
 #define SWEET_SMP_MAX_CPUS         8
 
+/*
+ * 0248: AMP. The ADT gives cpu0-5 (Cortex-A55) cluster-type 'E', cluster-id 0 and cpu6-7
+ * (Cortex-A76) cluster-type 'P', cluster-id 1 (tools/sweet-adt-amp.py). Without HAS_CLUSTER,
+ * ml_parse_cpu_topology makes one logical cluster per type; ml_processor_register creates
+ * one pset per cluster and XNU's sched_amp (the A11-era iPhone scheduler, multiq based)
+ * places threads: user threads above utility QoS on the P-cores, kernel and background
+ * threads on the E-cores, spilling to the E-cores when the P-cores are loaded.
+ */
+#define __ARM_AMP__               1
+
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
 #define __ARM_VMSA__              8
