+/*
+ * Real panel brightness for the Xiaomi K6 38/0c/0a AMOLED (live FDT:
+ * bl_ctrl_dcs, levels 8..2047, DCS long write 0x51 hi lo in LP mode, sw DMA
+ * trigger). The ABL leaves DSI0 (0xae94000, dsi-ctrl-hw-v2.3) streaming in
+ * video mode. A command is queued through the controller's TPG DMA FIFO
+ * exactly as the downstream SM6150 dsi_ctrl_hw_cmn_kickoff_fifo_command():
+ * no memory fetch, so no display-SMMU mapping is involved; the command engine
+ * is enabled only for the transfer, and embedded mode sends it in blanking.
+ *
+ * iOS finds the backlight by IOPropertyMatch {backlight-control: true}
+ * (CoreBrightness BLControl, PowerLog AppleARMBacklight) and reads
+ * IODisplayParameters/brightness/{min,max,value}. setProperties() accepts
+ * brightness as a number or {value}, top level or inside IODisplayParameters,
+ * or BrightnessMilliNits, and logs what userland actually sent.
+ * sweetbl=N (8..2047) sends one level after start, as a hardware check.
+ */
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+	volatile uint32_t *fDsi;
+	IOLock        *fLock;
+	thread_call_t  fCall;
+	uint32_t       fWanted, fSent, fValue, fFailures;
+	unsigned       fLogged;
+	static void    applyCall(thread_call_param_t owner, thread_call_param_t);
+	int            sendLevel(uint32_t level);
+	void           publish(void);
+	void           request(uint32_t level, uint32_t value);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
