+}
+
+static uint64_t
+sweet_adreno_read64(void *cookie, uint32_t offset)
+{
+ uint64_t value = *(volatile uint64_t *)((vm_offset_t)cookie + offset);
+ __asm__ volatile("dmb oshld" ::: "memory");
+ return value;
+}
+static void
+sweet_adreno_write64(void *cookie, uint32_t offset, uint64_t value)
+{
+ __asm__ volatile("dmb oshst" ::: "memory");
+ *(volatile uint64_t *)((vm_offset_t)cookie + offset) = value;
+ __asm__ volatile("dsb oshst" ::: "memory");
+}
+static void
+sweet_adreno_barrier(void *cookie)
+{
+ (void)cookie;
+ __asm__ volatile("dsb sy" ::: "memory");
 }
 
