+/*
+ * Copy the presented rectangle (lx, ly, lw, lh), whose top-left texel is at `src` (rows srcBpr
+ * apart), to the panel rows and columns that map into it: runs of up to 24 columns per memcpy.
+ */
+void
+AppleCLCD::copyScaled(uintptr_t src, uint32_t srcBpr, int32_t lx, int32_t ly, int32_t lw, int32_t lh)
+{
+	/* First panel column/row whose presented column/row is >= lx/ly, and the end ones. */
+	int32_t px0 = (lx * 24 + 24) / 25, px1 = ((lx + lw) * 24 + 24) / 25;
+	int32_t py0 = (ly * 200 + 202) / 203, py1 = ((ly + lh) * 200 + 202) / 203;
+	while (px0 > 0 && sweet_fb_scaled_col(px0 - 1) >= lx) {
+		px0--;
+	}
+	while (px0 < (int32_t)fWidth && sweet_fb_scaled_col(px0) < lx) {
+		px0++;
+	}
+	while (px1 > px0 && sweet_fb_scaled_col(px1 - 1) >= lx + lw) {
+		px1--;
+	}
+	while (py0 > 0 && sweet_fb_scaled_row(py0 - 1) >= ly) {
+		py0--;
+	}
+	while (py0 < (int32_t)fHeight && sweet_fb_scaled_row(py0) < ly) {
+		py0++;
+	}
+	while (py1 > py0 && sweet_fb_scaled_row(py1 - 1) >= ly + lh) {
+		py1--;
+	}
+	px1 = px1 > (int32_t)fWidth ? (int32_t)fWidth : px1;
+	py1 = py1 > (int32_t)fHeight ? (int32_t)fHeight : py1;
+	for (int32_t py = py0; py < py1; py++) {
+		const uintptr_t srow = src + (uint64_t)(sweet_fb_scaled_row(py) - ly) * srcBpr;
+		uint8_t *drow = (uint8_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (int32_t px = px0; px < px1;) {
+			int32_t end = (px / 24 + 1) * 24;
+			end = end > px1 ? px1 : end;
+			memcpy(drow + (uint64_t)px * 4, (const void *)(srow + (uint64_t)(sweet_fb_scaled_col(px) - lx) * 4),
+			    (size_t)(end - px) * 4);
+			px = end;
+		}
+	}
+}
