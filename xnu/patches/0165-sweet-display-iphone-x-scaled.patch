+/* sweetfb_mode=3: the presented 1125x2436 is scaled onto the 1080x2400 panel (SweetHID maps touch
+ * the same way: the whole display is the whole panel). */
+extern "C" bool
+sweet_fb_scaled(void)
+{
+	int native = 0, mode = 3;
+	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
+	PE_parse_boot_argn("sweetfb_mode", &mode, sizeof(mode));
+	return !native && mode == 3;
+}
+
+/* Panel column -> presented column: 25 presented columns over every 24 panel ones. */
+static inline int32_t
+sweet_fb_scaled_col(int32_t px)
+{
+	return px + px / 24;
+}
+
+/* Panel row -> presented row: 2436 over 2400, py + floor(36 py / 2400). */
+static inline int32_t
+sweet_fb_scaled_row(int32_t py)
+{
+	return py + (py * 3) / 200;
+}
