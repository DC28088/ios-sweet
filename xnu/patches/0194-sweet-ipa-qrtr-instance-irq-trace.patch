 /* the interrupts coachz_modem_poll handles: SPI ipa-irq, gsi-irq and the RX/TX event rings, polled */
+/* 0194: the 0193 boot panicked on CPU 3 right after INIT_DRIVER (no text in the logs); each new pending IPA/GSI interrupt
+   set is printed (first 64 changes) before it is handled, so the console shows what the hardware raised last. */
+static uint32_t si_irq_seen_ipa, si_irq_seen_gsi, si_irq_logs;
+static void
+si_irq_note(void)
+{
+	const uint32_t ipa = ipa_rd(&si_ipa, CIPA_IPA_IRQ_STTS);
+	const uint32_t gsi = si_state == SI_SET_UP ? gsi_rd(&si_gsi, CGSI_CNTXT_TYPE_IRQ) : 0;
+	if ((ipa & ~si_irq_seen_ipa) || (gsi & ~si_irq_seen_gsi)) {
+		si_irq_seen_ipa |= ipa;
+		si_irq_seen_gsi |= gsi;
+		if (si_irq_logs++ < 64)
+			printf("SWEET IPA: irq pending IPA 0x%x (enabled 0x%x) GSI type 0x%x (enabled 0x%x)\n", ipa, si_ipa.irq_enabled, gsi,
+			    si_gsi.type_enabled);
+	}
+}
+
 static void
 si_poll_locked(void)
 {
 	if (si_state == SI_OFF) return;
+	si_irq_note();
 	coachz_ipa_interrupt(&si_ipa);
 	if (si_state != SI_SET_UP) return;
 	coachz_gsi_interrupt(&si_gsi);
@@ -424,7 +447,7 @@
