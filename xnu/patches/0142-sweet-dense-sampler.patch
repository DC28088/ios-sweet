diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..36d2fbb 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -13,6 +13,7 @@
  * First sample 90 s after start, then every 120 s, 40 samples at most.
  */
 #include <sys/param.h>
+#include <mach/mach_time.h>
 #include <sys/systm.h>
 #include <sys/proc.h>
 #include <sys/proc_internal.h>
@@ -70,11 +71,29 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
-	for (int i = 0; i < 40; i++) {
-		printf("SMP --- sample %d\n", i);
+	/* sweetsamplefirst (s), sweetsamplems (interval), sweetsamplecount: a dense
+	 * burst shows where a render loop spends a slow frame (0132: ~290ms per
+	 * CoreAnimation frame while GPU waits were <=46ms). Defaults as before. */
+	int first = 90, interval_ms = 120000, count = 40;
+	PE_parse_boot_argn("sweetsamplefirst", &first, sizeof(first));
+	PE_parse_boot_argn("sweetsamplems", &interval_ms, sizeof(interval_ms));
+	PE_parse_boot_argn("sweetsamplecount", &count, sizeof(count));
+	if (interval_ms < 50) {
+		interval_ms = 50;
+	}
+	if (count > 2000) {
+		count = 2000;
+	}
+	int ticks = (int)(((int64_t)interval_ms * hz) / 1000);
+	if (ticks < 1) {
+		ticks = 1;
+	}
+	printf("SMP: sampling %s from %d s every %d ms, %d samples\n", sweet_sample_names, first, interval_ms, count);
+	(void)tsleep(&chan, PZERO, "sweetsmp", first * hz);
+	for (int i = 0; i < count; i++) {
+		printf("SMP --- sample %d t=%llu\n", i, mach_absolute_time());
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", ticks);
 	}
 }
 
