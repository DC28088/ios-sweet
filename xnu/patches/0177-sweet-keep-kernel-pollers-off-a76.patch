+	uint32_t spin_ns = 5000;
+	PE_parse_boot_argn("sweetdelayspin", &spin_ns, sizeof(spin_ns));
+	IOLog("SWEET CPU: delays below %u ns spin (cpu_idle_latency)\n", spin_ns);
 	sweet_cpufreq_start(topology);
 	thread_terminate(current_thread());
 }
