diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 03defe6..62abfe4 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -545,6 +545,36 @@ touch_se_init(void)
 	return true;
 }
 
+/*
+ * 0177: the touch thread polls the I2C engine every 10 ms at priority 81. On
+ * 0176 it cost ~7% of a core and, steered to the A76s by the 0167 scheduler
+ * rule, kept preempting CoreAnimation's render thread (bound to cpu7). Bind it
+ * to an A55 (boot-arg sweettouchcpu, default 5; negative = unbound). Called
+ * after the start delay, when all CPUs have been started.
+ */
+extern processor_t thread_bind(processor_t);
+extern processor_t cpu_to_processor(int);
+extern uint32_t processor_avail_count;
+
+static void
+touch_bind(void)
+{
+	int cpu = 5;
+	(void)PE_parse_boot_argn("sweettouchcpu", &cpu, sizeof(cpu));
+	if (cpu < 0 || cpu >= 8 || processor_avail_count < 8) {
+		printf("SWEET TOUCH: not bound (cpu %d, %u processors)\n", cpu, processor_avail_count);
+		return;
+	}
+	processor_t target = cpu_to_processor(cpu);
+	if (target == PROCESSOR_NULL) {
+		printf("SWEET TOUCH: cpu %d has no processor; not bound\n", cpu);
+		return;
+	}
+	(void)thread_bind(target);
+	thread_block(THREAD_CONTINUE_NULL); /* continue on the bound processor */
+	printf("SWEET TOUCH: thread bound to cpu %d\n", cpu);
+}
+
 static void
 touch_thread(void *arg, wait_result_t result)
 {
@@ -558,6 +588,7 @@ touch_thread(void *arg, wait_result_t result)
 	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
 	printf("SWEET TOUCH: starting in %u s\n", delay_s);
 	touch_wait(delay_s * 1000u);
+	touch_bind();
 	printf("SWEET TOUCH: mapping GCC/TLMM/SE7\n");
 	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
 	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
