+	 * as on Apple SoCs; longer ones still block. sweetdelayspin=<ns>, 0 = off.
+	 */
+	uint32_t spin_ns = 5000;
+	PE_parse_boot_argn("sweetdelayspin", &spin_ns, sizeof(spin_ns));
+	info.powergate_latency = spin_ns;
 	perfmon_interrupt_handler_func pmi_handler = NULL;
 	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
 	if (result != KERN_SUCCESS) {
@@ -294,6 +305,9 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	ml_set_max_cpus(topology->max_cpu_id + 1);
 	IOLog("SWEET CPU: %u/%u CPUs initialized, SGI1 verified\n",
