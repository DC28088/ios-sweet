 	info.l3_cache_id = cpu->l3_cache_id;
 	info.l3_cache_size = cpu->l3_cache_size;
+	/*
+	 * 0177: powergate_latency becomes cpu_idle_latency, the bound below which
+	 * delay()/IODelay() spin (ml_delay_should_spin). Left at 0, every delay
+	 * from a preemptible thread blocked on a timer: the drivers' 1 us register
+	 * polls (touch I2C, UFS, GPU power) each cost a timer, a context switch and
