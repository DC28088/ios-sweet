+	int ocv = (int)mv - (currentValid ? ma * 150 / 1000 : 0);
+	int32_t curve = (int32_t)estimatePercent(ocv > 0 ? (unsigned)ocv : 0) * 1000;
+	uint64_t now = mach_absolute_time(), ns = 0;
