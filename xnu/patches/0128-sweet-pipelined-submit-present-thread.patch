+/* GPU-gate waits and the panel copy run here, never in the vsync timer, so
+ * CoreAnimation keeps receiving vsync at the timer cadence while a frame is
+ * being waited for or copied. */
+void
+AppleCLCD::presentThread(void *arg, wait_result_t result)
+{
+	(void)result;
+	AppleCLCD *fb = (AppleCLCD *)arg;
+	for (;;) {
+		IOLockLock(fb->fPresentLock);
+		while (!fb->fPresentRequested) {
+			IOLockSleep(fb->fPresentLock, &fb->fPresentRequested, THREAD_UNINT);
+		}
+		fb->fPresentRequested = false;
+		IOLockUnlock(fb->fPresentLock);
+		bool take = false;
+		IOLockLock(fb->fLock);
+		if (fb->fDirty && !fb->fPowerOff) {
+			memcpy(fb->fPresentRec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
 			fb->fDirty = false;
+			take = true;
+		}
+		IOLockUnlock(fb->fLock);
+		if (!take) {
+			continue;
+		}
+		const uint64_t began = mach_absolute_time();
+		fb->present(fb->fPresentRec);
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		const uint64_t us = ns / NSEC_PER_USEC;
+		__atomic_add_fetch(&fb->fStatsPresents, 1, __ATOMIC_RELAXED);
+		__atomic_add_fetch(&fb->fStatsPresentUs, us, __ATOMIC_RELAXED);
+		uint64_t max = __atomic_load_n(&fb->fStatsPresentMaxUs, __ATOMIC_RELAXED);
+		while (us > max && !__atomic_compare_exchange_n(&fb->fStatsPresentMaxUs, &max, us,
+		    false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
 		}
 	}
