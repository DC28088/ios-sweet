+/* A request while the thread is still copying is coalesced: the thread then
+ * presents the latest pending swap once, instead of queuing stale frames. */
+void
+AppleCLCD::requestPresent(void)
+{
+	IOLockLock(fPresentLock);
+	if (fPresentRequested) {
+		__atomic_add_fetch(&fStatsCoalesced, 1, __ATOMIC_RELAXED);
+	}
+	fPresentRequested = true;
+	IOLockWakeup(fPresentLock, &fPresentRequested, true);
+	IOLockUnlock(fPresentLock);
+}
