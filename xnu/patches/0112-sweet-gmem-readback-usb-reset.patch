+ * reset. No IOC: allow the documented 1 ms settling time after EndTransfer.
+ * A command failure keeps the data path disabled until the next kernel boot. */
+static void
+ud_reset_data(void)
+{
+ lck_mtx_lock(ud.lock);
+ ud.configured = false;
+ ud.data_alt = 0;
+ static const unsigned endpoints[] = { EP_RX, EP_TX, EP_INT };
+ for (unsigned i = 0; i < sizeof(endpoints) / sizeof(endpoints[0]); i++) {
+  unsigned ep = endpoints[i];
