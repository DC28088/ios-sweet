+/* 0241: IPA QMI messages the modem sends after INIT_COMPLETE (ipa_qmi_service_v01.h) */
+#define SI_INSTALL_FILTER_RULE    0x23u
+#define SI_FILTER_INSTALLED_NOTIF 0x24u
+#define SI_CONFIG                 0x27u
+#define SI_FSPEC_EX_SIZE          173u     /* ipa_filter_spec_ex_type_v01; rule_id u32 at 168 (redfin/HakiOS) */
+#define SI_FSPEC_EX_RULE_ID       168u
+#define SI_MAX_RULES              32u
+
+static uint32_t
+si_rd32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* INSTALL_FILTER_RULE: result success + TLV 0x11 rule_id list echoed from TLV 0x15 (u8 count, count x 173-byte
+ * filter_spec_ex); then FILTER_INSTALLED_NOTIF (0x24) to the modem's IPA service: 0x01 source pipe = AP_MODEM_TX,
+ * 0x02 status u16 0, 0x03 empty filter_index_list, 0x17 rule ids (as Android ipa3_wwan_add_ul_flt_rule_to_ipa). */
+static void
+si_install_filter(uint32_t node, uint32_t port, const struct ci_msg *m)
+{
+	uint8_t ids[1 + 4 * SI_MAX_RULES];
+	unsigned k = 0;
+	uint16_t l = 0;
+	const uint8_t *p = ci_find(m, 0x15, &l);
+	ids[0] = 0;
+	if (p != NULL && l >= 1 && l == 1u + (unsigned)p[0] * SI_FSPEC_EX_SIZE) {
+		const unsigned cnt = p[0];
+		k = cnt > SI_MAX_RULES ? SI_MAX_RULES : cnt;
+		ids[0] = (uint8_t)k;
+		for (unsigned r = 0; r < cnt; r++) {
+			const uint8_t *e = p + 1 + r * SI_FSPEC_EX_SIZE;
+			if (r < 8)
+				printf("SWEET IPA: filter rule %u: ip %u action %u rt %u/%u mux %u/%u id 0x%x hash %u\n", r, si_rd32(e),
+				    si_rd32(e + 154), e[158], si_rd32(e + 159), e[163], si_rd32(e + 164), si_rd32(e + SI_FSPEC_EX_RULE_ID),
+				    e[172]);
+			if (r < k)
+				memcpy(ids + 1 + 4 * r, e + SI_FSPEC_EX_RULE_ID, 4);
+		}
+	} else {
+		printf("SWEET IPA: filter rules: TLV 0x15 %s (%u bytes): success alone\n", p ? "not 1 + n x 173" : "missing",
+		    (unsigned)l);
+	}
+	uint8_t out[16 + sizeof ids];
+	struct ci_buf b = { out, sizeof out, 0, 0 };
+	ci_header(&b, CI_QMI_RESPONSE, m->txn, m->id);
+	ci_u8(&b, 0x02); ci_u16(&b, 4); ci_u16(&b, 0); ci_u16(&b, 0);
+	if (k) {
+		ci_u8(&b, 0x11); ci_u16(&b, (uint16_t)(1 + 4 * k)); ci_put(&b, ids, 1 + 4 * k);
+	}
+	size_t n = ci_finish(&b);
+	int r1 = n ? si_send(0, node, port, out, (uint32_t)n) : -1;
+	int r2 = -1;
+	if (k && si_modem_known) {
+		uint8_t empty = 0;
+		ci_header(&b, CI_QMI_REQUEST, ++si_txn, SI_FILTER_INSTALLED_NOTIF);
+		ci_tlv_u32(&b, 0x01, CI_EP_AP_MODEM_TX);
+		ci_u8(&b, 0x02); ci_u16(&b, 2); ci_u16(&b, 0);
+		ci_u8(&b, 0x03); ci_u16(&b, 1); ci_put(&b, &empty, 1);
+		ci_u8(&b, 0x17); ci_u16(&b, (uint16_t)(1 + 4 * k)); ci_put(&b, ids, 1 + 4 * k);
+		n = ci_finish(&b);
+		r2 = n ? si_send(1, si_modem_node, si_modem_port, out, (uint32_t)n) : -1;
+	}
+	printf("SWEET IPA: install filter rule answered (%u ids) -> %d; FILTER_INSTALLED_NOTIF source ep %u -> %d\n", k, r1,
+	    CI_EP_AP_MODEM_TX, r2);
+}
