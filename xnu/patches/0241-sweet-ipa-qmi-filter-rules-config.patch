 		printf("SWEET IPA: QMI type %u message 0x%x from %u:0x%x%s\n", m.type, m.id, node, port, known ? "" : ", not handled");
 		if (!known) return;
+		if (m.id == SI_CONFIG || m.id == SI_FILTER_INSTALLED_NOTIF) {
