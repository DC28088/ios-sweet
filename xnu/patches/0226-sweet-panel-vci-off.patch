+/*
+ * 0226: panel VCI (pm6150_l18 = "ldoa18", an XOB: on/off only, enable register at +4 like
+ * the VRMs) off while the panel sleeps, so the K6 AMOLED is unpowered like on Android (Xiaomi
+ * sweet DT: dsi_panel_pwr_supply_labibb_amoled vdda-3p3 3.0 V, pre-off sleep 10 ms; only the
+ * display uses L18A in the sweet/sdmmagpie DTs). Only this resource; on and off.
+ */
+int sweet_rpmh_panel_vci(bool on);
+int
+sweet_rpmh_panel_vci(bool on)
+{
+	for (unsigned tries = 0; __atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE); tries++) {
+		if (tries >= 200) {
+			return EBUSY;
+		}
+		delay(1000);
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup("ldoa18", RH_VRM, &found);
+		}
+		if (!error) {
+			const uint32_t offsets[1] = {4};
+			const uint32_t values[1] = {on ? 1u : 0u};
+			error = rh_send_cmds("ldoa18", found.addr, 15u, offsets, values, 1, RH_TIMEOUT_US, NULL);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	printf("SWEET RPMH: panel VCI ldoa18 %s -> %d\n", on ? "on" : "off", error);
+	return error;
+}
