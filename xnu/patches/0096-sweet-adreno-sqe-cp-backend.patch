+
+/* CP storage and PAS metadata have separate lifetimes and separate physical
+ * pages; TrustZone may protect the metadata page during authentication. */
+static IOBufferMemoryDescriptor *sweet_aux_storage[2];
+static int
+sweet_aux_allocate(unsigned index, unsigned bytes, struct a618_dma_region *region)
+{
+ if (!region || index > 1) return EINVAL;
+ if (sweet_aux_storage[index]) return EALREADY;
+ IOBufferMemoryDescriptor *storage = IOBufferMemoryDescriptor::inTaskWithOptions(
+     kernel_task, kIODirectionInOut | kIOMemoryPhysicallyContiguous |
+     kIOMemoryMapperNone | kIOMapInhibitCache, bytes, 0x4000);
+ if (!storage) return ENOMEM;
+ if (storage->prepare(kIODirectionInOut) != kIOReturnSuccess) {
+  storage->release(); return EIO;
+ }
+ IOByteCount contiguous = 0;
+ uint64_t physical = storage->getPhysicalSegment(0, &contiguous, kIOMemoryMapperNone);
+ void *cpu = storage->getBytesNoCopy();
+ if (!cpu || !physical || (physical & 0x3fff) || contiguous < bytes ||
+     physical > (1ull << 36) - bytes) {
+  storage->complete(kIODirectionInOut); storage->release(); return ERANGE;
+ }
+ sweet_aux_storage[index] = storage;
+ region->cpu = (unsigned char *)cpu;
+ region->physical = physical; region->bytes = bytes; region->uncached = 1;
+ volatile uint32_t *words = (volatile uint32_t *)cpu;
+ for (unsigned i = 0; i < bytes / 4; ++i) words[i] = 0;
+ __asm__ volatile("dsb sy" ::: "memory");
+ return 0;
+}
+extern "C" int
+sweet_adreno_cp_allocate(struct a618_dma_region *region)
+{
+ return sweet_aux_allocate(0, A618_CP_DMA_BYTES, region);
+}
+extern "C" int
+sweet_adreno_pas_allocate(struct a618_dma_region *region)
+{
+ return sweet_aux_allocate(1, 0x4000, region);
+}
 #endif
