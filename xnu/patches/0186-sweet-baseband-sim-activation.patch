+static inline uint32_t cbd_tlv_endpoint(uint8_t *p, uint32_t room, uint32_t type)
+{
+    uint8_t b[8];
+    cbd_wr32(b, CBD_EP_EMBEDDED);
+    cbd_wr32(b + 4, CBD_EP_INTERFACE);
+    return cbd_tlv(p, room, type, b, 8);
