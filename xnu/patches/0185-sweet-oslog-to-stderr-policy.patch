--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -308,15 +308,48 @@
 }
 
 /* dyld op0x5a asks which DYLD_* settings may be honored. Scope the
- * permissive experimental policy to backboardd on explicit GLES boots. */
+ * permissive experimental policy to backboardd on explicit GLES boots.
+ *
+ * libsystem_trace asks the same question (amfi_check_dyld_policy_self) in
+ * _libtrace_init and honours OS_ACTIVITY_DT_MODE / CFLOG_FORCE_STDERR /
+ * ACTIVITY_LOG_STDERR (os_log mirrored to stderr) only when the call
+ * succeeds with bit 0x100 set. Processes named in boot-arg sweetoslog
+ * (comma separated, default none) get 0x7b | 0x100, so a launchd job with
+ * those variables writes its os_log text to stderr (/dev/null -> sweetnull).
+ */
+static bool
+sweet_oslog_listed(const char *name)
+{
+	char list[128];
+	size_t n = strlen(name);
+	if (n == 0 || !PE_parse_boot_argn("sweetoslog", list, sizeof(list))) {
+		return false;
+	}
+	for (const char *t = list; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
 static int
 sweet_gles_dyld_policy(__unused struct proc *p, int call, user_addr_t arg)
 {
     int enabled=0;
     char name[32]={0};proc_selfname(name,sizeof(name));
-    if (call!=0x5a || !PE_parse_boot_argn("sweetgles",&enabled,sizeof(enabled)) ||
-        enabled!=1 || strcmp(name,"backboardd")) return ENOPOLICY;
-    uint64_t request[2], flags=0x7b;
+    uint64_t request[2], flags=0;
+    if (call!=0x5a) return ENOPOLICY;
+    if (PE_parse_boot_argn("sweetgles",&enabled,sizeof(enabled)) && enabled==1 &&
+        !strcmp(name,"backboardd")) flags=0x7b;
+    if (sweet_oslog_listed(name)) flags=0x7b|0x100;
+    if (!flags) return ENOPOLICY;
     if (copyin(arg,request,sizeof(request)) || !request[1]) return EFAULT;
     return copyout(&flags,(user_addr_t)request[1],sizeof(flags));
 }
