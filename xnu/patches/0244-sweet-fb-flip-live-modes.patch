+#define SWEET_MDP_INTR_EN               (0x1000 + 0x10)
+#define SWEET_MDP_INTR_STATUS           (0x1000 + 0x14)
+#define SWEET_MDP_INTR_CLEAR            (0x1000 + 0x18)
+#define SWEET_INTR_INTF1_UNDERRUN       (1u << 26)      /* Linux dpu_hw_interrupts.c */
+#define SWEET_INTR_INTF1_VSYNC          (1u << 27)
+#define SWEET_INTR_INTF2_UNDERRUN       (1u << 28)
+
+bool
+AppleCLCD::flipMapMdp(void)
+{
+	if (fMdp == NULL) {
+		fMdp = (volatile uint32_t *)ml_io_map(SWEET_MDP_PA, SWEET_MDP_LEN);
+		if (fMdp != NULL) {
+			IOLog("SWEET FLIP: mdp intr en %#x status %#x ctl0 flush %#x vig0 src0 %#x\n",
+			    fMdp[SWEET_MDP_INTR_EN / 4], fMdp[SWEET_MDP_INTR_STATUS / 4],
+			    fMdp[SWEET_CTL0_FLUSH / 4], fMdp[SWEET_VIG0_SRC0_ADDR / 4]);
+		}
+	}
+	return fMdp != NULL;
+}
+
+/* Present thread only. Underrun/vsync status since the previous present; cleared after reading. */
+void
+AppleCLCD::flipSampleStatus(void)
+{
+	if (fMdp == NULL) {
+		return;
+	}
+	const uint32_t bits = SWEET_INTR_INTF1_UNDERRUN | SWEET_INTR_INTF1_VSYNC | SWEET_INTR_INTF2_UNDERRUN;
+	const uint32_t st = fMdp[SWEET_MDP_INTR_STATUS / 4] & bits;
+	__atomic_add_fetch(&fStatsStatusPresents, 1, __ATOMIC_RELAXED);
+	if (st & SWEET_INTR_INTF1_UNDERRUN) {
+		__atomic_add_fetch(&fStatsUnderrun1, 1, __ATOMIC_RELAXED);
+	}
+	if (st & SWEET_INTR_INTF2_UNDERRUN) {
+		__atomic_add_fetch(&fStatsUnderrun2, 1, __ATOMIC_RELAXED);
+	}
+	if (st & SWEET_INTR_INTF1_VSYNC) {
+		__atomic_add_fetch(&fStatsVsyncSeen, 1, __ATOMIC_RELAXED);
+	}
+	if (st != 0) {
+		fMdp[SWEET_MDP_INTR_CLEAR / 4] = st;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+
+/* Present thread only: switch to `mode` (kern.sweet_fb_flip), latched before it returns. */
+void
+AppleCLCD::flipApplyMode(int mode)
+{
+	if (mode < 0 || mode > 3) {
+		IOLog("SWEET FLIP: mode %d unknown (0-3), staying in %d\n", mode, fFlipMode);
+		__atomic_store_n(&sweet_fb_flip_req, fFlipMode, __ATOMIC_RELAXED);
+		return;
+	}
+	if (mode != 0 && !flipSetup()) {
+		fFlip = false;
+		fFlipMode = 0;
+		__atomic_store_n(&sweet_fb_flip_req, 0, __ATOMIC_RELAXED);
+		return;
+	}
+	if (fFlipReady) {
+		if (fFlipPending && !flipWait()) {
+			return;         /* abandoned: back in mode 0 */
+		}
+		const unsigned target = mode == 2 ? 1 : (mode == 1 ? fScan : 0);
+		if (target != fScan) {
+			memcpy((void *)fBufVA[target], (const void *)fBufVA[fScan], (size_t)fRowBytes * fHeight);
+			flipTo(target);
+			if (!flipWait()) {
+				return;
+			}
+		}
+	}
+	fFlip = mode == 1;
+	fFlipMode = mode;
+	IOLog("SWEET FLIP: mode %d: scan buffer %u at %#llx, flush mask %#x\n", mode, fScan,
+	    fFlipReady ? fBufPhys[fScan] : 0ULL, __atomic_load_n(&sweet_fb_flip_mask, __ATOMIC_RELAXED));
+}
