+/*
+ * 0244: page-flip diagnostics, switchable live as root (over SSH), applied at the next present:
+ *   sysctl kern.sweet_fb_flip=N   0 single buffer 0, beam-raced copy (default)
+ *                                 1 double buffer page flip (0181)
+ *                                 2 single buffer 1: scan and draw only the back buffer
+ *                                   (black/garbage = the display controller cannot read it)
+ *                                 3 single buffer 0, but rewrite VIG0 SRC0 + CTL0 flush every present
+ *                                   (flashes = the flush itself blanks frames)
+ *   sysctl kern.sweet_fb_flip_mask=M   CTL0 flush bits used by flips (default 0x20041 = VIG0|LM0|CTL)
+ * Boot-arg sweetfbflip=N picks the start mode. The 10 s "SWEET FLIP:" line counts presents that saw a
+ * display-controller underrun (MDP INTR_STATUS INTF_1/INTF_2 underrun bits, read and cleared per present).
+ * Keep mode 0 for panic hunting: the kernel console (and panic text) draws into buffer 0 only.
+ */
+static int sweet_fb_flip_req = -1;
+static unsigned int sweet_fb_flip_mask = 0x20041;
+SYSCTL_INT(_kern, OID_AUTO, sweet_fb_flip, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_fb_flip_req, 0,
+    "SWEET: page-flip mode 0-3 (0244)");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_fb_flip_mask, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_fb_flip_mask, 0,
+    "SWEET: CTL0 flush bits for flips (0244)");
