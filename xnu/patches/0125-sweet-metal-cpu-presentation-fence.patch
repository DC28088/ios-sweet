+/* Noncoherent A618 writes need a real physical cache acquire. The ARM64
+ * IOMemoryDescriptor coherent-I/O shortcut is only a barrier on this kernel.
+ * Surface descriptors remain prepared/pinned for the retained surface's life.
+ * CIVAC preserves dirty neighbouring bytes on partially used source pages. */
+static IOReturn sweet_fb_acquire(SweetSurface *s,uint64_t first,uint64_t last)
+{
+ const uint64_t start=first&~UINT64_C(4095),end=(last+4095)&~UINT64_C(4095);
+ if(last<=first || end<last || end>s->memory->getLength())return kIOReturnBadArgument;
+ for(uint64_t offset=start;offset<end;) {
+  IOByteCount span=0;
+  const uint64_t physical=s->memory->getPhysicalSegment(offset,&span,kIOMemoryMapperNone);
+  uint64_t bytes=span<end-offset?span:end-offset;
+  if(!physical || !bytes || ((physical|bytes)&4095))return kIOReturnUnsupported;
+  const IOReturn result=NativeAdrenoMaintainPhysicalPages(physical,(size_t)bytes,NativeAdrenoCleanInvalidate);
+  if(result)return result;
+  offset+=bytes;
+ }
+ return kIOReturnSuccess;
+}
