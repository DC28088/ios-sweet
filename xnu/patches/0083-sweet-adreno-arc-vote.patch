+/*
+ * Decode an ARC level table.  Command-DB aux data is a little-endian u16
+ * array of resource-specific levels; the consumer level adds one because
+ * zero is an invalid voltage.  Zero padding after the first entry is
+ * ignored, matching the downstream regulator driver.
+ */
+static int
+rh_arc_levels(const struct rh_res *res, uint16_t *level, unsigned *count)
+{
+	unsigned n = res->aux_len / RH_ARC_LEVEL_SIZE;
+	if (n == 0 || n > RH_ARC_MAX_LEVELS) {
+		return EINVAL;
+	}
+	unsigned used = n;
+	for (unsigned i = 0; i < n; ++i) {
+		uint16_t value = rh_db16(res->aux + i * RH_ARC_LEVEL_SIZE);
+		if (i > 0 && value == 0) {
+			used = i;
+			break;
+		}
+		level[i] = value + 1;
+		if (i > 0 && level[i] < level[i - 1]) {
+			printf("SWEET RPMH: non-monotonic ARC table index=%u\n", i);
+			return EINVAL;
+		}
+	}
+	if (used == 0 || level[used - 1] == 0) {
+		return EINVAL;
+	}
+	*count = used;
+	return 0;
+}
+
+static int
+rh_arc_selector(const char *name, const struct rh_res *res, unsigned target,
+    unsigned *selector)
+{
+	uint16_t level[RH_ARC_MAX_LEVELS] = {0};
+	unsigned count = 0;
+	int error = rh_arc_levels(res, level, &count);
+	if (error) {
+		return error;
+	}
+	printf("SWEET RPMH: ARC %s levels=%u:", name, count);
+	for (unsigned i = 0; i < count; ++i) {
+		printf(" %u:%u", i, level[i]);
+	}
+	printf("\n");
+	for (unsigned i = 0; i < count; ++i) {
+		if (level[i] >= target) {
+			*selector = i;
+			printf("SWEET RPMH: ARC target vlvl=%u -> hlvl=%u vlvl=%u\n",
+			    target, i, level[i]);
+			return 0;
+		}
+	}
+	printf("SWEET RPMH: ARC target vlvl=%u exceeds table max=%u\n",
+	    target, level[count - 1]);
+	return ERANGE;
+}
