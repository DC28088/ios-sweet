+/*
+ * Read the three ARC level tables first.  A malformed or missing table stops
+ * the stage before any vote.  mx must lead cx because the live DT makes MX the
+ * parent supply of CX; gfx is independent.  The RPMH completion only proves
+ * that the request was accepted, so this does not claim a measured voltage.
+ */
+static int
+sweet_gpu_arc_stage(unsigned stage)
+{
+	static const char *const names[] = { "mx.lvl", "cx.lvl", "gfx.lvl" };
+
+	for (unsigned i = 0; i < 3; ++i) {
+		int error = sweet_rpmh_arc_probe(names[i]);
+		if (error) {
+			printf("SWEET GPU: ARC probe %s failed %d\n", names[i], error);
+			return error;
+		}
+	}
+	printf("SWEET GPU: ARC tables read-only complete\n");
+	if (stage < 2) {
+		return 0;
+	}
+	for (unsigned i = 0; i < 3; ++i) {
+		int error = sweet_rpmh_arc_level(names[i], SWEET_GPU_ARC_TARGET);
+		if (error) {
+			printf("SWEET GPU: ARC vote %s failed %d; later rails not voted\n",
+			    names[i], error);
+			return error;
+		}
+	}
+	printf("SWEET GPU: ARC target vlvl=%u votes complete\n", SWEET_GPU_ARC_TARGET);
+	return 0;
+}
