+static bool
+rh_arc_name(const char *res)
+{
+	return res && (!strcmp(res, "cx.lvl") || !strcmp(res, "mx.lvl") ||
+	    !strcmp(res, "gfx.lvl"));
+}
+
+/*
+ * Read-only command-DB inspection.  No TCS is claimed, no RPMH command is
+ * written, and no rail is changed.  This is the evidence-gathering step before
+ * the first ARC vote.
+ */
+int
+sweet_rpmh_arc_probe(const char *res)
+{
+	if (!rh_arc_name(res)) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_ARC, &found);
+	}
+	if (!error) {
+		uint16_t level[RH_ARC_MAX_LEVELS] = {0};
+		unsigned count = 0;
+		error = rh_arc_levels(&found, level, &count);
+		if (!error) {
+			printf("SWEET RPMH: ARC %s read-only table:", res);
+			for (unsigned i = 0; i < count; ++i) {
+				printf(" %u:%u", i, level[i]);
+			}
+			printf("\n");
+		}
+	}
+	if (error) {
+		printf("SWEET RPMH: ARC probe %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * Vote an ARC regulator to the first table entry whose consumer level is at
+ * least target_vlvl.  The RPMH command carries the table index (hlvl), not a
+ * voltage.  There is no RPMH register readback; command completion proves the
+ * request was accepted, not that the rail reached a specific voltage.
+ */
+int
+sweet_rpmh_arc_level(const char *res, unsigned target_vlvl)
+{
+	if (!rh_arc_name(res) || target_vlvl < RH_LEVEL_MIN_SVS) {
+		printf("SWEET RPMH: ARC vote requires cx/mx/gfx.lvl and target>=%u\n",
+		    RH_LEVEL_MIN_SVS);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	unsigned selector = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC vote\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_ARC, &found);
+	}
+	if (!error) {
+		error = rh_arc_selector(res, &found, target_vlvl, &selector);
+	}
+	if (!error && selector == 0) {
+		/* Level zero is the ARC "off" selector; never take a GPU rail down. */
+		printf("SWEET RPMH: ARC %s target maps to off selector; refusing\n", res);
+		error = EINVAL;
+	}
+	if (!error) {
+		const uint32_t offset = 0;
+		const uint32_t value = selector;
+		printf("SWEET RPMH: ARC %s hlvl=%u target-vlvl=%u addr=%#x\n",
+		    res, selector, target_vlvl, found.addr);
+		error = rh_send_cmds(res, found.addr, 3u, &offset, &value, 1,
+		    RH_ARC_TIMEOUT_US);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
