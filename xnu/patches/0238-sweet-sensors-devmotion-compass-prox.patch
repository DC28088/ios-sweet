+/* sunfish 0243: one raw device-motion report as a VendorDefined {0xff0c, 4} event (CoreMotion populateDeviceMotion).
+ * 0245: also {0xff0c, 8} (devmotion8, type 2 only); its copy has the u64 at payload offset 4 zeroed (CLCompass7
+ * filters on it) unless boot-arg sweetdm8raw=1. */
+int
+SweetHIDSensor::postRaw(const struct sweet_motion_devmotion *r)
+{
+	uint64_t now = mach_absolute_time(), ts = r->ts_mach, sec;
+	uint8_t kind = r->bytes[0];
+	int i = sensorIndex();
+	uint8_t copy[sizeof(r->bytes)];
+	const uint8_t *payload = r->bytes;
+
+	if (!((r->len == 52 && (kind == 3 || kind == 4) && i == SWEET_SENSOR_DEVMOTION) || (r->len == 88 && kind == 2))) {
+		return EINVAL;
+	}
+	if (i == SWEET_SENSOR_DEVMOTION_COMPASS) {
+		static int raw = -1;
+		if (raw < 0) {
+			int v = 0;
+			PE_parse_boot_argn("sweetdm8raw", &v, sizeof(v));
+			raw = v ? 1 : 0;
+		}
+		if (!raw) {
+			memcpy(copy, r->bytes, r->len);
+			bzero(copy + 4, 8);
+			payload = copy;
+		}
+	}
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	if (ts == 0 || ts > now || now - ts > sec) {
+		ts = now;
+	}
+	IOHIDEvent *event = IOHIDEvent::vendorDefinedEvent(ts, gSweetSensorInfo[i].page,
+	    gSweetSensorInfo[i].usage, 0, (UInt8 *)payload, r->len);
+	if (!event) {
+		return ENOMEM;
+	}
+	uint64_t n = OSIncrementAtomic64((volatile SInt64 *)&fEvents) + 1;
+	if (n <= 3 || (gSweetKnobs.every && n % gSweetKnobs.every == 0)) {
+		IOLog("SWEET MOTION: %s #%llu: report type %u, %u bytes (%u clients)\n", gSweetSensorInfo[i].name, n, kind, r->len, fClients);
+	}
+	dispatchEvent(event);
+	IOLockLock(fLock);
+	IOHIDEvent *old = fLast;
+	fLast = event;
+	IOLockUnlock(fLock);
+	OSSafeReleaseNULL(old);
+	return 0;
+}
