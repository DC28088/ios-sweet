 	w->clients[i] = fClients;
 	w->interval_us[i] = fInterval;
@@ -1319,6 +1388,23 @@ sweet_hid_sensor(const struct sweet_motion_sample *s)
 	return gSweetSensors[i]->post(s);
 }
 
+extern "C" int
+sweet_hid_devmotion(const struct sweet_motion_devmotion *r)
+{
+	int e = ENODEV;
+	if (gSweetSensors[SWEET_SENSOR_DEVMOTION]) {
+		e = gSweetSensors[SWEET_SENSOR_DEVMOTION]->postRaw(r);
+	}
+	/* 0245: accepted type-2 reports also go to devmotion8 (CLCompass7) */
+	if (gSweetSensors[SWEET_SENSOR_DEVMOTION_COMPASS] && r->len == 88 && r->bytes[0] == 2 && (e == 0 || e == ENODEV)) {
+		int e8 = gSweetSensors[SWEET_SENSOR_DEVMOTION_COMPASS]->postRaw(r);
+		if (e == ENODEV) {
+			e = e8;
+		}
+	}
+	return e;
+}
