+/*
+ * 0228: one DSI packet through the command FIFO (the sendShort/sendLevel path): short 0x05
+ * (data0/data1 in the header) or long 0x39 (WC header, payload little-endian, 0xff padding).
+ */
+int
+AppleARMBacklight::sendPacket(uint8_t dtype, const uint8_t *data, unsigned len, bool hs)
+{
+	volatile uint32_t *dsi = fDsi;
+	const uint32_t ctrl = dsi[DSI_REG_CTRL / 4];
+	if ((ctrl & 3) != 3 || !len || len > 128) {
+		IOLog("SWEET PANEL: packet %#x len %u not sent (ctrl=%#x)\n", dtype, len, ctrl);
+		return ENODEV;
+	}
+	uint32_t words[1 + 32];
+	unsigned n = 1;
+	if (dtype == 0x05) {
+		words[0] = (uint32_t)data[0] | ((len > 1 ? (uint32_t)data[1] : 0u) << 8) | (0x05u << 16) | (0x80u << 24);
+	} else {
+		words[0] = (len & 0xff) | ((len >> 8) << 8) | ((uint32_t)dtype << 16) | (0xc0u << 24);
+		for (unsigned i = 0; i < len; i += 4, n++) {
+			uint32_t w = 0;
+			for (unsigned k = 0; k < 4; k++) {
+				w |= (uint32_t)(i + k < len ? data[i + k] : 0xff) << (8 * k);
+			}
+			words[n] = w;
+		}
+	}
+	const uint32_t dma_ctrl = dsi[DSI_REG_DMA_CTRL / 4];
+	dsi[DSI_REG_CTRL / 4] = ctrl | (1u << 2);
+	dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	dsi[DSI_REG_TPG_CTRL / 4] = (1u << 1) | (1u << 2) | (3u << 16);
+	for (unsigned i = 0; i < n; i++) {
+		dsi[DSI_REG_TPG_DMA_DATA / 4] = words[i];
+	}
+	dsi[DSI_REG_DMA_CTRL / 4] = (dma_ctrl & ~((1u << 31) | (1u << 30) | (1u << 26))) | (hs ? 0u : (1u << 26)) | (1u << 28);
+	dsi[DSI_REG_DMA_LENGTH / 4] = n * 4;
+	__asm__ volatile("dsb sy" ::: "memory");
+	dsi[DSI_REG_DMA_TRIGGER / 4] = 1;
+	unsigned us;
+	for (us = 0; us < 50000 && !(dsi[DSI_REG_INT_CTRL / 4] & 1u); us += 50) {
+		IODelay(50);
+	}
+	const bool done = (dsi[DSI_REG_INT_CTRL / 4] & 1u) != 0;
+	const uint32_t ack = dsi[DSI_REG_ACK_ERR / 4];
+	if (done) {
+		dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	}
+	dsi[DSI_REG_TPG_CTRL / 4] = 0;
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 1;
+	IODelay(1);
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 0;
+	dsi[DSI_REG_DMA_CTRL / 4] = dma_ctrl;
+	if (!(ctrl & (1u << 2))) {
+		dsi[DSI_REG_CTRL / 4] = dsi[DSI_REG_CTRL / 4] & ~(1u << 2);
+	}
+	if (!done || ack) {
+		IOLog("SWEET PANEL: packet %#x reg %#x len %u %s: done=%d after %u us ack_err=%#x\n", dtype, data[0], len,
+		    hs ? "HS" : "LP", done, us, ack);
+	}
+	return done ? 0 : ETIMEDOUT;
+}
+
+/*
+ * 0228: Xiaomi's K6 on-command (DT state "dsi_lp_mode"), each packet LP first and HS once if
+ * the FIFO DMA does not complete. The 90-byte 0x9E (DSC PPS) is longer than Qualcomm's 64-byte
+ * command FIFO store: if it fails whole, send its first 59 bytes, then the Samsung DDIC global
+ * parameter offset (B0 00 3B 9E, as the list itself does for F6/F4/B2) and the rest.
+ */
+int
+AppleARMBacklight::panelInit(void)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+	unsigned sent = 0, hs_used = 0, split = 0;
+	int error = 0;
+	for (unsigned i = 0, c = 0; c < SWEET_K6_ON_COUNT && i + 3 <= sizeof(sweet_k6_on); c++) {
+		const uint8_t dtype = sweet_k6_on[i], wait = sweet_k6_on[i + 1], len = sweet_k6_on[i + 2];
+		const uint8_t *pl = &sweet_k6_on[i + 3];
+		i += 3u + len;
+		int e = sendPacket(dtype, pl, len, false);
+		if (e) {
+			e = sendPacket(dtype, pl, len, true);
+			hs_used += e == 0;
+		}
+		if (e && dtype == 0x39 && len > 60) {
+			const unsigned first = 60;    /* register + 59 parameters */
+			const uint8_t off[3] = {0xb0, 0x00, (uint8_t)(first - 1)};
+			uint8_t sel[4] = {off[0], off[1], off[2], pl[0]};
+			uint8_t rest[64];
+			const unsigned left = len - first;
+			rest[0] = pl[0];
+			for (unsigned k = 0; k < left && k + 1 < sizeof(rest); k++) {
+				rest[k + 1] = pl[first + k];
+			}
+			e = sendPacket(dtype, pl, first, false);
+			if (!e) {
+				e = sendPacket(0x39, sel, sizeof(sel), false);
+			}
+			if (!e) {
+				e = sendPacket(0x39, rest, left + 1, false);
+			}
+			split += e == 0;
+		}
+		if (e) {
+			error = e;
+			IOLog("SWEET PANEL: init command %u (reg %#x len %u) failed\n", c, pl[0], len);
+			break;
+		}
+		sent++;
+		if (wait) {
+			IOSleep(wait);
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	IOLog("SWEET PANEL: K6 re-init %u/%u commands, %u needed HS, PPS split %u, %llu ms -> %d\n", sent,
+	    SWEET_K6_ON_COUNT, hs_used, split, ns / NSEC_PER_MSEC, error);
+	fSent = 0;
+	return error;
+}
