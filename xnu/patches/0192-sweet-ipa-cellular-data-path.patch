 /*
+ * 0192: a BCM clock vote as Linux's clk-rpmh casts it (clk_rpmh_bcm_set_rate/_send_cmd): level = rate / (cmd-db unit * 1000),
+ * BCM_TCS_CMD(commit, valid, 0, level). Only the IPA core clock (IP0, 100 MHz in ipa_data-v4.2.c).
+ */
+int sweet_rpmh_bcm_clock(const char *res, uint64_t hz);
+int
+sweet_rpmh_bcm_clock(const char *res, uint64_t hz)
+{
+	if (!res || strcmp(res, "IP0") || !hz || hz > 400000000ull) {
+		return EPERM;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, RH_BCM, &found);
+		}
+		if (!error && found.aux_len < 4) {
+			printf("SWEET RPMH: BCM %s has no unit (aux %u bytes)\n", res, found.aux_len);
+			error = EINVAL;
+		}
+		if (!error) {
+			const uint32_t unit = (uint32_t)rh_db16(found.aux) | (uint32_t)rh_db16(found.aux + 2) << 16;
+			const uint64_t level64 = unit ? hz / ((uint64_t)unit * 1000ull) : 0;
+			const uint32_t level = level64 < 1 ? 1u : level64 > 0x3fffu ? 0x3fffu : (uint32_t)level64;
+			const uint32_t offset = 0, value = 1u << 30 | 1u << 29 | level;
+			error = unit ? rh_send_cmds(res, found.addr, 3u, &offset, &value, 1, RH_TIMEOUT_US, NULL) : EINVAL;
+			printf("SWEET RPMH: BCM %s addr=%#x unit %u width %u: %llu Hz -> level %u vote %#x -> %d\n", res, found.addr, unit,
+			    found.aux_len >= 6 ? rh_db16(found.aux + 4) : 0, hz, level, value, error);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
