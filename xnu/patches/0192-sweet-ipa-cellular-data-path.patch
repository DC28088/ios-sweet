diff -ruN a/bsd/dev/sweet_ipa.c b/bsd/dev/sweet_ipa.c
--- a/bsd/dev/sweet_ipa.c
+++ b/bsd/dev/sweet_ipa.c
@@ -0,0 +1,461 @@
+/*
+ * Sweet (SM7150, IPA v4.2): the cellular data path. UniXNU QcomBaseband's IPA v4.2 code (bsd/dev/coachz_ipa/, BSD-2-Clause,
+ * from chiba233/Trogdor-ipadOS c6794008 via UniXNU/QcomBaseband 43d85fb08d) driven as its platform/coachz/coachz_modem.c does,
+ * with Sweet's differences:
+ *   - wland (userland) owns the modem link, SMP2P and the modem boot, so the steps arrive as /dev/sweet-bb records
+ *     (iokit/Kernel/arm/SweetBaseband.inc forwards them here): 7 configure, 8 firmware loaded, 9 modem starting, 10 IPA QMI in.
+ *     Answers go back as records 11 (IPA QMI to send) and 12 (status of a step).
+ *   - The GSI firmware is the AP's to load (stock DT qcom,ipa_fws, PAS 15, ips_fw_region 0x97f00000): wland loads it between
+ *     records 7 and 8, as mainline's IPA_LOADER_SELF does between ipa_config and ipa_setup. There is no ipa-setup-ready wait.
+ *   - The IPA core clock (BCM IP0) and its paths to DDR (SN11, SN0) and to its registers (CN0) are voted here; the apps SMMU
+ *     gets a bypass stream for the IPA (SID 0x520, 0x522 with mask 2), as 0153 does for the WLAN.
+ *   - DMA memory is low DRAM below 4 GB that XNU never maps (it uses only DDR above 4 GB) and wland does not use
+ *     (0xe0000000 WLAN pool, 0xe1000000 rmtfs): 0xe4000000..0xe4700000, mapped write-combined as upstream maps its ranges.
+ *   - A kernel thread polls the IPA/GSI interrupts (1 ms while packets move, 10 ms when idle) and drains the pdp_ip queues.
+ * Off unless the boot-arg sweetipa=1. Every failure is printed and turns the data path off; voice, SMS and Wi-Fi go on.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+
+#include "coachz_ipa/coachz_ipa_cmd.c"
+#include "coachz_ipa/coachz_ipa_rx.c"
+#include "coachz_ipa/coachz_ipa_modem.c"
+#include "coachz_ipa/coachz_ipa_qmi.h"
+
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+extern int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+extern int sweet_rpmh_bcm_clock(const char *res, uint64_t hz);
+extern void sweet_smmu_ipa_stream(void);
+extern void IOSleep(unsigned);
+extern void sweet_bb_pdp_poll(void);
+
+/* the entry points SweetBaseband.inc and coachz_bb_pdp.cpp use */
+int sweet_ipa_enabled(void);
+void sweet_ipa_record(uint32_t type, uint32_t a, uint32_t b, uint32_t c, uint32_t d, const void *data, uint32_t len);
+void sweet_ipa_new_server(uint32_t service, uint32_t version_instance, uint32_t node, uint32_t port);
+uint32_t sweet_ipa_drain(uint8_t *buf, uint32_t room);
+int sweet_ipa_polling(void);
+void coachz_modem_data_receiver(void (*receiver)(uint32_t, const uint8_t *, uint32_t, uint32_t));
+int coachz_modem_data_send(uint32_t mux, const uint8_t *ip, uint32_t length);
+
+#define SI_DMA_PA        0xe4000000ull
+#define SI_RX_PA         (SI_DMA_PA + 0x000000ull)   /* LAN RX buffers, 2 MB */
+#define SI_RX_BYTES      0x200000u
+#define SI_RING_PA       (SI_DMA_PA + 0x200000ull)   /* GSI rings, 64 KB; the command ring at +0xc000 */
+#define SI_RING_BYTES    0x10000u
+#define SI_CMD_OFFSET    0xc000u
+#define SI_CMD_BYTES     0x4000u
+#define SI_ZERO_PA       (SI_DMA_PA + 0x210000ull)   /* zeroed bytes for ipa_mem_zero, 8 KB */
+#define SI_ZERO_BYTES    0x2000u
+#define SI_MODEM_RX_PA   (SI_DMA_PA + 0x400000ull)   /* modem RX buffers, 2 MB */
+#define SI_MODEM_RX_BYTES 0x200000u
+#define SI_MODEM_TX_PA   (SI_DMA_PA + 0x600000ull)   /* modem TX buffers, 1 MB */
+#define SI_MODEM_TX_BYTES 0x100000u
+#define SI_CORE_HZ       100000000ull                /* ipa_data-v4.2.c core_clock_rate */
+
+enum { SI_OFF, SI_CONFIGURED, SI_SET_UP };
+enum { SI_REC_CONFIGURE = 7, SI_REC_FW_LOADED = 8, SI_REC_STARTING = 9, SI_REC_QMI_IN = 10, SI_REC_QMI_OUT = 11, SI_REC_STATUS = 12 };
+
+static LCK_GRP_DECLARE(si_lck_grp, "sweet-ipa");
+static LCK_MTX_DECLARE(si_mtx, &si_lck_grp);
+
+static int si_enabled = -1;
+static int si_state;
+static struct coachz_ipa si_ipa;
+static struct coachz_gsi si_gsi;
+static struct coachz_ipa_cmd si_cmd;
+static struct coachz_ipa_rx si_lan, si_modem_rx;
+static struct coachz_ipa_modem si_modem;
+static int si_modem_open;
+static void (*si_data_rx)(uint32_t, const uint8_t *, uint32_t, uint32_t);
+static struct ci_handshake si_hs;
+static uint32_t si_modem_node, si_modem_port, si_peer_node, si_peer_port;
+static int si_modem_known, si_peer_known, si_init_driver_sent, si_thread_started;
+static uint16_t si_txn;
+static volatile uint64_t si_activity;   /* bumped when packets move: the poll thread runs fast */
+
+/* records for wland (11, 12): a small ring of copies, drained by sweet_ipa_drain under si_mtx */
+#define SI_OUTQ 16u
+struct si_out { uint32_t type, a, b, c, len; uint8_t data[CI_INIT_DRIVER_REQ_MAX + 32]; };
+static struct si_out si_outq[SI_OUTQ];
+static uint32_t si_out_head, si_out_count, si_out_dropped;
+
+int
+sweet_ipa_enabled(void)
+{
+	if (si_enabled < 0) {
+		int on = 0;
+		PE_parse_boot_argn("sweetipa", &on, sizeof(on));
+		si_enabled = on ? 1 : 0;
+	}
+	return si_enabled;
+}
+
+static void
+si_queue(uint32_t type, uint32_t a, uint32_t b, uint32_t c, const void *data, uint32_t len)
+{
+	if (si_out_count == SI_OUTQ || len > sizeof(si_outq[0].data)) {
+		si_out_dropped++;
+		return;
+	}
+	struct si_out *o = &si_outq[(si_out_head + si_out_count++) % SI_OUTQ];
+	o->type = type; o->a = a; o->b = b; o->c = c; o->len = len;
+	if (len) __builtin_memcpy(o->data, data, len);
+}
+
+static void
+si_status(uint32_t stage, int result)
+{
+	si_queue(SI_REC_STATUS, stage, (uint32_t)result, 0, NULL, 0);
+}
+
+/* upstream's send callback: an IPA QMI body from our client (1) or server (0) port to node:port; wland sends it */
+static int
+si_send(int client, uint32_t node, uint32_t port, const void *message, uint32_t length)
+{
+	const uint32_t before = si_out_dropped;
+	si_queue(SI_REC_QMI_OUT, client ? 1u : 0u, node, port, message, length);
+	return si_out_dropped != before ? ENOSPC : 0;
+}
+
+/* ---------------------------------------------------------------- data entry points (coachz_bb_pdp.cpp) */
+static void
+si_data_deliver(void *context, uint32_t mux, const uint8_t *ip, uint32_t length, uint32_t ip_version)
+{
+	(void)context;
+	si_activity++;
+	if (si_data_rx) si_data_rx(mux, ip, length, ip_version);
+}
+void
+coachz_modem_data_receiver(void (*receiver)(uint32_t, const uint8_t *, uint32_t, uint32_t))
+{
+	si_data_rx = receiver;
+}
+int
+coachz_modem_data_send(uint32_t mux, const uint8_t *ip, uint32_t length)
+{
+	if (!si_modem_open) return ENETDOWN;
+	lck_mtx_lock(&si_mtx);
+	const int result = si_modem_open ? coachz_ipa_modem_xmit(&si_modem, mux, ip, length) : -ENETDOWN;
+	lck_mtx_unlock(&si_mtx);
+	if (!result) si_activity++;
+	return result < 0 ? -result : result;
+}
+
+/* ---------------------------------------------------------------- the steps (si_mtx held) */
+static uint32_t
+si_channel_state(uint32_t id)
+{
+	return cgs_state(gsi_rd(&si_gsi, CGSI_CH_C_CNTXT_0 + id * CGSI_CH_C_CNTXT_0_STRIDE));
+}
+
+static void si_thread(void *arg, wait_result_t wr);
+
+/* record 7: power, SMMU, then mainline's ipa_config and the rings Linux allocates at probe (coachz_modem_configure) */
+static int
+si_configure(void)
+{
+	if (si_state != SI_OFF) return 0;
+	const int clk = sweet_rpmh_bcm_clock("IP0", SI_CORE_HZ);
+	const int sn11 = sweet_rpmh_bcm_vote("SN11", 1, 1), sn0 = sweet_rpmh_bcm_vote("SN0", 1, 1), cn0 = sweet_rpmh_bcm_vote("CN0", 1, 1);
+	printf("SWEET IPA: votes IP0 %d SN11 %d SN0 %d CN0 %d\n", clk, sn11, sn0, cn0);
+	if (clk) {
+		printf("SWEET IPA: no core clock: the IPA registers are not touched, cellular data stays off\n");
+		return EIO;
+	}
+	sweet_smmu_ipa_stream();
+	void *zero = (void *)ml_io_map_wcomb((vm_offset_t)SI_ZERO_PA, SI_ZERO_BYTES);
+	uint8_t *ring = (uint8_t *)ml_io_map_wcomb((vm_offset_t)SI_RING_PA, SI_RING_BYTES);
+	void *rx = (void *)ml_io_map_wcomb((vm_offset_t)SI_RX_PA, SI_RX_BYTES);
+	if (!zero || !ring || !rx) {
+		printf("SWEET IPA: no DMA mappings\n");
+		return ENOMEM;
+	}
+	__builtin_memset(ring, 0, SI_RING_BYTES);
+	int err = coachz_ipa_config(&si_ipa, zero, SI_ZERO_PA, NULL);
+	if (!err) err = coachz_gsi_init(&si_gsi, si_ipa.gsi, ring, SI_RING_PA, SI_RING_BYTES);
+	if (!err) err = coachz_ipa_cmd_init(&si_cmd, &si_ipa, &si_gsi, ring + SI_CMD_OFFSET, SI_RING_PA + SI_CMD_OFFSET, SI_CMD_BYTES);
+	if (!err) err = coachz_ipa_rx_init(&si_lan, &si_ipa, &si_gsi, CIPA_EP_AP_LAN_RX, rx, SI_RX_PA, SI_RX_BYTES);
+	if (err) {
+		printf("SWEET IPA: configuration failed (%d), cellular data stays off\n", err);
+		return err < 0 ? -err : err;
+	}
+	si_state = SI_CONFIGURED;
+	if (!si_thread_started) {
+		thread_t t = THREAD_NULL;
+		if (kernel_thread_start(si_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+			si_thread_started = 1;
+		}
+	}
+	printf("SWEET IPA: configured; GSI firmware next (wland, PAS 15)\n");
+	return 0;
+}
+
+static void
+si_init_driver(void)
+{
+	uint8_t message[CI_INIT_DRIVER_REQ_MAX];
+	if (si_state != SI_SET_UP || !si_modem_known || si_init_driver_sent) return;
+	const size_t length = ci_init_driver_req(message, sizeof message, ++si_txn, si_ipa.mem_offset, si_ipa.uc_loaded);
+	const int result = length ? si_send(1, si_modem_node, si_modem_port, message, (uint32_t)length) : -1;
+	si_init_driver_sent = !result;
+	printf("SWEET IPA: INIT_DRIVER %u bytes to %u:0x%x, mem_offset 0x%x, uc_loaded %d, queued %d\n", (unsigned)length, si_modem_node,
+	    si_modem_port, si_ipa.mem_offset, si_ipa.uc_loaded, result);
+}
+
+/* record 8: the GSI firmware runs; the rest of ipa_setup (coachz_modem_setup) */
+static int
+si_setup(void)
+{
+	if (si_state != SI_CONFIGURED) {
+		printf("SWEET IPA: firmware loaded, but the IPA is not configured\n");
+		return EINVAL;
+	}
+	int err = coachz_gsi_setup(&si_gsi);
+	if (!err) err = coachz_ipa_setup_commands(&si_cmd);
+	if (!err) err = coachz_ipa_setup_lan_rx(&si_lan);
+	if (err) {
+		printf("SWEET IPA: setup failed (%d), cellular data stays off\n", err);
+		si_state = SI_OFF;
+		return err < 0 ? -err : err;
+	}
+	si_state = SI_SET_UP;
+	ci_setup(&si_hs);
+	printf("SWEET IPA: set up; waiting for the modem's IPA service\n");
+	si_init_driver();
+	return 0;
+}
+
+/* ipa_modem_start and opening rmnet_ipa0 (cm_modem_start) */
+static void
+si_modem_start(void)
+{
+	void *rx = (void *)ml_io_map_wcomb((vm_offset_t)SI_MODEM_RX_PA, SI_MODEM_RX_BYTES);
+	void *tx = (void *)ml_io_map_wcomb((vm_offset_t)SI_MODEM_TX_PA, SI_MODEM_TX_BYTES);
+	int err = !rx || !tx ? -1 : coachz_ipa_rx_init(&si_modem_rx, &si_ipa, &si_gsi, CIPA_EP_AP_MODEM_RX, rx, SI_MODEM_RX_PA, SI_MODEM_RX_BYTES);
+	if (!err) err = coachz_ipa_modem_init(&si_modem, &si_ipa, &si_gsi, &si_modem_rx, tx, SI_MODEM_TX_PA, SI_MODEM_TX_BYTES);
+	if (!err) err = coachz_ipa_modem_start(&si_modem);
+	if (!err) err = coachz_ipa_modem_open(&si_modem);
+	if (err) {
+		printf("SWEET IPA: modem data path failed (%d); voice and Wi-Fi go on without it\n", err);
+		return;
+	}
+	for (uint32_t mux = 1; mux <= 4; mux++) coachz_ipa_modem_mux_add(&si_modem, mux);
+	si_modem.mux_deliver = si_data_deliver;
+	si_modem_open = 1;
+	printf("SWEET IPA: modem endpoints open, channel states TX 0:%u RX 3:%u; pdp_ip0..3 = mux 1..4\n", si_channel_state(0),
+	    si_channel_state(3));
+}
+
+static void
+si_step(void)
+{
+	for (;;) {
+		const struct ci_step step = ci_ready_step(&si_hs);
+		if (step.send_init_complete) {
+			uint8_t message[32];
+			const size_t length = ci_init_complete_ind(message, sizeof message, ++si_txn);
+			const int sent = si_peer_known && length && !si_send(0, si_peer_node, si_peer_port, message, (uint32_t)length);
+			printf("SWEET IPA: INIT_COMPLETE %s\n", sent ? "queued" : "not sent");
+			if (!sent) return;
+			ci_indication_sent(&si_hs);
+			continue;
+		}
+		if (step.start_modem && !si_modem_open) {
+			printf("SWEET IPA: handshake complete, starting the modem endpoints\n");
+			si_modem_start();
+		}
+		return;
+	}
+}
+
+static void
+si_qmi(int client, uint32_t node, uint32_t port, const void *body, uint32_t length)
+{
+	struct ci_msg m;
+	if (!ci_parse(body, length, &m)) {
+		printf("SWEET IPA: bad QMI message of %u bytes from %u:0x%x\n", length, node, port);
+		return;
+	}
+	if (client) {
+		struct ci_init_driver_rsp r;
+		if (!ci_init_driver_rsp_parse(&m, &r)) {
+			printf("SWEET IPA: QMI type %u message 0x%x on the client port\n", m.type, m.id);
+			return;
+		}
+		printf("SWEET IPA: INIT_DRIVER answer: ok %d error %u, ctrl %d/%u default %d/%u pending %d/%u\n", r.ok, r.error, r.has_ctrl,
+		    r.ctrl_end_pt, r.has_default, r.default_end_pt, r.has_pending, r.pending);
+		if (r.ok) ci_on_init_driver_success(&si_hs);
+	} else {
+		uint8_t message[32];
+		const int known = m.type == CI_QMI_REQUEST && (m.id == CI_INDICATION_REGISTER || m.id == CI_DRIVER_INIT_COMPLETE);
+		printf("SWEET IPA: QMI type %u message 0x%x from %u:0x%x%s\n", m.type, m.id, node, port, known ? "" : ", not handled");
+		if (!known) return;
+		si_peer_node = node;
+		si_peer_port = port;
+		si_peer_known = 1;
+		const size_t size = ci_success_rsp(message, sizeof message, m.txn, m.id);
+		if (!size || si_send(0, node, port, message, (uint32_t)size)) {
+			printf("SWEET IPA: response to 0x%x not queued\n", m.id);
+			return;
+		}
+		if (m.id == CI_INDICATION_REGISTER) ci_on_indication_register_answered(&si_hs);
+		else ci_on_driver_init_complete_answered(&si_hs);
+	}
+	si_step();
+}
+
+/* the interrupts coachz_modem_poll handles: SPI ipa-irq, gsi-irq and the RX/TX event rings, polled */
+static void
+si_poll_locked(void)
+{
+	if (si_state == SI_OFF) return;
+	coachz_ipa_interrupt(&si_ipa);
+	if (si_state != SI_SET_UP) return;
+	coachz_gsi_interrupt(&si_gsi);
+	if (si_gsi.ieob_pending & (1u << si_lan.evt_ring)) {
+		si_gsi.ieob_pending &= ~(1u << si_lan.evt_ring);
+		coachz_ipa_rx_poll(&si_lan);
+	}
+	if (!si_modem_open) return;
+	if (si_gsi.ieob_pending & (1u << si_modem_rx.evt_ring)) {
+		si_gsi.ieob_pending &= ~(1u << si_modem_rx.evt_ring);
+		if (coachz_ipa_rx_poll(&si_modem_rx)) si_activity++;
+	}
+	if (si_gsi.ieob_pending & (1u << si_modem.tx_evt_ring)) {
+		si_gsi.ieob_pending &= ~(1u << si_modem.tx_evt_ring);
+		coachz_ipa_modem_tx_poll(&si_modem);
+	}
+}
+
+static void
+si_report(unsigned second)
+{
+	printf("SWEET IPA: %u s: state %d uc_loaded %d modem_ready %d uc_ready %d indication %d/%d, LAN RX %llu/%llu/%llu, out dropped %u\n",
+	    second, si_state, si_ipa.uc_loaded, si_hs.modem_ready, si_hs.uc_ready, si_hs.indication_requested, si_hs.indication_sent,
+	    si_lan.packets, si_lan.delivered, si_lan.dropped, si_out_dropped);
+	if (si_modem_open)
+		printf("SWEET IPA: %u s: channels TX 0:%u RX 3:%u, modem RX %llu delivered %llu dropped %llu, TX %llu\n", second,
+		    si_channel_state(0), si_channel_state(3), si_modem_rx.packets, si_modem_rx.delivered, si_modem_rx.dropped, si_modem.tx_packets);
+}
+
+static void
+si_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	uint64_t last_activity = 0, quiet_rounds = 0, next_report = 0;
+	for (;;) {
+		lck_mtx_lock(&si_mtx);
+		si_poll_locked();
+		uint64_t now_s = 0;
+		{
+			uint64_t ns = 0;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			now_s = ns / 1000000000ull;
+		}
+		if (now_s >= next_report) {
+			if (next_report) si_report((unsigned)now_s);
+			next_report = now_s + 30;
+		}
+		lck_mtx_unlock(&si_mtx);
+		sweet_bb_pdp_poll();   /* pdp_ip output queues -> coachz_modem_data_send; never under si_mtx */
+		if (si_activity != last_activity) {
+			last_activity = si_activity;
+			quiet_rounds = 0;
+		} else {
+			quiet_rounds++;
+		}
+		IOSleep(quiet_rounds < 100 ? 1 : 10);
+	}
+}
+
+/* ---------------------------------------------------------------- /dev/sweet-bb */
+void
+sweet_ipa_record(uint32_t type, uint32_t a, uint32_t b, uint32_t c, uint32_t d, const void *data, uint32_t len)
+{
+	(void)d;
+	if (type < SI_REC_CONFIGURE || type > SI_REC_QMI_IN) return;
+	lck_mtx_lock(&si_mtx);
+	if (!sweet_ipa_enabled()) {
+		if (type == SI_REC_CONFIGURE) {
+			printf("SWEET IPA: off (boot-arg sweetipa=1 turns the cellular data path on)\n");
+			si_status(type, ENODEV);
+		}
+		lck_mtx_unlock(&si_mtx);
+		return;
+	}
+	switch (type) {
+	case SI_REC_CONFIGURE:
+		si_status(type, si_configure());
+		break;
+	case SI_REC_FW_LOADED:
+		if (a) {
+			printf("SWEET IPA: wland could not load the GSI firmware (%d), cellular data stays off\n", (int)a);
+			si_state = SI_OFF;
+			si_status(type, (int)a);
+			break;
+		}
+		si_status(type, si_setup());
+		break;
+	case SI_REC_STARTING:
+		if (si_state != SI_OFF) coachz_ipa_modem_starting(&si_ipa);
+		break;
+	case SI_REC_QMI_IN:
+		if (si_state != SI_OFF) si_qmi(a != 0, b, c, data, len);
+		break;
+	}
+	lck_mtx_unlock(&si_mtx);
+}
+
+/* QRTR NEW_SERVER, whichever order it comes in relative to the setup (coachz_modem_new_server) */
+void
+sweet_ipa_new_server(uint32_t service, uint32_t version_instance, uint32_t node, uint32_t port)
+{
+	if (!ci_is_modem_service(service, version_instance >> 8)) return;
+	lck_mtx_lock(&si_mtx);
+	si_modem_node = node;
+	si_modem_port = port;
+	si_modem_known = 1;
+	printf("SWEET IPA: modem IPA service at %u:0x%x\n", node, port);
+	si_init_driver();
+	lck_mtx_unlock(&si_mtx);
+}
+
+/* 1 once the poll thread drains the pdp_ip queues (SweetBaseband.inc then leaves bb_pdp_poll to it) */
+int
+sweet_ipa_polling(void)
+{
+	return si_thread_started;
+}
+
+/* records 11 and 12 for wland, little endian: u32 type, a, b, c, 0, len, then len bytes padded to 4 */
+uint32_t
+sweet_ipa_drain(uint8_t *buf, uint32_t room)
+{
+	uint32_t at = 0;
+	lck_mtx_lock(&si_mtx);
+	while (si_out_count) {
+		struct si_out *o = &si_outq[si_out_head];
+		const uint32_t padded = (o->len + 3u) & ~3u;
+		if (at + 24u + padded > room) break;
+		const uint32_t w[6] = { o->type, o->a, o->b, o->c, 0, o->len };
+		__builtin_memcpy(buf + at, w, 24);
+		if (o->len) __builtin_memcpy(buf + at + 24, o->data, o->len);
+		for (uint32_t i = o->len; i < padded; i++) buf[at + 24 + i] = 0;
+		at += 24u + padded;
+		si_out_head = (si_out_head + 1) % SI_OUTQ;
+		si_out_count--;
+	}
+	lck_mtx_unlock(&si_mtx);
+	return at;
+}
