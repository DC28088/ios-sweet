+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 ios-sweet contributors
+ *
+ * Original portable implementation of the public A6xx PM4 wire format and
+ * SDM7150 CX GDSC sequence. References and limitations: docs/adreno-port.md.
+ * No Linux DRM or Mesa rendering implementation is included in this file.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno.h"
+
+#define CX_GDSCR 0x106cu
+#define CX_STATUS 0x1540u
+#define COLLAPSE 1u
+#define HW_CONTROL 2u
+#define POWER_ON 0x80000000u
+
+int
+a618_enable_cx(const struct a618_io *io, struct a618_power_result *result)
+{
+	uint32_t control, status;
+	if (!io || !result || !io->read || !io->write || !io->delay_us)
+		return EINVAL;
+	result->waited_us = 0;
+	control = result->control = io->read(io->cookie, CX_GDSCR);
+	status = result->status = io->read(io->cookie, CX_STATUS);
+	if (control == 0xffffffffu || status == 0xffffffffu)
+		return EIO;
+	if (control & HW_CONTROL)
+		return EBUSY;
+	/* This call does not reset an already powered domain. */
+	if (!(control & COLLAPSE) && (status & POWER_ON))
+		return 0;
+	/* Live DT: qcom,clk-dis-wait-val = 8; preserve all other fields. */
+	control = (control & ~(0xfu << 12)) | (8u << 12);
+	io->write(io->cookie, CX_GDSCR, control & ~COLLAPSE);
+	/* Qualcomm gdsc_enable: allow at least eight XO cycles before polling. */
+	io->delay_us(io->cookie, 1);
+	for (unsigned elapsed = 0; elapsed < 500; ++elapsed) {
+		result->waited_us = elapsed + 1;
+		status = result->status = io->read(io->cookie, CX_STATUS);
+		if (status == 0xffffffffu)
+			return EIO;
+		if (status & POWER_ON) {
+			/* Clock re-enable/memory power-up settling from gdsc_enable. */
+			io->delay_us(io->cookie, 2);
+			result->control = io->read(io->cookie, CX_GDSCR);
+			if (result->control == 0xffffffffu ||
+			    (result->control & (COLLAPSE | HW_CONTROL)))
+				return EIO;
+			return 0;
+		}
+		io->delay_us(io->cookie, 1);
+	}
+	result->control = io->read(io->cookie, CX_GDSCR);
+	/* Do not attempt a power-down after uncertain hardware completion. */
+	return ETIMEDOUT;
+}
+
+/* A6xx uses odd parity for the payload length and opcode/register fields. */
+static uint32_t
+odd_parity(uint32_t value)
+{
+	unsigned parity = 1;
+	while (value) {
+		parity ^= value & 1u;
+		value >>= 1;
+	}
+	return parity;
+}
+
+static int
+reserve(const struct a618_commands *commands, unsigned count)
+{
+	if (!commands || !commands->words || commands->used > commands->capacity)
+		return EINVAL;
+	if (count > commands->capacity - commands->used)
+		return ENOSPC;
+	return 0;
+}
+
+static uint32_t
+packet7(unsigned opcode, unsigned count)
+{
+	return 0x70000000u | count | (odd_parity(count) << 15) |
+	    (opcode << 16) | (odd_parity(opcode) << 23);
+}
+
+int
+a618_emit_reg_write(struct a618_commands *commands, uint32_t reg, uint32_t value)
+{
+	int error;
+	/* Register indices are DWORD indices, not byte offsets. */
+	if (reg > 0x3ffffu)
+		return EINVAL;
+	error = reserve(commands, 2);
+	if (error)
+		return error;
+	commands->words[commands->used++] = 0x40000001u | (reg << 8) |
+	    (odd_parity(reg) << 27); /* count=1 has odd parity already */
+	commands->words[commands->used++] = value;
+	return 0;
+}
+
+int
+a618_emit_memory_write(struct a618_commands *commands, uint64_t iova, uint32_t value)
+{
+	int error;
+	if ((iova & 3u) || iova >= (1ull << 49))
+		return EINVAL;
+	error = reserve(commands, 4);
+	if (error)
+		return error;
+	commands->words[commands->used++] = packet7(0x3d, 3); /* CP_MEM_WRITE */
+	commands->words[commands->used++] = (uint32_t)iova;
+	commands->words[commands->used++] = (uint32_t)(iova >> 32);
+	commands->words[commands->used++] = value;
+	return 0;
+}
+
+int
+a618_emit_fence(struct a618_commands *commands, uint64_t iova, uint32_t sequence)
+{
+	int error;
+	if ((iova & 3u) || iova >= (1ull << 49))
+		return EINVAL;
+	error = reserve(commands, 5);
+	if (error)
+		return error;
+	commands->words[commands->used++] = packet7(0x46, 4); /* CP_EVENT_WRITE */
+	/* CACHE_FLUSH_TS + IRQ, same event used by MSM a6xx_submit(). */
+	commands->words[commands->used++] = 4u | (1u << 31);
+	commands->words[commands->used++] = (uint32_t)iova;
+	commands->words[commands->used++] = (uint32_t)(iova >> 32);
+	commands->words[commands->used++] = sequence;
+	return 0;
+}
+
+int
+a618_ring_init(struct a618_ring *ring, uint32_t *words, unsigned size,
+    void *cookie, int (*read_rptr)(void *, unsigned *),
+    int (*publish)(void *, unsigned))
+{
+	/* A6xx ring length is a power of two. Keep one slot empty. The
+	 * hardware must already be configured for this length and RPTR=WPTR=0.
+	 */
+	if (!ring || !words || size < 2 || (size & (size - 1)) ||
+	    size > 0x100000u || !read_rptr || !publish)
+		return EINVAL;
+	ring->words = words;
+	ring->size = size;
+	ring->wptr = 0;
+	ring->poisoned = 0;
+	ring->cookie = cookie;
+	ring->read_rptr = read_rptr;
+	ring->publish = publish;
+	return 0;
+}
+
+int
+a618_ring_submit(struct a618_ring *ring, const struct a618_commands *commands)
+{
+	unsigned rptr, available, next;
+	int error;
+	if (!ring || !ring->words || !ring->read_rptr || !ring->publish ||
+	    ring->size < 2 || (ring->size & (ring->size - 1)) ||
+	    ring->wptr >= ring->size || !commands || !commands->words ||
+	    !commands->used || commands->used > commands->capacity)
+		return EINVAL;
+	if (ring->poisoned)
+		return EIO;
+	if (commands->used >= ring->size)
+		return ENOSPC;
+	error = ring->read_rptr(ring->cookie, &rptr);
+	if (error || rptr >= ring->size) {
+		ring->poisoned = 1;
+		return error ? error : EIO;
+	}
+	available = (rptr - ring->wptr - 1) & (ring->size - 1);
+	if (commands->used > available)
+		return EAGAIN; /* Caller may retry with a deadline, never busy-spin. */
+	next = ring->wptr;
+	for (unsigned i = 0; i < commands->used; ++i) {
+		ring->words[next] = commands->words[i];
+		next = (next + 1) & (ring->size - 1);
+	}
+	error = ring->publish(ring->cookie, next);
+	if (error) {
+		ring->poisoned = 1;
+		return error;
+	}
+	ring->wptr = next;
+	return 0;
+}
