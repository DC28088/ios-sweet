+/* SPDX-License-Identifier: MIT
+ * SWEET A618 hardware core. See docs/adreno-port.md for provenance/status.
+ */
+#ifndef SWEET_ADRENO_H
+#define SWEET_ADRENO_H
+#if defined(KERNEL)
+#include <sys/types.h>
+#else
+#include <stdint.h>
+#endif
+
+/* All offsets passed to these callbacks are GPUCC byte offsets.
+ * write() must order prior stores and complete the MMIO store before return.
+ * The caller serializes device operations and keeps the rails voted on.
+ */
+struct a618_io {
+	void *cookie;
+	uint32_t (*read)(void *, uint32_t);
+	void (*write)(void *, uint32_t, uint32_t);
+	void (*delay_us)(void *, unsigned);
+};
+struct a618_power_result {
+	uint32_t control;
+	uint32_t status;
+	unsigned waited_us;
+};
+int a618_enable_cx(const struct a618_io *, struct a618_power_result *);
+
+/* CPU-side PM4 builder. No allocation, MMIO, firmware loading or submission.
+ * Caller supplies private, writable storage and owns all referenced IOVAs.
+ * A failed append leaves both the buffer and used count unchanged.
+ */
+struct a618_commands {
+	uint32_t *words;
+	unsigned capacity;
+	unsigned used;
+};
+int a618_emit_reg_write(struct a618_commands *, uint32_t, uint32_t);
+int a618_emit_memory_write(struct a618_commands *, uint64_t, uint32_t);
+int a618_emit_fence(struct a618_commands *, uint64_t, uint32_t);
+
+/* Single producer ring transport. Caller holds its device lock for init and
+ * submit, supplies coherent memory (or syncs it in publish), and guarantees
+ * CP/SQE, SMMU, power and clocks are initialized before attaching this ring.
+ * publish synchronizes the ENTIRE ring for DMA, orders writes, then writes
+ * CP_RB_WPTR. A failure poisons the ring: hardware ownership is uncertain.
+ * This API accepts trusted kernel-built packets only, never userspace PM4.
+ */
+struct a618_ring {
+	uint32_t *words;
+	unsigned size;
+	unsigned wptr;
+	int poisoned;
+	void *cookie;
+	int (*read_rptr)(void *, unsigned *);
+	int (*publish)(void *, unsigned);
+};
+int a618_ring_init(struct a618_ring *, uint32_t *, unsigned, void *,
+    int (*)(void *, unsigned *), int (*)(void *, unsigned));
+int a618_ring_submit(struct a618_ring *, const struct a618_commands *);
+#endif
