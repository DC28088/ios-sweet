+ if(selector==NativeAdrenoMethodBoMap) {
+  static unsigned maps=0;
+  if(++maps<=4 || maps%256==0 || result)
+   IOLog("SWEET RENDER: map %u objects=%lu/4128 spans=%lu/%lu total_us=%llu result=%#x\n",maps,
+    (unsigned long)backend.vm->objectCount(),(unsigned long)backend.vm->spanCount(),
+    (unsigned long)backend.vm->spanCapacity(),backend.clock.now_us(backend.clock.cookie)-began,result);
+ }
  if(selector==NativeAdrenoMethodSubmitResources) {
   static unsigned submissions=0;
   if(++submissions<=8 || submissions%120==0) {
    const auto *request=static_cast<const NativeAdrenoAbiSubmitResources *>(args->structureInput);
-   IOLog("SWEET RENDER: scoped submit %u IBs=%u BOs=%u total_us=%llu result=%#x\n",submissions,
+   IOLog("SWEET RENDER: scoped submit %u IBs=%u BOs=%u total_us=%llu quiesce_us=%llu result=%#x\n",submissions,
      request->commands.buffer_count,request->resource_count,
-     backend.clock.now_us(backend.clock.cookie)-began,result);
+     backend.clock.now_us(backend.clock.cookie)-began,quiesce_us,result);
   }
  }
 
