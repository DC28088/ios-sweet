+#define SWEET_FB_REGION_LEN     0x1700000ULL    /* DT cont_splash_region@9c000000 */
+#define SWEET_VIG0_SRC_SIZE     (0x5000 + 0x00)
+#define SWEET_VIG0_SRC0_ADDR    (0x5000 + 0x14)
+#define SWEET_VIG0_YSTRIDE0     (0x5000 + 0x24)
+#define SWEET_CTL0_LAYER0       (0x2000 + 0x00)
+#define SWEET_CTL0_FLUSH        (0x2000 + 0x18)
+#define SWEET_CTL0_INTF_ACTIVE  (0x2000 + 0xf4)
+/* Linux dpu_hw_ctl.c: SSPP_VIG0 BIT(0), LM_0 BIT(6), CTL BIT(17) (added with every mixer flush). */
+#define SWEET_FLIP_FLUSH_BITS   ((1u << 0) | (1u << 6) | (1u << 17))
+#define SWEET_FLIP_TIMEOUT_US   34000   /* four 120 Hz frames */
+
+/* Runs once on the present thread. Checks that ABL's pipeline is exactly the one
+ * 0180 recorded (VIG0 -> LM0 -> CTL0 -> INTF_1 scanning fPhys) before touching it. */
+bool
+AppleCLCD::flipSetup(void)
+{
+	int on = 0;
+	PE_parse_boot_argn("sweetfbflip", &on, sizeof(on));
+	if (!on) {
+		return false;
+	}
+	fMdp = (volatile uint32_t *)ml_io_map(SWEET_MDP_PA, SWEET_MDP_LEN);
+	if (fMdp == NULL) {
+		IOLog("SWEET FLIP: off: MDP map failed\n");
+		return false;
+	}
+	const uint32_t addr = fMdp[SWEET_VIG0_SRC0_ADDR / 4], size = fMdp[SWEET_VIG0_SRC_SIZE / 4];
+	const uint32_t stride = fMdp[SWEET_VIG0_YSTRIDE0 / 4] & 0xffff, layer = fMdp[SWEET_CTL0_LAYER0 / 4];
+	const uint32_t intf = fMdp[SWEET_CTL0_INTF_ACTIVE / 4], flush = fMdp[SWEET_CTL0_FLUSH / 4];
+	if (addr != (uint32_t)fPhys || size != ((fHeight << 16) | fWidth) || stride != fRowBytes ||
+	    (layer & 7) == 0 || intf == 0 || flush != 0 || fPhys >> 32) {
+		IOLog("SWEET FLIP: off: pipeline differs (vig0 addr %#x size %#x stride %#x, ctl0 layer %#x intf %#x flush %#x)\n",
+		    addr, size, stride, layer, intf, flush);
+		return false;
+	}
+	const uint64_t bytes = ((uint64_t)fRowBytes * fHeight + 0xffff) & ~0xffffULL;
+	const uint64_t back = fPhys + bytes;
+	if (back + bytes > fPhys + SWEET_FB_REGION_LEN || (back + bytes) >> 32) {
+		IOLog("SWEET FLIP: off: no room for a back buffer (%#llx bytes)\n", bytes);
+		return false;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(back, bytes, kIODirectionInOut);
+	fBufMap = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);
+	if (fBufMap == NULL || fBufMap->getVirtualAddress() == 0) {
+		OSSafeReleaseNULL(fBufMap);
+		IOLog("SWEET FLIP: off: back buffer map failed\n");
+		return false;
+	}
+	fBufPhys[0] = fPhys;
+	fBufVA[0] = fPixels;
+	fBufPhys[1] = back;
+	fBufVA[1] = (uintptr_t)fBufMap->getVirtualAddress();
+	memcpy((void *)fBufVA[1], (const void *)fBufVA[0], (size_t)fRowBytes * fHeight);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fScan = 0;
+	fFlipPending = false;
+	IOLog("SWEET FLIP: on: buffers %#llx %#llx (%#llx bytes), vig0 -> ctl0 flush %#x\n",
+	    fBufPhys[0], fBufPhys[1], bytes, SWEET_FLIP_FLUSH_BITS);
+	return true;
+}
