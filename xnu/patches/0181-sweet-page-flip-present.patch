+/* The CPU is about to write the buffer that is not fScan: the previous flip must
+ * have been latched, otherwise that buffer may still be on screen. */
+bool
+AppleCLCD::flipWait(void)
+{
+	if (!fFlipPending) {
+		return true;
+	}
+	const uint64_t began = mach_absolute_time();
+	uint64_t ns = 0;
+	for (;;) {
+		if ((fMdp[SWEET_CTL0_FLUSH / 4] & SWEET_FLIP_FLUSH_BITS) == 0) {
+			break;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		if (ns > (uint64_t)SWEET_FLIP_TIMEOUT_US * 1000) {
+			fStatsFlipTimeouts++;
+			flipAbandon("flush not latched");
+			return false;
+		}
+		IODelay(100);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+	const uint64_t us = ns / NSEC_PER_USEC;
+	fFlipPending = false;
+	__atomic_add_fetch(&fStatsFlipWaitUs, us, __ATOMIC_RELAXED);
+	if (us > fStatsFlipWaitMaxUs) {
+		fStatsFlipWaitMaxUs = us;
+	}
+	return true;
+}
+
+void
+AppleCLCD::flipTo(unsigned idx)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");       /* write-combined frame reaches memory first */
+	fMdp[SWEET_VIG0_SRC0_ADDR / 4] = (uint32_t)fBufPhys[idx];
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fMdp[SWEET_CTL0_FLUSH / 4] = SWEET_FLIP_FLUSH_BITS;
+	fScan = idx;
+	fPixels = fBufVA[idx];          /* fade-out and band clears draw into what is shown */
+	fFlipPending = true;
+	__atomic_add_fetch(&fStatsFlips, 1, __ATOMIC_RELAXED);
+}
+
+/* Back to ABL's single buffer and the beam-raced copy. */
+void
+AppleCLCD::flipAbandon(const char *why)
+{
+	IOLog("SWEET FLIP: off: %s (flush %#x addr %#x); back to the single buffer\n",
+	    why, fMdp[SWEET_CTL0_FLUSH / 4], fMdp[SWEET_VIG0_SRC0_ADDR / 4]);
+	fFlip = false;
+	fFlipPending = false;
+	if (fScan != 0) {
+		memcpy((void *)fBufVA[0], (const void *)fBufVA[fScan], (size_t)fRowBytes * fHeight);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		fMdp[SWEET_VIG0_SRC0_ADDR / 4] = (uint32_t)fBufPhys[0];
+		__asm__ volatile ("dsb sy" ::: "memory");
+		fMdp[SWEET_CTL0_FLUSH / 4] = SWEET_FLIP_FLUSH_BITS;
+	}
+	fScan = 0;
+	fPixels = fBufVA[0];
+}
