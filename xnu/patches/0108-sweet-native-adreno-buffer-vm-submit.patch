+/* TLBIALL of the bank before a submission. Where a table update has observed the bank's image (each region's whole-verification
+ * update remembers its register offset), the invalidation alone: the image and faults were observed there and every 64th table
+ * operation since (int-159: a submission spent 1.3 ms in the kernel, most of it reading SMMU registers). */
+IOReturn NativeAdrenoVm::invalidateTlb()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    ArmSmmu4KProgramResult r;
+    uint64_t offset=0;
+    for(const auto &region:regions_)if(region.state && region.state->context_offset)offset=region.state->context_offset;
+    const ArmSmmu4KStatus status=offset?ArmSmmu4KSyncContextTlb(&io_,offset,context_->asid,1,budget_,&r):
+        ArmSmmu4KInvalidateAllOwnedContext(&io_,streams_->bank,context_,budget_,&r);
+    return status?fail(status):kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::publishMapped()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory)continue;
+        if(coherentMapping(m.writeback)) {native_adreno_coherent_skips[2]=native_adreno_coherent_skips[2]+1;continue;}
+        if(m.memory->publishForDevice(0,m.memory->bytes(),true,distrust_write_combined_))return fail(ArmSmmu4KIoError);
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::acquireImported()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || !m.memory->imported() || !(m.permissions&ArmSmmu4KWrite))continue;
+        if(coherentMapping(m.writeback)) {native_adreno_coherent_skips[3]=native_adreno_coherent_skips[3]+1;continue;}
+        if(m.memory->acquireDeviceWrites(0,m.memory->bytes()))return fail(ArmSmmu4KIoError);
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::sampleWord(uint64_t iova,uint32_t *cached,uint32_t *dram) const
+{
+    if(!cached || !dram)return kIOReturnBadArgument;
+    *cached=*dram=~0u;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(iova&3)return kIOReturnBadArgument;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        const size_t offset=(size_t)(iova-m.iova);
+        if(m.memory->mapping())*cached=static_cast<const volatile uint32_t *>(m.memory->mapping())[offset/4];
+        for(size_t j=0;j<m.memory->spanCount();++j) {
+            const auto &span=m.memory->spans()[j];
+            if(offset<span.offset || offset-span.offset>=span.bytes)continue;
+            uint32_t value=0;
+            /* DRAM first: the cached reader writes its line back, so read after it DRAM would always agree (int-099). */
+            if(native_adreno_dram_read32 && !native_adreno_dram_read32(span.physical+(offset-span.offset),&value))*dram=value;
+            /* A write-combined BO's own mapping is non-cacheable: read the cacheable alias instead, so a dirty line is still seen. */
+            if(native_adreno_cached_read32 && !native_adreno_cached_read32(span.physical+(offset-span.offset),&value))*cached=value;
+            break;
+        }
+        return kIOReturnSuccess;
+    }
+    return kIOReturnBadArgument;
+}
+IOReturn NativeAdrenoVm::reassertWriteCombined(uint32_t *reset) const
+{
+    if(!reset)return kIOReturnBadArgument;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory)continue;
+        const IOReturn status=m.memory->reassertWriteCombined(reset);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::auditRange(uint64_t iova,size_t bytes,uint32_t *lines,uint32_t *dirty,uint32_t *stale) const
+{
+    if(!lines || !dirty || !stale)return kIOReturnBadArgument;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!native_adreno_line_audit)return kIOReturnUnsupported;
+    if(!bytes || iova>UINT64_MAX-bytes)return kIOReturnBadArgument;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        if(!m.memory->writeCombined())return kIOReturnSuccess;   /* maintained before every submission anyway */
+        /* Whole lines; the range is clipped to its BO. */
+        size_t at=(size_t)(iova-m.iova)&~(size_t)63;
+        const size_t end=(size_t)(iova-m.iova)+bytes>m.memory->bytes()?m.memory->bytes():(size_t)(iova-m.iova)+bytes;
+        while(at<end) {
+            const NativeAdrenoPhysicalSpan *span=nullptr;
+            for(size_t j=0;j<m.memory->spanCount();++j) {
+                const auto &s=m.memory->spans()[j];
+                if(at>=s.offset && at-s.offset<s.bytes) {span=&s;break;}
+            }
+            if(!span)return kIOReturnBadArgument;
+            const uint64_t physical=span->physical+(at-span->offset);
+            size_t chunk=4096-(size_t)(physical&4095);
+            if(chunk>span->offset+span->bytes-at)chunk=span->offset+span->bytes-at;
+            if(chunk>end-at)chunk=(end-at+63)&~(size_t)63;
+            if(native_adreno_line_audit(physical,chunk,dirty,stale))return kIOReturnIOError;
+            *lines+=(uint32_t)(chunk/64);at+=chunk;
+        }
+        return kIOReturnSuccess;
+    }
+    return kIOReturnBadArgument;
+}
+IOReturn NativeAdrenoVm::peekWords(uint64_t iova,uint32_t *out,size_t count) const
+{
+    if(!out || !attached_ || poisoned_)return kIOReturnBadArgument;
+    for(size_t k=0;k<count;++k)out[k]=0;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || !m.memory->mapping() || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        const size_t offset=(size_t)(iova-m.iova);
+        for(size_t k=0;k<count && offset+4*k+4<=m.memory->bytes();++k)out[k]=static_cast<const volatile uint32_t *>(m.memory->mapping())[offset/4+k];
+        return kIOReturnSuccess;
+    }
+    return kIOReturnBadArgument;
+}
+IOReturn NativeAdrenoVm::holdJob(uint64_t handle)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Mapping *record=find(handle);if(!record)return kIOReturnBadArgument;
+    if(record->jobs==UINT32_MAX)return kIOReturnNoResources;
+    IOReturn status=record->memory->holdForDevice();if(status)return status;
+    ++record->jobs;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::retireJobAfterCompletion(uint64_t handle)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Mapping *record=find(handle);if(!record || !record->jobs)return kIOReturnBadArgument;
+    IOReturn status=record->memory->retireAfterQuiescence();if(status)return status;
+    --record->jobs;return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoVm.h b/iokit/Kernel/arm/unixnu/NativeAdrenoVm.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoVm.h
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_VM_H
+#define NATIVE_ADRENO_VM_H
+#include "NativeAdrenoSmmuMemory.h"
+#include "ArmSmmu4KStreams.h"
+struct NativeAdrenoVmRegion {
+    NativeAdrenoMemory *tables;
+    ArmSmmu4KLiveArena *arena;
+    ArmSmmu4KLiveState *state;
+};
+struct NativeAdrenoVmResult {
+    ArmSmmu4KStatus operation,quarantine;
+    size_t completed_spans;
+    bool complete;
+};
+/* Kernel-owned BO mapping transactions, not a userspace ABI or GPU scheduler.
+ * Attach only under the actual bank/ASID/stream and powered-MMIO lease, with
+ * fault IRQ handling installed and empty native4K arenas already active.
+ * The real table allocations, context/streams and BO objects remain retained
+ * by the owning driver. No implicit destructor cleanup; detach must succeed.
+ * Serialize all methods, table updates and submission under the DRIVER gate.
+ * ALL masters must stay genuinely quiesced through each map/unmap transaction.
+ * Job counts are lifetime accounting; neither they nor these APIs are fences.
+ * Each active region is audited, including the unmodified peer. Partial failure
+ * keeps every old/new BO reference, poisons both arenas and attempts to FAULT
+ * only the owned streams. Uncertain resources require independent real reset.
+ * No VM may be advertised to apps until per-client isolation, submission
+ * validation/protection, genuine IRQ fences and reset are implemented. */
+enum : size_t {NativeAdrenoVmMaxObjects=1024};
+/* Board hook for sampleWord(): reads one aligned word of physical memory through a fresh uncached mapping; 0 on success. */
+extern "C" int (*native_adreno_dram_read32)(uint64_t physical,uint32_t *value);
+/* The board's reader through the kernel's cacheable physical aperture (null on the host: the BO's own mapping is read). */
+extern "C" int (*native_adreno_cached_read32)(uint64_t physical,uint32_t *value);
+/* Board hook for auditRange(): [physical, physical+bytes), whole 64-byte lines inside one page, as the cacheable physical aperture and
+ * DRAM (a fresh uncached mapping) read it. A line that differs is cleaned and invalidated and DRAM read again: when DRAM then holds the
+ * cached copy the line was dirty (*dirty), when DRAM is unchanged it was a stale clean copy (*stale). 0 on success. */
+extern "C" int (*native_adreno_line_audit)(uint64_t physical,size_t bytes,uint32_t *dirty,uint32_t *stale);
+class NativeAdrenoVm final {
+    struct Mapping {
+        NativeAdrenoMemory *memory=nullptr;
+        uint64_t handle=0,iova=0;
+        size_t spans=0,mapped_spans=0;
+        unsigned permissions=0,writeback=0,shareability=0,jobs=0;
+    };
+    Mapping *mappings_=nullptr;
+    NativeAdrenoVmRegion regions_[2]{};
+    ArmSmmu4KLiveVisibility visibility_[2]{};
+    ArmSmmu4KIo io_{};
+    ArmSmmu4KContextConfig *context_=nullptr;
+    ArmSmmu4KStreamState *streams_=nullptr;
+    ArmSmmu4KRange *ranges_=nullptr;
+    size_t capacity_=0,lower_count_=0,upper_count_=0,objects_=0;
+    unsigned budget_=0;
+    uint64_t next_handle_=1;
+    bool attached_=false,poisoned_=false,distrust_write_combined_=false;
+    NativeAdrenoVmResult result_{};
+    ArmSmmu4KLiveRegion region(unsigned) const;
+    ArmSmmu4KStatus observe() const;
+    /* The route check alone: the table walk is the update's own (it verifies every region before the first store and after the last), so
+     * map/unmap pay a full extra audit only every 64th operation (int-139: 4 full walks of the 2 GiB aperture made every map 70 ms). */
+    ArmSmmu4KStatus observeStreamsOnly() const;
+    ArmSmmu4KStatus observeCheap();
+    unsigned since_audit_=0;
+    IOReturn fail(ArmSmmu4KStatus);
+    Mapping *find(uint64_t);
+    void insert(size_t,unsigned);
+    void erase(size_t,size_t,unsigned);
+    IOReturn preflight(const NativeAdrenoMemory *,unsigned,uint64_t,unsigned,unsigned,unsigned) const;
+public:
+    NativeAdrenoVm()=default;
+    ~NativeAdrenoVm()=default;
+    NativeAdrenoVm(const NativeAdrenoVm &)=delete;
+    NativeAdrenoVm &operator=(const NativeAdrenoVm &)=delete;
+    IOReturn attach(const ArmSmmu4KIo *,ArmSmmu4KContextConfig *,ArmSmmu4KStreamState *,
+        const NativeAdrenoVmRegion *lower,const NativeAdrenoVmRegion *upper,
+        size_t max_spans,unsigned poll_budget);
+    /* Frees CPU metadata only, with no BOs remaining. Never releases roots,
+     * disables a bank or returns the platform lease; board lifecycle owns it. */
+    IOReturn detach();
+    IOReturn findAddress(unsigned upper,size_t bytes,uint64_t alignment,uint64_t *iova) const;
+    IOReturn map(NativeAdrenoMemory *,unsigned upper,uint64_t iova,
+        unsigned permissions,unsigned writeback,unsigned shareability,uint64_t *handle);
+    IOReturn unmap(uint64_t handle);
+    IOReturn holdJob(uint64_t handle);
+    /* TLBIALL for the context bank plus TLBSYNC: drops every cached translation of the bank whatever its ASID. Unmap already
+     * synchronizes by ASID; this is the stronger form the submit path uses before each submission (int-070: on sheng the CP read
+     * zeros from an IB whose table entry and DRAM were both correct, after the address had been mapped to other pages before). */
+    IOReturn invalidateTlb();
+    /* Cleans and invalidates the CPU caches over every mapped BO (whole objects; imported ones through their physical pages), so
+     * no CPU cache line can hold data the GPU should see or hide what it wrote. Lines are physically tagged, so this also reaches
+     * lines a user mapping of the same pages left behind. int-070 runs it before every submission. */
+    IOReturn publishMapped();
+    /* The submit path saw a CPU-cached word that DRAM did not hold yet in a client's BO: from now on write-combined BOs are maintained
+     * like any other (sticky; the safe behaviour of int-070..097). */
+    void distrustWriteCombined() {distrust_write_combined_=true;}
+    bool writeCombinedTrusted() const {return !distrust_write_combined_;}
+    /* After a submission completed: cleans and invalidates the CPU caches over every GPU-writable imported BO, so the owner's mapping
+     * (an IOSurface) reads what the GPU wrote, not a line prefetched while the GPU ran. Jobs name only their IBs, so every such BO
+     * is covered. int-071: an imported render target read back 672 of 4096 texels stale. */
+    IOReturn acquireImported();
+    /* Diagnostic, never a proof of coherence: the 32-bit word at a mapped GPU address as the kernel's cacheable alias reads it
+     * and, when the board installed native_adreno_dram_read32, as DRAM reads it through an uncached mapping (else ~0). */
+    IOReturn sampleWord(uint64_t iova,uint32_t *cached,uint32_t *dram) const;
+    /* Every line of [iova, iova+bytes) that lies in a write-combined BO, through native_adreno_line_audit: *dirty counts lines a CPU
+     * cache held newer than DRAM (a client view that caches after all; each such line is written back by the audit), *stale clean
+     * copies, *lines the lines compared. kIOReturnUnsupported without a board hook. int-099 sampled one word and wrote its line back
+     * before reading DRAM, so it could never see a dirty line. */
+    /* Before a submission while write-combined BOs are trusted: every page of every mapped write-combined BO that XNU set back to the
+     * default attribute is write-combined again (and its lines written back); *reset counts the pages. */
+    IOReturn reassertWriteCombined(uint32_t *reset) const;
+    IOReturn auditRange(uint64_t iova,size_t bytes,uint32_t *lines,uint32_t *dirty,uint32_t *stale) const;
+    /* Read-only description of a live mapping; never pins or extends it. */
+    IOReturn describe(uint64_t handle,uint64_t *iova,size_t *bytes,unsigned *permissions) const;
+    /* Up to `count` dwords of a mapped kernel-owned BO at a GPU address (through the kernel's own mapping), for the board log. */
+    IOReturn peekWords(uint64_t iova,uint32_t *out,size_t count) const;
+    /* Only a scheduler's actual successful GPU completion may call this.
+     * A timeout, interrupt bit alone or CPU-written timestamp is insufficient. */
+    IOReturn retireJobAfterCompletion(uint64_t handle);
+    bool poisoned() const {return poisoned_;}
+    size_t objectCount() const {return objects_;}
+    size_t spanCount() const {return lower_count_+upper_count_;}
+    NativeAdrenoVmResult lastResult() const {return result_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoVmAlias.h b/iokit/Kernel/arm/unixnu/NativeAdrenoVmAlias.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoVmAlias.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_VM_ALIAS_H
+#define NATIVE_ADRENO_VM_ALIAS_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* Temporary CPU validation index, never a GPU mapping or translation table.
+ * Range has physical/bytes fields. The caller has validated nonempty ranges
+ * with nonoverflowing ends and supplies count valid indices in owned scratch.
+ * Original ranges are immutable. One serialized owner uses scratch at a time. */
+template<class Range> class NativeAdrenoPhysicalIndex final {
+    const Range *ranges_;
+    uint32_t *order_;
+    size_t count_;
+    uint64_t end(uint32_t i) const {return ranges_[i].physical+ranges_[i].bytes;}
+    bool less(uint32_t a,uint32_t b) const {
+        return ranges_[a].physical<ranges_[b].physical ||
+            (ranges_[a].physical==ranges_[b].physical && ranges_[a].bytes<ranges_[b].bytes);
+    }
+    void sift(size_t root,size_t count) {
+        while(root<count/2) {
+            size_t child=root*2+1;
+            if(child+1<count && less(order_[child],order_[child+1]))++child;
+            if(!less(order_[root],order_[child]))break;
+            uint32_t t=order_[root];order_[root]=order_[child];order_[child]=t;root=child;
+        }
+    }
+public:
+    NativeAdrenoPhysicalIndex(const Range *ranges,uint32_t *order,size_t count):ranges_(ranges),order_(order),count_(count) {
+        for(size_t i=count/2;i-->0;)sift(i,count);
+        for(size_t n=count;n>1;) {--n;uint32_t t=order_[0];order_[0]=order_[n];order_[n]=t;sift(0,n);}
+        /* Discard an interval contained by an earlier interval. The remaining
+         * starts AND ends are monotonic, even for nested/duplicate/overlapping
+         * inputs. Each query then needs a binary search, with no backward scan. */
+        size_t kept=0;
+        for(size_t i=0;i<count;++i) {
+            uint32_t index=order_[i];
+            if(!kept || end(index)>end(order_[kept-1]))order_[kept++]=index;
+        }
+        count_=kept;
+    }
+    bool overlaps(uint64_t physical,uint64_t bytes) const {
+        size_t lo=0,hi=count_;
+        while(lo<hi) {size_t mid=lo+(hi-lo)/2;if(end(order_[mid])<=physical)lo=mid+1;else hi=mid;}
+        return lo<count_ && ranges_[order_[lo]].physical<physical+bytes;
+    }
+};
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4K.c b/iokit/Kernel/arm/unixnu/ArmSmmu4K.c
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4K.c
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4K.h"
+#define PAGE_BYTES UINT64_C(4096)
+#define ADDRESS_MASK UINT64_C(0x0000fffffffff000)
+
+static ArmSmmu4KStatus build_region(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result, unsigned upper)
+{
+    if (!result) return ArmSmmu4KArgument;
+    result->root_physical = result->mair = 0;
+    result->table_pages = result->leaf_pages = result->start_level = 0;
+    result->upper_region = 0;
+    if (!config || !ranges || !range_count || !tables || !capacity ||
+        capacity > SIZE_MAX / PAGE_BYTES || range_count > SIZE_MAX / sizeof(*ranges) ||
+        config->input_bits < 32 || config->input_bits > 48 ||
+        !(config->output_bits == 32 || config->output_bits == 36 || config->output_bits == 40 ||
+          config->output_bits == 42 || config->output_bits == 44 || config->output_bits == 48) ||
+        !config->leaf_budget || config->leaf_budget > (SIZE_MAX - 1) / 3 ||
+        ((uintptr_t)tables & 7)) return ArmSmmu4KArgument;
+    if (range_count > config->leaf_budget) return ArmSmmu4KBudget;
+    uint64_t input_limit = UINT64_C(1) << config->input_bits;
+    uint64_t output_limit = UINT64_C(1) << config->output_bits;
+    uint64_t pool_bytes = (uint64_t)capacity * PAGE_BYTES;
+    uint64_t pool = config->table_physical;
+    if ((pool & 4095) || pool >= output_limit || pool_bytes > output_limit - pool)
+        return ArmSmmu4KBadRange;
+    size_t leaves = 0;
+    uint64_t previous_end = 0;
+    for (size_t i = 0; i < range_count; ++i) {
+        const ArmSmmu4KRange *r = &ranges[i];
+        if (!r->bytes || ((r->iova | r->physical | r->bytes) & 4095) ||
+            (!(r->permissions & ArmSmmu4KRead) || (r->permissions & ~15u)) || r->writeback > 1 || (r->shareability != 2 && r->shareability != 3) ||
+            r->physical >= output_limit || r->bytes > output_limit - r->physical)
+            return ArmSmmu4KBadRange;
+        if (upper ? (r->iova < UINT64_MAX-input_limit+1 || r->bytes-1 > UINT64_MAX-r->iova) :
+                    (r->iova >= input_limit || r->bytes > input_limit-r->iova))
+            return ArmSmmu4KBadRange;
+        if (i && r->iova <= previous_end) return ArmSmmu4KOverlap;
+        previous_end = r->iova + (r->bytes-1);
+        if (r->physical < pool + pool_bytes && pool < r->physical + r->bytes)
+            return ArmSmmu4KOverlap;
+        for (size_t j = 0; j < i; ++j) {
+            if ((r->writeback != ranges[j].writeback || r->shareability != ranges[j].shareability || ((r->permissions ^ ranges[j].permissions) & ArmSmmu4KPrivileged)) && r->physical < ranges[j].physical + ranges[j].bytes &&
+                ranges[j].physical < r->physical + r->bytes) return ArmSmmu4KOverlap;
+        }
+        uint64_t pages = r->bytes / PAGE_BYTES;
+        if (pages > config->leaf_budget - leaves) return ArmSmmu4KBudget;
+        leaves += (size_t)pages;
+    }
+    /* Each range has at least one leaf, so the validated leaf budget also
+     * bounds the range/alias loops. Sorted IOVAs make prefix counting exact. */
+    unsigned levels = (config->input_bits - 12 + 8) / 9;
+    unsigned start = 4 - levels;
+    size_t required = 1;
+    uint64_t last[3] = {UINT64_MAX, UINT64_MAX, UINT64_MAX};
+    for (size_t i = 0; i < range_count; ++i) {
+        for (uint64_t offset = 0; offset < ranges[i].bytes; offset += PAGE_BYTES) {
+            uint64_t va = ranges[i].iova + offset;
+            for (unsigned level = start; level < 3; ++level) {
+                uint64_t prefix = va >> (39 - 9 * level);
+                if (prefix != last[level]) { ++required; last[level] = prefix; }
+            }
+        }
+    }
+    if (required > capacity) return ArmSmmu4KCapacity;
+    for (size_t i = 0; i < required * 512; ++i) tables[i] = 0;
+    size_t next = 1;
+    for (size_t i = 0; i < range_count; ++i) {
+        const ArmSmmu4KRange *r = &ranges[i];
+        uint64_t attributes = (1u << 11) | (1u << 10) | 3;
+        if (!(r->permissions & ArmSmmu4KExecute)) attributes |= UINT64_C(3) << 53;
+        if (!(r->permissions & ArmSmmu4KPrivileged)) attributes |= 1u << 6;
+        if (!(r->permissions & ArmSmmu4KWrite)) attributes |= 1u << 7;
+        attributes |= (uint64_t)r->shareability << 8;
+        if (r->writeback) attributes |= 1u << 2;
+        for (uint64_t offset = 0; offset < r->bytes; offset += PAGE_BYTES) {
+            uint64_t va = r->iova + offset;
+            size_t table = 0;
+            for (unsigned level = start; level < 3; ++level) {
+                unsigned shift = 39-9*level;
+                unsigned width = level==start ? config->input_bits-shift : 9;
+                size_t slot = table * 512 + ((va >> shift) & ((1u<<width)-1));
+                if (!tables[slot]) tables[slot] = (pool + PAGE_BYTES * next++) | 3;
+                table = (size_t)(((tables[slot] & ADDRESS_MASK) - pool) / PAGE_BYTES);
+            }
+            tables[table * 512 + ((va >> 12) & 511)] = (r->physical + offset) | attributes;
+        }
+    }
+    result->root_physical = pool;
+    result->mair = 0xff44;
+    result->table_pages = required;
+    result->leaf_pages = leaves;
+    result->start_level = start;
+    result->upper_region = upper;
+    return ArmSmmu4KSuccess;
+}
+
+ArmSmmu4KStatus ArmSmmu4KBuild(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result)
+{
+    return build_region(config,ranges,range_count,tables,capacity,result,0);
+}
+
+ArmSmmu4KStatus ArmSmmu4KBuildUpper(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result)
+{
+    return build_region(config,ranges,range_count,tables,capacity,result,1);
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4K.h b/iokit/Kernel/arm/unixnu/ArmSmmu4K.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4K.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_H
+#define ARM_SMMU_4K_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    ArmSmmu4KSuccess = 0, ArmSmmu4KArgument, ArmSmmu4KBadRange,
+    ArmSmmu4KOverlap, ArmSmmu4KCapacity, ArmSmmu4KBudget,
+    ArmSmmu4KUnsupported, ArmSmmu4KStateMismatch,
+    ArmSmmu4KIoError, ArmSmmu4KTimeout, ArmSmmu4KBusy, ArmSmmu4KFault
+} ArmSmmu4KStatus;
+typedef struct {
+    unsigned input_bits;           /* 32..48, low-address TTBR0 profile. */
+    unsigned output_bits;          /* 32,36,40,42,44,48. */
+    uint64_t table_physical;        /* Caller-owned contiguous pool, aligned 4K. */
+    size_t leaf_budget;            /* Explicit upper bound on mapping work. */
+} ArmSmmu4KConfig;
+enum {ArmSmmu4KRead=1,ArmSmmu4KWrite=2,ArmSmmu4KExecute=4,ArmSmmu4KPrivileged=8};
+typedef struct {
+    uint64_t iova, physical, bytes;
+    unsigned permissions;          /* Read required; optional Write/Execute/Privileged. */
+    unsigned writeback;            /* 0=normal NC, 1=normal WB/WA. */
+    unsigned shareability;         /* 2=outer, 3=inner; explicit, no default. */
+} ArmSmmu4KRange;
+typedef struct {
+    uint64_t root_physical;
+    uint64_t mair;                 /* NC at index 0, WB/WA at index 1. */
+    size_t table_pages, leaf_pages;
+    unsigned start_level;
+    unsigned upper_region;        /* 0=Build TTBR0, 1=BuildUpper TTBR1. */
+} ArmSmmu4KResult;
+
+/* Build inactive ARM LPAE stage-1 tables with ONLY 4K level-3 leaves.
+ * Sorted disjoint low IOVA ranges; no sign extension or input conversion.
+ * No resource may map the table pool. Conflicting cache/shareability/privilege
+ * aliases refuse. Default 1/3 retains unprivileged PXN/UXN behavior. Execute
+ * and Privileged explicitly describe DEVICE-stage1 accesses (e.g. firmware),
+ * never CPU permissions or authorization to execute unauthenticated images.
+ * All validation/capacity checks precede table writes. Failure zeros result
+ * and leaves tables untouched. Success writes only result.table_pages pages.
+ * Caller guarantees real accessible, disjoint storage, immutable inputs,
+ * native-endian uint64_t table storage aligned to at least 8 bytes, actual
+ * physical ownership and matching CPU attributes/cache maintenance.
+ * NO MMIO, allocation, barriers, TLB operations or activation. This does NOT
+ * prove hardware support, coherent walks or a live isolated GPU context. */
+ArmSmmu4KStatus ArmSmmu4KBuild(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t table_capacity_pages, ArmSmmu4KResult *result);
+/* Same native 4K format for TTBR1's upper, sign-extended address region.
+ * IOVAs must already be in [2^64-2^input_bits,2^64); truncated low addresses
+ * refuse. Uses the architectural partial-root index width. No lower-region
+ * remapping, page-size conversion, MMIO or translation activation occurs. */
+ArmSmmu4KStatus ArmSmmu4KBuildUpper(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t table_capacity_pages, ArmSmmu4KResult *result);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.c
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.c
@@ -0,0 +1,172 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KAudit.h"
+#define PAGE UINT64_C(4096)
+#define ADDRESS UINT64_C(0x0000fffffffff000)
+typedef struct {
+    const ArmSmmu4KTableIo *io;
+    const ArmSmmu4KConfig *c;
+    const ArmSmmu4KResult *built;
+    const ArmSmmu4KAuditRegion *a;
+    ArmSmmu4KTableAuditResult *r;
+    size_t range;
+    uint64_t offset;
+} Walk;
+static int intersects(uint64_t a,uint64_t an,uint64_t b,uint64_t bn)
+{return a<b+bn && b<a+an;}
+static int incompatible(const ArmSmmu4KRange *a,const ArmSmmu4KRange *b)
+{return a->writeback!=b->writeback || a->shareability!=b->shareability || ((a->permissions^b->permissions)&ArmSmmu4KPrivileged);}
+static ArmSmmu4KStatus validate(const ArmSmmu4KConfig *c,const ArmSmmu4KResult *b,
+    const ArmSmmu4KAuditRegion *a,uint64_t root)
+{
+    if(!c || !b || !a || !a->ranges || !a->range_count || !a->visited ||
+        !a->capacity_pages || a->capacity_pages>SIZE_MAX/4096 ||
+        a->visited_bytes<a->capacity_pages || !a->read_budget ||
+        c->input_bits<32 || c->input_bits>48 ||
+        !(c->output_bits==32 || c->output_bits==36 || c->output_bits==40 ||
+          c->output_bits==42 || c->output_bits==44 || c->output_bits==48) ||
+        !c->leaf_budget || c->leaf_budget>(SIZE_MAX-1)/3 ||
+        a->range_count>SIZE_MAX/sizeof(*a->ranges))return ArmSmmu4KArgument;
+    if(a->range_count>c->leaf_budget)return ArmSmmu4KBudget;
+    uint64_t limit=UINT64_C(1)<<c->output_bits,span=UINT64_C(1)<<c->input_bits;
+    uint64_t pool_bytes=(uint64_t)a->capacity_pages*PAGE;
+    if((c->table_physical&4095) || c->table_physical>=limit || pool_bytes>limit-c->table_physical)
+        return ArmSmmu4KBadRange;
+    if(root!=c->table_physical || b->root_physical!=root || b->mair!=0xff44 ||
+        !b->table_pages || b->table_pages>a->capacity_pages || !b->leaf_pages ||
+        b->start_level!=4-(c->input_bits-12+8)/9 || b->upper_region>1)
+        return ArmSmmu4KStateMismatch;
+    if(b->table_pages>a->read_budget/512)return ArmSmmu4KBudget;
+    size_t leaves=0;uint64_t end=0;
+    for(size_t i=0;i<a->range_count;++i) {
+        const ArmSmmu4KRange *r=&a->ranges[i];
+        if(!r->bytes || ((r->iova|r->physical|r->bytes)&4095) ||
+            !(r->permissions&ArmSmmu4KRead) || (r->permissions&~15u) ||
+            r->writeback>1 || (r->shareability!=2 && r->shareability!=3) ||
+            r->physical>=limit || r->bytes>limit-r->physical ||
+            (b->upper_region?(r->iova<UINT64_MAX-span+1 || r->bytes-1>UINT64_MAX-r->iova):
+             (r->iova>=span || r->bytes>span-r->iova)))return ArmSmmu4KBadRange;
+        if(i && r->iova<=end)return ArmSmmu4KOverlap;
+        end=r->iova+r->bytes-1;
+        if(intersects(r->physical,r->bytes,c->table_physical,pool_bytes))return ArmSmmu4KOverlap;
+        for(size_t j=0;j<i;++j)if(incompatible(r,&a->ranges[j]) &&
+            intersects(r->physical,r->bytes,a->ranges[j].physical,a->ranges[j].bytes))return ArmSmmu4KOverlap;
+        uint64_t pages=r->bytes/PAGE;
+        if(pages>c->leaf_budget-leaves)return ArmSmmu4KBudget;
+        leaves+=(size_t)pages;
+    }
+    return leaves==b->leaf_pages?ArmSmmu4KSuccess:ArmSmmu4KStateMismatch;
+}
+static ArmSmmu4KStatus walk(Walk *w,uint64_t table,unsigned level,uint64_t base)
+{
+    if((table&4095) || table<w->c->table_physical ||
+        (table-w->c->table_physical)/PAGE>=w->a->capacity_pages)return ArmSmmu4KBadRange;
+    size_t page=(size_t)((table-w->c->table_physical)/PAGE);
+    if(w->a->visited[page])return ArmSmmu4KOverlap;
+    if(w->r->table_pages>=w->built->table_pages)return ArmSmmu4KStateMismatch;
+    w->a->visited[page]=1;++w->r->table_pages;
+    size_t initial_leaves=w->r->leaf_pages;
+    unsigned shift=39-9*level;
+    unsigned width=level==w->built->start_level?w->c->input_bits-shift:9;
+    for(unsigned i=0;i<512;++i) {
+        w->r->descriptor_physical=table+8*i;w->r->descriptor=0;
+        w->r->level=level;w->r->iova=base|((uint64_t)i<<shift);w->r->expected_descriptor=0;
+        if(w->r->descriptor_reads==w->a->read_budget)return ArmSmmu4KBudget;
+        ++w->r->descriptor_reads;
+        uint64_t d;
+        if(w->io->read_descriptor(w->io->cookie,table+8*i,&d))return ArmSmmu4KIoError;
+        w->r->descriptor=d;
+        if(!d)continue;
+        if(i>=(1u<<width) || (d&3)!=3)return ArmSmmu4KStateMismatch;
+        if(level<3) {
+            if(d!=((d&ADDRESS)|3))return ArmSmmu4KStateMismatch;
+            ArmSmmu4KStatus status=walk(w,d&ADDRESS,level+1,base|((uint64_t)i<<shift));
+            if(status)return status;
+        } else {
+            if(w->range==w->a->range_count)return ArmSmmu4KStateMismatch;
+            const ArmSmmu4KRange *r=&w->a->ranges[w->range];
+            uint64_t expected=(r->physical+w->offset)|3|(1u<<11)|(1u<<10)|((uint64_t)r->shareability<<8);
+            if(!(r->permissions&ArmSmmu4KExecute))expected|=UINT64_C(3)<<53;
+            if(!(r->permissions&ArmSmmu4KPrivileged))expected|=1u<<6;
+            if(!(r->permissions&ArmSmmu4KWrite))expected|=1u<<7;
+            if(r->writeback)expected|=1u<<2;
+            w->r->expected_descriptor=expected;
+            if(w->r->iova!=r->iova+w->offset || d!=expected)return ArmSmmu4KStateMismatch;
+            ++w->r->leaf_pages;w->offset+=PAGE;
+            if(w->offset==r->bytes){++w->range;w->offset=0;}
+        }
+    }
+    /* Empty intermediate tables are not part of the declared resource graph. */
+    return w->r->leaf_pages>initial_leaves?ArmSmmu4KSuccess:ArmSmmu4KStateMismatch;
+}
+ArmSmmu4KStatus ArmSmmu4KAuditTables(const ArmSmmu4KTableIo *io,
+    const ArmSmmu4KConfig *c,const ArmSmmu4KResult *b,const ArmSmmu4KAuditRegion *a,
+    uint64_t root,ArmSmmu4KTableAuditResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;*r=(ArmSmmu4KTableAuditResult){0};
+    if(!io || !io->read_descriptor)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=validate(c,b,a,root);if(status)return status;
+    for(size_t i=0;i<a->capacity_pages;++i)a->visited[i]=0;
+    Walk w={io,c,b,a,r,0,0};
+    uint64_t base=b->upper_region?UINT64_MAX-(UINT64_C(1)<<c->input_bits)+1:0;
+    status=walk(&w,root,b->start_level,base);if(status)return status;
+    if(r->table_pages!=b->table_pages || r->leaf_pages!=b->leaf_pages || w.range!=a->range_count)
+        return ArmSmmu4KStateMismatch;
+    r->complete=1;return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus pair_validate(const ArmSmmu4KContextConfig *c,const ArmSmmu4KAuditConfig *a)
+{
+    if(!c || !a || !a->io.read_descriptor || (!c->lower && !c->upper) ||
+        !!c->lower!=!!c->lower_tables || !!c->upper!=!!c->upper_tables ||
+        !!c->lower!=!!a->lower || !!c->upper!=!!a->upper)return ArmSmmu4KArgument;
+    const ArmSmmu4KConfig *cs[2]={c->lower,c->upper};
+    const ArmSmmu4KResult *bs[2]={c->lower_tables,c->upper_tables};
+    const ArmSmmu4KAuditRegion *as[2]={a->lower,a->upper};
+    for(unsigned i=0;i<2;++i)if(cs[i]) {
+        ArmSmmu4KStatus status=validate(cs[i],bs[i],as[i],bs[i]->root_physical);if(status)return status;
+        if(bs[i]->upper_region!=i)return ArmSmmu4KStateMismatch;
+    }
+    if(c->lower && c->upper) {
+        if(c->lower->output_bits!=c->upper->output_bits)return ArmSmmu4KStateMismatch;
+        if(intersects(c->lower->table_physical,a->lower->capacity_pages*PAGE,
+                      c->upper->table_physical,a->upper->capacity_pages*PAGE))return ArmSmmu4KOverlap;
+        for(unsigned side=0;side<2;++side)for(size_t i=0;i<as[side]->range_count;++i) {
+            const ArmSmmu4KRange *r=&as[side]->ranges[i];
+            if(intersects(r->physical,r->bytes,cs[!side]->table_physical,as[!side]->capacity_pages*PAGE))return ArmSmmu4KOverlap;
+        }
+        for(size_t i=0;i<a->lower->range_count;++i)for(size_t j=0;j<a->upper->range_count;++j) {
+            const ArmSmmu4KRange *x=&a->lower->ranges[i],*y=&a->upper->ranges[j];
+            if(incompatible(x,y) && intersects(x->physical,x->bytes,y->physical,y->bytes))return ArmSmmu4KOverlap;
+        }
+    }
+    return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus regions(const ArmSmmu4KContextConfig *c,const ArmSmmu4KAuditConfig *a,
+    uint64_t lower,uint64_t upper,ArmSmmu4KAuditResult *r)
+{
+    ArmSmmu4KStatus status;
+    if(c->lower){r->phase=2;status=ArmSmmu4KAuditTables(&a->io,c->lower,c->lower_tables,a->lower,lower,&r->lower);if(status)return status;}
+    if(c->upper){r->phase=3;status=ArmSmmu4KAuditTables(&a->io,c->upper,c->upper_tables,a->upper,upper,&r->upper);if(status)return status;}
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KAuditDeclaredContext(const ArmSmmu4KContextConfig *c,
+    const ArmSmmu4KAuditConfig *a,ArmSmmu4KAuditResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;*r=(ArmSmmu4KAuditResult){0};
+    ArmSmmu4KStatus status=pair_validate(c,a);if(status)return status;
+    status=regions(c,a,c->lower?c->lower_tables->root_physical:0,c->upper?c->upper_tables->root_physical:0,r);
+    if(!status){r->phase=4;r->complete=1;}return status;
+}
+ArmSmmu4KStatus ArmSmmu4KObserveAuditedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *c,const ArmSmmu4KAuditConfig *a,ArmSmmu4KAuditResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;*r=(ArmSmmu4KAuditResult){0};
+    ArmSmmu4KStatus status=pair_validate(c,a);if(status)return status;
+    r->phase=1;status=ArmSmmu4KObserveOwnedContext(io,bank,c,&r->before);if(status)return status;
+    status=regions(c,a,r->before.readback.ttbr0&ADDRESS,r->before.readback.ttbr1&ADDRESS,r);if(status)return status;
+    r->phase=5;status=ArmSmmu4KObserveOwnedContext(io,bank,c,&r->after);if(status)return status;
+    /* Each complete image independently matched the same immutable expected
+     * context, including capabilities, ASID, roots, MAIR and granules. */
+    if(r->before.id0!=r->after.id0 || r->before.id1!=r->after.id1 || r->before.id2!=r->after.id2)
+        return ArmSmmu4KStateMismatch;
+    r->phase=6;r->complete=1;return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_AUDIT_H
+#define ARM_SMMU_4K_AUDIT_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    void *cookie;
+    /* Read the actual descriptor at an owned physical address. No generated,
+     * cached reference-table or translated/shadow-table substitute. Return 0
+     * on success. Platform supplies a real coherent CPU mapping and ownership. */
+    int (*read_descriptor)(void *,uint64_t physical,uint64_t *);
+} ArmSmmu4KTableIo;
+typedef struct {
+    const ArmSmmu4KRange *ranges;
+    size_t range_count,capacity_pages,read_budget;
+    /* Scratch: one byte per pool page, reset by each audit. Disjoint from all
+     * inputs, outputs, mapped resources, physical tables and other scratch. */
+    unsigned char *visited;
+    size_t visited_bytes;
+} ArmSmmu4KAuditRegion;
+typedef struct {
+    ArmSmmu4KTableIo io;
+    const ArmSmmu4KAuditRegion *lower,*upper; /* exactly the enabled regions */
+} ArmSmmu4KAuditConfig;
+typedef struct {
+    size_t descriptor_reads,table_pages,leaf_pages;
+    uint64_t descriptor_physical,descriptor,iova,expected_descriptor;
+    unsigned level,complete;
+} ArmSmmu4KTableAuditResult;
+typedef struct {
+    ArmSmmu4KTableAuditResult lower,upper;
+    ArmSmmu4KProgramResult before,after;
+    unsigned phase,complete;
+} ArmSmmu4KAuditResult;
+/* Walk the physical graph, including every unused slot, with a strict read
+ * budget and bounded depth (four levels). Reject blocks, cycles, aliases of
+ * table pages, extra/missing mappings, permissions/attributes differing from
+ * declared resources, foreign PAs and nonzero reserved descriptor bits.
+ * No allocation, descriptor writes, rebuilding, conversion or MMIO. Each
+ * expected resource must appear exactly once, in ascending native IOVA order.
+ * Caller holds immutable tables/ranges/results and exclusive leases throughout;
+ * all masters are quiesced. Scratch and physical callback are trusted kernel
+ * boundaries. Declared bounds do NOT establish physical ownership/provenance. */
+ArmSmmu4KStatus ArmSmmu4KAuditTables(const ArmSmmu4KTableIo *,
+    const ArmSmmu4KConfig *,const ArmSmmu4KResult *,const ArmSmmu4KAuditRegion *,
+    uint64_t root_physical,ArmSmmu4KTableAuditResult *);
+/* Pre-activation audit of BOTH declared physical regions; also rejects pool
+ * overlap and resource access to either entire pool, including spare pages.
+ * This is not an observation of an active context. */
+ArmSmmu4KStatus ArmSmmu4KAuditDeclaredContext(const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KAuditConfig *,ArmSmmu4KAuditResult *);
+/* Read actual context before AND after the physical walks; use its observed
+ * TTBR addresses as traversal roots. Require exact enabled 4K state and no
+ * faults at both observations. No writes, activation or hardware timing proof.
+ * Exclusive ownership/quiescence and coherent immutable tables are mandatory;
+ * two observations cannot detect an unowned writer changing and restoring state. */
+ArmSmmu4KStatus ArmSmmu4KObserveAuditedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,const ArmSmmu4KAuditConfig *,ArmSmmu4KAuditResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KContext.h"
+static int width_code(unsigned bits)
+{
+    switch(bits) {case 32:return 0;case 36:return 1;case 40:return 2;
+        case 42:return 3;case 44:return 4;case 48:return 5;default:return -1;}
+}
+static unsigned width_bits(unsigned code)
+{
+    switch(code) {case 0:return 32;case 1:return 36;case 2:return 40;
+        case 3:return 42;case 4:return 44;case 5:return 48;default:return 0;}
+}
+static int region_valid(const ArmSmmu4KConfig *c,const ArmSmmu4KResult *r,unsigned upper)
+{
+    if(!c || !r)return !c && !r;
+    if(c->input_bits<32 || c->input_bits>48 || width_code(c->output_bits)<0 ||
+        (c->table_physical&4095) || r->root_physical!=c->table_physical ||
+        r->mair!=0xff44 || r->upper_region!=upper || !r->table_pages ||
+        r->leaf_pages>c->leaf_budget || r->table_pages>UINT64_MAX/4096 ||
+        r->start_level!=4-(c->input_bits-12+8)/9)return 0;
+    uint64_t limit=UINT64_C(1)<<c->output_bits;
+    return r->root_physical<limit && (uint64_t)r->table_pages*4096<=limit-r->root_physical;
+}
+ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *c,
+    ArmSmmu4KContextImage *out)
+{
+    if(!out)return ArmSmmu4KArgument;
+    out->cbar=out->cba2r=out->tcr=out->tcr2=out->mair0=out->mair1=out->sctlr=0;
+    out->reserved_zero=0;
+    out->ttbr0=out->ttbr1=0;
+    if(!c || (!c->lower && !c->upper) || c->asid>65535 || c->coherent_walk>1 ||
+        c->stall_on_fault>1 || c->continue_after_fault>1 ||
+        !region_valid(c->lower,c->lower_tables,0) || !region_valid(c->upper,c->upper_tables,1))return ArmSmmu4KArgument;
+    unsigned va=width_bits((c->id2>>8)&15),pa=width_bits((c->id2>>4)&15);
+    if(!(c->id0&(UINT32_C(1)<<30)) || !(c->id2&(1u<<12)) || !va || !pa)return ArmSmmu4KUnsupported;
+    const ArmSmmu4KConfig *basis=c->lower?c->lower:c->upper;
+    if(basis->output_bits>pa || (c->lower && c->lower->input_bits>va) ||
+        (c->upper && (c->upper->input_bits>va || c->upper->output_bits!=basis->output_bits)))return ArmSmmu4KUnsupported;
+    if(c->lower && c->upper) {
+        const ArmSmmu4KResult *a=c->lower_tables,*b=c->upper_tables;
+        if(a->root_physical<b->root_physical+(uint64_t)b->table_pages*4096 &&
+           b->root_physical<a->root_physical+(uint64_t)a->table_pages*4096)return ArmSmmu4KOverlap;
+    }
+    ArmSmmu4KContextImage v;
+    v.cbar=0x1f300; /* Stage1 translation, stage2 bypass; weakest bypass attrs. */
+    v.cba2r=1;      /* AArch64. No stage2 VMID or guest translation. */
+    v.tcr=UINT32_C(2)<<30; /* TG1=4K, TG0=4K. */
+    unsigned walk=c->coherent_walk?0x3500:0x2000;
+    if(c->lower)v.tcr|=walk|(64-c->lower->input_bits);
+    else v.tcr|=1u<<7; /* EPD0 */
+    if(c->upper)v.tcr|=(walk|(64-c->upper->input_bits))<<16;
+    else v.tcr|=1u<<23; /* EPD1 */
+    v.tcr2=(7u<<15)|(1u<<4)|(unsigned)width_code(basis->output_bits);
+    v.ttbr0=(uint64_t)c->asid<<48;v.ttbr1=v.ttbr0;
+    if(c->lower)v.ttbr0|=c->lower_tables->root_physical;
+    if(c->upper)v.ttbr1|=c->upper_tables->root_physical;
+    v.mair0=0xff44;v.mair1=0;
+    v.sctlr=0x1067|(c->stall_on_fault<<7)|(c->continue_after_fault<<8);
+    v.reserved_zero=0;
+    *out=v;
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KValidateContextReadback(const ArmSmmu4KContextConfig *c,
+    const ArmSmmu4KContextImage *observed)
+{
+    if(!observed)return ArmSmmu4KArgument;
+    ArmSmmu4KContextImage expected;
+    ArmSmmu4KStatus status=ArmSmmu4KEncodeContext(c,&expected);
+    if(status!=ArmSmmu4KSuccess)return status;
+    /* TCR2.TBI0/TBI1 (bits 5/6, top-byte ignore) are written 0 but may read 1: the sheng Adreno MMU-500 reads
+     * 0x38071 for 0x38011 (int-008). Linux neither sets nor reads them back. With a 48-bit upstream bus the top
+     * byte of a device address is zero, so ignoring it changes no translation. Only 0 -> 1 is accepted here. */
+    const uint32_t tbi_set=observed->tcr2&~expected.tcr2&UINT32_C(0x60);
+    /* SCTLR.ASIDPNE (bit 12) is written 1 but may read 0: the same SMMU reads 0x167 for 0x1167 (int-009). Linux
+     * writes it and never reads it back. A shared ASID namespace is safe because every bank's ASID is the
+     * caller's exclusive lease. Only 1 -> 0 is accepted. */
+    const uint32_t asidpne_clear=expected.sctlr&~observed->sctlr&UINT32_C(0x1000);
+    if(expected.cbar!=observed->cbar || expected.cba2r!=observed->cba2r ||
+        expected.tcr!=observed->tcr || ((expected.tcr2^observed->tcr2)&~tbi_set) ||
+        expected.mair0!=observed->mair0 || expected.mair1!=observed->mair1 ||
+        ((expected.sctlr^observed->sctlr)&~asidpne_clear) || observed->reserved_zero || expected.ttbr0!=observed->ttbr0 ||
+        expected.ttbr1!=observed->ttbr1)return ArmSmmu4KStateMismatch;
+    return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_CONTEXT_H
+#define ARM_SMMU_4K_CONTEXT_H
+#include "ArmSmmu4K.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    /* A config/result pair from Build, BuildUpper or LivePrepare; NULL pair disables it.
+     * A live arena may have zero mapped leaves while retaining its table topology.
+     * Both enabled regions need distinct physical pools and equal OAS/MAIR.
+     * The trusted caller retains actual pool ownership and immutable results. */
+    const ArmSmmu4KConfig *lower, *upper;
+    const ArmSmmu4KResult *lower_tables, *upper_tables;
+    uint32_t id0, id2;       /* Raw SMMUv2 identification register values. */
+    unsigned asid;          /* 0..65535, ownership managed by the caller. */
+    unsigned coherent_walk; /* Explicit: 1=inner WBWA, 0=outer NC. */
+    unsigned stall_on_fault, continue_after_fault; /* Each 0 or 1. */
+} ArmSmmu4KContextConfig;
+typedef struct {
+    uint32_t cbar, cba2r, tcr, tcr2, mair0, mair1, sctlr, reserved_zero;
+    uint64_t ttbr0, ttbr1;
+} ArmSmmu4KContextImage;
+
+/* Encode AArch64 stage1, stage2-bypass native4K SMMUv2 context registers.
+ * Capability/width/result/refusal checks precede publishing an image. Failure
+ * zeros it. Both TG0/TG1 select 4K even for a disabled region. No MMIO, power,
+ * stream/context assignment, cache barriers, TLB operations or activation.
+ * ID inputs are not proof that the caller read actual hardware. Inputs,
+ * their pointed-to configs/results, and output must be disjoint and immutable
+ * throughout the call; this is a trusted kernel integration boundary. */
+ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *,
+    ArmSmmu4KContextImage *);
+/* Compare all supplied readback fields with the freshly encoded expected
+ * image. Caller must read real hardware and independently walk its actual
+ * TTBR tables, verify ownership/coherency and handle faults/TLB lifetime.
+ * Matching caller-supplied values alone never qualify an active GPU mapping. */
+ArmSmmu4KStatus ArmSmmu4KValidateContextReadback(const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KContextImage *);
+#ifdef __cplusplus
+}
+#endif
