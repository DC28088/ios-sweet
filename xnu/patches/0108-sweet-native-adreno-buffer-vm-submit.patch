+    memset(mappings_,0,sizeof(Mapping)*NativeAdrenoVmMaxObjects);
+    capacity_=capacity;io_=*io;context_=context;streams_=streams;budget_=budget;
+    if(lower)regions_[0]=*lower;if(upper)regions_[1]=*upper;
