diff --git a/bsd/dev/sweet_bb_dev.c b/bsd/dev/sweet_bb_dev.c
new file mode 100644
index 0000000..def3b45
--- /dev/null
+++ b/bsd/dev/sweet_bb_dev.c
@@ -0,0 +1,119 @@
+/*
+ * /dev/sweet-bb: the cellular bridge's QRTR side (iokit/Kernel/arm/SweetBaseband.inc, UniXNU QcomBaseband).
+ * The modem's QRTR link belongs to the userland wland daemon, so wland reads the QMI requests CommCenter/ABM
+ * send on the qmux channels from here and writes back what the modem says. Records (little endian): u32 type,
+ * a, b, c, d, len, then len bytes padded to 4 (types: SweetBaseband.inc). A read never waits: no records, 0
+ * bytes. Only with the boot-arg sweetbb=1; root only. Compiled as part of flame_wlan.c (#include at its end).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+
+extern int sweet_bb_enabled(void);
+extern void sweet_bb_wland_write(uint32_t type, uint32_t a, uint32_t b, uint32_t c, uint32_t d, const void *data, uint32_t len);
+extern uint32_t sweet_bb_wland_read(uint8_t *buf, uint32_t room);
+
+#define SBB_ROOM   (64u * 1024u + 4096u)
+#define SBB_MAXLEN (64u * 1024u)
+
+static LCK_GRP_DECLARE(sbb_lck_grp, "sweet-bb");
+static LCK_MTX_DECLARE(sbb_mtx, &sbb_lck_grp);
+static uint8_t *sbb_buf;	/* one reader/writer at a time: under sbb_mtx */
+static uint32_t sbb_opens;
+
+static int
+sbb_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	lck_mtx_lock(&sbb_mtx);
+	if (!sbb_buf) {
+		sbb_buf = kalloc_data(SBB_ROOM, Z_WAITOK | Z_ZERO);
+	}
+	if (!sbb_opens++) {
+		printf("SWEET BB: /dev/sweet-bb opened (wland)\n");
+	}
+	lck_mtx_unlock(&sbb_mtx);
+	return sbb_buf ? 0 : ENOMEM;
+}
+
+static int
+sbb_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sbb_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int error = 0;
+	lck_mtx_lock(&sbb_mtx);
+	user_ssize_t want = uio_resid(uio);
+	uint32_t room = want < (user_ssize_t)SBB_ROOM ? (uint32_t)want : SBB_ROOM;
+	uint32_t n = sbb_buf ? sweet_bb_wland_read(sbb_buf, room) : 0;
+	if (n) {
+		error = uiomove((caddr_t)sbb_buf, (int)n, uio);
+	}
+	lck_mtx_unlock(&sbb_mtx);
+	return error;
+}
+
+static int
+sbb_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int error = 0;
+	lck_mtx_lock(&sbb_mtx);
+	while (!error && sbb_buf && uio_resid(uio) >= 24) {
+		uint32_t w[6];
+		if ((error = uiomove((caddr_t)w, 24, uio)) != 0) {
+			break;
+		}
+		uint32_t len = w[5], padded = (len + 3u) & ~3u;
+		if (len > SBB_MAXLEN || uio_resid(uio) < padded) {
+			error = EINVAL;
+			break;
+		}
+		if (padded && (error = uiomove((caddr_t)sbb_buf, (int)padded, uio)) != 0) {
+			break;
+		}
+		sweet_bb_wland_write(w[0], w[1], w[2], w[3], w[4], sbb_buf, len);
+	}
+	lck_mtx_unlock(&sbb_mtx);
+	return error;
+}
+
+static const struct cdevsw sbb_cdevsw = {
+	.d_open       = sbb_open,
+	.d_close      = sbb_close,
+	.d_read       = sbb_read,
+	.d_write      = sbb_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void sweet_bb_dev_init(void);
+void
+sweet_bb_dev_init(void)
+{
+	if (!sweet_bb_enabled()) {
+		return;
+	}
+	int major = cdevsw_add(-1, &sbb_cdevsw);
+	if (major < 0) {
+		printf("SWEET BB: cdevsw_add failed (%d)\n", major);
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "sweet-bb");
+	printf("SWEET BB: /dev/sweet-bb ready (major %d); AppleBaseband services follow wland's READY\n", major);
+}
