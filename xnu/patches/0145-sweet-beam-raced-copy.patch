+/* Find the running DSI timing engine (INTF_1/INTF_2) and measure its line
+ * period from the hardware frame counter. Any inconsistency leaves the copy
+ * unsynchronised, as before 0144. Runs once, on the present thread. */
+void
+AppleCLCD::beamProbe(void)
+{
+	fBeamProbed = true;
+	int beam = 1;
+	PE_parse_boot_argn("sweetfbbeam", &beam, sizeof(beam));
+	if (!beam) {
+		IOLog("SWEET FB: beam-raced copy off (sweetfbbeam=0)\n");
+		return;
+	}
+	volatile uint32_t *intf = (volatile uint32_t *)ml_io_map(SWEET_INTF_PA, 0x2000);
+	if (intf == NULL) {
+		IOLog("SWEET FB: beam: INTF map failed\n");
+		return;
+	}
+	for (unsigned i = 1; i <= 2; i++) {
+		volatile uint32_t *r = intf + i * 0x800 / 4;
+		const uint32_t en = r[INTF_TIMING_ENGINE_EN / 4], hctl = r[INTF_HSYNC_CTL / 4];
+		const uint32_t period = r[INTF_VSYNC_PERIOD_F0 / 4], vstart = r[INTF_DISPLAY_V_START_F0 / 4];
+		const uint32_t vend = r[INTF_DISPLAY_V_END_F0 / 4], lce = r[INTF_FRAME_LINE_COUNT_EN / 4];
+		IOLog("SWEET FB: beam: INTF_%u en=%#x hsync_ctl=%#x vsync_period=%#x v_start=%#x v_end=%#x count_en=%#x frame=%u line=%u\n",
+		    i, en, hctl, period, vstart, vend, lce, r[INTF_FRAME_COUNT / 4], r[INTF_LINE_COUNT / 4]);
+		const uint32_t hp = hctl >> 16;
+		if (!(en & 1) || hp == 0 || fIntf != NULL) {
+			continue;
+		}
+		const uint32_t total = period / hp, first = vstart / hp, last = (vend + 1) / hp;
+		if (last <= first || last > total || last - first != fHeight) {
+			IOLog("SWEET FB: beam: INTF_%u lines total=%u active=%u-%u do not match %u rows\n",
+			    i, total, first, last, fHeight);
+			continue;
+		}
+		fIntf = r;
+		fBeamTotal = total;
+		fBeamFirst = first;
+		fBeamLast = last;
+	}
+	if (fIntf == NULL) {
+		IOLog("SWEET FB: beam: no usable DSI timing engine; copy unsynchronised\n");
+		return;
+	}
+	if ((fIntf[INTF_FRAME_LINE_COUNT_EN / 4] & 3) != 3) {
+		fIntf[INTF_FRAME_LINE_COUNT_EN / 4] = 3;
+		IODelay(50);
+	}
+	/* Frame period between two counter edges ~200 ms apart. */
+	uint32_t f0 = fIntf[INTF_FRAME_COUNT / 4];
+	uint64_t t0 = 0, t1 = 0;
+	for (unsigned spins = 0; spins < 400; spins++) {
+		const uint32_t f = fIntf[INTF_FRAME_COUNT / 4];
+		if (f != f0) {
+			f0 = f;
+			t0 = mach_absolute_time();
+			break;
+		}
+		IODelay(50);
+	}
+	IOSleep(190);
+	uint32_t f1 = fIntf[INTF_FRAME_COUNT / 4];
+	const uint32_t target = f1 + 1;
+	for (unsigned spins = 0; t0 && spins < 400; spins++) {
+		f1 = fIntf[INTF_FRAME_COUNT / 4];
+		if (f1 == target) {
+			t1 = mach_absolute_time();
+			break;
+		}
+		IODelay(50);
+	}
+	uint64_t ns = 0;
+	if (t0 && t1) {
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+	}
+	const uint32_t frames = f1 - f0;
+	if (!t1 || frames == 0 || frames > 1000) {
+		IOLog("SWEET FB: beam: frame counter not advancing (frames=%u); copy unsynchronised\n", frames);
+		return;
+	}
+	fBeamLineNs = ns / frames / fBeamTotal;
+	uint32_t lines[4];
+	for (unsigned i = 0; i < 4; i++) {
+		lines[i] = fIntf[INTF_LINE_COUNT / 4];
+		IODelay(1000);
+	}
+	fBeam = fBeamLineNs != 0;
+	IOLog("SWEET FB: beam-raced copy %s: %u lines (active %u-%u), frame %llu us over %u frames, line %llu ns, samples %u %u %u %u\n",
+	    fBeam ? "on" : "off", fBeamTotal, fBeamFirst, fBeamLast, ns / frames / 1000, frames, fBeamLineNs,
+	    lines[0], lines[1], lines[2], lines[3]);
+}
+
+/* The copy writes rows top to bottom faster than the panel scans them. Begun
+ * while the scan is at active row b, it overtakes the scan at row
+ * b/(1 - copy/scan) - after the last copied row when b >= rows*(1 - copy/scan).
+ * So start in that late window (with a 1.5x copy-time margin), never in the
+ * last lines before the wrap, where fetch-ahead may already read the next frame. */
+void
+AppleCLCD::beamWait(uint32_t rows)
+{
+	if (!fBeamProbed) {
+		beamProbe();
+	}
+	if (!fBeam || rows == 0 || rows > fBeamLast - fBeamFirst) {
+		return;
+	}
+	const uint64_t copy = (fCopyRowNs ? fCopyRowNs : 1100) * 3 / 2, scan = fBeamLineNs;
+	if (copy >= scan) {
+		__atomic_add_fetch(&fStatsBeamSkips, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	const uint32_t from = fBeamFirst + rows - (uint32_t)((uint64_t)rows * copy / scan);
+	const uint32_t to = fBeamLast - 16;
+	if (from >= to) {
+		__atomic_add_fetch(&fStatsBeamSkips, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	const uint64_t began = mach_absolute_time();
+	uint32_t line = 0, before = fIntf[INTF_LINE_COUNT / 4];
+	bool ok = false;
+	for (unsigned tries = 0; tries < 6; tries++) {
+		line = fIntf[INTF_LINE_COUNT / 4];
+		if (line >= fBeamTotal) {
+			break;
+		}
+		if (line >= from && line < to) {
+			ok = true;
+			break;
+		}
+		const uint32_t ahead = line < from ? from - line : fBeamTotal - line + from;
+		IODelay((unsigned)((uint64_t)ahead * scan / NSEC_PER_USEC) + 1);
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+	__atomic_add_fetch(&fStatsBeamUs, ns / NSEC_PER_USEC, __ATOMIC_RELAXED);
+	if (!ok) {
+		__atomic_add_fetch(&fStatsBeamSkips, 1, __ATOMIC_RELAXED);
+	}
+	static unsigned logged;
+	if (logged < 8 || !ok) {
+		if (logged < 24) {
+			logged++;
+			IOLog("SWEET FB: beam wait rows=%u window=%u-%u line %u -> %u in %llu us copy_row_ns=%llu %s\n",
+			    rows, from, to, before, line, ns / NSEC_PER_USEC, fCopyRowNs, ok ? "ok" : "gave up");
+		}
+	}
+}
