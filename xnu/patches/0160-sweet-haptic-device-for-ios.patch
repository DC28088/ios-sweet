+/* ---- sweethaptic=3: the motor for iOS ---- */
+
+#define HAP_ACTIVE_US    30000u   /* a write that was not silence counts for this long */
+#define HAP_SILENT_BELOW 256u     /* of 32768 */
+#define HAP_MIN_US       30000u   /* shortest buzz: a tap */
+#define HAP_MAX_US       1000000u /* longest buzz; then it rests as long */
+#define HAP_DRIVE        0x6au    /* the DT's cont_drv_lvl: never exceeded */
+
+static volatile uint64_t hap_heard_us, hap_quiet_us;
+static volatile uint32_t hap_peak;
+static uint64_t hap_frames;
+
+static uint64_t
+hap_now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+/* From the audio server's I/O thread: never waits, never touches the chip. */
+static int
+hap_dev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		uint32_t peak = 0;
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < bytes / 2; i++) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)-(int32_t)samples[i] : (uint32_t)samples[i];
+			peak = v > peak ? v : peak;
+		}
+		hap_frames += (uint64_t)bytes / 2;
+		uint64_t now = hap_now_us();
+		if (peak > HAP_SILENT_BELOW) {
+			if (hap_heard_us == 0 || hap_quiet_us > hap_heard_us || now - hap_heard_us >= HAP_ACTIVE_US) {
+				hap_peak = 0;
+			}
+			hap_heard_us = now;
+			if (peak > hap_peak) {
+				hap_peak = peak;
+			}
+		} else {
+			hap_quiet_us = now;
+		}
+	}
+	return error;
+}
+
+static int
+hap_dev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw hap_cdevsw = {
+	.d_open       = hap_dev_open,
+	.d_close      = hap_dev_open,
+	.d_read       = eno_rdwrt,
+	.d_write      = hap_dev_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* the vendor drive level from a third of full scale up, five eighths of it for the softest */
+static uint8_t
+hap_drive_for(uint32_t peak)
+{
+	const uint32_t full = 32768u / 3u, low = HAP_DRIVE * 5u / 8u;
+	if (peak >= full) {
+		return HAP_DRIVE;
+	}
+	return (uint8_t)(low + (HAP_DRIVE - low) * peak / full);
+}
+
+static void
+hap_serve(void)
+{
+	bool on = false;
+	uint64_t began = 0, rest_until = 0;
+	unsigned buzzes = 0, capped = 0;
+	printf("SWEET HAPTIC: serving /dev/sweet-haptic (%llu frames written so far)\n", hap_frames);
+	while (!hs.dead) {
+		uint64_t now = hap_now_us(), heard = hap_heard_us;
+		bool want = heard != 0 && now - heard < HAP_ACTIVE_US && hap_quiet_us <= heard;
+		if (want && !on && now >= rest_until) {
+			uint8_t drive = hap_drive_for(hap_peak);
+			if (!aw_cont_start(drive)) {
+				break;
+			}
+			on = true;
+			began = now;
+			if (++buzzes <= 24) {
+				printf("SWEET HAPTIC: buzz %u: peak %u of 32768, drive %#x\n", buzzes, hap_peak, drive);
+			}
+		} else if (on && (now - began >= HAP_MAX_US || (!want && now - began >= HAP_MIN_US))) {
+			bool cap = now - began >= HAP_MAX_US;
+			aw_cont_stop();
+			on = false;
+			if (cap) {
+				rest_until = now + HAP_MAX_US;
+				if (++capped <= 8) {
+					printf("SWEET HAPTIC: buzz %u capped at %u ms; resting\n", buzzes, HAP_MAX_US / 1000u);
+				}
+			}
+			uint8_t sysint = 0;
+			if (aw_rd(0x02, &sysint) || (sysint & 0x46u)) {
+				printf("SWEET HAPTIC: after buzz %u: SYSINT %#04x: stop, chip back into reset\n", buzzes, sysint);
+				hs.dead = true;
+			}
+		}
+		hap_wait(on ? 2 : 4);
+	}
+	if (on) {
+		aw_cont_stop();
+	}
+	printf("SWEET HAPTIC: service stopped after %u buzzes (%u capped), %llu frames\n", buzzes, capped, hap_frames);
+}
