+static void
+sweet_bl_log(const char *process, const char *prefix, OSDictionary *dict, int depth)
+{
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return;
+	}
+	while (OSSymbol *key = OSDynamicCast(OSSymbol, it->getNextObject())) {
+		OSObject *v = dict->getObject(key);
+		OSNumber *n = OSDynamicCast(OSNumber, v);
+		OSDictionary *child = OSDynamicCast(OSDictionary, v);
+		IOLog("SWEET BL: %s set %s%s %s %llu bits=%u\n", process, prefix, key->getCStringNoCopy(),
+		    v ? v->getMetaClass()->getClassName() : "null", n ? n->unsigned64BitValue() : 0ULL,
+		    n ? n->numberOfBits() : 0);
+		if (child != NULL && depth < 2) {
+			char nested[64];
+			snprintf(nested, sizeof(nested), "%s%s.", prefix, key->getCStringNoCopy());
+			sweet_bl_log(process, nested, child, depth + 1);
+		}
+	}
+	it->release();
+}
