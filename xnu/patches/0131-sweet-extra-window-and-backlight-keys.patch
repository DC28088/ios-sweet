-				IOLog("SWEET BL: %s setProperties key %s %s %llu\n", name, key->getCStringNoCopy(),
-				    v ? v->getMetaClass()->getClassName() : "null", numeric ? n : 0);
-			}
-			it->release();
-		}
+		sweet_bl_log(name, "", dict, 0);
 		++fLogged;
 	}
+	/* 0127 hardware: backboardd sends brightness-nits, brightness-nits-cap,
+	 * DisplayBrightness{...}, DisplayBrightnessSliderPosition, CompensationTweak. */
+	uint64_t nits = 0;
+	if (sweet_bl_number(dict->getObject("brightness-nits"), &nits) && nits) {
+		/* CoreBrightness sends nits * 65536 (IOFixed SInt32), as Bergamota 0249
+		 * also measured on iOS 18; a negative value means off. */
+		if (nits & 0x80000000ULL) {
+			nits = 0;
+		}
+		const uint64_t mnits = ((nits & 0xffffffffULL) * 1000) >> 16;
+		const uint64_t clamped = mnits > SWEET_BL_PEAK_MNITS ? SWEET_BL_PEAK_MNITS : mnits;
+		const uint32_t level = SWEET_BL_MIN + (uint32_t)((clamped * (SWEET_BL_MAX - SWEET_BL_MIN)) / SWEET_BL_PEAK_MNITS);
+		request(level, (uint32_t)((clamped * SWEET_BL_SCALE) / SWEET_BL_PEAK_MNITS));
+		return kIOReturnSuccess;
+	}
+	OSDictionary *display = OSDynamicCast(OSDictionary, dict->getObject("DisplayBrightness"));
+	uint64_t position = 0;
+	if (display != NULL && (sweet_bl_number(display->getObject("value"), &position) ||
+	    sweet_bl_number(display->getObject("brightness"), &position)) && position > 1) {
+		const uint64_t v = position > SWEET_BL_SCALE ? SWEET_BL_SCALE : position;
+		request(SWEET_BL_MIN + (uint32_t)((v * (SWEET_BL_MAX - SWEET_BL_MIN)) / SWEET_BL_SCALE), (uint32_t)v);
+		return kIOReturnSuccess;
+	}
+	if (sweet_bl_number(dict->getObject("DisplayBrightnessSliderPosition"), &position) && position > 1) {
+		const uint64_t v = position > SWEET_BL_SCALE ? SWEET_BL_SCALE : position;
+		request(SWEET_BL_MIN + (uint32_t)((v * (SWEET_BL_MAX - SWEET_BL_MIN)) / SWEET_BL_SCALE), (uint32_t)v);
+		return kIOReturnSuccess;
+	}
