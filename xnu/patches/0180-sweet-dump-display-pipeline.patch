+/*
+ * 0180: read-only dump of the display pipeline ABL left running, for a later
+ * page-flip present (GPU blit into a back buffer, then switch the scanout
+ * address at vsync instead of the CPU copy). Offsets from the sweet DT
+ * (qcom,mdss_mdp@ae00000): SSPP vig0 0x5000 vig1 0x7000 dma0 0x25000
+ * dma1 0x27000 dma2 0x29000; CTL0-5 0x2000 + 0x200*n; LM0-3 0x45000 + 0x1000*n.
+ * Register names as Linux dpu_hw_sspp.c / dpu_hw_ctl.c / dpu_hw_lm.c. Reads only.
+ */
+#define SWEET_MDP_PA            0x0ae00000ULL
+#define SWEET_MDP_LEN           0x86000
+static void
+sweet_fb_dump_dpu(uint64_t fb_phys)
+{
+	int on = 1;
+	PE_parse_boot_argn("sweetfbdpudump", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	volatile uint32_t *mdp = (volatile uint32_t *)ml_io_map(SWEET_MDP_PA, SWEET_MDP_LEN);
+	if (mdp == NULL) {
+		IOLog("SWEET DPU: map failed\n");
+		return;
+	}
+#define R(off) (mdp[(off) / 4])
+	IOLog("SWEET DPU: fb_phys=%#llx top hw_rev=%#x\n", fb_phys, R(0x1000));
+	static const uint32_t sspp[5] = {0x5000, 0x7000, 0x25000, 0x27000, 0x29000};
+	static const char *const sspp_name[5] = {"vig0", "vig1", "dma0", "dma1", "dma2"};
+	for (unsigned i = 0; i < 5; i++) {
+		const uint32_t b = sspp[i];
+		IOLog("SWEET DPU: %s src_size=%#x img=%#x xy=%#x out=%#x out_xy=%#x addr=%#x,%#x,%#x,%#x stride=%#x,%#x fmt=%#x unpack=%#x op=%#x sw_status=%#x\n",
+		    sspp_name[i], R(b + 0x00), R(b + 0x04), R(b + 0x08), R(b + 0x0c), R(b + 0x10),
+		    R(b + 0x14), R(b + 0x18), R(b + 0x1c), R(b + 0x20), R(b + 0x24), R(b + 0x28),
+		    R(b + 0x30), R(b + 0x34), R(b + 0x38), R(b + 0x70));
+		if (i < 2) {
+			IOLog("SWEET DPU: %s qseed op=%#x phase_x=%#x phase_y=%#x preload=%#x src_y_rgb=%#x src_uv=%#x dst=%#x\n",
+			    sspp_name[i], R(b + 0xa00 + 0x04), R(b + 0xa00 + 0x24), R(b + 0xa00 + 0x28),
+			    R(b + 0xa00 + 0x30), R(b + 0xa00 + 0x44), R(b + 0xa00 + 0x48), R(b + 0xa00 + 0x4c));
+		}
+	}
+	for (unsigned n = 0; n < 6; n++) {
+		const uint32_t b = 0x2000 + 0x200 * n;
+		IOLog("SWEET DPU: ctl%u layer=%#x,%#x,%#x,%#x,%#x top=%#x flush=%#x start=%#x ext=%#x,%#x ext2=%#x,%#x ext3=%#x,%#x intf_active=%#x prepare=%#x\n",
+		    n, R(b + 0x00), R(b + 0x04), R(b + 0x08), R(b + 0x0c), R(b + 0x10), R(b + 0x14), R(b + 0x18), R(b + 0x1c),
+		    R(b + 0x40), R(b + 0x44), R(b + 0x70), R(b + 0x74), R(b + 0xa0), R(b + 0xa4), R(b + 0xf4), R(b + 0xd0));
+	}
+	for (unsigned n = 0; n < 4; n++) {
+		const uint32_t b = 0x45000 + 0x1000 * n;
+		IOLog("SWEET DPU: lm%u op=%#x out_size=%#x border=%#x stage0_op=%#x stage0_fg=%#x stage1_op=%#x\n",
+		    n, R(b + 0x00), R(b + 0x04), R(b + 0x08), R(b + 0x20), R(b + 0x24), R(b + 0x38));
+	}
+#undef R
+}
