+/* Per-window GPU and lock telemetry (0144). Busy is sampled from the
+ * framebuffer's 120 Hz timer: the newest fence still incomplete. A sample
+ * that finds the lock taken is counted apart rather than guessed. */
+namespace {
+struct MethodStat {uint64_t calls,us;};
+MethodStat method_stats[NativeAdrenoMethodSubmitResources+1];
+uint64_t lock_wait_us,lock_wait_max_us,lock_takes,wait_polls;
+unsigned busy_samples,idle_samples,locked_samples;
+uint64_t window_began_us;
+}
+extern "C" void sweet_native_adreno_sample_busy(void)
+{
+ if(!__atomic_load_n(&presentation_ready,__ATOMIC_ACQUIRE) || !backend.ring)return;
+ if(!IOLockTryLock(backend.lock)) {++locked_samples;return;}
+ const uint32_t newest=healthy()?backend.ring->lastSubmitted():0;
+ const IOReturn state=newest?backend.submit->observeFence(newest,&backend.clock,0):kIOReturnSuccess;
+ if(state==kIOReturnTimeout)++busy_samples;else ++idle_samples;
+ IOLockUnlock(backend.lock);
+}
+/* Called with the lock held after each method; prints once per 10 s. */
+static void method_window(void)
+{
+ const uint64_t now=backend.clock.now_us(backend.clock.cookie);
+ if(!window_began_us) {window_began_us=now;return;}
+ if(now-window_began_us<10000000)return;
+ static const char *const names[]={"0","query","alloc","map","free","submit","wait","ts","status","setmeta","getmeta","mkq","rmq","cpumap","cpuunmap","devinfo","import","submit-res"};
+ char line[320];size_t at=0;
+ for(unsigned i=1;i<=NativeAdrenoMethodSubmitResources && at<sizeof line;i++) {
+  if(!method_stats[i].calls)continue;
+  at+=snprintf(line+at,sizeof line-at," %s=%llu/%llu",i<sizeof names/sizeof names[0]?names[i]:"?",
+    method_stats[i].calls,method_stats[i].us/method_stats[i].calls);
+ }
+ if(at>=sizeof line)at=sizeof line-1;
+ line[at]=0;
+ const unsigned sampled=busy_samples+idle_samples;
+ IOLog("SWEET RENDER: window_ms=%llu gpu_busy_pct=%u samples=%u locked=%u lock_avg_us=%llu lock_max_us=%llu wait_polls=%llu calls/avg_us:%s\n",
+   (now-window_began_us)/1000,sampled?busy_samples*100/sampled:0,sampled,locked_samples,
+   lock_takes?lock_wait_us/lock_takes:0,lock_wait_max_us,wait_polls,line);
+ memset(method_stats,0,sizeof method_stats);
+ lock_wait_us=lock_wait_max_us=lock_takes=wait_polls=0;busy_samples=idle_samples=locked_samples=0;
+ window_began_us=now;
+}
+static void lock_timed(void)
+{
+ const uint64_t asked=backend.clock.now_us(backend.clock.cookie);
+ IOLockLock(backend.lock);
+ const uint64_t waited=backend.clock.now_us(backend.clock.cookie)-asked;
+ lock_wait_us+=waited;++lock_takes;if(waited>lock_wait_max_us)lock_wait_max_us=waited;
+}
