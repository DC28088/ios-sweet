  * The iOS userland only has status bar / layout data for real iPhone
  * screens (UIKit: "No status bar visual provider for screen", the red
  * rdar://45025538 bar for 360x800 points). The display is therefore
- * presented as the iPhone X panel, 1125x2436 (375x812 points @3x), and the
- * centered 1080x2400 part of it is shown on the 1080x2400 panel.
- * Boot-arg sweetfb_native=1 presents the real panel size instead.
+ * presented as a real iPhone screen (sweet_fb_logical_size()):
+ *   sweetfb_mode=2 (default, 0163) iPhone 12/13 mini, 1080x2340 (360x780 points @3x): the
+ *                  full width, pixel for pixel, 30 black rows above and below
+ *   sweetfb_mode=1 iPhone X, 1125x2436 (375x812 points @3x), its centered 1080x2400 shown:
+ *                  23 px cut off left and right (0152 hardware: keyboard keys, the App
+ *                  Library index and "Cancel" cut at the edges)
+ *   sweetfb_mode=0 or sweetfb_native=1: the real 1080x2400 panel (the red status bar)
+ * The ADT's /product artwork-device-subtype must match (2340 / 2436).
  */
-#define SWEET_FB_LOGICAL_W              1125
-#define SWEET_FB_LOGICAL_H              2436
+extern "C" void
+sweet_fb_logical_size(uint32_t panelW, uint32_t panelH, uint32_t *w, uint32_t *h)
+{
+	int native = 0, mode = 2;
+	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
+	PE_parse_boot_argn("sweetfb_mode", &mode, sizeof(mode));
+	*w = panelW;
+	*h = panelH;
+	if (native || panelW != 1080 || panelH != 2400) {
+		return;
+	}
+	if (mode == 2) {
+		*h = 2340;
+	} else if (mode == 1) {
+		*w = 1125;
+		*h = 2436;
+	}
+}
