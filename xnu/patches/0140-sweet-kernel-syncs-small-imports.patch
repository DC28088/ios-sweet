  * 0129 hardware: the full publish was 15.7ms of a 16.1ms submit, 204MiB in
  * 620 objects per submit. Owned cacheable BOs are always maintained. */
 extern "C" {volatile uint32_t native_adreno_import_sync=1;}
+/* With client sync, imported BOs smaller than this are still maintained by the
+ * kernel: SweetMetal2 flushes the IOSurfaces a command uses, but not
+ * newBufferWithBytesNoCopy/newTextureWithBytesNoCopy host memory. The 0129
+ * 204MiB per submit was large surfaces. 0 = maintain no imported BO. */
+extern "C" {volatile uint64_t native_adreno_import_sync_below=2u<<20;}
+static bool kernelMaintainsImport(const NativeAdrenoMemory *m)
+{
+    return native_adreno_import_sync || m->bytes()<native_adreno_import_sync_below;
+}
 static bool coherentMapping(unsigned writeback) {return writeback && native_adreno_io_coherent;}
 static bool overlap(uint64_t a,uint64_t ab,uint64_t b,uint64_t bb)
 {return a<b+bb && b<a+ab;}
