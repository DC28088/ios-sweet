+/*
+ * 0245: where in the frame the SRC0 + CTL0 flush write lands. 0244 mode 3 (flush every present, same address)
+ * flashed "here and there": guess = a flush written near the frame end / in the 32-line blanking gap races the
+ * next frame's fetch. kern.sweet_fb_flip_guard = N lines (default 64; 0 = off): a flush that would land in
+ * [last active line - N, frame end) or [0, first active line + 8) waits (<= 1 ms) until the scan is inside the
+ * active area. The 10 s line counts flushes per region (blank / near_end / active) and the guard wait.
+ */
+static unsigned int sweet_fb_flip_guard = 64;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_fb_flip_guard, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_fb_flip_guard, 0,
+    "SWEET: lines before the frame end where flip flushes wait (0245)");
