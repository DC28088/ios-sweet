+/* MMIO write followed by a readback, matching gdsc_mb() in the GDSC driver. */
+static void
+sweet_gpucc_write(uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(sweet_gpucc + offset) = value;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	(void)sweet_gpucc_read(offset);
+}
+
+static uint32_t
+sweet_gpu_reg_read(uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(sweet_gpu_regs + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
