+/*
+ * CX GDSC enable, mirroring the downstream qcom,gdsc driver for
+ * gpu_cx_gdsc: refuse HW-controlled domains, clear SW_COLLAPSE and poll
+ * GPU_CC_CX_HW_CTRL bit 31 (the DT points status at 0x1540). The parent
+ * rails were voted in earlier stages and are never written here.
+ */
+static int
+sweet_gpu_power_cx(void)
+{
+	uint32_t gdscr = sweet_gpucc_read(GPU_CC_CX_GDSCR);
+	unsigned waited;
+
+	if (gdscr & GDSC_HW_CONTROL) {
+		printf("SWEET GPU: CX GDSCR=%#x is under HW control; refusing write\n",
+		    gdscr);
+		return EBUSY;
+	}
+	printf("SWEET GPU: CX power before GDSCR=%#x hw_ctrl=%#x clk_dis_wait=%u\n",
+	    gdscr, sweet_gpucc_read(GPU_CC_CX_HW_CTRL), (gdscr >> 12) & 0xfu);
+	if (gdscr & GDSC_SW_COLLAPSE) {
+		sweet_gpucc_write(GPU_CC_CX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+	}
+	for (waited = 0; waited < 500; ++waited) {
+		uint32_t hw = sweet_gpucc_read(GPU_CC_CX_HW_CTRL);
+		if (hw & GDSC_PWR_ON) {
+			printf("SWEET GPU: CX power on after %u us; GDSCR=%#x HW_CTRL=%#x\n",
+			    waited, sweet_gpucc_read(GPU_CC_CX_GDSCR), hw);
+			return 0;
+		}
+		delay(1);
+	}
+	printf("SWEET GPU: CX power timeout after 500 us; GDSCR=%#x HW_CTRL=%#x\n",
+	    sweet_gpucc_read(GPU_CC_CX_GDSCR),
+	    sweet_gpucc_read(GPU_CC_CX_HW_CTRL));
+	return ETIMEDOUT;
+}
+
+/*
+ * GX GDSC enable, mirroring gdsc_enable() for gpu_gx_gdsc: pulse the BCR
+ * block reset for 1 us, clear GMEM_CLAMP_IO in GPU_CC_GX_DOMAIN, clear
+ * SW_COLLAPSE and poll GX_GDSCR bit 31 (GX has no HW-control register).
+ */
+static int
+sweet_gpu_power_gx(void)
+{
+	uint32_t bcr = sweet_gpucc_read(GPU_CC_GX_BCR);
+	uint32_t domain = sweet_gpucc_read(GPU_CC_GX_DOMAIN);
+	uint32_t gdscr = sweet_gpucc_read(GPU_CC_GX_GDSCR);
+	unsigned waited;
+
+	if (gdscr & GDSC_HW_CONTROL) {
+		printf("SWEET GPU: GX GDSCR=%#x is under HW control; refusing write\n",
+		    gdscr);
+		return EBUSY;
+	}
+	printf("SWEET GPU: GX power before GDSCR=%#x DOMAIN=%#x BCR=%#x\n",
+	    gdscr, domain, bcr);
+	sweet_gpucc_write(GPU_CC_GX_BCR, bcr | GX_BCR_BLK_ARES);
+	delay(1);
+	sweet_gpucc_write(GPU_CC_GX_BCR, bcr & ~GX_BCR_BLK_ARES);
+	sweet_gpucc_write(GPU_CC_GX_DOMAIN, domain & ~GX_DOMAIN_CLAMP);
+	sweet_gpucc_write(GPU_CC_GX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+	for (waited = 0; waited < 500; ++waited) {
+		uint32_t status = sweet_gpucc_read(GPU_CC_GX_GDSCR);
+		if (status & GDSC_PWR_ON) {
+			printf("SWEET GPU: GX power on after %u us; GDSCR=%#x DOMAIN=%#x BCR=%#x\n",
+			    waited, status, sweet_gpucc_read(GPU_CC_GX_DOMAIN),
+			    sweet_gpucc_read(GPU_CC_GX_BCR));
+			return 0;
+		}
+		delay(1);
+	}
+	printf("SWEET GPU: GX power timeout after 500 us; GDSCR=%#x DOMAIN=%#x BCR=%#x\n",
+	    sweet_gpucc_read(GPU_CC_GX_GDSCR),
+	    sweet_gpucc_read(GPU_CC_GX_DOMAIN), sweet_gpucc_read(GPU_CC_GX_BCR));
+	return ETIMEDOUT;
+}
+
+/* Reads are attempted only after the AHB branch reports a running clock. */
+static void
+sweet_gpu_read_aperture(void)
+{
+	unsigned count = sizeof(sweet_gpu_regs_table) / sizeof(sweet_gpu_regs_table[0]);
+	uint32_t status3;
+
+	printf("SWEET GPU: GPU aperture reads at %#x; %u registers\n",
+	    SWEET_GPU_PA, count);
+	for (unsigned i = 0; i < count; ++i) {
+		printf("SWEET GPU: REG %s @%#x=%#x\n", sweet_gpu_regs_table[i].name,
+		    sweet_gpu_regs_table[i].offset,
+		    sweet_gpu_reg_read(sweet_gpu_regs_table[i].offset));
+	}
+	status3 = sweet_gpu_reg_read(0x084cu);
+	printf("SWEET GPU: RBBM_STATUS3 smmu_stalled=%u CP_HW_FAULT=%#x\n",
+	    !!(status3 & (1u << 24)), sweet_gpu_reg_read(0x2084u));
+	printf("SWEET GPU: GPU aperture reads complete\n");
+}
