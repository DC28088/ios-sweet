@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: MIT
+ * A618 render-engine setup from pinned SM7150 a6xx_gpu/catalog/XML and
+ * qcom_ubwc_cfg_data sm7150_data. Does not reset the working CP or GMU.
+ */
+#include <IOKit/IOLib.h>
+#include "unixnu/NativeAdrenoABI.h"
+extern "C" int sweet_native_adreno_render_profile(uintptr_t mapping,NativeAdrenoAbiDeviceInfo *info)
+{
+ if(!mapping || !info)return 1;
+ auto core=reinterpret_cast<volatile uint32_t *>(mapping);
+ /* Call only after the boot timestamp fence: no render IB is published yet.
+  * CP_PROTECT, SQE, trusted range and UCHE trap already have the proven boot
+  * values. Complete the previously missing 3D blocks and GMEM/UBWC layout. */
+ static const struct {unsigned reg,value,mask;} setup[]={
+  {0x0c01,1,1}, {0x8601,1,1}, {0x8e05,1,1}, {0x9e01,1,1},
+  {0xbe05,1,1}, {0xa601,1,1}, {0x9601,1,1}, {0xae01,1,1}, {0xb601,1,1},
+  {0x050b,0xffffffff,0}, {0x0500,1,1},
+  {0x0e0b,0x100000,0xffffffff}, {0x0e0c,0,0xffffffff},
+  {0x0e0d,0x17ffff,0xffffffff}, {0x0e0e,0,0xffffffff},
+  {0x9e00,0x00180000,0x00180000},
+  /* UBWC2: bank14 (hbb_lo1), min32B, four channels, levels2+3 swizzle. */
+  {0x8e08,2,0xffffffff}, {0xb604,2,0xffffffff}, {0xae02,2,0xffffffff},
+  {0x0e01,1u<<21,(1u<<23)|(3u<<21)}, {0x0534,0,1}, {0x0e19,0x81,0x81},
+ };
+ for(const auto &entry:setup) {
+  core[entry.reg]=entry.value;
+  __asm__ volatile("dsb sy":::"memory");
+  const uint32_t value=core[entry.reg];
+  if(value==UINT32_MAX && entry.value!=UINT32_MAX)return 1;
+  if((value&entry.mask)!=(entry.value&entry.mask)) {
+   IOLog("SWEET RENDER: reg=%#x expected=%#x read=%#x\n",entry.reg,entry.value,value);return 1;
+  }
+ }
+ if(core[0x084f]!=0xb || core[0x0e09]!=0xfffff000 || core[0x0e0a]!=0x1ffff)return 1;
+ *info={0x06010800,512u*1024u,0x100000,UINT64_C(0x1fffffffff000),
+     UINT64_C(0x40000000),UINT64_C(0x30000000),14,6,0,2,NativeAdrenoDeviceClientIova,0};
+ IOLog("SWEET RENDER: A618 address modes/GMEM512K/UBWC2 programmed and read back\n");
+ return 0;
+}
