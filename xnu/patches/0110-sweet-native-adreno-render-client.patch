diff --git a/iokit/Kernel/arm/SweetNativeAdrenoClient.cpp b/iokit/Kernel/arm/SweetNativeAdrenoClient.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNativeAdrenoClient.cpp
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: MIT
+ * IOKit transport for the real NativeAdreno ABI. One compositor connection,
+ * one resource gate, synchronous quiescence before VM edits/cache publication.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include "unixnu/NativeAdrenoUserClient.h"
+extern "C" void proc_selfname(char *,int);
+extern "C" volatile uint32_t native_adreno_wc_enabled;
+namespace {
+struct Backend {
+ NativeAdrenoVm *vm=nullptr;
+ NativeAdrenoSubmit *submit=nullptr;
+ NativeAdrenoRing *ring=nullptr;
+ IOLock *lock=nullptr;
+ NativeAdrenoRingClock clock{};
+ NativeAdrenoTimer timer;
+ NativeAdrenoStatus status;
+ NativeAdrenoAbiDeviceInfo info{};
+ int (*health)(void *)=nullptr;
+ bool published=false,opened=false,lost=false;
+} backend;
+bool healthy()
+{
+ if(backend.lost)return false;
+ if(!backend.health || backend.health(nullptr) || backend.vm->poisoned() ||
+    backend.submit->poisoned() || backend.ring->poisoned()) {
+  backend.lost=true;backend.status.noteFault();return false;
+ }
+ return true;
+}
+IOReturn quiesce()
+{
+ if(!healthy())return kIOReturnIOError;
+ IOReturn result=backend.submit->waitAll(&backend.clock,1000000);
+ if(!result)result=backend.ring->drainA6xx(&backend.clock,1000000);
+ if(result) {backend.lost=true;backend.status.noteFault();}
+ return result;
+}
+}
+class AGXDeviceUserClient : public IOUserClient {
+ OSDeclareDefaultStructors(AGXDeviceUserClient)
+ NativeAdrenoUserClient *core_=nullptr;
+ task_t task_=TASK_NULL;
+ bool mounted_=false,closed_=false;
+public:
+ bool mount(task_t task,void *securityID,UInt32 type,OSDictionary *properties);
+ IOReturn externalMethod(uint32_t selector,IOExternalMethodArguments *arguments,
+     IOExternalMethodDispatch *dispatch,OSObject *target,void *reference) APPLE_KEXT_OVERRIDE;
+ IOReturn clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+ IOReturn clientClose() APPLE_KEXT_OVERRIDE;
+ void free() APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AGXDeviceUserClient,IOUserClient)
+/* Userland discovery matches this class, then loads the actual Metal bundle.
+ * The service is published only after VM, CP, render profile and transport are
+ * connected; unsupported Apple IOAccelerator command types stay unsupported. */
+class IOAcceleratorES : public IOService {
+ OSDeclareDefaultStructors(IOAcceleratorES)
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES,IOService)
+class AGXAccelerator : public IOAcceleratorES {
+ OSDeclareDefaultStructors(AGXAccelerator)
+public:
+ IOReturn newUserClient(task_t task,void *securityID,UInt32 type,OSDictionary *properties,
+     IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AGXAccelerator,IOAcceleratorES)
+bool AGXDeviceUserClient::mount(task_t task,void *securityID,UInt32 type,OSDictionary *properties)
+{
+ if(!IOUserClient::initWithTask(task,securityID,type,properties))return false;
+ task_=task;
+ core_=new NativeAdrenoUserClient;
+ if(!core_)return false;
+ IOReturn error=core_->open(NativeAdrenoAbiVersion,backend.vm,backend.submit,backend.ring,32,36);
+ if(!error)error=core_->setScope(0,backend.info.va_start,backend.info.va_size);
+ if(!error)error=core_->attachTimer(&backend.timer);
+ if(!error)error=core_->attachStatus(&backend.status);
+ if(!error)error=core_->attachDeviceInfo(&backend.info);
+ if(error) {if(core_->close()!=kIOReturnSuccess)backend.lost=true;return false;}
+ mounted_=true;return true;
+}
+IOReturn AGXAccelerator::newUserClient(task_t task,void *securityID,UInt32 type,
+    OSDictionary *properties,IOUserClient **handler)
+{
+ if(!handler)return kIOReturnBadArgument;
+ *handler=nullptr;
+ if(type!=0x4147 || task!=current_task())return kIOReturnUnsupported;
+ char name[32]={};proc_selfname(name,sizeof name);
+ if(strcmp(name,"backboardd"))return kIOReturnNotPrivileged;
+ IOLockLock(backend.lock);
+ if(backend.opened || !healthy()) {IOLockUnlock(backend.lock);return kIOReturnBusy;}
+ auto client=new AGXDeviceUserClient;
+ if(!client || !client->mount(task,securityID,type,properties) || !client->attach(this) || !client->start(this)) {
+  if(client)client->release();
+  IOLockUnlock(backend.lock);return kIOReturnNoResources;
+ }
+ backend.opened=true;*handler=client;
+ IOLockUnlock(backend.lock);return kIOReturnSuccess;
+}
+IOReturn AGXDeviceUserClient::clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory)
+{
+ if(!options || !memory)return kIOReturnBadArgument;
+ *memory=nullptr;
+ IOLockLock(backend.lock);
+ NativeAdrenoMemory *buffer=mounted_ && !closed_?core_->memoryForToken(type):nullptr;
+ auto descriptor=buffer?buffer->descriptor():nullptr;
+ if(!descriptor || buffer->quarantined()) {IOLockUnlock(backend.lock);return kIOReturnBadArgument;}
+ /* Return this same original descriptor on every map/unmap query. Its maps
+  * retain the BO allocation until the last user mapping really disappears. */
+ descriptor->retain();*memory=descriptor;*options=kIOMapDefaultCache;
+ IOLockUnlock(backend.lock);return kIOReturnSuccess;
+}
+IOReturn AGXDeviceUserClient::externalMethod(uint32_t selector,IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *,OSObject *,void *)
+{
+ if(!args || args->scalarInputCount || args->scalarOutputCount || args->structureInputDescriptor ||
+    args->structureOutputDescriptor)return kIOReturnBadArgument;
+ IOExternalMethodArguments forwarded=*args;
+ if(args->structureInput && args->structureInputSize>=8) {
+  uint32_t tunnel[2];memcpy(tunnel,args->structureInput,sizeof tunnel);
+  if(tunnel[0]==0x4e544e4c) {
+   if(tunnel[1]==UINT32_MAX) {
+    if(args->structureInputSize!=8 || args->structureOutputSize)return kIOReturnBadArgument;
+    IOLockLock(backend.lock);
+    const bool accepted=mounted_ && !closed_ && healthy();
+    IOLockUnlock(backend.lock);return accepted?kIOReturnSuccess:kIOReturnNotReady;
+   }
+   selector=tunnel[1];
+   forwarded.structureInput=static_cast<const unsigned char *>(args->structureInput)+8;
+   forwarded.structureInputSize-=8;args=&forwarded;
+  }
+ }
+ if(selector<1 || selector>NativeAdrenoMethodBoImport)return kIOReturnUnsupported;
+ const size_t input=NativeAdrenoUserClient::inputSize(selector),output=NativeAdrenoUserClient::outputSize(selector);
+ if(args->structureInputSize!=input || args->structureOutputSize!=output ||
+    (input && !args->structureInput) || (output && !args->structureOutput))return kIOReturnBadArgument;
+ IOLockLock(backend.lock);
+ if(!mounted_ || closed_ || !healthy()) {IOLockUnlock(backend.lock);return kIOReturnNotReady;}
+ IOReturn result=kIOReturnSuccess;
+ // The single shared context must be idle through EVERY table edit and cache
+ // publication; completion is the actual CP fence, not a job-count estimate.
+ if(selector==NativeAdrenoMethodBoMap || selector==NativeAdrenoMethodBoFree || selector==NativeAdrenoMethodSubmit)
+  result=quiesce();
+ if(!result && selector==NativeAdrenoMethodBoImport) {
+  NativeAdrenoAbiBoImport request{};NativeAdrenoAbiBoAllocReply reply{};
+  memcpy(&request,args->structureInput,sizeof request);
+  result=core_->importBo(&request,task_,&reply);
+  if(!result)memcpy(args->structureOutput,&reply,sizeof reply);
+ } else if(!result)result=core_->dispatch(selector,args->structureInput,input,args->structureOutput,output,&backend.clock);
+ if(!result)args->structureOutputSize=output;
+ IOLockUnlock(backend.lock);return result;
+}
+IOReturn AGXDeviceUserClient::clientClose()
+{
+ IOLockLock(backend.lock);
+ if(closed_) {IOLockUnlock(backend.lock);return kIOReturnSuccess;}
+ closed_=true;
+ IOReturn error=mounted_?quiesce():kIOReturnSuccess;
+ if(!error && mounted_)error=core_->releaseAll(&backend.clock,1000000);
+ if(error) {
+  backend.lost=true;
+  // Keep uncertain GPU resources and their bookkeeping alive for this boot.
+  retain();
+ } else {mounted_=false;backend.opened=false;}
+ IOLockUnlock(backend.lock);
+ terminate();return error;
+}
+void AGXDeviceUserClient::free()
+{
+ if(core_) {
+  if(mounted_) {
+   // Partial open/start failure: no GPU job was submitted, but do not discard
+   // an object that still owns resources on a failed close.
+   if(core_->close()!=kIOReturnSuccess) {backend.lost=true;core_=nullptr;}
+  }
+  if(core_) {delete core_;core_=nullptr;}
+ }
+ IOUserClient::free();
+}
+extern "C" int sweet_native_adreno_publish(NativeAdrenoVm *vm,NativeAdrenoSubmit *submit,
+    NativeAdrenoRing *ring,IOLock *gate,const NativeAdrenoRingClock *clock,
+    int (*health)(void *),int (*read)(void *,uint32_t,uint32_t *),const NativeAdrenoAbiDeviceInfo *info)
+{
+ if(backend.published || !vm || !submit || !ring || !gate || !clock || !clock->now_us || !health || !read || !info)return 1;
+ backend.vm=vm;backend.submit=submit;backend.ring=ring;backend.lock=gate;
+ backend.clock=*clock;backend.health=health;backend.info=*info;
+ const NativeAdrenoTimeIo timerIo={nullptr,read};
+ if(backend.timer.attach(&timerIo,NativeAdrenoTimeCp)!=kIOReturnSuccess || !healthy())return 1;
+ native_adreno_wc_enabled=0; // explicit cache maintenance until page modes are qualified
+ auto provider=new AGXAccelerator;
+ if(!provider || !provider->init() || !provider->attach(IOService::getPlatform())) {
+  if(provider)provider->release();return 1;
+ }
+ provider->setName("NativeAdrenoGpu");
+ provider->setProperty("MetalPluginName","NativeAdrenoMetal");
+ provider->setProperty("model","Adreno 618");
+ provider->setProperty("NativeAdrenoABI",NativeAdrenoAbiVersion,32);
+ backend.published=true;provider->registerService();
+ IOLog("SWEET RENDER: NativeAdreno ABI + Metal discovery published on live A618 context\n");
+ return 0;
+}
