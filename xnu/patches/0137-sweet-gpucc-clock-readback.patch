+/* Read-only GPUCC view of the real GX clock (Lineage gpucc-sm6150.c): alpha
+ * PLLs at +0x0/+0x100 (L +4, ALPHA +8, ALPHA_U +0xc, USER_CTL +0x10) feed
+ * gpu_cc_gx_gfx3d_clk_src (CMD_RCGR 0x101c, CFG 0x1020: SRC_SEL [10:8],
+ * SRC_DIV [4:0]) through a CRC divider. Logged raw with the VCO estimate. */
+static void
+sweet_gpu_clock_regs(const char *tag)
+{
+	if (!sweet_gpucc) {
+		return;
+	}
+	for (unsigned pll = 0; pll < 2; ++pll) {
+		const uint32_t base = pll * 0x100u;
+		const uint32_t l = sweet_gpucc_read(base + 0x4) & 0xffffu;
+		const uint32_t alpha = sweet_gpucc_read(base + 0x8), alpha_u = sweet_gpucc_read(base + 0xc) & 0xffu;
+		const uint64_t frac = ((uint64_t)alpha_u << 32) | alpha;
+		const uint64_t khz = 19200ULL * l + ((19200ULL * frac) >> 40);
+		printf("SWEET ADRENO: %s GPU PLL%u mode=%#x L=%u alpha=%#llx user_ctl=%#x vco~%llu kHz\n", tag, pll,
+		    sweet_gpucc_read(base), l, (unsigned long long)frac, sweet_gpucc_read(base + 0x10), (unsigned long long)khz);
+	}
+	const uint32_t cmd = sweet_gpucc_read(0x101c), cfg = sweet_gpucc_read(0x1020);
+	printf("SWEET ADRENO: %s gfx3d RCG cmd=%#x cfg=%#x src_sel=%u src_div=%u crc_fsm=%#x crc_mnd=%#x\n", tag, cmd, cfg,
+	    (cfg >> 8) & 7, cfg & 0x1f, sweet_gpucc_read(0x1024), sweet_gpucc_read(0x1028));
+}
+
 static void
 sweet_gpu_raise_clock(vm_offset_t core, vm_offset_t gmu)
 {
