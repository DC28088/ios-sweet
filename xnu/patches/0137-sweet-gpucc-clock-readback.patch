 	const uint32_t before = sweet_gpu_measure_khz(core);
 	printf("SWEET ADRENO: GX clock measured=%u kHz at perf index 1 (configured %u kHz)\n",
 	    before, a618_gpu_level_count ? a618_gpu_levels[0].khz : 267000u);
@@ -326,6 +351,7 @@ sweet_gpu_raise_clock(vm_offset_t core, vm_offset_t gmu)
