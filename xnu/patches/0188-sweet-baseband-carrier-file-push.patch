+// Sweet: CommCenter's carrier-file push (QMIBasebandSettingsDriver::sendSegmentWithData_sync, libCommCenterMCommandDrivers): BSP
+// SendFile 0xa000 per segment, TLV 0x01 FileTransferInfo {u8 file type (bsp::QMIFileType: 3 PRI, 6 GRI, 7/8 DER PRI/GRI, ...), u8,
+// u16 segment number from 0, u16 total segments, data}, a signature on the last one; done when the baseband sends FileTransferStatus
+// 0xa001 with TLV 0x01 {u8 file type, u8 result, 0 = FILE_TRANSFER_SUCCESS}. This modem runs its own Qualcomm configuration, so the
+// files are taken and dropped. Unanswered, every push failed and CommCenter reset the baseband after each round (an endless loop).
+#define BB_BSP_SEND_FILE 0xa000u
+#define BB_BSP_FILE_TRANSFER_STATUS 0xa001u
+static uint32_t bb_files_logged;
+static int bb_send_file(uint32_t channel, const struct cbq_result &r, const uint8_t *sdu)
+{
+  uint32_t len = 0;
+  const uint8_t *info = cbd_find(sdu, r.len, 0x01u, &len);   // TLV 0x10 is the signature, 0x11 a flag
+  const uint32_t type = info && len >= 6 ? info[0] : 0, segment = info && len >= 6 ? cbd_rd16(info + 2) : 0,
+                 total = info && len >= 6 ? cbd_rd16(info + 4) : 0;
+  uint32_t n = cbq_private_answer(sdu, r.service, r.cid, 0, nullptr, 0, bb_out, sizeof bb_out);
+  if (n) bb_push(channel, bb_out, n);
+  const bool last = info && len >= 6 && segment + 1u >= total;
+  if (bb_files_logged < 24 && (segment == 0 || last)) {
+    bb_files_logged++;
+    printf("SWEET BB: carrier file type %u segment %u of %u accepted%s\n", type, segment, total, last ? ", transfer done" : "");
+  }
+  if (last) {
+    const uint8_t status[] = { 0x01, 0x02, 0x00, (uint8_t)type, 0x00 };
+    n = cbq_private_indication(BB_BSP_FILE_TRANSFER_STATUS, r.service, r.cid, status, sizeof status, bb_out, sizeof bb_out);
+    if (n) bb_push(channel, bb_out, n);
+  }
+  return 1;
+}
