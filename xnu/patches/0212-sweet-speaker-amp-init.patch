+static int
+amp_write(uint8_t addr, uint16_t reg, uint16_t val)
+{
+	uint8_t tx[3] = {(uint8_t)reg, (uint8_t)(val >> 8), (uint8_t)val};
+	return amp_msg(addr, tx, sizeof(tx), NULL, 0, false);
+}
+
+static bool
+amp_write_seq(uint8_t addr, const uint16_t (*seq)[2], unsigned n)
+{
+	for (unsigned i = 0; i < n; ++i) {
+		int err = amp_write(addr, seq[i][0], seq[i][1]);
+		if (err) {
+			printf("SWEET AMP: write %s reg %#x val %#x failed %d\n",
+			    addr == 0x34 ? "TOP" : "BOT", seq[i][0], seq[i][1], err);
+			return false;
+		}
+	}
+	return true;
+}
