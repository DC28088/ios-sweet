+/*
+ * CPU DVFS through the SM7150 cpufreq-hw (OSM) domains. Nothing in this
+ * kernel ever wrote REG_PERF_STATE, so the cores stayed at whatever index the
+ * bootloader left. Register layout is Linux qcom-cpufreq-hw.c qcom_soc_data
+ * (the pinned sm7150.dtsi uses "qcom,cpufreq-hw"): enable 0x0, LUT 0x110 and
+ * voltage 0x114 in 32-byte rows, current (throttled) vote 0x704, perf state
+ * 0x920. The hardware owns voltage (CPR) and limits management; only a LUT
+ * index is written. Each cluster's clock is estimated before and after from
+ * a dependent-add chain against the architected timer, on a bound core.
+ * sweetcpufreq=0 logs only; 1 (default) selects the highest non-boost row.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern "C" processor_t thread_bind(processor_t);
+
+#define SWEET_OSM_ENABLE        0x000
+#define SWEET_OSM_DCVS_CTRL     0x0bc
+#define SWEET_OSM_FREQ_LUT      0x110
+#define SWEET_OSM_VOLT_LUT      0x114
+#define SWEET_OSM_CURRENT_VOTE  0x704
+#define SWEET_OSM_PERF_STATE    0x920
+#define SWEET_OSM_LUT_ROW       32u
+#define SWEET_OSM_LUT_MAX       40u
+#define SWEET_OSM_XO_KHZ        19200u
+#define SWEET_OSM_GPLL0_KHZ     300000u
+
+/* 64 dependent adds per iteration: one per cycle on both A55 and A76. */
+static uint64_t
+sweet_cpu_measure_khz(void)
+{
+	const uint64_t iterations = 20000;
+	boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+	uint64_t acc = 0, n = iterations;
+	uint64_t begin = mach_absolute_time();
+	__asm__ volatile(
+		"1:\n"
+		".rept 64\n"
+		"add %0, %0, #1\n"
+		".endr\n"
+		"subs %1, %1, #1\n"
+		"b.ne 1b\n"
+		: "+r"(acc), "+r"(n) : : "cc");
+	uint64_t ticks = mach_absolute_time() - begin;
+	ml_set_interrupts_enabled(enabled);
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(ticks, &ns);
+	return ns ? (iterations * 64 * 1000000ULL) / ns : 0;
+}
+
+static void
+sweet_cpufreq_domain(const ml_topology_info_t *topology, unsigned domain,
+    uint64_t pa, unsigned first_cpu, int mode)
+{
+	volatile uint32_t *osm = (volatile uint32_t *)ml_io_map(pa, 0x1400);
+	if (osm == NULL || first_cpu >= topology->num_cpus || sweet_cpus[first_cpu] == NULL) {
+		IOLog("SWEET CPUFREQ: domain %u unavailable\n", domain);
+		return;
+	}
+	const uint32_t enable = osm[SWEET_OSM_ENABLE / 4];
+	const uint32_t dcvs = osm[SWEET_OSM_DCVS_CTRL / 4];
+	const uint32_t state = osm[SWEET_OSM_PERF_STATE / 4];
+	const uint32_t vote = osm[SWEET_OSM_CURRENT_VOTE / 4];
+	IOLog("SWEET CPUFREQ: domain %u pa=0x%llx enable=%#x dcvs=%#x perf_state=%u current_vote=%#x (%u kHz)\n",
+	    domain, pa, enable, dcvs, state, vote, (vote & 0x3ff) * SWEET_OSM_XO_KHZ);
+	if (!(enable & 1)) {
+		IOLog("SWEET CPUFREQ: domain %u hardware not enabled; no write\n", domain);
+		return;
+	}
+	uint32_t khz[SWEET_OSM_LUT_MAX] = {0};
+	unsigned rows = 0, best = SWEET_OSM_LUT_MAX;
+	for (unsigned i = 0; i < SWEET_OSM_LUT_MAX; i++) {
+		const uint32_t data = osm[(SWEET_OSM_FREQ_LUT + i * SWEET_OSM_LUT_ROW) / 4];
+		const uint32_t volt = osm[(SWEET_OSM_VOLT_LUT + i * SWEET_OSM_LUT_ROW) / 4];
+		const uint32_t src = data >> 30, lval = data & 0xff, cores = (data >> 16) & 7;
+		khz[i] = src ? SWEET_OSM_XO_KHZ * lval : SWEET_OSM_GPLL0_KHZ;
+		IOLog("SWEET CPUFREQ: domain %u lut %u data=%#x %u kHz cores=%u volt=%u mV\n",
+		    domain, i, data, khz[i], cores, volt & 0xfff);
+		/* Linux: a repeated frequency ends the table. */
+		if (i > 0 && khz[i] == khz[i - 1]) {
+			break;
+		}
+		rows = i + 1;
+		/* core_count 1 marks a boost-only row (LUT_TURBO_IND). */
+		if (cores != 1 && (best == SWEET_OSM_LUT_MAX || khz[i] > khz[best])) {
+			best = i;
+		}
+	}
+	processor_t processor = sweet_cpus[first_cpu]->processor();
+	thread_bind(processor);
+	thread_block(THREAD_CONTINUE_NULL);
+	const uint64_t before = sweet_cpu_measure_khz();
+	IOLog("SWEET CPUFREQ: domain %u cpu=%d measured before=%llu kHz (LUT state %u = %u kHz)\n",
+	    domain, cpu_number(), before, state, state < rows ? khz[state] : 0);
+	if (mode == 1 && best < rows && best != state) {
+		osm[SWEET_OSM_PERF_STATE / 4] = best;
+		__builtin_arm_dsb(DSB_SY);
+		IOSleep(5);
+		const uint64_t after = sweet_cpu_measure_khz();
+		IOLog("SWEET CPUFREQ: domain %u selected lut %u = %u kHz; readback perf_state=%u current_vote=%#x (%u kHz) measured after=%llu kHz\n",
+		    domain, best, khz[best], osm[SWEET_OSM_PERF_STATE / 4],
+		    osm[SWEET_OSM_CURRENT_VOTE / 4], (osm[SWEET_OSM_CURRENT_VOTE / 4] & 0x3ff) * SWEET_OSM_XO_KHZ, after);
+	} else {
+		IOLog("SWEET CPUFREQ: domain %u no write (mode=%d best=%u rows=%u)\n", domain, mode, best, rows);
+	}
+	thread_bind(PROCESSOR_NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+sweet_cpufreq_start(const ml_topology_info_t *topology)
+{
+	int mode = 1;
+	PE_parse_boot_argn("sweetcpufreq", &mode, sizeof(mode));
+	/* Pinned sm7150.dtsi: cpu0-5 freq-domain 0, cpu6-7 freq-domain 1. */
+	sweet_cpufreq_domain(topology, 0, 0x18323000ULL, 0, mode);
+	sweet_cpufreq_domain(topology, 1, 0x18325800ULL, 6, mode);
+}
+
 /* Do not wait in a nub's start(): matching can be asynchronous or serialized. */
 void
 SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
@@ -175,6 +294,7 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	ml_set_max_cpus(topology->max_cpu_id + 1);
 	IOLog("SWEET CPU: %u/%u CPUs initialized, SGI1 verified\n",
 	    topology->num_cpus, topology->num_cpus);
+	sweet_cpufreq_start(topology);
 	thread_terminate(current_thread());
 }
 
