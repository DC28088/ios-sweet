diff --git a/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp b/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: MIT
+ * sweet/A618 live BO arena. Called before SQE release, under the boot GPU
+ * owner's lease. Never replaces an enabled CB0 or touches GMU CB1.
+ */
+#include <IOKit/IOLib.h>
+#include <sys/errno.h>
+#include "../../../bsd/dev/sweet_adreno_cp.h"
+#include "unixnu/NativeAdrenoVm.h"
+#include "unixnu/NativeAdrenoSubmit.h"
+
+namespace {
+constexpr unsigned PollBudget=100000, TableBytes=0x404000;
+constexpr uint64_t ArenaStart=0x40000000, ArenaBytes=0x80000000;
+struct BootVm {
+ NativeAdrenoMemory tables,firmware,ring,fence;
+ NativeAdrenoVm vm;
+ NativeAdrenoSubmit submit;
+ ArmSmmu4KLiveArena arena{};
+ ArmSmmu4KLiveState live{};
+ ArmSmmu4KLiveVisibility visibility{};
+ ArmSmmu4KContextConfig config{};
+ ArmSmmu4KStreamState streams{};
+ ArmSmmu4KIo io{};
+ a618_smmu_io hardware{};
+ uint64_t handles[3]{};
+ bool attempted=false,ready=false,connected=false;
+} state;
+int read32(void *,size_t offset,uint32_t *value)
+{
+ if(!value || (offset&3) || offset>0xfffc)return 1;
+ *value=state.hardware.registers.read(state.hardware.registers.cookie,(uint32_t)offset);
+ return *value==UINT32_MAX;
+}
+int read64(void *,size_t offset,uint64_t *value)
+{
+ if(!value || (offset&7) || offset>0xfff8)return 1;
+ *value=state.hardware.read64(state.hardware.registers.cookie,(uint32_t)offset);
+ return *value==UINT64_MAX;
+}
+int write32(void *,size_t offset,uint32_t value)
+{
+ /* Restrict the helper to its leased CB0 and one stream slot. The SMMU
+  * core does no global writes, and never accesses the GMU context bank. */
+ const unsigned slot=state.streams.streams[0].slot;
+ if((offset&3) || !((offset>=0x8000 && offset<=0x8ffc) || offset==0x1000 ||
+     offset==0x1800 || offset==0x800+4*slot || offset==0xc00+4*slot))return 1;
+ state.hardware.registers.write(state.hardware.registers.cookie,(uint32_t)offset,value);
+ return 0;
+}
+int write64(void *,size_t offset,uint64_t value)
+{
+ if((offset&7) || offset<0x8000 || offset>0x8ff8)return 1;
+ state.hardware.write64(state.hardware.registers.cookie,(uint32_t)offset,value);
+ return 0;
+}
+int barrier(void *)
+{state.hardware.barrier(state.hardware.registers.cookie);return 0;}
+int failed(const char *where,IOReturn error)
+{
+ /* All descriptor and VM storage is retained on an uncertain failure. There
+  * is no fallback that clears active tables or restarts an already-run SQE. */
+ IOLog("SWEET NATIVE VM: %s failed=%#x; all resources retained\n",where,error);
+ state.ready=false;return EIO;
+}
+int translate(uint64_t iova,uint64_t *physical)
+{
+ if(write64(nullptr,0x8800,iova) || barrier(nullptr))return EIO;
+ for(unsigned i=0;i<1000;++i) {
+  uint32_t status=0;
+  if(read32(nullptr,0x88f0,&status))return EIO;
+  if(!(status&1))return read64(nullptr,0x8050,physical)?EIO:0;
+  state.hardware.registers.delay_us(state.hardware.registers.cookie,1);
+ }
+ return ETIMEDOUT;
+}
+}
+extern "C" int sweet_native_adreno_prepare_vm(const a618_smmu_io *hardware,
+    const a618_dma_region *memory,a618_smmu_result *result)
+{
+ if(!hardware || !memory || !result || !hardware->registers.read || !hardware->registers.write ||
+    !hardware->registers.delay_us || !hardware->read64 || !hardware->write64 || !hardware->barrier ||
+    !memory->cpu || !memory->uncached || memory->bytes!=A618_CP_DMA_BYTES ||
+    (memory->physical&0x3fff) || memory->physical>=(UINT64_C(1)<<36) ||
+    memory->bytes>(UINT64_C(1)<<36)-memory->physical)return EINVAL;
+ if(state.attempted)return EBUSY;
+ state.attempted=true;state.hardware=*hardware;*result={};result->slot=UINT32_MAX;
+ state.io={nullptr,0x10000,read32,read64,write32,write64,barrier,1};
+ uint32_t id0=0,id1=0,id2=0,control=0,sctlr=0,fsr=0;
+ if(read32(nullptr,0x20,&id0) || read32(nullptr,0x24,&id1) || read32(nullptr,0x28,&id2) ||
+    read32(nullptr,0,&control) || read32(nullptr,0x8000,&sctlr) || read32(nullptr,0x8058,&fsr))return EIO;
+ if(fsr&(1u<<30))return EBUSY;
+ if(id0!=0x48016605 || id1!=0x20008005 || id2!=0x7511 || (sctlr&1))return ENOTSUP;
+ /* Claim only an invalid slot. An active SID0 or any live CB0 route is a
+  * foreign owner, regardless of its apparent idle state. */
+ unsigned slot=UINT32_MAX;
+ for(unsigned i=0;i<5;++i) {
+  uint32_t smr=0,s2cr=0;
+  if(read32(nullptr,0x800+4*i,&smr) || read32(nullptr,0xc00+4*i,&s2cr))return EIO;
+  if(smr&(1u<<31)) {
+   const uint32_t mask=(smr>>16)&0x7fff;
+   if(((smr&0xffff)&~mask)==0 || (!(s2cr&(3u<<16)) && !(s2cr&255)))return EBUSY;
+  } else if(slot==UINT32_MAX)slot=i;
+ }
+ if(slot==UINT32_MAX)return ENOSPC;
+ result->slot=slot;result->context=0;result->control=control;
+ /* The boot GMU owner has already established enable/fault-on-unmatched,
+  * with global IRQ disabled. Preserve that policy and every other route. */
+ if((control&0x407)!=0x402)return ENOTSUP;
+ state.streams.streams[0]={slot,0};
+ if(write32(nullptr,0xc00+4*slot,2u<<16) || barrier(nullptr))return EIO;
+ const ArmSmmu4KStream stream={slot,0};ArmSmmu4KStreamResult routes{};
+ ArmSmmu4KStatus status=ArmSmmu4KCheckFaultedStreams(&state.io,&stream,1,0,&routes);
+ if(status)return failed("route preflight",(IOReturn)status);
+ IOReturn error=state.tables.allocate(TableBytes,36,true,8u*1024u*1024u);
+ if(error)return failed("table allocation",error);
+ error=NativeAdrenoPrepareSmmuMemory(&state.tables,32,36,ArenaStart,ArenaBytes,0,
+     ArenaBytes/4096,&state.arena,&state.live,&state.visibility);
+ if(error)return failed("table preparation",error);
+ state.config={&state.arena.config,nullptr,&state.live.tables,nullptr,id0,id2,0x62,0,0,1,1};
+ ArmSmmu4KProgramResult programmed{};
+ status=ArmSmmu4KProgramDisabledContext(&state.io,0,&state.config,PollBudget,&programmed);
+ if(status)return failed("context programming",(IOReturn)status);
+ status=ArmSmmu4KAttachStreams(&state.io,&state.streams,&stream,1,0,&state.config,&routes);
+ if(status)return failed("stream attachment",(IOReturn)status);
+ NativeAdrenoVmRegion region={&state.tables,&state.arena,&state.live};
+ error=state.vm.attach(&state.io,&state.config,&state.streams,&region,nullptr,65536,PollBudget);
+ if(error)return failed("VM attachment",error);
+ NativeAdrenoMemory *objects[]={&state.firmware,&state.ring,&state.fence};
+ const unsigned offsets[]={A618_CP_SQE_OFFSET,A618_CP_RING_OFFSET,A618_CP_FENCE_OFFSET};
+ const unsigned sizes[]={0x8000,0x8000,0x4000};
+ const uint64_t addresses[]={A618_CP_IOVA,A618_CP_RING_IOVA,A618_CP_FENCE_IOVA};
+ for(unsigned i=0;i<3;++i) {
+  error=objects[i]->borrowBootStorage(memory->cpu+offsets[i],memory->physical+offsets[i],sizes[i],36);
+  if(!error)error=state.vm.map(objects[i],0,addresses[i],ArmSmmu4KRead|
+      (i?ArmSmmu4KWrite:ArmSmmu4KExecute),0,2,&state.handles[i]);
+  if(error)return failed("bootstrap mapping",error);
+ }
+ /* Prove real translations for the unchanged firmware/ring/fence IOVAs,
+  * including the immediately following unmapped guard, before SQE starts. */
+ for(unsigned i=0;i<=20;++i) {
+  uint64_t translated=0;
+  const int failure=translate(A618_CP_IOVA+4096ull*i,&translated);
+  result->par=translated;
+  if(failure)return failure;
+  if(i==20) {if(!(translated&1))return EFAULT;}
+  else {
+   const uint64_t expected=memory->physical+A618_CP_SQE_OFFSET+4096ull*i;
+   if((translated&1) || (translated&UINT64_C(0xffffff000))!=expected)return EFAULT;
+   ++result->translated;
+  }
+ }
+ if(read32(nullptr,0x8058,&result->fault) || (result->fault&0xc00001feu))return EIO;
+ result->offset=0x800+4*slot;
+ if(read32(nullptr,result->offset,&result->value))return EIO;
+ state.ready=true;
+ IOLog("SWEET NATIVE VM: CB0 active ASID62 4K GPU /16K host, aperture=%#llx+%#llx tablePA=%#llx pages=%lu bootstrap=%u\n",
+     ArenaStart,ArenaBytes,state.tables.spans()[0].physical,state.live.tables.table_pages,result->translated);
+ return 0;
+}
+extern "C" int sweet_native_adreno_connect_vm(NativeAdrenoRing *ring)
+{
+ if(!state.ready || state.connected || !ring)return ENXIO;
+ const IOReturn error=state.submit.attach(&state.vm,ring);
+ if(error)return failed("submit attachment",error);
+ state.connected=true;
+ IOLog("SWEET NATIVE VM: live BO/IB submission manager connected; frontend not published\n");
+ return 0;
+}
