diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c
index 2977dae..30a4a32 100644
--- a/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c
@@ -59,10 +59,12 @@ ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *c,
     if(c->profile==1) {
         if(c->id0!=0x48016605 || c->id2!=0x7511 || !c->lower || c->upper ||
             c->lower->input_bits!=32 || c->lower->output_bits!=36 || c->asid!=0x62 ||
-            c->coherent_walk || c->stall_on_fault || !c->continue_after_fault)return ArmSmmu4KUnsupported;
+            c->stall_on_fault || !c->continue_after_fault)return ArmSmmu4KUnsupported;
         /* Measured0106: EPD1 with unusedTG1 zero, TTBR1zero, CFIEdisabled.
          * The board polls faults synchronously and never enables unhandled IRQs. */
-        v.tcr=0x802020;v.ttbr1=0;v.sctlr=0x1127;
+        /* 0170: coherent_walk=1 (boot-arg sweetsmmuwalk=1): inner-shareable write-back walks instead of outer non-cacheable ones.
