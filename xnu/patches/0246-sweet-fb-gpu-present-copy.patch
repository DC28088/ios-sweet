+/*
+ * 0246: GPU present copy. Kernel GPU addresses (SweetNativeAdrenoVM.cpp kernel window 0xb0000000..0xc0000000):
+ * scanout buffer i at 0xb0000000 + i * 16 MiB, a 16 KiB scratch page for the CCU flush timestamps at 0xb1f00000,
+ * up to four source IOSurfaces at 0xb2000000 + k * 32 MiB (LRU; each holds a surface reference until evicted).
+ */
+#define SWEET_GPU_SCAN_IOVA     0xb0000000ULL
+#define SWEET_GPU_SCRATCH_IOVA  0xb1f00000ULL
+#define SWEET_GPU_SRC_IOVA      0xb2000000ULL
+#define SWEET_GPU_SRC_SLOT      0x02000000ULL
+
+uint64_t
+AppleCLCD::gpuSourceIova(SweetSurface *s)
+{
+	unsigned victim = 0;
+	for (unsigned k = 0; k < 4; k++) {
+		if (fGpuSrc[k].surface == s && fGpuSrc[k].map != NULL) {
+			fGpuSrc[k].used = ++fGpuUse;
+			return fGpuSrc[k].iova;
+		}
+		if (fGpuSrc[k].used < fGpuSrc[victim].used) {
+			victim = k;
+		}
+	}
+	const uint64_t length = s->memory != NULL ? s->memory->getLength() : 0;
+	const uintptr_t kva = s->kernelAddress();
+	const uint64_t bytes = (length + 4095) & ~4095ULL;
+	if (kva == 0 || (kva & 4095) || bytes == 0 || bytes > SWEET_GPU_SRC_SLOT ||
+	    OSDynamicCast(IOBufferMemoryDescriptor, s->memory) == NULL) {
+		return 0;       /* only kernel-allocated (IOBufferMemoryDescriptor) surfaces */
+	}
+	GpuSrc &slot = fGpuSrc[victim];
+	if (slot.map != NULL) {
+		if (sweet_native_adreno_kunmap(slot.map) != 0) {
+			fGpuBroken = true;      /* mapping retained: do not reuse the slot or the GPU path */
+			return 0;
+		}
+		slot.map = NULL;
+		OSSafeReleaseNULL(slot.surface);
+	}
+	const uint64_t iova = SWEET_GPU_SRC_IOVA + victim * SWEET_GPU_SRC_SLOT;
+	void *map = sweet_native_adreno_kmap(kernel_task, kva, 0, (size_t)bytes, iova, 0);
+	if (map == NULL) {
+		return 0;
+	}
+	s->retain();
+	slot.surface = s;
+	slot.map = map;
+	slot.iova = iova;
+	slot.used = ++fGpuUse;
+	__atomic_add_fetch(&fStatsGpuMapMiss, 1, __ATOMIC_RELAXED);
+	return iova;
+}
+
+static inline uint32_t
+sweet_pm4_parity(uint32_t v)
+{
+	return (0x9669u >> (0xf & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1;
+}
+static inline uint32_t
+sweet_pm4_type4(uint32_t reg, uint32_t count)
+{
+	return 0x40000000u | count | (sweet_pm4_parity(count) << 7) | ((reg & 0x3ffff) << 8) | (sweet_pm4_parity(reg) << 27);
+}
+static inline uint32_t
+sweet_pm4_type7(uint32_t opcode, uint32_t count)
+{
+	return 0x70000000u | count | (sweet_pm4_parity(count) << 15) | ((opcode & 0x7f) << 16) | (sweet_pm4_parity(opcode) << 23);
+}
+
+/* Present thread only. True: the whole frame of `s` is scaled into the back buffer and the GPU finished. */
+bool
+AppleCLCD::gpuCopy(SweetSurface *s, int filter)
+{
+	if (s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1 || (s->bytesPerRow & 63) ||
+	    (s->offset & 63) || s->width == 0 || s->height == 0 || s->width > 0x7fff || s->height > 0x7fff ||
+	    (fRowBytes & 63)) {
+		return false;
+	}
+	if (fGpuScanMap[0] == NULL) {
+		const uint64_t bytes = ((uint64_t)fRowBytes * fHeight + 0xffff) & ~0xffffULL;
+		for (unsigned i = 0; i < 2; i++) {
+			fGpuScanMap[i] = sweet_native_adreno_kmap(NULL, fBufVA[i], fBufPhys[i], (size_t)bytes,
+			    SWEET_GPU_SCAN_IOVA + i * 0x01000000ULL, 1);
+		}
+		fGpuScratch = IOMallocAligned(16384, 16384);
+		if (fGpuScratch != NULL) {
+			bzero(fGpuScratch, 16384);
+			fGpuScratchMap = sweet_native_adreno_kmap(kernel_task, (uintptr_t)fGpuScratch, 0, 16384, SWEET_GPU_SCRATCH_IOVA, 1);
+		}
+		IOLog("SWEET GPUCOPY: scanout maps %p %p scratch %p (iova %#llx %#llx %#llx)\n", fGpuScanMap[0], fGpuScanMap[1],
+		    fGpuScratchMap, SWEET_GPU_SCAN_IOVA, SWEET_GPU_SCAN_IOVA + 0x01000000ULL, SWEET_GPU_SCRATCH_IOVA);
+		if (fGpuScanMap[0] == NULL || fGpuScanMap[1] == NULL || fGpuScratchMap == NULL) {
+			fGpuBroken = true;
+			return false;
+		}
+	}
+	const uint64_t src = gpuSourceIova(s);
+	if (src == 0) {
+		return false;
+	}
+	const uint64_t srcAddr = src + s->offset;
+	const unsigned target = fScan ^ 1;
+	const uint64_t dst = SWEET_GPU_SCAN_IOVA + target * 0x01000000ULL;
+	const uint64_t ts = SWEET_GPU_SCRATCH_IOVA;
+	const uint32_t sw = s->width, sh = s->height;
+	uint32_t w[96];
+	unsigned n = 0;
+#define EV(e) do { w[n++] = sweet_pm4_type7(0x46, 1); w[n++] = (e); } while (0)
+#define EVTS(e) do { w[n++] = sweet_pm4_type7(0x46, 4); w[n++] = (e); w[n++] = (uint32_t)ts; w[n++] = (uint32_t)(ts >> 32); w[n++] = 1; } while (0)
+#define WFI() do { w[n++] = sweet_pm4_type7(0x26, 0); } while (0)
+#define REG(r, c) do { w[n++] = sweet_pm4_type4((r), (c)); } while (0)
+	/* emit_setup: flush + invalidate CCU colour/depth, bypass CCU layout for BLIT_OP_SCALE (a618: one CCU, 64 KiB
+	 * sysmem depth cache -> colour at 0x10000: RB_CCU_CNTL COLOR_OFFSET field = 0x10 << 23). */
+	EVTS(29);               /* PC_CCU_FLUSH_COLOR_TS */
+	EVTS(28);               /* PC_CCU_FLUSH_DEPTH_TS */
+	EV(25);                 /* PC_CCU_INVALIDATE_COLOR */
+	EV(24);                 /* PC_CCU_INVALIDATE_DEPTH */
+	EV(49);                 /* CACHE_INVALIDATE: the source was written by the 3D pipe */
+	WFI();
+	REG(0x8e07, 1); w[n++] = 0x08000000;    /* RB_CCU_CNTL */
+	/* emit_blit_texture: source / destination rectangles */
+	REG(0x8401, 4); w[n++] = 0; w[n++] = (sw - 1) << 8; w[n++] = 0; w[n++] = (sh - 1) << 8;
+	REG(0x8405, 2); w[n++] = 0; w[n++] = (fWidth - 1) | ((fHeight - 1) << 16);
+	/* emit_blit_setup: FMT6_8_8_8_8_UNORM (0x30), R2D_UNORM8 (0x10), mask 0xf, ROTATE_0 */
+	const uint32_t cntl = (0xfu << 20) | (0x30u << 8) | (0x10u << 24);
+	REG(0x8c00, 1); w[n++] = cntl;          /* RB_2D_BLIT_CNTL */
+	REG(0x8400, 1); w[n++] = cntl;          /* GRAS_2D_BLIT_CNTL */
+	REG(0xacc0, 1); w[n++] = (0x30u << 3) | (0xfu << 12);   /* SP_2D_DST_FORMAT */
+	REG(0x8c01, 1); w[n++] = 0;             /* RB_2D_UNKNOWN_8C01 */
+	/* emit_blit_src: linear, WZYX, unk20 | unk22 as Mesa */
+	REG(0xb4c0, 5);
+	w[n++] = 0x30u | ((uint32_t)filter << 16) | (1u << 20) | (1u << 22);   /* SP_PS_2D_SRC_INFO */
+	w[n++] = sw | (sh << 15);                                               /* SP_PS_2D_SRC_SIZE */
+	w[n++] = (uint32_t)srcAddr; w[n++] = (uint32_t)(srcAddr >> 32);        /* SP_PS_2D_SRC */
+	w[n++] = (s->bytesPerRow >> 6) << 9;                                    /* SP_PS_2D_SRC_PITCH */
+	/* emit_blit_dst */
+	REG(0x8c17, 4);
+	w[n++] = 0x30u;                                                         /* RB_2D_DST_INFO */
+	w[n++] = (uint32_t)dst; w[n++] = (uint32_t)(dst >> 32);                 /* RB_2D_DST */
+	w[n++] = fRowBytes >> 6;                                                /* RB_2D_DST_PITCH */
+	/* emit_blit_fini (a6xx gen1: RB_DBG_ECO_CNTL and its blit value are both 0x04100000) */
+	WFI();
+	REG(0x8e04, 1); w[n++] = 0x04100000;
+	w[n++] = sweet_pm4_type7(0x2c, 1); w[n++] = 3;  /* CP_BLIT BLIT_OP_SCALE */
+	WFI();
+	REG(0x8e04, 1); w[n++] = 0x04100000;
+	EVTS(29);               /* the blit's colour writes reach memory before the ring fence */
+	WFI();
+#undef EV
+#undef EVTS
+#undef WFI
+#undef REG
+	unsigned fence = 0;
+	int error = sweet_native_adreno_submit_async(w, n, &fence);
+	if (error == 0) {
+		error = sweet_native_adreno_fence_wait(fence, 200000);
+	}
+	if (error != 0) {
+		static unsigned logged;
+		if (logged++ < 8) {
+			IOLog("SWEET GPUCOPY: submit/wait failed %d (fence %u, %u words); %s\n", error, fence, n,
+			    error == ETIMEDOUT || error == EIO ? "GPU copy off" : "CPU copy for this frame");
+		}
+		if (error == ETIMEDOUT || error == EIO) {
+			fGpuBroken = true;
+		}
+		return false;
+	}
+	return true;
+}
