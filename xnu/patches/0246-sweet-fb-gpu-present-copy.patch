+/* 0246: kernel submission without the synchronous wait, for the framebuffer's GPU present copy. User work queued
+ * ahead of the copy can take longer than sweet_native_adreno_submit's 10 ms, and a timeout there unmounts the board.
+ * The caller waits with sweet_native_adreno_fence_wait (gate taken per poll only); a failure never unmounts. */
+extern "C" int sweet_native_adreno_submit_async(const uint32_t *words,unsigned count,unsigned *fence)
+{
+ if(!words || !count || count>4096 || !fence)return EINVAL;
+ *fence=0;
+ if(!board.mounted || !native_lock)return ENXIO;
+ IOLockLock(native_lock);
+ uint32_t issued=0;
+ const IOReturn result=board.mounted?native_ring.submit(words,count,&issued):kIOReturnNotReady;
+ IOLockUnlock(native_lock);
+ if(result!=kIOReturnSuccess)return result==kIOReturnNoResources?EBUSY:EIO;
+ *fence=issued;
+ return 0;
+}
+extern "C" int sweet_native_adreno_fence_wait(unsigned fence,unsigned timeout_us)
+{
+ if(!fence)return EINVAL;
+ if(!native_lock)return ENXIO;
+ const uint64_t start=now_us(nullptr);
+ for(;;) {
+  IOLockLock(native_lock);
+  const NativeAdrenoRingFence state=native_ring.observeFence(fence,nullptr,0,nullptr);
+  IOLockUnlock(native_lock);
+  if(state==NativeAdrenoRingFenceComplete)return 0;
+  if(state!=NativeAdrenoRingFenceTimeout)return EIO;
+  if(now_us(nullptr)-start>=timeout_us)return ETIMEDOUT;
+  IODelay(25);
+ }
+}
