diff --git a/bsd/dev/sweet_dark.c b/bsd/dev/sweet_dark.c
new file mode 100644
index 0000000..5c8df9d
--- /dev/null
+++ b/bsd/dev/sweet_dark.c
@@ -0,0 +1,101 @@
+/*
+ * 0200: display-dark power state for sweet. Adapted from ios-flame (Pixel 4a "sunfish" port, MIT)
+ * xnu 0242 "display-dark idle" (itself after akshaynexus/iOSPlus10 0382 "power idle", MIT) and 0257
+ * "dark clocks".
+ *
+ * AppleCLCD's RequestPowerChange (SweetFramebuffer.cpp; backboardd sends it when the screen locks or
+ * wakes) calls sweet_dark_set(). While dark:
+ *   - the panel sleeps (DCS 28 display off, 10 sleep in; on wake 11 sleep out, 29 display on), see
+ *     SweetFramebuffer.cpp (sweetpanelsleep=1), instead of a CPU fade of a lit black frame
+ *   - USB ud_thread polls every 20 ms instead of 1 ms once the host link was quiet for 2 s (any
+ *     event or queued frame -> 1 ms at once); the USB log thread every 250 ms instead of 100 ms
+ *   - touch polling stops while no finger is down; keys poll every 40 ms instead of 20 ms
+ *   - the framebuffer tick runs every 500 ms after 5 s dark (instead of 120 Hz)
+ *   - CPU clocks: A55 at most ~1.25 GHz, A76 at most ~0.65 GHz (SweetCPU.cpp sweet_cpufreq_dark;
+ *     cpufreq-hw LUT rows), restored on wake
+ * Boot-arg sweetdark=0: nothing changes (the flag stays 0). sweetdarkclk=0 keeps the CPU clocks.
+ * kern.sweet_display_dark (read-only) shows the state.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+
+void sweet_dark_set(int dark);
+void sweet_dark_sleep(uint32_t ms);
+extern void sweet_cpufreq_dark(int dark);   /* iokit/Kernel/arm/SweetCPU.cpp */
+
+int sweet_display_dark;                 /* 1 while the display is off (and sweetdark=1) */
+const uint32_t sweet_dark_usb_ms = 20;
+const uint32_t sweet_dark_usblog_ms = 250;
+const uint32_t sweet_dark_keys_ms = 40;
+const uint32_t sweet_dark_fb_ms = 500;
+const uint32_t sweet_dark_fb_after_ms = 5000;
+static int sweet_dark_enabled = -1, sweet_dark_clk = 1;
+static unsigned sweet_dark_cycles;
+
+SYSCTL_INT(_kern, OID_AUTO, sweet_display_dark, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_display_dark, 0,
+    "SWEET: display off, kernel pollers slowed (0200)");
+
+void
+sweet_dark_set(int dark)
+{
+	if (sweet_dark_enabled < 0) {
+		int en = 1;
+		(void)PE_parse_boot_argn("sweetdark", &en, sizeof(en));
+		(void)PE_parse_boot_argn("sweetdarkclk", &sweet_dark_clk, sizeof(sweet_dark_clk));
+		sweet_dark_enabled = en != 0;
+	}
+	if (!sweet_dark_enabled) {
+		return;
+	}
+	int was = __atomic_exchange_n(&sweet_display_dark, dark ? 1 : 0, __ATOMIC_SEQ_CST);
+	if (!dark) {
+		thread_wakeup((event_t)&sweet_display_dark);    /* slowed pollers restart now */
+	}
+	if (was == !!dark) {
+		return;
+	}
+	if (sweet_dark_clk) {
+		sweet_cpufreq_dark(dark);
+	}
+	if (dark) {
+		sweet_dark_cycles++;
+	}
+	if (sweet_dark_cycles <= 20) {
+		if (dark) {
+			printf("SWEET DARK: on (%u): usb %u ms (no traffic 2 s), usblog %u ms, touch stopped, keys %u ms, "
+			    "fb %u ms after %u ms, cpu clocks %s\n", sweet_dark_cycles, sweet_dark_usb_ms, sweet_dark_usblog_ms,
+			    sweet_dark_keys_ms, sweet_dark_fb_ms, sweet_dark_fb_after_ms, sweet_dark_clk ? "low" : "kept");
+		} else {
+			printf("SWEET DARK: off: usb 1 ms, usblog 100 ms, touch 10 ms, keys 20 ms, fb full rate, cpu clocks %s\n",
+			    sweet_dark_clk ? "restored" : "kept");
+		}
+	}
+}
+
+/*
+ * Sleep up to ms (0 = until the display comes on) on the dark channel. Returns at once if the display
+ * is already on again (the check after assert_wait: a sweet_dark_set(0) in between is not lost).
+ */
+void
+sweet_dark_sleep(uint32_t ms)
+{
+	if (ms) {
+		uint64_t deadline;
+		clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline((event_t)&sweet_display_dark, THREAD_UNINT, deadline);
+	} else {
+		(void)assert_wait((event_t)&sweet_display_dark, THREAD_UNINT);
+	}
+	if (!__atomic_load_n(&sweet_display_dark, __ATOMIC_SEQ_CST)) {
+		clear_wait(current_thread(), THREAD_AWAKENED);
+		return;
+	}
+	thread_block(THREAD_CONTINUE_NULL);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
