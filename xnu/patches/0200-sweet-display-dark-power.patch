+/* 0200: DCS short write without a parameter (data type 0x05), same FIFO path as sendLevel */
+int
+AppleARMBacklight::sendShort(uint8_t cmd)
+{
+	volatile uint32_t *dsi = fDsi;
+	const uint32_t ctrl = dsi[DSI_REG_CTRL / 4];
+	if ((ctrl & 3) != 3) {
+		IOLog("SWEET PANEL: DSI0 left video mode (ctrl=%#x); dcs %#x not sent\n", ctrl, cmd);
+		return ENODEV;
+	}
+	const uint32_t dma_ctrl = dsi[DSI_REG_DMA_CTRL / 4];
+	/* header {data0 = cmd, data1 = 0, data id 0x05, LAST} */
+	const uint32_t word = (uint32_t)cmd | (0x05u << 16) | (0x80u << 24);
+	dsi[DSI_REG_CTRL / 4] = ctrl | (1u << 2);                       /* command engine on */
+	dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;    /* W1C stale DMA done */
+	dsi[DSI_REG_TPG_CTRL / 4] = (1u << 1) | (1u << 2) | (3u << 16);
+	dsi[DSI_REG_TPG_DMA_DATA / 4] = word;
+	dsi[DSI_REG_DMA_CTRL / 4] = (dma_ctrl & ~((1u << 31) | (1u << 30))) | (1u << 26) | (1u << 28);
+	dsi[DSI_REG_DMA_LENGTH / 4] = sizeof(word);
+	__asm__ volatile("dsb sy" ::: "memory");
+	dsi[DSI_REG_DMA_TRIGGER / 4] = 1;
+	unsigned us;
+	for (us = 0; us < 50000 && !(dsi[DSI_REG_INT_CTRL / 4] & 1u); us += 50) {
+		IODelay(50);
+	}
+	const bool done = (dsi[DSI_REG_INT_CTRL / 4] & 1u) != 0;
+	const uint32_t ack = dsi[DSI_REG_ACK_ERR / 4];
+	if (done) {
+		dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	}
+	dsi[DSI_REG_TPG_CTRL / 4] = 0;
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 1;
+	IODelay(1);
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 0;
+	dsi[DSI_REG_DMA_CTRL / 4] = dma_ctrl;
+	if (!(ctrl & (1u << 2))) {
+		dsi[DSI_REG_CTRL / 4] = dsi[DSI_REG_CTRL / 4] & ~(1u << 2);
+	}
+	if (!done) {
+		IOLog("SWEET PANEL: dcs %#x NOT acknowledged after %u us ack_err=%#x\n", cmd, us, ack);
+	}
+	return done ? 0 : ETIMEDOUT;
 }
 
