diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 86b3acc..36a10e0 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -159,6 +159,42 @@ extern "C" processor_t thread_bind(processor_t);
 #define SWEET_OSM_XO_KHZ        19200u
 #define SWEET_OSM_GPLL0_KHZ     300000u
 
+/*
+ * 0200: dark clocks (after ios-flame 0257, MIT). While the display is off (bsd/dev/sweet_dark.c) each
+ * domain runs at the highest LUT row at or below its dark target (A55 1248 MHz, A76 652.8 MHz, as the
+ * sunfish port's rows 4 and 1 of the same SM7150 table), and goes back to the row selected at boot on
+ * wake. Only rows this file chose at boot are written; nothing happens with sweetcpufreq=0.
+ */
+static struct {
+	volatile uint32_t *osm;
+	unsigned bright_row, dark_row;
+	uint32_t bright_khz, dark_khz;
+	bool ready;
+} sweet_dark_dom[2];
+static const uint32_t sweet_dark_target_khz[2] = {1248000u, 652800u};
+
+extern "C" void sweet_cpufreq_dark(int dark);
+
+void
+sweet_cpufreq_dark(int dark)
+{
+	for (unsigned d = 0; d < 2; d++) {
+		if (!sweet_dark_dom[d].ready) {
+			continue;
+		}
+		sweet_dark_dom[d].osm[SWEET_OSM_PERF_STATE / 4] = dark ? sweet_dark_dom[d].dark_row : sweet_dark_dom[d].bright_row;
+	}
+	__builtin_arm_dsb(DSB_SY);
+	static unsigned logged;
+	if (logged++ < 12 && (sweet_dark_dom[0].ready || sweet_dark_dom[1].ready)) {
+		IOLog("SWEET CPUFREQ: %s: a55 row %u (%u kHz), a76 row %u (%u kHz)\n", dark ? "dark" : "bright",
+		    dark ? sweet_dark_dom[0].dark_row : sweet_dark_dom[0].bright_row,
+		    dark ? sweet_dark_dom[0].dark_khz : sweet_dark_dom[0].bright_khz,
+		    dark ? sweet_dark_dom[1].dark_row : sweet_dark_dom[1].bright_row,
+		    dark ? sweet_dark_dom[1].dark_khz : sweet_dark_dom[1].bright_khz);
+	}
+}
+
 /* 64 dependent adds per iteration: one per cycle on both A55 and A76. */
 static uint64_t
 sweet_cpu_measure_khz(void)
@@ -237,6 +273,27 @@ sweet_cpufreq_domain(const ml_topology_info_t *topology, unsigned domain,
 	} else {
 		IOLog("SWEET CPUFREQ: domain %u no write (mode=%d best=%u rows=%u)\n", domain, mode, best, rows);
 	}
+	/* 0200: the dark row: the highest row at or below the target (rows rise in frequency) */
+	if (mode == 1 && best < rows && domain < 2) {
+		unsigned dark = best;
+		bool found = false;
+		for (unsigned i = 0; i < rows; i++) {
+			const uint32_t cores = (osm[(SWEET_OSM_FREQ_LUT + i * SWEET_OSM_LUT_ROW) / 4] >> 16) & 7;
+			if (cores != 1 && khz[i] <= sweet_dark_target_khz[domain] && (!found || khz[i] > khz[dark])) {
+				dark = i;
+				found = true;
+			}
+		}
+		if (found) {
+			sweet_dark_dom[domain].osm = osm;
+			sweet_dark_dom[domain].bright_row = best;
+			sweet_dark_dom[domain].bright_khz = khz[best];
+			sweet_dark_dom[domain].dark_row = dark;
+			sweet_dark_dom[domain].dark_khz = khz[dark];
+			sweet_dark_dom[domain].ready = true;
+			IOLog("SWEET CPUFREQ: domain %u dark row %u = %u kHz (bright row %u)\n", domain, dark, khz[dark], best);
+		}
+	}
 	thread_bind(PROCESSOR_NULL);
 	thread_block(THREAD_CONTINUE_NULL);
 }
