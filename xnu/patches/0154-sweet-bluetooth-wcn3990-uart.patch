+/* Firmware blobs from the ADT (tools/adt-add-bluetooth.py puts fw-<file name> under /arm-io/bluetooth).
+ * A writable copy: the NVM is edited before it is sent. */
+static bool
+sweet_bt_fw_get(const char *file, void **buf, size_t *len)
+{
+	DTEntry node;
+	const void *data = NULL;
+	unsigned int size = 0;
+	char prop[32];
+	snprintf(prop, sizeof(prop), "fw-%s", file);
+	if (SecureDTLookupEntry(NULL, "/arm-io/bluetooth", &node) != kSuccess ||
+	    SecureDTGetProperty(node, prop, &data, &size) != kSuccess || size == 0) {
+		return false;
+	}
+	void *copy = kalloc_data(size, Z_WAITOK);
+	if (copy == NULL) {
+		return false;
+	}
+	memcpy(copy, data, size);
+	*buf = copy;
+	*len = size;
+	return true;
+}
+
+static void
+sweet_bt_fw_put(void *buf, size_t len)
+{
+	kfree_data(buf, len);
+}
