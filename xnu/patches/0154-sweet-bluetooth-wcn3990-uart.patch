+/*
+ * Sweet (Redmi Note 10 Pro, SM7150) Bluetooth: the Qualcomm WCN3990's BT core over the
+ * QUP0 SE3 GENI UART (hsuart0, 0x88c000), HCI in the kernel (power pulse, rampatch + NVM download,
+ * in-band sleep), then an H4 transport for iOS's bluetoothd/BlueTool through the kernel control
+ * com.apple.uart.bluetooth (bsd/dev/sweet_bt_hci.c).
+ *
+ * Ported from Bergamota (ry-diffusion, Poco F1 / SDM845, xnu patches 0104-0133 beryllium_wlan.c,
+ * MIT): only its Bluetooth stage. The WLAN probe/inventory parts are left out: they read the apps
+ * SMMU and SMEM, and on sweet a CPU load from the apps SMMU stalls once the system is up (0141).
+ * SM7150 differences (Linux gcc-sm7150.c / pinctrl-sm7150.c, sweet DT): SE3 instead of SE3
+ * (CBCR 0x173c0, RCG 0x173c4, vote bit 13), TLMM SOUTH tile 0x3d00000 with GPIO 38-41 (qup03 = 1),
+ * rails L10A (vdd-io), L1C (xtal), L2C (core), L10C (pa). Firmware (crbtfw21.tlv, crnv21.bin from
+ * sweet's own bluetooth partition) comes from ADT properties of /arm-io/bluetooth, as the GPU's.
+ *
+ * Off unless sweetbt=1 (or sweetwlan=2 for the bring-up stage alone).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
