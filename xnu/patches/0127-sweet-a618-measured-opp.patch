+/*
+ * GPU performance levels from the pinned sm7150.dtsi gpu_opp_table, every
+ * one opp-supported-hw 0x1f (all speed bins): kHz and raw RPMh opp-level.
+ * Bring-up still runs at index 1 (267MHz, the proven corner). After the CP
+ * fence succeeds the APPS gfx/mx floors are raised for the chosen level, the
+ * GX clock is measured, DCVS selects it, and the clock is measured again.
+ * sweetgpukhz=267000 keeps the previous single-level behaviour.
+ */
+static const struct { uint32_t khz, level; } sweet_gpu_opps[] = {
+	{ 267000u, 64u },       /* LOW_SVS */
+	{ 355000u, 128u },      /* SVS */
+	{ 430000u, 192u },      /* SVS_L1 */
+	{ 565000u, 256u },      /* NOM */
+};
+static unsigned sweet_gpu_opp_mx[4];
+
+static void
+sweet_gpu_levels_prepare(void)
+{
+	uint32_t target = 565000u;
+	PE_parse_boot_argn("sweetgpukhz", &target, sizeof(target));
+	a618_gpu_level_count = 0;
+	unsigned count = 0;
+	for (unsigned i = 0; i < sizeof(sweet_gpu_opps) / sizeof(sweet_gpu_opps[0]); ++i) {
+		if (sweet_gpu_opps[i].khz > target) {
+			break;
+		}
+		uint32_t vote = 0;
+		unsigned mx = 0;
+		int error = sweet_rpmh_adreno_level_vote(sweet_gpu_opps[i].level, &vote, &mx);
+		if (error) {
+			printf("SWEET ADRENO: OPP %u kHz vote errno=%d; single legacy level\n",
+			    sweet_gpu_opps[i].khz, error);
+			return;
+		}
+		a618_gpu_levels[count].vote = vote;
+		a618_gpu_levels[count].khz = sweet_gpu_opps[i].khz;
+		sweet_gpu_opp_mx[count] = mx;
+		++count;
+	}
+	/* Only a table that begins with the proven 267MHz/raw64 corner. */
+	if (count < 2 || (a618_gpu_levels[0].vote >> 16) != 64u) {
+		printf("SWEET ADRENO: OPP table count=%u first=%#x; single legacy level\n",
+		    count, count ? a618_gpu_levels[0].vote : 0);
+		return;
+	}
+	a618_gpu_level_count = count;
+	printf("SWEET ADRENO: OPP table %u levels up to %u kHz (target %u)\n",
+	    count, a618_gpu_levels[count - 1].khz, target);
+}
+
+/* RBBM_PERFCTR_RBBM_0 with countable PERF_RBBM_ALWAYS_COUNT (GX core clock
+ * cycles) against the architected 19.2MHz timer. 0 means not measurable. */
+static uint64_t
+sweet_gpu_counter(vm_offset_t core)
+{
+	uint32_t hi, lo, again;
+	do {
+		hi = sweet_adreno_read((void *)core, 0x41d * 4);
+		lo = sweet_adreno_read((void *)core, 0x41c * 4);
+		again = sweet_adreno_read((void *)core, 0x41d * 4);
+	} while (hi != again);
+	return ((uint64_t)hi << 32) | lo;
+}
+
+static uint32_t
+sweet_gpu_measure_khz(vm_offset_t core)
+{
+	sweet_adreno_write((void *)core, 0x500 * 4, 1);         /* RBBM_PERFCTR_CNTL */
+	sweet_adreno_write((void *)core, 0x507 * 4, 0);         /* RBBM_SEL_0: ALWAYS_COUNT */
+	sweet_adreno_barrier(NULL);
+	delay(100);
+	const uint64_t c0 = sweet_gpu_counter(core), t0 = mach_absolute_time();
+	delay(20000);
+	const uint64_t c1 = sweet_gpu_counter(core), t1 = mach_absolute_time();
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	if (!ns || c1 <= c0 || (c1 >> 63) || c0 == 0xffffffffffffffffULL) {
+		return 0;
+	}
+	return (uint32_t)(((c1 - c0) * 1000000ULL) / ns);
+}
+
+static void
+sweet_gpu_raise_clock(vm_offset_t core, vm_offset_t gmu)
+{
+	const uint32_t before = sweet_gpu_measure_khz(core);
+	printf("SWEET ADRENO: GX clock measured=%u kHz at perf index 1 (configured %u kHz)\n",
+	    before, a618_gpu_level_count ? a618_gpu_levels[0].khz : 267000u);
+	if (a618_gpu_level_count < 2) {
+		return;
+	}
+	const unsigned top = a618_gpu_level_count - 1;
+	const unsigned gfx_vlvl = (a618_gpu_levels[top].vote >> 16) + 1;   /* ARC consumer level */
+	const unsigned mx_vlvl = sweet_gpu_opp_mx[top] + 1;
+	int error = sweet_rpmh_arc_raise("mx.lvl", mx_vlvl);
+	if (!error) {
+		error = sweet_rpmh_arc_raise("gfx.lvl", gfx_vlvl);
+	}
+	if (error) {
+		printf("SWEET ADRENO: APPS rail floor errno=%d; GX stays at perf index 1\n", error);
+		return;
+	}
+	const struct a618_io gmu_io = {(void *)gmu,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+	error = a618_gmu_dcvs(&gmu_io, top + 1);
+	const uint32_t after = sweet_gpu_measure_khz(core);
+	printf("SWEET ADRENO: DCVS perf index %u (%u kHz, gfx vlvl %u, mx vlvl %u) errno=%d; GX clock measured=%u kHz\n",
+	    top + 1, a618_gpu_levels[top].khz, gfx_vlvl, mx_vlvl, error, after);
+	if (error && error != ETIMEDOUT) {
+		/* Firmware refused: request the proven bring-up index again. */
+		int back = a618_gmu_dcvs(&gmu_io, 1);
+		printf("SWEET ADRENO: DCVS restore index 1 errno=%d measured=%u kHz\n",
+		    back, sweet_gpu_measure_khz(core));
+	}
+}
