diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 1ff8f4b..031be6f 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -9,6 +9,8 @@
 #include <sys/errno.h>
 #include <kern/clock.h>
 #include <machine/machine_routines.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
@@ -66,6 +68,7 @@ struct rh_res {
 #define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
 #define RH_ARC          3u
 #define RH_VRM          4u
+#define RH_BCM          5u
 #define RH_ARC_LEVEL_SIZE   2u
 #define RH_ARC_MAX_LEVELS   16u
 #define RH_TIMEOUT_US   100000u
@@ -214,7 +217,7 @@ rh_lookup(const char *res, unsigned expected_slave, struct rh_res *out)
 			uint32_t addr = rh_read(rh_db, e + 16);
 			uint32_t aux_len = rh_db16(e + 20);
 			uint32_t aux_off = rh_db16(e + 22);
-			uint32_t align = expected_slave == RH_ARC ? 3u : 15u;
+			uint32_t align = expected_slave == RH_VRM ? 15u : 3u;
 			if (slave != expected_slave || (addr >> 16) != expected_slave ||
 			    (addr & align) || aux_off > rh_db_size - data ||
 			    !rh_range(data + aux_off, aux_len)) {
@@ -819,6 +822,40 @@ out:
 	return error;
 }
 
+/*
+ * 0149: a bus (BCM) vote from the kernel. The apps SMMU (0x15000000) sits
+ * behind the path its downstream node votes (msm-bus 161 -> 627 = BCMs SN15
+ * and CN0, active-only, 1000 KBps); 0131's wland stalled a CPU on its first
+ * apps-SMMU read with no such vote. Command: commit|valid|x<<14|y, as
+ * Linux's BCM_TCS_CMD. Only those two BCMs, only small nonzero levels.
+ */
+int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y)
+{
+	if (!res || (strcmp(res, "SN15") && strcmp(res, "CN0")) || x > 16 || y > 16 || (!x && !y)) {
+		return EPERM;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, RH_BCM, &found);
+		}
+		if (!error) {
+			const uint32_t offset = 0, value = 1u << 30 | 1u << 29 | x << 14 | y;
+			error = rh_send_cmds(res, found.addr, 3u, &offset, &value, 1, RH_TIMEOUT_US, NULL);
+			printf("SWEET RPMH: BCM %s addr=%#x vote %#x -> %d\n", res, found.addr, value, error);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
 /*
  * Raise-only ARC vote. This is deliberately narrower than 0083's fixed
  * votes: it reads the resource first, refuses a non-index reply, and never
@@ -913,3 +950,44 @@ out:
 	return error;
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/*
+ * 0149 opt-in (sweetsmmuprobe=1): vote SN15+CN0, then read the apps SMMU's
+ * ID registers from a thread of its own, logging before each read so a stall
+ * is visible as the last line. Votes stay in place for wland's SMMU step.
+ */
+static void
+sweet_smmu_probe_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	extern void IOSleep(unsigned);
+	IOSleep(20000);
+	const int sn = sweet_rpmh_bcm_vote("SN15", 1, 1), cn = sweet_rpmh_bcm_vote("CN0", 1, 1);
+	printf("SWEET SMMU: votes SN15=%d CN0=%d; reading apps SMMU sCR0/ID0/ID1 next\n", sn, cn);
+	IOSleep(50);
+	volatile uint32_t *smmu = (volatile uint32_t *)ml_io_map(0x15000000, 0x1000);
+	if (!smmu) {
+		printf("SWEET SMMU: map failed\n");
+		return;
+	}
+	const uint32_t scr0 = smmu[0];
+	printf("SWEET SMMU: sCR0=%#x\n", scr0);
+	const uint32_t id0 = smmu[0x20 / 4], id1 = smmu[0x24 / 4], id2 = smmu[0x28 / 4];
+	printf("SWEET SMMU: ID0=%#x ID1=%#x ID2=%#x: %u SMRs, %u context banks\n", id0, id1, id2, id0 & 0xff, id1 & 0xff);
+}
+
+void sweet_smmu_probe_start(void);
+void
+sweet_smmu_probe_start(void)
+{
+	int on = 0;
+	PE_parse_boot_argn("sweetsmmuprobe", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	thread_t thread = THREAD_NULL;
+	if (kernel_thread_start(sweet_smmu_probe_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET SMMU: apps SMMU probe armed (20 s after boot)\n");
+	}
+}
