+/* The owned-BO pool (0146/0147): one physically contiguous block, taken from
+ * bsd init (sweet_ufs_init) while memory is still unfragmented. sweetbopool=MiB
+ * (default 384, 0 = off); halves until a block is found. Returns 1 if held. */
+extern "C" int sweet_native_adreno_reserve_pool(void)
+{
+ if(NativeAdrenoMemory::poolBytes())return 1;
+ uint32_t pool_mib=384;PE_parse_boot_argn("sweetbopool",&pool_mib,sizeof(pool_mib));
+ IOReturn reserved=kIOReturnNoMemory;uint32_t got=0;
+ for(uint32_t mib=pool_mib>1024?1024:pool_mib;mib>=16 && reserved;mib/=2)
+  if(!(reserved=NativeAdrenoMemory::reservePool(36,(size_t)mib<<20)))got=mib;
+ if(pool_mib)IOLog("SWEET RENDER: owned BO pool reserved %u of %u MiB (%#x)\n",got,pool_mib,reserved);
+ return got!=0;
+}
