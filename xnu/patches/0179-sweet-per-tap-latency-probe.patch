+/*
+ * SWEET 0179: per-tap probe. The user reports a delay between a tap and the app
+ * opening animation; 10 s aggregates cannot say where it goes. A finger release
+ * (sweet_touch) opens a SWEET_TAP_MS window. During it we sum SpringBoard's on-core
+ * time per core type, its runnable-but-not-running wait (dispatch latency), the
+ * offset of its last off-core switch, all UI-thread time per core type, and the
+ * offsets of the first swaps (CA frame handed to the framebuffer) and presents
+ * (frame copied to the panel). SweetFramebuffer prints one "SWEET TAP:" line per
+ * window. A new release during an open window is ignored. Statistics only; races
+ * between CPUs can only misattribute a slice at the window edges.
+ */
+#define SWEET_TAP_MS     600
+#define SWEET_TAP_EVENTS 8
+static uint32_t sweet_tap_state;        /* 0 idle, 3 arming, 1 open, 2 reporting */
+static uint64_t sweet_tap_start, sweet_tap_end;
+static uint64_t sweet_tap_sb_abs[2], sweet_tap_ui_abs[2];
+static uint64_t sweet_tap_sb_wait, sweet_tap_sb_wait_max, sweet_tap_sb_last;
+static uint32_t sweet_tap_sb_switches, sweet_tap_sb_on_big;
+static uint32_t sweet_tap_ev_n[2];
+static uint32_t sweet_tap_ev_ms[2][SWEET_TAP_EVENTS];
+static uint32_t sweet_tap_count;
+
+static inline bool
+sweet_tap_open_at(uint64_t now)
+{
+	return os_atomic_load(&sweet_tap_state, acquire) == 1 &&
+	       now >= sweet_tap_start && now < sweet_tap_end;
+}
+
+static bool
+sweet_is_springboard(thread_t thread)
+{
+	task_t task = get_threadtask(thread);
+	if (task == TASK_NULL || task == kernel_task) {
+		return false;
+	}
+	void *p = get_bsdtask_info(task);
+	if (p == NULL) {
+		return false;
+	}
+	const char *name = proc_name_address(p);
+	return name != NULL && strncmp(name, "SpringBoard", 12) == 0;
+}
+
+void sweet_sched_tap_mark(void);
+void
+sweet_sched_tap_mark(void)
+{
+	if (!os_atomic_cmpxchg(&sweet_tap_state, 0, 3, acquire)) {
+		return;
+	}
+	uint64_t now = mach_absolute_time(), span;
+	nanoseconds_to_absolutetime((uint64_t)SWEET_TAP_MS * NSEC_PER_MSEC, &span);
+	sweet_tap_sb_abs[0] = sweet_tap_sb_abs[1] = sweet_tap_ui_abs[0] = sweet_tap_ui_abs[1] = 0;
+	sweet_tap_sb_wait = sweet_tap_sb_wait_max = sweet_tap_sb_last = 0;
+	sweet_tap_sb_switches = sweet_tap_sb_on_big = 0;
+	sweet_tap_ev_n[0] = sweet_tap_ev_n[1] = 0;
+	sweet_tap_start = now;
+	sweet_tap_end = now + span;
+	os_atomic_store(&sweet_tap_state, 1, release);
+}
+
+/* kind 0 = swap, 1 = present; from SweetFramebuffer. */
+void sweet_sched_tap_event(int kind);
+void
+sweet_sched_tap_event(int kind)
+{
+	uint64_t now = mach_absolute_time(), ns;
+	if (kind < 0 || kind > 1 || !sweet_tap_open_at(now)) {
+		return;
+	}
+	uint32_t i = os_atomic_inc_orig(&sweet_tap_ev_n[kind], relaxed);
+	if (i < SWEET_TAP_EVENTS) {
+		absolutetime_to_nanoseconds(now - sweet_tap_start, &ns);
+		sweet_tap_ev_ms[kind][i] = (uint32_t)(ns / NSEC_PER_MSEC);
+	}
+}
+
+/* From thread_dispatch for the thread coming on core: its runnable wait. */
+static void
+sweet_tap_latency(thread_t self, uint64_t now, uint64_t latency)
+{
+	if (sweet_tap_open_at(now) && sweet_is_springboard(self)) {
+		os_atomic_add(&sweet_tap_sb_wait, latency, relaxed);
+		if (latency > sweet_tap_sb_wait_max) {
+			sweet_tap_sb_wait_max = latency;
+		}
+	}
+}
+
+static void
+sweet_tap_account(thread_t thread, processor_t processor, uint64_t slice)
+{
+	uint64_t now = processor->last_dispatch;
+	if (!sweet_tap_open_at(now)) {
+		return;
+	}
+	int big = processor->cpu_id >= 6 ? 1 : 0;
+	if (sweet_is_springboard(thread)) {
+		os_atomic_add(&sweet_tap_sb_abs[big], slice, relaxed);
+		os_atomic_inc(&sweet_tap_sb_switches, relaxed);
+		if (big) {
+			os_atomic_inc(&sweet_tap_sb_on_big, relaxed);
+		}
+		if (now - sweet_tap_start > sweet_tap_sb_last) {
+			sweet_tap_sb_last = now - sweet_tap_start;
+		}
+	}
+	if (sweet_is_ui_thread(thread)) {
+		os_atomic_add(&sweet_tap_ui_abs[big], slice, relaxed);
+	}
+}
+
+static uint32_t
+sweet_abs_ms(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
+
+static size_t
+sweet_tap_fmt_events(char *buf, size_t len, int kind)
+{
+	uint32_t n = MIN(sweet_tap_ev_n[kind], SWEET_TAP_EVENTS);
+	size_t used = 0;
+	buf[0] = '\0';
+	for (uint32_t i = 0; i < n && used + 1 < len; i++) {
+		used += (size_t)snprintf(buf + used, len - used, i ? ",%u" : "%u", sweet_tap_ev_ms[kind][i]);
+	}
+	if (n == 0) {
+		strlcpy(buf, "-", len);
+	}
+	return used;
+}
+
+/* From the framebuffer vsync tick: formats the finished window once, false otherwise. */
+bool sweet_sched_tap_report(char *buf, size_t len);
+bool
+sweet_sched_tap_report(char *buf, size_t len)
+{
+	if (os_atomic_load(&sweet_tap_state, acquire) != 1 || mach_absolute_time() < sweet_tap_end) {
+		return false;
+	}
+	if (!os_atomic_cmpxchg(&sweet_tap_state, 1, 2, acquire)) {
+		return false;
+	}
+	char swaps[64], presents[64];
+	sweet_tap_fmt_events(swaps, sizeof(swaps), 0);
+	sweet_tap_fmt_events(presents, sizeof(presents), 1);
+	snprintf(buf, len,
+	    "SWEET TAP: n=%u window_ms=%u sb_run_ms a55=%u a76=%u sb_switches=%u on_a76=%u sb_wait_ms=%u max=%u sb_last_off_ms=%u ui_run_ms a55=%u a76=%u swaps=%u at_ms=%s presents=%u at_ms=%s",
+	    ++sweet_tap_count, (unsigned)SWEET_TAP_MS,
+	    sweet_abs_ms(sweet_tap_sb_abs[0]), sweet_abs_ms(sweet_tap_sb_abs[1]),
+	    sweet_tap_sb_switches, sweet_tap_sb_on_big,
+	    sweet_abs_ms(sweet_tap_sb_wait), sweet_abs_ms(sweet_tap_sb_wait_max), sweet_abs_ms(sweet_tap_sb_last),
+	    sweet_abs_ms(sweet_tap_ui_abs[0]), sweet_abs_ms(sweet_tap_ui_abs[1]),
+	    sweet_tap_ev_n[0], swaps, sweet_tap_ev_n[1], presents);
+	os_atomic_store(&sweet_tap_state, 0, release);
+	return true;
+}
+
 /* From thread_dispatch for the thread leaving the core. */
 static void
 sweet_account_ui(thread_t thread, processor_t processor, uint64_t slice)
 {
+	sweet_tap_account(thread, processor, slice);
 	if (sweet_big_enabled > 0 && sweet_is_ui_thread(thread)) {
 		os_atomic_add(&sweet_ui_abs[processor->cpu_id >= 6 ? 1 : 0], slice, relaxed);
 	}
