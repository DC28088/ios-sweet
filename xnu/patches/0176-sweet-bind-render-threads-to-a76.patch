+/* 0176: the ADT gives XNU one homogeneous cluster: cpu0-5 are Cortex-A55
+ * (1.8 GHz), cpu6-7 Cortex-A76 (2.3 GHz, far higher IPC). With no AMP
+ * scheduler, CoreAnimation's render thread lands on an A55 whenever app
+ * launches keep other cores busy, and first app opens stutter. Bind the
+ * threads that submit GPU work to cpu7 and the framebuffer present thread to
+ * cpu6. Only when all eight processors are available; sweetbigbind=0 off. */
+extern "C" processor_t thread_bind(processor_t);
+extern "C" processor_t cpu_to_processor(int);
+extern "C" uint32_t processor_avail_count;
+extern "C" bool sweet_bind_current_thread(int cpu)
+{
+ static int enabled=-1;
+ if(enabled<0) {
+  int value=1;
+  PE_parse_boot_argn("sweetbigbind",&value,sizeof value);
+  enabled=value!=0;
+  IOLog("SWEET CPU: big-core binding %s (GPU submitters -> cpu7, present -> cpu6)\n",enabled?"on":"off (sweetbigbind=0)");
+ }
+ if(!enabled)return true;   /* nothing to retry */
+ if(processor_avail_count<8 || cpu<0 || cpu>=8)return false;
+ processor_t target=cpu_to_processor(cpu);
+ if(!target)return false;
+ if(thread_bind(target)!=target || cpu_number()!=cpu)thread_block(THREAD_CONTINUE_NULL);
+ return true;
+}
