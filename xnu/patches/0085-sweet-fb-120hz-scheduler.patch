+/* Advance on an absolute cadence. Skip missed slots instead of queuing bursts. */
+void
+AppleCLCD::rearmVsync(void)
+{
+	uint64_t now = mach_absolute_time();
+	fNextVsync += fVsyncPeriod;
+	if (fNextVsync <= now) {
+		uint64_t skipped = (now - fNextVsync) / fVsyncPeriod + 1;
+		fNextVsync += skipped * fVsyncPeriod;
+		fStatsMissed += skipped;
+	}
+	uint64_t elapsed;
+	absolutetime_to_nanoseconds(now - fStatsStart, &elapsed);
+	if (elapsed >= 10ULL * NSEC_PER_SEC) {
+		IOLog("SWEET FB: timing window_ms=%llu callbacks=%llu present_calls=%llu missed_deadlines=%llu target=%u Hz\n",
+		    elapsed / NSEC_PER_MSEC, fStatsCallbacks, fStatsPresents,
+		    fStatsMissed, fPresentHz);
+		fStatsStart = now;
+		fStatsCallbacks = fStatsPresents = fStatsMissed = 0;
+	}
+	fVsync->wakeAtTime(fNextVsync);
+}
