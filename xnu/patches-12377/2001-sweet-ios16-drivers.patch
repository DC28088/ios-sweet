+	volatile uint32_t *gr0 = (volatile uint32_t *)ml_io_map(0x15000000, 0x1000);
+	if (!gr0) {
+		printf("SWEET SMMU: IPA stream: map failed\n");
+		return ENOMEM;
+	}
+	const uint32_t scr0 = gr0[0], id0 = gr0[0x20 / 4], id1 = gr0[0x24 / 4];
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
