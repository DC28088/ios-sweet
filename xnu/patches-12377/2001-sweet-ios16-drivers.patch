+/* SPDX-License-Identifier: MIT */
+#ifndef SWEET_ADRENO_CP_H
+#define SWEET_ADRENO_CP_H
+#include "sweet_adreno_dma.h"
+#define A618_CP_DMA_BYTES 0x18000u
+#define A618_CP_SQE_OFFSET 0x4000u
+#define A618_CP_RING_OFFSET 0xc000u
+#define A618_CP_FENCE_OFFSET 0x14000u
+#define A618_CP_SHADOW_OFFSET (A618_CP_FENCE_OFFSET + 0x100u)
+#define A618_CP_IOVA 0x70000000u
+#define A618_CP_RING_IOVA (A618_CP_IOVA + 0x8000u)
+#define A618_CP_FENCE_IOVA (A618_CP_IOVA + 0x10000u)
+#define A618_CP_SHADOW_IOVA (A618_CP_FENCE_IOVA + 0x100u)
+#define A618_CP_SNAPSHOT_COUNT 16
+struct a618_cp_snapshot {
+ const char *tag;
+ uint32_t irq, sqectl, instr_lo, instr_hi, rb_cntl, cp2gmu;
+};
+#ifdef __cplusplus
+extern "C" {
+#endif
+int sweet_adreno_cp_allocate(struct a618_dma_region *);
+int sweet_adreno_pas_allocate(struct a618_dma_region *);
+int a618_smmu_prepare_cp(const struct a618_smmu_io *,
+ const struct a618_dma_region *, struct a618_smmu_result *);
+struct a618_cp_result {
+ unsigned phase, submitted, completed;
+ uint32_t rptr, wptr, status, interrupt, hw_fault, fence, value;
+ uint32_t cp_interrupt;
+ uint32_t irq_after_power, irq_before_auth, irq_after_auth;
+ unsigned bootstrap_wait_us;
+ uint32_t initial_sqectl, initial_instr_lo, initial_instr_hi, initial_rb_cntl;
+ struct a618_cp_snapshot snapshot[A618_CP_SNAPSHOT_COUNT];
+ unsigned snapshots;
+ const char *first_fault;
+ unsigned sqe_started, secure_prepare_attempted;
+ int secure_prepare_error;
+ uint64_t initial_tsb_base;
+ uint32_t initial_tsb_size, initial_tsb_control;
+ unsigned aperture_phase;
+ int aperture_error;
+ int64_t aperture_status;
+ uint64_t aperture_response;
+ int poisoned;
+};
+/* Trusted kernel commands only. The caller verified SQE blob CRC, GPU stream
+ * mappings, GMU/HFI completion and live clocks/rails. Failure retains OOB and
+ * wired memory; no speculative reset/powerdown or retry. No userspace PM4. */
+int a618_cp_stage(const struct a618_dma_region *, const unsigned char *,
+ unsigned, void (*)(void *), void *);
+int a618_cp_start(const struct a618_io *, const struct a618_io *,
+ const struct a618_dma_region *, const unsigned char *, unsigned,
+ void (*)(void *), void *, int (*)(void *), void *, struct a618_cp_result *);
+struct a618_pas_result { unsigned phase; int64_t status; uint64_t response; };
+/* Optional SCM MP/CP aperture setup, fixed to the driver-owned CB0. */
+int a618_cp_configure_aperture(struct a618_pas_result *);
+/* Signed device ZAP only, live reserved range must match the device DT.
+ * Metadata lives in its own permanently retained, cache-inhibited host page.
+ * No security-register fallback if firmware authorization fails. */
+int a618_zap_authenticate(volatile uint32_t *, uint64_t,
+ const struct a618_dma_region *, const unsigned char *, unsigned,
+ const unsigned char *, unsigned, struct a618_pas_result *);
+int a618_gmu_dcvs(const struct a618_io *, unsigned index);
+int a618_cp_leave_secure(const struct a618_io *, const struct a618_io *,
+ const struct a618_dma_region *, void (*)(void *), void *, struct a618_cp_result *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/sweet_adreno_cp_smmu.c b/bsd/dev/sweet_adreno_cp_smmu.c
new file mode 100644
index 0000000..d4fc121
--- /dev/null
+++ b/bsd/dev/sweet_adreno_cp_smmu.c
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: MIT
+ * Original bounded SMMUv2 backend using the ARM architecture and public
+ * Linux/Qualcomm register protocols. See docs/adreno-port.md for source pins.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_cp.h"
+#define CP_CB 0x8000u
+#define ASID 0x62u
+/* FSR.Format[10:9] is read-only metadata, not a W1C fault. */
+#define FSR_FAULT 0xc00001feu
+static int
+put(const struct a618_io *io, uint32_t offset, uint32_t value,
+ uint32_t mask, struct a618_smmu_result *r)
+{
+ io->write(io->cookie, offset, value);
+ r->offset = offset; r->value = io->read(io->cookie, offset);
+ return r->value != 0xffffffffu && (r->value & mask) == (value & mask) ? 0 : EIO;
+}
+static int
+wait_clear(const struct a618_io *io, uint32_t offset, unsigned mask,
+ struct a618_smmu_result *r)
+{
+ for (unsigned i = 0; i < 500; ++i) {
+  r->offset = offset; r->value = io->read(io->cookie, offset);
+  if (r->value == 0xffffffffu) return EIO;
+  if (!(r->value & mask)) return 0;
+  io->delay_us(io->cookie, 1);
+ }
+ return ETIMEDOUT;
+}
+int
+a618_smmu_prepare_cp(const struct a618_smmu_io *ops,
+ const struct a618_dma_region *memory, struct a618_smmu_result *r)
+{
+ if (!ops || !memory || !r || !ops->registers.read ||
+     !ops->registers.write || !ops->registers.delay_us ||
+     !ops->read64 || !ops->write64 || !ops->barrier || !memory->cpu ||
+     !memory->uncached || memory->bytes != A618_CP_DMA_BYTES ||
+     (memory->physical & 0x3fff) || !memory->physical ||
+     memory->physical > (1ull << 36) - A618_CP_DMA_BYTES ||
+     ((uintptr_t)memory->cpu & 7)) return EINVAL;
+ const struct a618_io *io = &ops->registers;
+ *r = (struct a618_smmu_result){ .context = 0, .slot = 0xffffffffu };
+ /* Measured 0091 profile: 4 KiB register pages, 0x8000 CB base, five
+  * stream match slots and context banks, 36-bit PA. 16K PT granules are
+  * intentionally not used (Qualcomm advertises broken 16K support).
+  */
+ const uint32_t identity[] = {0x48016605, 0x20008005, 0x7511};
+ for (unsigned i = 0; i < 3; ++i) {
+  r->offset = 0x20 + 4 * i; r->value = io->read(io->cookie, r->offset);
+  if (r->value != identity[i]) return ENOTSUP;
+ }
+ /* Do not steal an active bank or matching stream, even if its firmware
+  * owner appears idle. CB1 and protected banks are left alone.
+  */
+ r->offset = CP_CB; r->value = io->read(io->cookie, CP_CB);
+ if (r->value == 0xffffffffu) return EIO;
+ if (r->value & 1) return EBUSY; /* M=0 is disabled; other reset bits may be UNKNOWN. */
+ for (unsigned i = 0; i < 5; ++i) {
+  r->offset = 0x800 + 4 * i;
+  uint32_t smr = r->value = io->read(io->cookie, r->offset);
+  if (smr == 0xffffffffu) return EIO;
+  if (!(smr & 0x80000000u)) {
+   if (r->slot == 0xffffffffu) r->slot = i;
+  } else if (((smr ^ 0u) & ~((smr >> 16) & 0x7fffu) & 0xffffu) == 0) {
+   r->slot = i; return EBUSY;
+  }
+ }
+ if (r->slot == 0xffffffffu) return ENOSPC;
+ r->control = io->read(io->cookie, 0);
+ if (r->control == 0xffffffffu) return EIO;
+ /* Three 4K tables inside one host page: L1[1] -> L2[384] ->
+  * L3[0..19] at 0x70000000. SQE pages are RO/executable; ring/fence
+  * pages RW/NX. Tables are inaccessible to the GPU. Normal NC/OSH.
+  */
+ volatile uint64_t *l1 = (volatile uint64_t *)memory->cpu;
+ volatile uint64_t *l2 = (volatile uint64_t *)(memory->cpu + 0x1000);
+ volatile uint64_t *l3 = (volatile uint64_t *)(memory->cpu + 0x2000);
+ for (unsigned i = 0; i < 512; ++i) l1[i] = l2[i] = l3[i] = 0;
+ l1[1] = (memory->physical + 0x1000) | 3;
+ l2[384] = (memory->physical + 0x2000) | 3;
+ for (unsigned i = 0; i < 20; ++i)
+  l3[i] = (memory->physical + A618_TABLE_BYTES + 0x1000 * i) |
+      (i < 8 ? 0 : (3ull << 53)) | (1u << 11) | (1u << 10) |
+      (2u << 8) | ((i < 8 ? 3u : 1u) << 6) | 3;
+ ops->barrier(io->cookie);
+ int error;
+ #define SET(o,v,m) do { error = put(io, (o), (v), (m), r); if (error) return error; } while (0)
+ SET(0x1800, 1, 1); /* GR1 CBA2R(1): AArch64. */
+ SET(0x1000, 0x1f300, 0x3f3ff); /* Stage1, stage2 bypass, weak upstream attributes. */
+ SET(CP_CB + 0x10, 0x38011, 0x38077); /* TCR2: SEP upstream, 36-bit output, AArch64 ASID. */
+ SET(CP_CB + 0x30, 0x00802020u, 0x00c0ffbfu); /* EPD1, OSH, NC walks, T0SZ=32; AArch64, no EAE. */
+ uint64_t ttbr = memory->physical | ((uint64_t)ASID << 48);
+ ops->write64(io->cookie, CP_CB + 0x20, ttbr);
+ r->offset = CP_CB + 0x20;
+ r->par = ops->read64(io->cookie, r->offset);
+ if ((r->par & 0xffff000ffffff000ull) != ttbr) return EIO;
+ ops->write64(io->cookie, CP_CB + 0x28, 0);
+ SET(CP_CB + 0x38, 0x44, 0xff); /* MAIR[0]: Normal NC. */
+ /* MAIR1 is unused: every data PTE references MAIR0[0]. */
+ /* Fault reporting enabled, IRQ/stalling disabled until an IRQ handler
+  * exists; HUPCF continues other transactions after an abort.
+  */
+ /* AFE/TRE are UNK/SBOP for long descriptors: write ones, do not
+  * compare their readback. Check M, E, fault controls, WXN and ASIDPNE.
+  */
+ SET(CP_CB, 0x1127, 0x17f1);
+ /* Block unmatched streams and enable this device. Preserve other controls;
+  * do not enable interrupt sources without handlers. No reset-all/TLBI-all.
+  */
+ SET(0, (r->control | 0x1c12u) & ~0xe025u, 0xfc37);
+ io->write(io->cookie, CP_CB + 0x610, ASID);
+ io->write(io->cookie, CP_CB + 0x7f0, 0);
+ error = wait_clear(io, CP_CB + 0x7f4, 1, r);
+ if (error) return error;
+ /* Hardware translation probes, not a software table walk: all twenty pages
+  * plus a guard fault must match before the stream is published.
+  */
+ for (unsigned i = 0; i <= 20; ++i) {
+  uint64_t va = (uint64_t)A618_CP_IOVA + i * 0x1000u;
+  ops->write64(io->cookie, CP_CB + 0x800, va);
+  error = wait_clear(io, CP_CB + 0x8f0, 1, r);
+  if (error) return error;
+  r->par = ops->read64(io->cookie, CP_CB + 0x50);
+  if (r->par == 0xffffffffffffffffull) return EIO;
+  if (i == 20) {
+   if (!(r->par & 1)) return EFAULT;
+  } else {
+   uint64_t expected = memory->physical + A618_TABLE_BYTES + i * 0x1000u;
+   if ((r->par & 1) || (r->par & 0x0000000ffffff000ull) != expected)
+    return EFAULT;
+   ++r->translated;
+  }
+ }
+ r->fault = io->read(io->cookie, CP_CB + 0x58);
+ if (r->fault == 0xffffffffu) return EIO;
+ if (r->fault & (1u << 30)) return EBUSY; /* Never resume an unknown stall. */
+ if (r->fault & FSR_FAULT) {
+  io->write(io->cookie, CP_CB + 0x58, r->fault & (FSR_FAULT & ~(1u << 30)));
+  uint32_t after = io->read(io->cookie, CP_CB + 0x58);
+  if (after == 0xffffffffu || (after & FSR_FAULT)) return EIO;
+ }
+ /* Only exact GPU stream 0, route first and VALID last. CP_CB/stream5
+  * remain owned by the running GMU. No user stream or bypass entry. */
+ SET(0xc00 + 4 * r->slot, 0, 0x030300ff);
+ SET(0x800 + 4 * r->slot, 0x80000000u, 0xffffffffu);
+ r->fault = io->read(io->cookie, CP_CB + 0x58);
+ #undef SET
+ return r->fault == 0xffffffffu || (r->fault & FSR_FAULT) ? EIO : 0;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_dma.h b/bsd/dev/sweet_adreno_dma.h
new file mode 100644
index 0000000..414871d
--- /dev/null
+++ b/bsd/dev/sweet_adreno_dma.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SWEET_ADRENO_DMA_H
+#define SWEET_ADRENO_DMA_H
+#include "sweet_adreno.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define A618_DMA_BYTES 0x14000u
+#define A618_TABLE_BYTES 0x4000u
+#define A618_SHARED_IOVA 0x60000000u
+#define A618_HFI_IOVA 0x60004000u
+#define A618_DEBUG_IOVA 0x60008000u
+#define A618_LOG_IOVA 0x6000c000u
+struct a618_dma_region {
+ unsigned char *cpu;
+ uint64_t physical;
+ unsigned bytes;
+ unsigned uncached;
+};
+struct a618_smmu_io {
+ struct a618_io registers;
+ uint64_t (*read64)(void *, uint32_t);
+ void (*write64)(void *, uint32_t, uint64_t);
+ void (*barrier)(void *);
+};
+struct a618_smmu_result {
+ unsigned context, slot, translated;
+ uint32_t control, fault, offset, value;
+ uint64_t par;
+};
+/* Permanent wired allocation: retain on failure once hardware can reference it. */
+int sweet_adreno_dma_allocate(struct a618_dma_region *);
+/* Caller holds GMU reset, GX off, clocks/rails on. CB0 is never touched.
+ * Only the measured SMMU profile is accepted. No reset-all or bypass domain.
+ * Full DMA readiness requires all 16 translation checks and the guard fault.
+ */
+int a618_smmu_prepare(const struct a618_smmu_io *,
+ const struct a618_dma_region *, struct a618_smmu_result *);
+/* Legacy HFI v1, single host producer/consumer, uncached shared storage.
+ * barrier orders device-visible RAM. All caller messages are trusted kernel
+ * data, <=255 DWORDs. These APIs do not start firmware or touch MMIO.
+ */
+struct a618_hfi {
+ volatile uint32_t *table;
+ void (*barrier)(void *);
+ void *cookie;
+ unsigned sequence, poisoned, responses;
+ uint32_t last_request, last_response, firmware_error;
+};
+int a618_hfi_init(struct a618_hfi *, const struct a618_dma_region *,
+ void (*)(void *), void *);
+int a618_hfi_write(struct a618_hfi *, const uint32_t *, unsigned);
+int a618_hfi_read(struct a618_hfi *, unsigned, uint32_t *, unsigned, unsigned *);
+/* Single caller, polled legacy v1 RPC. A timeout/fault poisons the session:
+ * never reuse it or release DMA memory while firmware ownership is uncertain.
+ * payload_words is a required response length, not an unchecked copy size.
+ */
+int a618_hfi_call(struct a618_hfi *, const struct a618_io *, unsigned,
+ const uint32_t *, unsigned, uint32_t *, unsigned);
+int a618_hfi_bootstrap(struct a618_hfi *, const struct a618_io *,
+ uint32_t gpu_vote, uint32_t gmu_vote, uint32_t *firmware_version);
+/* Optional active GPU levels after the mandatory off entry, ascending. When
+ * empty the legacy single level (derived from gpu_vote) is sent. Index i in
+ * this table is HFI performance index i+1 for the legacy DCVS request. */
+#define A618_GPU_LEVELS_MAX 8u
+struct a618_gpu_level { uint32_t vote, khz; };
+extern struct a618_gpu_level a618_gpu_levels[A618_GPU_LEVELS_MAX];
+extern unsigned a618_gpu_level_count;
+struct a618_gmu_boot_result {
+ unsigned phase;
+ uint32_t offset, value, firmware_version;
+};
+/* SM7150/A618 cold boot only. Firmware must be staged, the shared SMMU
+ * mappings verified and all clocks/parent rails held before calling.
+ * PDC/PDC-sequence apertures are the SM7150 DT regions. No warm resume,
+ * CP/SQE init, GPU stream mapping, graphics service or rendering here.
+ */
+int a618_gmu_boot_legacy(const struct a618_io *, const struct a618_io *,
+ const struct a618_io *, struct a618_hfi *, uint32_t, uint32_t,
+ struct a618_gmu_boot_result *);
+/* Read command DB only; constructs raw ARC votes for the documented MIN_SVS
+ * 180 MHz GPU / 200 MHz GMU operating points. No ACTIVE rail write.
+ */
+int sweet_rpmh_adreno_votes(uint32_t *, uint32_t *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/sweet_adreno_gmu.c b/bsd/dev/sweet_adreno_gmu.c
new file mode 100644
index 0000000..7951dc0
--- /dev/null
+++ b/bsd/dev/sweet_adreno_gmu.c
@@ -0,0 +1,186 @@
+/* SPDX-License-Identifier: MIT
+ * A618 cold-start implementation using the pinned SM7150 Linux register and
+ * firmware protocols. See docs/adreno-port.md for scope and source hashes.
+ * Single caller. No dynamic clock scaling, warm boot, IRQs or CP submission.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_dma.h"
+#define GMU_CM3_DTCM_START 0x7000u
+#define GMU_GENERAL_7 0x14730u
+#define GMU_CM3_BOOT_CONFIG 0x14004u
+#define GMU_HFI_QTBL_ADDR 0x14614u
+#define GMU_HFI_QTBL_INFO 0x14610u
+#define GMU_AHB_FENCE_RANGE_0 0x24c44u
+#define GMU_CM3_CFG 0x140b4u
+#define GMU_HFI_SFR_ADDR 0x14608u
+#define GPU_GMU_CX_GMU_PWR_COL_CP_MSG 0x14400u
+#define GPU_GMU_CX_GMU_PWR_COL_CP_RESP 0x14404u
+#define GMU_SYS_BUS_CONFIG 0x1303cu
+#define GMU_ICACHE_CONFIG 0x13000u
+#define GMU_DCACHE_CONFIG 0x13004u
+#define GMU_PWR_COL_INTER_FRAME_CTRL 0x14300u
+#define GMU_RPMH_CTRL 0x143a0u
+#define GMU_BOOT_SLUMBER_OPTION 0x8fe0u
+#define GMU_GX_VOTE_IDX 0x8fe4u
+#define GMU_MX_VOTE_IDX 0x8fe8u
+#define GMU_HOST2GMU_INTR_SET 0x14650u
+#define GMU_GMU2HOST_INTR_INFO 0x14648u
+#define GMU_GMU2HOST_INTR_CLR 0x14644u
+#define GMU_GMU2HOST_INTR_MASK 0x1464cu
+#define GMU_AO_HOST_INTERRUPT_MASK 0x24c18u
+#define GMU_GX_SPTPRAC_POWER_CONTROL 0x204u
+#define GMU_SPTPRAC_PWR_CLK_STATUS 0x14340u
+#define GMU_HFI_CTRL_INIT 0x14618u
+#define GMU_HFI_CTRL_STATUS 0x14600u
+
+static int
+valid_io(const struct a618_io *io)
+{
+ return io && io->read && io->write && io->delay_us;
+}
+static int
+poll(const struct a618_io *io, uint32_t offset, uint32_t mask,
+ uint32_t expected, unsigned timeout, struct a618_gmu_boot_result *result)
+{
+ result->offset = offset;
+ for (unsigned us = 0; us <= timeout; us += 10) {
+  result->value = io->read(io->cookie, offset);
+  if (result->value == 0xffffffffu) return EIO;
+  uint32_t faults = io->read(io->cookie, 0x24c14); /* AO status */
+  uint32_t interrupts = io->read(io->cookie, GMU_GMU2HOST_INTR_INFO);
+  if (faults == 0xffffffffu || interrupts == 0xffffffffu ||
+      (faults & 0x29) || (interrupts & (1u << 23))) return EIO;
+  if ((result->value & mask) == expected) return 0;
+  if (us != timeout) io->delay_us(io->cookie, 10);
+ }
+ return ETIMEDOUT;
+}
+static void
+rscc_write(const struct a618_io *gmu, unsigned reg, uint32_t value)
+{
+ gmu->write(gmu->cookie, 0x23000 + reg * 4, value);
+}
+static void
+pdc_program(const struct a618_io *gmu, const struct a618_io *pdc,
+ const struct a618_io *seq)
+{
+ /* SM7150 A618 constants, not the newer A650/A7xx sequence. */
+ static const uint32_t rsc[] = {
+  0xa7a506a0, 0xa1e6a6e7, 0xa2e081e1, 0xe9a982e2, 0x0020e8a8 };
+ static const uint32_t program[] = {
+  0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+ rscc_write(gmu, 4, 1u << 24);
+ rscc_write(gmu, 0xb, 1);
+ for (unsigned i = 0; i < 3; ++i) {
+  rscc_write(gmu, 0xe + i * 2, i == 2 ? 0x80000000 : 0);
+  rscc_write(gmu, 0xd + i * 2, 0);
+ }
+ rscc_write(gmu, 0x100, 0);
+ rscc_write(gmu, 8, 0x4520);
+ rscc_write(gmu, 9, 0x4510);
+ rscc_write(gmu, 0xa, 0x4514);
+ for (unsigned i = 0; i < 5; ++i) {
+  rscc_write(gmu, 0x180 + i, rsc[i]);
+  seq->write(seq->cookie, i * 4, program[i]);
+ }
+ /* Third address is the target-specific A618 PDC resource from Linux.
+  * Do not label it xo.lvl without command-DB identity evidence. */
+ static const uint32_t address[] = {0x30010, 0x30000, 0x30090};
+ static const uint32_t sleep[] = {1, 0, 0}, wake[] = {2, 2, 3};
+ for (unsigned bank = 0; bank < 2; ++bank) {
+  unsigned base = bank ? 0x15d6 : 0x1572; /* TCS3 / TCS1 DWORD offsets */
+  pdc->write(pdc->cookie, (base + 1) * 4, 7);
+  pdc->write(pdc->cookie, (base + 2) * 4, 0);
+  pdc->write(pdc->cookie, base * 4, 0);
+  for (unsigned i = 0; i < 3; ++i) {
+   unsigned command = base + 3 + 4 * i;
+   pdc->write(pdc->cookie, command * 4, 0x10108);
+   pdc->write(pdc->cookie, (command + 1) * 4, address[i]);
+   pdc->write(pdc->cookie, (command + 2) * 4, bank ? wake[i] : sleep[i]);
+  }
+ }
+ pdc->write(pdc->cookie, 0x1148 * 4, 0);
+ pdc->write(pdc->cookie, 0x1140 * 4, 0x80000001);
+}
+int
+a618_gmu_boot_legacy(const struct a618_io *gmu, const struct a618_io *pdc,
+ const struct a618_io *seq, struct a618_hfi *hfi, uint32_t gpu_vote,
+ uint32_t gmu_vote, struct a618_gmu_boot_result *result)
+{
+ if (!valid_io(gmu) || !valid_io(pdc) || !valid_io(seq) || !hfi ||
+     !hfi->table || !hfi->barrier || hfi->poisoned || !result ||
+     !(gpu_vote >> 16) || !(gmu_vote >> 16)) return EINVAL;
+ result->phase = result->offset = result->value = result->firmware_version = 0;
+ /* Never reload a running M3 or pretend a warm boot is cold. The caller
+  * has already validated every SMMU page and the unmapped guard. */
+ if (gmu->read(gmu->cookie, A618_GMU_SYSRESET) != 1) return EBUSY;
+ uint32_t version = gmu->read(gmu->cookie, GMU_CM3_DTCM_START + 0xff8 * 4);
+ if (version == 0xffffffffu) return EIO;
+ /* Polled faults only; no unhandled GMU interrupts reach the host GIC. */
+ gmu->write(gmu->cookie, GMU_GMU2HOST_INTR_MASK, 0xffffffffu);
+ gmu->write(gmu->cookie, GMU_AO_HOST_INTERRUPT_MASK, 0xffffffffu);
+ gmu->write(gmu->cookie, GMU_GMU2HOST_INTR_CLR, 0xffffffffu);
+ gmu->write(gmu->cookie, 0x24c10, 0xffffffffu); /* AO status W1C */
+ /* A reset M3 does not prove the independent RSC sequencer is idle. */
+ if (gmu->read(gmu->cookie, 0x23000 + 0x101 * 4) != 0) return EBUSY;
+ pdc_program(gmu, pdc, seq);
+ gmu->write(gmu->cookie, GMU_GENERAL_7, 1);
+ gmu->write(gmu->cookie, A618_GMU_FW_INIT_RESULT, 0);
+ gmu->write(gmu->cookie, GMU_CM3_BOOT_CONFIG, 2);
+ gmu->write(gmu->cookie, GMU_HFI_QTBL_ADDR, A618_HFI_IOVA);
+ gmu->write(gmu->cookie, GMU_HFI_QTBL_INFO, 1);
+ gmu->write(gmu->cookie, GMU_AHB_FENCE_RANGE_0, (1u << 31) | (0xau << 18) | 0xa0);
+ gmu->write(gmu->cookie, GMU_CM3_CFG, 0x4052);
+ /* 0x06010800 chipid in the GMU's packed minor/patch layout. */
+ gmu->write(gmu->cookie, GMU_HFI_SFR_ADDR, 0x06018000);
+ gmu->write(gmu->cookie, GPU_GMU_CX_GMU_PWR_COL_CP_MSG, A618_LOG_IOVA | 3);
+ gmu->write(gmu->cookie, GMU_SYS_BUS_CONFIG, 1);
+ gmu->write(gmu->cookie, GMU_ICACHE_CONFIG, 1);
+ gmu->write(gmu->cookie, GMU_DCACHE_CONFIG, 1);
+ /* ACTIVE idle policy: no automatic GX collapse until recovery exists. */
+ gmu->write(gmu->cookie, GMU_PWR_COL_INTER_FRAME_CTRL, 0x09c40400);
+ uint32_t rpmh = gmu->read(gmu->cookie, GMU_RPMH_CTRL);
+ if (rpmh == 0xffffffffu) return EIO;
+ gmu->write(gmu->cookie, GMU_RPMH_CTRL, rpmh | 0xf11);
+ gmu->write(gmu->cookie, GPU_GMU_CX_GMU_PWR_COL_CP_RESP, 0);
+ hfi->barrier(hfi->cookie);
+ result->phase = 1;
+ gmu->write(gmu->cookie, A618_GMU_SYSRESET, 0);
+ int error = poll(gmu, A618_GMU_FW_INIT_RESULT,
+     version <= 0x20010004 ? 0xffffffffu : 0x1ff,
+     version <= 0x20010004 ? 0xbabeface : 0x100, 10000, result);
+ if (error) goto failed;
+ result->phase = 2;
+ gmu->write(gmu->cookie, GMU_BOOT_SLUMBER_OPTION, 0);
+ gmu->write(gmu->cookie, GMU_GX_VOTE_IDX, gpu_vote & 255);
+ gmu->write(gmu->cookie, GMU_MX_VOTE_IDX, (gpu_vote >> 8) & 255);
+ gmu->write(gmu->cookie, GMU_HOST2GMU_INTR_SET, 1u << 22);
+ error = poll(gmu, GMU_GMU2HOST_INTR_INFO, 1u << 30, 1u << 30, 10000, result);
+ gmu->write(gmu->cookie, GMU_GMU2HOST_INTR_CLR, 1u << 30);
+ if (error) goto failed;
+ result->phase = 3;
+ gmu->write(gmu->cookie, GMU_GX_SPTPRAC_POWER_CONTROL, 0x778000);
+ error = poll(gmu, GMU_SPTPRAC_PWR_CLK_STATUS, 0x38, 0x28, 100, result);
+ if (error) goto failed;
+ result->phase = 4;
+ gmu->write(gmu->cookie, GMU_HFI_CTRL_INIT, 1);
+ error = poll(gmu, GMU_HFI_CTRL_STATUS, 1, 1, 10000, result);
+ if (error) goto failed;
+ result->phase = 5;
+ error = a618_hfi_bootstrap(hfi, gmu, gpu_vote, gmu_vote, &result->firmware_version);
+ if (error) goto failed;
+ result->phase = 6; /* GMU/HFI ready; this does not imply a working GPU CP. */
+ return 0;
+failed:
+ /* Do not reset/power down behind an in-flight RPMh transaction or free
+  * its DMA storage. Preserve the failure registers and poison the session.
+  * Controlled shutdown/recovery is still required before any retry. */
+ hfi->poisoned = 1;
+ return error;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_hfi.c b/bsd/dev/sweet_adreno_hfi.c
new file mode 100644
index 0000000..ad20320
--- /dev/null
+++ b/bsd/dev/sweet_adreno_hfi.c
@@ -0,0 +1,234 @@
+/* SPDX-License-Identifier: MIT
+ * Legacy GMU HFI v1 wire format, original bounded host transport.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#include <sys/systm.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_dma.h"
+#define QUEUE_WORDS 1024u
+#define HEADER_WORDS 12u
+static volatile uint32_t *
+queue_header(struct a618_hfi *hfi, unsigned queue)
+{
+ return hfi->table + 6 + queue * HEADER_WORDS;
+}
+static int
+indices(struct a618_hfi *hfi, unsigned queue, unsigned *read, unsigned *write)
+{
+ volatile uint32_t *header = queue_header(hfi, queue);
+ hfi->barrier(hfi->cookie);
+ if (header[0] != 1 || header[3] != QUEUE_WORDS) return EIO;
+ *read = header[10]; *write = header[11];
+ if (*read >= QUEUE_WORDS || *write >= QUEUE_WORDS) return EIO;
+ hfi->barrier(hfi->cookie);
+ return 0;
+}
+int
+a618_hfi_init(struct a618_hfi *hfi, const struct a618_dma_region *memory,
+ void (*barrier)(void *), void *cookie)
+{
+ if (!hfi || !memory || !memory->cpu || !memory->uncached || !barrier ||
+     memory->bytes != A618_DMA_BYTES || ((uintptr_t)memory->cpu & 3))
+  return EINVAL;
+ hfi->table = (volatile uint32_t *)(memory->cpu + A618_TABLE_BYTES +
+     (A618_HFI_IOVA - A618_SHARED_IOVA));
+ hfi->barrier = barrier; hfi->cookie = cookie;
+ hfi->sequence = hfi->poisoned = hfi->responses = 0;
+ hfi->last_request = hfi->last_response = hfi->firmware_error = 0;
+ for (unsigned i = 0; i < 4096; ++i) hfi->table[i] = 0;
+ hfi->table[0] = 0;
+ hfi->table[1] = 24 + 3 * 48; /* size in bytes; offsets below in DWORDs */
+ hfi->table[2] = 6; hfi->table[3] = 12;
+ hfi->table[4] = hfi->table[5] = 3;
+ const unsigned id[] = {0, 4, 5};
+ for (unsigned q = 0; q < 3; ++q) {
+  volatile uint32_t *header = queue_header(hfi, q);
+  header[0] = 1;
+  header[1] = A618_HFI_IOVA + (q + 1) * 4096;
+  header[2] = (10u << 8) | id[q];
+  header[3] = QUEUE_WORDS;
+  header[6] = header[7] = header[8] = 1;
+ }
+ barrier(cookie);
+ return 0;
+}
+int
+a618_hfi_write(struct a618_hfi *hfi, const uint32_t *words, unsigned count)
+{
+ if (!hfi || !hfi->table || !hfi->barrier || !words || !count || count > 255 ||
+     ((words[0] >> 8) & 255) != count || (words[0] & 0xf0000u)) return EINVAL;
+ unsigned read, write;
+ int error = indices(hfi, 0, &read, &write);
+ if (error) return error;
+ unsigned free_words = (read + QUEUE_WORDS - write - 1) % QUEUE_WORDS;
+ if (count > free_words) return ENOSPC;
+ volatile uint32_t *data = hfi->table + QUEUE_WORDS;
+ for (unsigned i = 0; i < count; ++i) data[(write + i) % QUEUE_WORDS] = words[i];
+ hfi->barrier(hfi->cookie);
+ queue_header(hfi, 0)[11] = (write + count) % QUEUE_WORDS;
+ hfi->barrier(hfi->cookie);
+ return 0;
+}
+int
+a618_hfi_read(struct a618_hfi *hfi, unsigned queue, uint32_t *words,
+ unsigned capacity, unsigned *count)
+{
+ if (!count) return EINVAL;
+ *count = 0;
+ if (!hfi || !hfi->table || !hfi->barrier || !words || !capacity ||
+     queue < 1 || queue > 2) return EINVAL;
+ unsigned read, write;
+ int error = indices(hfi, queue, &read, &write);
+ if (error) return error;
+ unsigned available = (write + QUEUE_WORDS - read) % QUEUE_WORDS;
+ if (!available) {
+  queue_header(hfi, queue)[8] = 1;
+  hfi->barrier(hfi->cookie);
+  return EAGAIN;
+ }
+ volatile uint32_t *data = hfi->table + (queue + 1) * QUEUE_WORDS;
+ unsigned size = (data[read] >> 8) & 255;
+ if (!size) return EIO;
+ if (size > available) return EAGAIN;
+ if (size > capacity) return EMSGSIZE;
+ for (unsigned i = 0; i < size; ++i) words[i] = data[(read + i) % QUEUE_WORDS];
+ hfi->barrier(hfi->cookie);
+ queue_header(hfi, queue)[10] = (read + size) % QUEUE_WORDS;
+ hfi->barrier(hfi->cookie);
+ *count = size;
+ return 0;
+}
+
+/* GMU-relative byte offsets from the A6xx register XML. Keep host IRQs
+ * masked: this backend polls, and no XNU interrupt handler is installed. */
+#define HFI_INTR_INFO 0x14648u
+#define HFI_INTR_CLEAR 0x14644u
+#define HFI_DOORBELL 0x14650u
+#define HFI_CM3_FAULT (1u << 23)
+int
+a618_hfi_call(struct a618_hfi *hfi, const struct a618_io *io, unsigned id,
+ const uint32_t *body, unsigned body_words, uint32_t *payload,
+ unsigned payload_words)
+{
+ if (!hfi || !hfi->table || !hfi->barrier || !io || !io->read ||
+     !io->write || !io->delay_us || id > 255 || body_words > 254 ||
+     (body_words && !body) || payload_words > 252 ||
+     (payload_words && !payload)) return EINVAL;
+ if (hfi->poisoned) return EIO;
+ uint32_t message[255];
+ hfi->sequence = (hfi->sequence + 1) % 0xfffu;
+ uint32_t sent = (hfi->sequence << 20) | ((body_words + 1) << 8) | id;
+ message[0] = sent;
+ hfi->last_request = sent;
+ for (unsigned i = 0; i < body_words; ++i) message[i + 1] = body[i];
+ int error = a618_hfi_write(hfi, message, body_words + 1);
+ if (error) return error; /* Nothing published on a rejected append. */
+ io->write(io->cookie, HFI_DOORBELL, 1);
+ for (unsigned elapsed = 0; elapsed < 1000000; elapsed += 100) {
+  uint32_t interrupt = io->read(io->cookie, HFI_INTR_INFO);
+  if (interrupt == 0xffffffffu || (interrupt & HFI_CM3_FAULT)) {
+   error = EIO; goto failed;
+  }
+  /* W1C before reading: a concurrent firmware append remains visible via
+   * the queue indices, including when no fresh interrupt edge is seen. */
+  if (interrupt & 1) io->write(io->cookie, HFI_INTR_CLEAR, 1);
+  unsigned words = 0;
+  error = a618_hfi_read(hfi, 1, message, 255, &words);
+  if (error != EAGAIN && error) goto failed;
+  if (!error) {
+   ++hfi->responses;
+   unsigned received_id = message[0] & 255;
+   unsigned type = (message[0] >> 16) & 15;
+   if (received_id == 100) { error = EIO; goto failed; }
+   if (received_id != 126 || type != 2 || words < 3) {
+    error = EPROTO; goto failed;
+   }
+   /* Match command ID and transaction sequence as in the Linux transport;
+    * request length bits are not used to size the ACK payload. The actual
+    * response length/type were validated above. Stale ACKs cannot extend
+    * the fixed one-second deadline. */
+   hfi->last_response = message[1];
+   if ((message[1] & 0xfff000ffu) == (sent & 0xfff000ffu)) {
+    hfi->firmware_error = message[2];
+    if (message[2]) { error = EIO; goto failed; }
+    if (words < 3 + payload_words) { error = EPROTO; goto failed; }
+    for (unsigned i = 0; i < payload_words; ++i) payload[i] = message[3 + i];
+    return 0;
+   }
+  }
+  /* Drain a single debug packet per iteration so logs cannot deadlock FW.
+   * All queue indices and packet sizes pass the same validation. */
+  error = a618_hfi_read(hfi, 2, message, 255, &words);
+  if (error != EAGAIN && error) goto failed;
+  if (!error && (message[0] & 255) == 100) { error = EIO; goto failed; }
+  io->delay_us(io->cookie, 100);
+ }
+ error = ETIMEDOUT;
+failed:
+ hfi->poisoned = 1;
+ return error;
+}
+
+struct a618_gpu_level a618_gpu_levels[A618_GPU_LEVELS_MAX];
+unsigned a618_gpu_level_count;
+
+int
+a618_hfi_bootstrap(struct a618_hfi *hfi, const struct a618_io *io,
+ uint32_t gpu_vote, uint32_t gmu_vote, uint32_t *firmware_version)
+{
+ if (!firmware_version || !(gpu_vote >> 16) || !(gmu_vote >> 16)) return EINVAL;
+ *firmware_version = 0;
+ uint32_t init[] = {0, A618_DEBUG_IOVA, 0x4000, 1}; /* cold boot = 1 */
+ int error = a618_hfi_call(hfi, io, 0, init, 4, 0, 0);
+ if (error) return error;
+ uint32_t supported = (1u << 28) | (1u << 19) | (1u << 17); /* HFI 1.10 */
+ error = a618_hfi_call(hfi, io, 1, &supported, 1, firmware_version, 1);
+ if (error) return error;
+ /* The pinned SM7150 DT permits 267MHz at raw LOW_SVS=64 for all
+  * speed bins (opp-supported-hw=0x1f). The live command DB already rounds
+  * our MIN_SVS=48 request up to raw64; use that existing voltage corner.
+  * Keep 180MHz if a different command DB supplies a lower corner. Never
+  * infer a measured clock from firmware accepting this table. Higher
+  * frequency/voltage corners and dynamic scaling remain absent. */
+ const uint32_t gpu_khz = (gpu_vote >> 16) >= 64u ? 267000u : 180000u;
+#if defined(KERNEL)
+ printf("SWEET ADRENO: HFI active OPP configured=%u kHz raw_corner=%u; clock not measured\n",
+     gpu_khz, gpu_vote >> 16);
+#endif
+ uint32_t perf[42] = {0}; /* body of the fixed 43-DWORD v1 message */
+ /* Linux a6xx_hfi_msg_perf_table_v1: counts, 16 gx {vote,kHz}, 4 cx. */
+ perf[0] = perf[1] = 2;
+ perf[4] = gpu_vote; perf[5] = gpu_khz;
+ if (a618_gpu_level_count && a618_gpu_level_count <= A618_GPU_LEVELS_MAX) {
+  perf[0] = 1 + a618_gpu_level_count;
+  for (unsigned i = 0; i < a618_gpu_level_count; ++i) {
+   perf[4 + 2 * i] = a618_gpu_levels[i].vote;
+   perf[5 + 2 * i] = a618_gpu_levels[i].khz;
+#if defined(KERNEL)
+   printf("SWEET ADRENO: HFI perf index %u vote=%#x %u kHz\n", i + 1,
+       a618_gpu_levels[i].vote, a618_gpu_levels[i].khz);
+#endif
+  }
+ }
+ perf[36] = gmu_vote; perf[37] = 200000;
+ error = a618_hfi_call(hfi, io, 4, perf, 42, 0, 0);
+ if (error) return error;
+ /* A618 uses a single DDR off entry: GMU does not scale its bus. Exact
+  * target-specific wire constants from Linux a618_build_bw_table().
+  * Host interconnect bandwidth remains a separate prerequisite. */
+ uint32_t bw[159] = {0}; /* body of the fixed 160-DWORD message */
+ bw[0] = 1; bw[1] = 1; bw[2] = 3; bw[3] = bw[4] = 1;
+ bw[5] = 0x5007c;
+ bw[11] = 0x40000000; bw[17] = 0x60000001;
+ bw[23] = 0x50000; bw[24] = 0x5003c; bw[25] = 0x5000c;
+ bw[31] = bw[32] = bw[33] = 0x40000000;
+ error = a618_hfi_call(hfi, io, 3, bw, 159, 0, 0);
+ if (error) return error;
+ /* Wire message 5 ends legacy initialization (named TEST in Linux). */
+ return a618_hfi_call(hfi, io, 5, 0, 0, 0, 0);
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_pas.c b/bsd/dev/sweet_adreno_pas.c
new file mode 100644
index 0000000..27d080f
--- /dev/null
+++ b/bsd/dev/sweet_adreno_pas.c
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: MIT
+ * Restricted SM7150 signed-ZAP PAS transport (public Qualcomm SCM protocol).
+ * No generic SCM entry point, memory-assignment or security-register bypass.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include "sweet_adreno_cp.h"
+static uint32_t
+le32(const unsigned char *p)
+{
+ return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+     ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static int
+scm(unsigned service, unsigned command, uint64_t arguments,
+ uint64_t arg0, uint64_t arg1, uint64_t arg2, uint64_t arg3,
+ struct a618_pas_result *result)
+{
+ uint64_t function = 0x42000000u | (service << 8) | command;
+ for (unsigned busy = 0; busy < 5; ++busy) {
+  uint64_t resume = function, quirk_a6 = 0;
+  for (unsigned interrupted = 0; interrupted < 32; ++interrupted) {
+   register uint64_t x0 __asm__("x0") = resume;
+   register uint64_t x1 __asm__("x1") = arguments;
+   register uint64_t x2 __asm__("x2") = arg0;
+   register uint64_t x3 __asm__("x3") = arg1;
+   register uint64_t x4 __asm__("x4") = arg2;
+   register uint64_t x5 __asm__("x5") = arg3;
+   register uint64_t x6 __asm__("x6") = quirk_a6;
+   register uint64_t x7 __asm__("x7") = 0;
+   __asm__ volatile("dsb sy\n\tsmc #0\n\tdsb sy" :
+       "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+       "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7) : :
+       "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+       "x16", "x17", "memory", "cc");
+   result->status = (int64_t)x0;
+   result->response = x1;
+   if (x0 == 1) { resume = 1; quirk_a6 = x6; continue; }
+   if ((int64_t)x0 == -12) break; /* bounded busy retry */
+   if (x0) return x0 == (uint64_t)-1 ? ENOTSUP : EIO;
+   return 0;
+  }
+  if (result->status != -12) return ETIMEDOUT;
+  if (busy != 4) delay(30000);
+ }
+ return EBUSY;
+}
+/* Public SCM aperture protocol used by the pinned Linux Adreno driver.
+ * Availability is optional; an advertised call that fails is fatal. The four
+ * arguments fit x2..x5 directly, so no shared extended-argument buffer exists.
+ * This entry cannot select another context or issue arbitrary SCM commands. */
+int
+a618_cp_configure_aperture(struct a618_pas_result *result)
+{
+ if (!result) return EINVAL;
+ *result = (struct a618_pas_result){ .phase = 1 };
+ int error = scm(6, 1, 1, 0x02000c1b, 0, 0, 0, result);
+ /* Linux treats a failed availability query as unavailable. It has no
+  * configuration side effects; retain raw status for the boot log. */
+ if (error) return 0;
+ if (!result->response) return 0; /* optional MP command unavailable */
+ result->phase = 2;
+ error = scm(0x0c, 0x1b, 4, 0xffff0000, 0xffffffffu,
+     0xffffffffu, 0xffffffffu, result);
+ if (error) return error;
+ result->phase = 3;
+ return 0;
+}
+int
+a618_zap_authenticate(volatile uint32_t *reserved, uint64_t physical,
+ const struct a618_dma_region *metadata, const unsigned char *mdt,
+ unsigned mdt_bytes, const unsigned char *code, unsigned code_bytes,
+ struct a618_pas_result *result)
+{
+ if (!result) return EINVAL;
+ *result = (struct a618_pas_result){0};
+ if (!reserved || physical != 0x97f15000ull || !metadata || !metadata->cpu ||
+     metadata->bytes != 0x4000 || !metadata->uncached ||
+     !metadata->physical || (metadata->physical & 0x3fff) ||
+     metadata->physical >= (1ull << 36) || !mdt || !code ||
+     mdt_bytes != 0x1acc || code_bytes != 0x7c0 ||
+     le32(mdt) != 0x464c457f || mdt[4] != 1 || mdt[5] != 1 ||
+     le32(mdt + 28) != 52 || (le32(mdt + 44) & 0xffff) != 3 || le32(mdt + 40) != 0x00200034 ||
+     le32(mdt + 52 + 2 * 32) != 1 ||
+     le32(mdt + 52 + 2 * 32 + 12) != 0x5000 ||
+     le32(mdt + 52 + 2 * 32 + 16) != code_bytes ||
+     le32(mdt + 52 + 2 * 32 + 20) != code_bytes ||
+     le32(mdt + 52 + 2 * 32 + 24) != 0x08000007) return EINVAL;
+ result->phase = 1;
+ const unsigned commands[] = {1, 2, 5};
+ for (unsigned i = 0; i < 3; ++i) {
+  int error = scm(6, 1, 1, 0x02000200u | commands[i], 0, 0, 0, result);
+  if (error) return error;
+  if (!result->response) return ENOTSUP;
+ }
+ volatile uint32_t *words = (volatile uint32_t *)metadata->cpu;
+ for (unsigned i = 0; i < mdt_bytes / 4; ++i) words[i] = le32(mdt + i * 4);
+ __asm__ volatile("dsb sy" ::: "memory");
+ result->phase = 2;
+ int error = scm(2, 1, 0x82, 13, metadata->physical, 0, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ /* TZ may now protect metadata. Retain its separate page and do not read,
+  * modify, free or reuse it, including on errors below. */
+ result->phase = 3;
+ error = scm(2, 2, 3, 13, physical, 0x1000, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ for (unsigned i = 0; i < 0x1000 / 4; ++i) reserved[i] = 0;
+ for (unsigned i = 0; i < code_bytes / 4; ++i) reserved[i] = le32(code + i * 4);
+ __asm__ volatile("dsb sy" ::: "memory");
+ result->phase = 4;
+ error = scm(2, 5, 1, 13, 0, 0, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ result->phase = 5;
+ return 0;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_smmu.c b/bsd/dev/sweet_adreno_smmu.c
new file mode 100644
index 0000000..e27c05c
--- /dev/null
+++ b/bsd/dev/sweet_adreno_smmu.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: MIT
+ * Original bounded SMMUv2 backend using the ARM architecture and public
+ * Linux/Qualcomm register protocols. See docs/adreno-port.md for source pins.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_dma.h"
+#define CB1 0x9000u
+#define ASID 0x61u
+/* FSR.Format[10:9] is read-only metadata, not a W1C fault. */
+#define FSR_FAULT 0xc00001feu
+static int
+put(const struct a618_io *io, uint32_t offset, uint32_t value,
+ uint32_t mask, struct a618_smmu_result *r)
+{
+ io->write(io->cookie, offset, value);
+ r->offset = offset; r->value = io->read(io->cookie, offset);
+ return r->value != 0xffffffffu && (r->value & mask) == (value & mask) ? 0 : EIO;
+}
+static int
+wait_clear(const struct a618_io *io, uint32_t offset, unsigned mask,
+ struct a618_smmu_result *r)
+{
+ for (unsigned i = 0; i < 500; ++i) {
+  r->offset = offset; r->value = io->read(io->cookie, offset);
+  if (r->value == 0xffffffffu) return EIO;
+  if (!(r->value & mask)) return 0;
+  io->delay_us(io->cookie, 1);
+ }
+ return ETIMEDOUT;
+}
+int
+a618_smmu_prepare(const struct a618_smmu_io *ops,
+ const struct a618_dma_region *memory, struct a618_smmu_result *r)
+{
+ if (!ops || !memory || !r || !ops->registers.read ||
+     !ops->registers.write || !ops->registers.delay_us ||
+     !ops->read64 || !ops->write64 || !ops->barrier || !memory->cpu ||
+     !memory->uncached || memory->bytes != A618_DMA_BYTES ||
+     (memory->physical & 0x3fff) || !memory->physical ||
+     memory->physical > (1ull << 36) - A618_DMA_BYTES ||
+     ((uintptr_t)memory->cpu & 7)) return EINVAL;
+ const struct a618_io *io = &ops->registers;
+ *r = (struct a618_smmu_result){ .context = 1, .slot = 0xffffffffu };
+ /* Measured 0091 profile: 4 KiB register pages, 0x8000 CB base, five
+  * stream match slots and context banks, 36-bit PA. 16K PT granules are
+  * intentionally not used (Qualcomm advertises broken 16K support).
+  */
+ const uint32_t identity[] = {0x48016605, 0x20008005, 0x7511};
+ for (unsigned i = 0; i < 3; ++i) {
+  r->offset = 0x20 + 4 * i; r->value = io->read(io->cookie, r->offset);
+  if (r->value != identity[i]) return ENOTSUP;
+ }
+ /* Do not steal an active bank or matching stream, even if its firmware
+  * owner appears idle. CB0 and all protected banks are left alone.
+  */
+ r->offset = CB1; r->value = io->read(io->cookie, CB1);
+ if (r->value == 0xffffffffu) return EIO;
+ if (r->value & 1) return EBUSY; /* M=0 is disabled; other reset bits may be UNKNOWN. */
+ for (unsigned i = 0; i < 5; ++i) {
+  r->offset = 0x800 + 4 * i;
+  uint32_t smr = r->value = io->read(io->cookie, r->offset);
+  if (smr == 0xffffffffu) return EIO;
+  if (!(smr & 0x80000000u)) {
+   if (r->slot == 0xffffffffu) r->slot = i;
+  } else if (((smr ^ 5u) & ~((smr >> 16) & 0x7fffu) & 0xffffu) == 0) {
+   r->slot = i; return EBUSY;
+  }
+ }
+ if (r->slot == 0xffffffffu) return ENOSPC;
+ r->control = io->read(io->cookie, 0);
+ if (r->control == 0xffffffffu) return EIO;
+ /* Three 4K tables inside a 16K host page; no mapping of the table arena.
+  * L1[1] -> L2[256] -> L3[0..15]: shared 64K at 0x60000000.
+  * All other entries fault. Both privileged/unprivileged data R/W, NX,
+  * Normal NC and outer shareable match the uncached CPU mapping.
+  */
+ volatile uint64_t *l1 = (volatile uint64_t *)memory->cpu;
+ volatile uint64_t *l2 = (volatile uint64_t *)(memory->cpu + 0x1000);
+ volatile uint64_t *l3 = (volatile uint64_t *)(memory->cpu + 0x2000);
+ for (unsigned i = 0; i < 512; ++i) l1[i] = l2[i] = l3[i] = 0;
+ l1[1] = (memory->physical + 0x1000) | 3;
+ l2[256] = (memory->physical + 0x2000) | 3;
+ for (unsigned i = 0; i < 16; ++i)
+  l3[i] = (memory->physical + A618_TABLE_BYTES + 0x1000 * i) |
+      (3ull << 53) | (1u << 11) | (1u << 10) | (2u << 8) | (1u << 6) | 3;
+ ops->barrier(io->cookie);
+ int error;
+ #define SET(o,v,m) do { error = put(io, (o), (v), (m), r); if (error) return error; } while (0)
+ SET(0x1804, 1, 1); /* GR1 CBA2R(1): AArch64. */
+ SET(0x1004, 0x1f300, 0x3f3ff); /* Stage1, stage2 bypass, weak upstream attributes. */
+ SET(CB1 + 0x10, 0x38011, 0x38077); /* TCR2: SEP upstream, 36-bit output, AArch64 ASID. */
+ SET(CB1 + 0x30, 0x00802020u, 0x00c0ffbfu); /* EPD1, OSH, NC walks, T0SZ=32; AArch64, no EAE. */
+ uint64_t ttbr = memory->physical | ((uint64_t)ASID << 48);
+ ops->write64(io->cookie, CB1 + 0x20, ttbr);
+ r->offset = CB1 + 0x20;
+ r->par = ops->read64(io->cookie, r->offset);
+ if ((r->par & 0xffff000ffffff000ull) != ttbr) return EIO;
+ ops->write64(io->cookie, CB1 + 0x28, 0);
+ SET(CB1 + 0x38, 0x44, 0xff); /* MAIR[0]: Normal NC. */
+ /* MAIR1 is unused: every data PTE references MAIR0[0]. */
+ /* Fault reporting enabled, IRQ/stalling disabled until an IRQ handler
+  * exists; HUPCF continues other transactions after an abort.
+  */
+ /* AFE/TRE are UNK/SBOP for long descriptors: write ones, do not
+  * compare their readback. Check M, E, fault controls, WXN and ASIDPNE.
+  */
+ SET(CB1, 0x1127, 0x17f1);
+ /* Block unmatched streams and enable this device. Preserve other controls;
+  * do not enable interrupt sources without handlers. No reset-all/TLBI-all.
+  */
+ SET(0, (r->control | 0x1c12u) & ~0xe025u, 0xfc37);
+ io->write(io->cookie, CB1 + 0x610, ASID);
+ io->write(io->cookie, CB1 + 0x7f0, 0);
+ error = wait_clear(io, CB1 + 0x7f4, 1, r);
+ if (error) return error;
+ /* Hardware translation probes, not a software table walk: every shared
+  * page plus a guard fault must match before the stream is published.
+  */
+ for (unsigned i = 0; i <= 16; ++i) {
+  uint64_t va = (uint64_t)A618_SHARED_IOVA + i * 0x1000u;
+  ops->write64(io->cookie, CB1 + 0x800, va);
+  error = wait_clear(io, CB1 + 0x8f0, 1, r);
+  if (error) return error;
+  r->par = ops->read64(io->cookie, CB1 + 0x50);
+  if (r->par == 0xffffffffffffffffull) return EIO;
+  if (i == 16) {
+   if (!(r->par & 1)) return EFAULT;
+  } else {
+   uint64_t expected = memory->physical + A618_TABLE_BYTES + i * 0x1000u;
+   if ((r->par & 1) || (r->par & 0x0000000ffffff000ull) != expected)
+    return EFAULT;
+   ++r->translated;
+  }
+ }
+ r->fault = io->read(io->cookie, CB1 + 0x58);
+ if (r->fault == 0xffffffffu) return EIO;
+ if (r->fault & (1u << 30)) return EBUSY; /* Never resume an unknown stall. */
+ if (r->fault & FSR_FAULT) {
+  io->write(io->cookie, CB1 + 0x58, r->fault & (FSR_FAULT & ~(1u << 30)));
+  uint32_t after = io->read(io->cookie, CB1 + 0x58);
+  if (after == 0xffffffffu || (after & FSR_FAULT)) return EIO;
+ }
+ /* Only GMU kernel stream 5: route first, VALID last. Never program
+  * GMU user stream 4, GPU stream 0, broad masks or a bypass entry.
+  */
+ SET(0xc00 + 4 * r->slot, 1, 0x030300ff);
+ SET(0x800 + 4 * r->slot, 0x80000005u, 0xffffffffu);
+ r->fault = io->read(io->cookie, CB1 + 0x58);
+ #undef SET
+ return r->fault == 0xffffffffu || (r->fault & FSR_FAULT) ? EIO : 0;
+}
+#endif
diff --git a/bsd/dev/sweet_amp.c b/bsd/dev/sweet_amp.c
new file mode 100644
index 0000000..5f177b3
--- /dev/null
+++ b/bsd/dev/sweet_amp.c
@@ -0,0 +1,470 @@
+/*
+ * 0197: speaker amplifier probe (audio milestone 3 groundwork, docs/audio-plan.md). Read only.
+ *
+ * Sweet's two Awinic AW882xx smart PAs (Xiaomi DT aw882xx_smartpa@34 "TOP" and @35 "BOT", channel 0
+ * and 1) sit on QUP0 SE4 (qupv3_se4_i2c, i2c@0x890000, SDA/SCL GPIO 53/54 = qup04), resets on TLMM
+ * GPIO 64 and 72 (low = reset), interrupts GPIO 93 and 56. The I2S/MI2S audio comes from the ADSP
+ * (not booted by this kernel), so nothing can be heard yet: this only checks that the bus and the
+ * amps answer, as the step before the AFE/MI2S path.
+ *
+ *   sweetamp=1  about 50 s after boot: SE4 clocks + pins, each amp out of reset for 20 ms, chip ID
+ *               (reg 0x00, 16 bit) and status registers 0x01..0x05 read, then back into reset, the
+ *               pins restored to what the bootloader left. Nothing is written to the amps (after a
+ *               reset they power up in power-down state: no output stage running).
+ *
+ * The GENI I2C engine is a copy of bsd/dev/sweet_haptic.c's (Linux i2c-qcom-geni FIFO mode). The
+ * probe stops at the first unexpected state (SE4 without I2C firmware, a busy engine, an I2C error).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <mach/mach_time.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_amp_init(void);
+
+#define AMP_SE_PA        0x00890000u   /* QUP0 SE4: qupv3_se4_i2c, i2c@0x890000 */
+#define AMP_GCC_PA       0x00100000u
+#define AMP_NORTH_PA     0x03900000u   /* TLMM NORTH tile: GPIO 64, 72 (amp resets), 93 */
+#define AMP_WEST_PA      0x03500000u   /* TLMM WEST tile: GPIO 53, 54 (SE4 I2C, qup04 = mux 2), 56 */
+#define AMP_GCC_VOTE     0x5200cu
+#define AMP_RCG          0x174f4u      /* gcc_qupv3_wrap0_s4_clk_src (gcc-sm7150.c) */
+#define AMP_CBCR         0x174f0u      /* gcc_qupv3_wrap0_s4_clk, vote bit 14 */
+#define AMP_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define AMP_GPIO_IO(n)   (AMP_GPIO_CFG(n) + 4u)
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	bool started, dead, probing;
+	uint32_t irq_status, irq_last;
+	unsigned sent, got;
+	int stage;
+} as;
+static int amp_sleep_chan;
+
+static uint32_t
+amp_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+amp_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+amp_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&amp_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+amp_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(amp_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+amp_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = AMP_GPIO_CFG(pin);
+	uint32_t cfg = amp_rd(as.gpio, off);
+	if (out) {
+		/* Set the desired latch before enabling output (reset is active low). */
+		amp_wr(as.gpio, AMP_GPIO_IO(pin),
+		    (amp_rd(as.gpio, AMP_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	amp_wr(as.gpio, off, cfg);
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+amp_abort(void)
+{
+	amp_wr(as.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (amp_rd(as.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !amp_wait_clear(as.se, SE_STATUS, 1u)) {
+		as.dead = true;
+		printf("SWEET AMP: abort failed status=%#x irq=%#x; stopping\n",
+		    amp_rd(as.se, SE_STATUS), amp_rd(as.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (amp_rd(as.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)amp_rd(as.se, SE_RX);
+	}
+	amp_wr(as.se, SE_IRQ_CLR, 0xffffffffu);
+	if (amp_rd(as.se, SE_TX_COUNT) & 0xfffffffu) {
+		as.dead = true;
+		printf("SWEET AMP: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
+static uint32_t
+amp_irq(void)
+{
+	as.irq_last = amp_rd(as.se, SE_IRQ);
+	as.irq_status |= as.irq_last;
+	return as.irq_last;
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+amp_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (as.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!amp_wait_clear(as.se, SE_STATUS, 1u)) {
+		as.dead = true; /* no other SE4 owner is supported */
+		return EBUSY;
+	}
+	amp_wr(as.se, SE_IRQ_CLR, 0xffffffffu);
+	amp_wr(as.se, SE_TX_WM, nt ? 1u : 0u);
+	amp_wr(as.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	amp_wr(as.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = amp_irq();
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the other IC. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = amp_irq();
+			}
+			if ((irq & SE_DONE) && !(amp_rd(as.se, SE_STATUS) & 1u) &&
+			    !(amp_rd(as.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(amp_rd(as.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				amp_wr(as.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !as.sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			amp_wr(as.se, SE_TX, word);
+			as.sent = nt;
+			amp_wr(as.se, SE_TX_WM, 0);
+		}
+		uint32_t count = amp_rd(as.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - as.got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = amp_rd(as.se, SE_RX);
+			for (unsigned j = 0; j < 4 && as.got < nr; ++j) {
+				rx[as.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			/* Re-sample after the final drain; a late error must beat DONE. */
+			irq = amp_irq();
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			amp_wr(as.se, SE_IRQ_CLR, irq);
+			if (as.got == nr && as.sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		amp_wr(as.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	amp_abort();
+	return err;
+}
+
+static int
+amp_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	as.irq_status = as.irq_last = 0;
+	as.sent = as.got = 0;
+	int err = amp_msg_run(addr, tx, nt, rx, nr, stretch);
+	if (as.probing) {
+		printf("SWEET AMP: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+		    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+		    err, as.irq_last, as.irq_status, as.sent, as.got,
+		    amp_rd(as.se, SE_STATUS));
+	}
+	return err;
+}
+
+static int
+amp_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = amp_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
+	    NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return amp_msg(addr, NULL, 0, buf, len, false);
+}
+
+static bool
+amp_clocks(void)
+{
+	/* wrapper0 m_ahb/s_ahb/core/core2x (bits 6-9) and wrap0 s4 (bit 14); BT votes 6, 7 and s3 */
+	uint32_t mask = (0x0fu << 6) | (1u << 14);
+	amp_wr(as.gcc, AMP_GCC_VOTE, amp_rd(as.gcc, AMP_GCC_VOTE) | mask);
+	uint32_t dfs = amp_rd(as.gcc, AMP_RCG + 0x14u);
+	uint32_t cfg = amp_rd(as.gcc, AMP_RCG + 4u);
+	printf("SWEET AMP: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    amp_rd(as.gcc, AMP_GCC_VOTE), amp_rd(as.gcc, AMP_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		cfg = amp_rd(as.gcc, AMP_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SWEET AMP: DFS level0=%#x is not XO/1; stop\n", cfg);
+			return false;
+		}
+	} else {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;   /* XO, divider 1: 19.2 MHz */
+		amp_wr(as.gcc, AMP_RCG + 4u, cfg);
+		amp_wr(as.gcc, AMP_RCG, amp_rd(as.gcc, AMP_RCG) | 1u);
+		if (!amp_wait_clear(as.gcc, AMP_RCG, 1u)) {
+			printf("SWEET AMP: RCG update timeout\n");
+			return false;
+		}
+	}
+	const uint32_t branches[] = {0x17004, 0x17008, 0x1700c, 0x17014, AMP_CBCR};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!amp_wait_clear(as.gcc, branches[i], 1u << 31)) {
+			printf("SWEET AMP: GCC branch %#x halted (%#x)\n", branches[i], amp_rd(as.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+amp_se_init(void)
+{
+	uint32_t fw = amp_rd(as.se, SE_FW);
+	uint32_t tx = amp_rd(as.se, SE_HW_TX), rx = amp_rd(as.se, SE_HW_RX);
+	printf("SWEET AMP: se9 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, amp_rd(as.se, SE_STATUS), tx, rx);
+	if (((fw >> 8) & 0xffu) != 3u || (amp_rd(as.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET AMP: SE4 has no ABL-loaded I2C firmware / 32-bit FIFOs; stop\n");
+		return false;
+	}
+	if (amp_rd(as.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET AMP: SE4 already busy; stop\n");
+		return false;
+	}
+	amp_wr(as.se, 0xe18, 0);
+	amp_wr(as.se, 0xe1c, 0);
+	amp_wr(as.se, 0x644, 0);
+	amp_wr(as.se, SE_IRQ_CLR, 0xffffffffu);
+	amp_wr(as.se, 0x648, 0xffffffffu);
+	amp_wr(as.se, SE_DMA, 0);
+	amp_wr(as.se, 0x28, amp_rd(as.se, 0x28) | 0x7fu);
+	amp_wr(as.se, 0xe30, amp_rd(as.se, 0xe30) | 0x0fu);
+	amp_wr(as.se, 0x24, 0x7f);
+	amp_wr(as.se, 0x20, 1);
+	amp_wr(as.se, SE_CLK_SEL, 0);
+	amp_wr(as.se, SE_MCLK, (7u << 4) | 1u);
+	amp_wr(as.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	amp_wr(as.se, 0x254, 0);
+	amp_wr(as.se, 0x260, SE_PACK0);
+	amp_wr(as.se, 0x264, SE_PACK1);
+	amp_wr(as.se, 0x284, SE_PACK0);
+	amp_wr(as.se, 0x288, SE_PACK1);
+	amp_wr(as.se, SE_TX_WM, 0);
+	amp_wr(as.se, 0x810, 0);
+	amp_wr(as.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	amp_wr(as.se, SE_IRQ_EN, SE_EVENTS);
+	if (amp_rd(as.se, 0x260) != SE_PACK0 || amp_rd(as.se, 0x264) != SE_PACK1 ||
+	    (amp_rd(as.se, SE_TX_COUNT) & 0xfffffffu) || (amp_rd(as.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET AMP: SE4 setup readback mismatch / inherited FIFO data; stop\n");
+		return false;
+	}
+	return true;
+}
+
+
+/* ---------------------------------------------------------------- AW882xx */
+
+static const struct {
+	const char *name;
+	uint8_t addr;
+	unsigned reset_gpio;
+} amp_chips[] = {
+	{"TOP", 0x34, 64},
+	{"BOT", 0x35, 72},
+};
+
+static void
+amp_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	amp_wait(50000);    /* after the UI is up */
+	as.gcc = ml_io_map(AMP_GCC_PA, 0x90000);
+	as.gpio = ml_io_map(AMP_WEST_PA, 0x80000);   /* gpio 53/54 */
+	vm_offset_t north = ml_io_map(AMP_NORTH_PA, 0x80000);   /* gpio 64/72 */
+	as.se = ml_io_map(AMP_SE_PA, 0x4000);
+	if (!as.gcc || !as.gpio || !north || !as.se) {
+		printf("SWEET AMP: mapping failed\n");
+		goto out;
+	}
+	uint32_t cfg53 = amp_rd(as.gpio, AMP_GPIO_CFG(53)), cfg54 = amp_rd(as.gpio, AMP_GPIO_CFG(54));
+	uint32_t rcfg[2], rio[2];
+	for (unsigned i = 0; i < 2; i++) {
+		rcfg[i] = amp_rd(north, AMP_GPIO_CFG(amp_chips[i].reset_gpio));
+		rio[i] = amp_rd(north, AMP_GPIO_IO(amp_chips[i].reset_gpio));
+	}
+	printf("SWEET AMP: before: gpio53 cfg %#x gpio54 cfg %#x; reset gpio64 cfg %#x io %#x, gpio72 cfg %#x io %#x\n",
+	    cfg53, cfg54, rcfg[0], rio[0], rcfg[1], rio[1]);
+	if (!amp_clocks()) {
+		goto out;
+	}
+	/* I2C pins: function qup04 (mux 2), bias disabled (board pull-ups), 2 mA (DT qupv3_se4_i2c_active) */
+	amp_gpio(53, 2, 0, 0, false, false);
+	amp_gpio(54, 2, 0, 0, false, false);
+	if (!amp_se_init()) {
+		goto pins;
+	}
+	for (unsigned c = 0; c < 2 && !as.dead; c++) {
+		vm_offset_t keep = as.gpio;
+		as.gpio = north;
+		amp_gpio(amp_chips[c].reset_gpio, 0, 0, 0, true, false);   /* reset, then release */
+		amp_wait(2);
+		amp_gpio(amp_chips[c].reset_gpio, 0, 0, 0, true, true);
+		as.gpio = keep;
+		amp_wait(20);
+		uint8_t v[2] = {0, 0};
+		int err = amp_read(amp_chips[c].addr, 0x00, false, v, 2);
+		printf("SWEET AMP: %s @%#x: chip ID read -> %d, id %#06x\n", amp_chips[c].name, amp_chips[c].addr,
+		    err, (v[0] << 8) | v[1]);
+		if (!err) {
+			char line[96];
+			unsigned n = 0;
+			for (uint8_t r = 0x01; r <= 0x05 && n + 12 < sizeof(line); r++) {
+				uint8_t w[2] = {0, 0};
+				int e = amp_read(amp_chips[c].addr, r, false, w, 2);
+				n += (unsigned)snprintf(line + n, sizeof(line) - n, " %02x=%s%04x", r, e ? "err" : "",
+				    e ? 0 : (w[0] << 8) | w[1]);
+			}
+			printf("SWEET AMP: %s regs:%s\n", amp_chips[c].name, line);
+		}
+		as.dead = false;    /* a NACK on one amp must not hide the other */
+		as.gpio = north;
+		/* back to what the bootloader left (cfg, then the level) */
+		amp_wr(north, AMP_GPIO_IO(amp_chips[c].reset_gpio), rio[c]);
+		amp_wr(north, AMP_GPIO_CFG(amp_chips[c].reset_gpio), rcfg[c]);
+		as.gpio = keep;
+	}
+pins:
+	amp_wr(as.gpio, AMP_GPIO_CFG(53), cfg53);
+	amp_wr(as.gpio, AMP_GPIO_CFG(54), cfg54);
+	printf("SWEET AMP: probe done; reset and I2C pins restored\n");
+out:
+	(void)thread_terminate(current_thread());
+}
+
+#include "sweet_amp_control.inc"
+
+void
+sweet_amp_init(void)
+{
+	int mode = 0;
+	(void)PE_parse_boot_argn("sweetamp", &mode, sizeof(mode));
+	if (mode == 2 && !as.started) {
+		as.started = true;
+		amp_control_init();
+		return;
+	}
+	if (mode <= 0 || as.started) {
+		return;
+	}
+	as.started = true;
+	thread_t th;
+	if (kernel_thread_start(amp_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+		printf("SWEET AMP: probe armed (50 s)\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_amp_control.inc b/bsd/dev/sweet_amp_control.inc
new file mode 100644
index 0000000..dd78db4
--- /dev/null
+++ b/bsd/dev/sweet_amp_control.inc
@@ -0,0 +1,183 @@
+/* SPDX-License-Identifier: MIT */
+/* 0214: opt-in speaker controller, root-only, one owner. Kernel polls amplifier
+ * faults and resets both PAs if its owner's heartbeat is absent for 3 seconds.
+ * Device close also stops and resets both. No PCM or vendor data in the kernel.
+ * sweetamp=2 selects this controller; sweetamp=1 retains the old ID-only probe. */
+#include <sys/proc.h>
+#include <kern/locks.h>
+#include "sweet_aw2032.h"
+#include "sweet_amp_ctl.h"
+static LCK_GRP_DECLARE(amp_control_group,"sweet_amp_control");
+static LCK_MTX_DECLARE(amp_control_lock,&amp_control_group);
+static struct {
+    vm_offset_t north;
+    struct sweet_aw2032 amp[2];
+    struct sweet_amp_profile profile[2];
+    uint32_t saved[6],saved_io[6];
+    uint32_t loaded,prepared,active,expired;
+    uint64_t deadline;
+    bool ready,claimed,opened;
+    int owner;
+} ac;
+static const unsigned amp_control_pins[]={49,50,51,52,53,54};
+static void amp_control_deadline(void)
+{clock_interval_to_deadline(3000,NSEC_PER_MSEC,&ac.deadline);}
+static int amp_control_read(void *ctx,uint8_t reg,uint16_t *v)
+{
+    unsigned c=(unsigned)(uintptr_t)ctx;uint8_t b[2]={0,0};
+    int e=amp_read(amp_chips[c].addr,reg,false,b,2);if(e)return e;
+    *v=(uint16_t)((b[0]<<8)|b[1]);return 0;
+}
+static int amp_control_write(void *ctx,uint8_t reg,uint16_t v)
+{
+    unsigned c=(unsigned)(uintptr_t)ctx;
+    uint8_t b[3]={reg,(uint8_t)(v>>8),(uint8_t)v};
+    return amp_msg(amp_chips[c].addr,b,3,NULL,0,false);
+}
+static int amp_control_reset(void *ctx,int asserted)
+{
+    unsigned c=(unsigned)(uintptr_t)ctx;if(!ac.north)return ENODEV;
+    vm_offset_t keep=as.gpio;as.gpio=ac.north;
+    amp_gpio(amp_chips[c].reset_gpio,0,0,0,true,!asserted);as.gpio=keep;
+    uint32_t want=asserted?0:2;
+    return (amp_rd(ac.north,AMP_GPIO_IO(amp_chips[c].reset_gpio))&2)==want?0:EIO;
+}
+static void amp_control_sleep(void *ctx __unused,unsigned ms){amp_wait(ms);}
+static void amp_control_stop(void)
+{
+    for(unsigned c=0;c<2;c++){
+        if(ac.amp[c].io.reset)sweet_aw2032_stop(&ac.amp[c]);
+        else if(ac.north)(void)amp_control_reset((void *)(uintptr_t)c,1);
+    }
+    ac.prepared=ac.active=0;
+    if(ac.claimed){
+        for(unsigned i=0;i<6;i++){
+            amp_wr(as.gpio,AMP_GPIO_IO(amp_control_pins[i]),ac.saved_io[i]);
+            amp_wr(as.gpio,AMP_GPIO_CFG(amp_control_pins[i]),ac.saved[i]);
+        }
+        ac.claimed=false;
+    }
+}
+static int amp_control_bus(void)
+{
+    if(as.dead)return EIO;
+    if(!ac.ready){
+        as.gcc=ml_io_map(AMP_GCC_PA,0x90000);
+        as.gpio=ml_io_map(AMP_WEST_PA,0x80000);
+        ac.north=ml_io_map(AMP_NORTH_PA,0x80000);
+        as.se=ml_io_map(AMP_SE_PA,0x4000);
+        if(!as.gcc || !as.gpio || !ac.north || !as.se)return ENOMEM;
+        ac.ready=true;
+    }
+    if(ac.claimed)return 0;
+    if(!amp_clocks())return EIO;
+    for(unsigned i=0;i<6;i++){
+        ac.saved[i]=amp_rd(as.gpio,AMP_GPIO_CFG(amp_control_pins[i]));
+        ac.saved_io[i]=amp_rd(as.gpio,AMP_GPIO_IO(amp_control_pins[i]));
+    }
+    ac.claimed=true;
+    amp_gpio(53,2,0,0,false,false);amp_gpio(54,2,0,0,false,false);
+    if(!amp_se_init()){amp_control_stop();return EIO;}
+    /* Stock SM7150 pinctrl: mux1, bias disabled, 8mA PRI_MI2S on WEST pins. */
+    for(unsigned i=0;i<4;i++){
+        bool output=amp_control_pins[i]!=52; /* exact Sweet DT: 49/50/51 output-high,52 input-enable */
+        amp_gpio(amp_control_pins[i],1,0,3,output,output);
+        uint32_t want=0xc4u|(output?0x200u:0u);
+        if((amp_rd(as.gpio,AMP_GPIO_CFG(amp_control_pins[i]))&0x3ffu)!=want){amp_control_stop();return EIO;}
+    }
+    for(unsigned c=0;c<2;c++)if(amp_control_reset((void *)(uintptr_t)c,1)){amp_control_stop();return EIO;}
+    return 0;
+}
+static int amp_control_open(dev_t d __unused,int f __unused,int t __unused,struct proc *p)
+{
+    if(!p)return EPERM;
+    lck_mtx_lock(&amp_control_lock);
+    int e=ac.opened?EBUSY:0;
+    if(!e){ac.opened=true;ac.owner=proc_pid(p);ac.loaded=0;ac.expired=0;amp_control_deadline();}
+    lck_mtx_unlock(&amp_control_lock);return e;
+}
+static int amp_control_close(dev_t d __unused,int f __unused,int t __unused,struct proc *p __unused)
+{
+    lck_mtx_lock(&amp_control_lock);amp_control_stop();ac.opened=false;ac.owner=0;ac.loaded=0;
+    lck_mtx_unlock(&amp_control_lock);return 0;
+}
+static int amp_control_ioctl(dev_t d __unused,u_long cmd,caddr_t data,int f __unused,struct proc *p)
+{
+    if(!p)return EPERM;
+    int e=0;lck_mtx_lock(&amp_control_lock);
+    if(!ac.opened || ac.owner!=proc_pid(p)){e=EPERM;goto out;}
+    if(ac.prepared && mach_absolute_time()>=ac.deadline){amp_control_stop();++ac.expired;}
+    switch(cmd){
+    case SWEET_AMP_LOAD:{
+        struct sweet_amp_profile *v=(void *)data;
+        if(ac.prepared || v->channel>1 || !v->count || v->count>SWEET_AMP_PROFILE_MAX){e=EINVAL;break;}
+        ac.profile[v->channel]=*v;ac.loaded|=1u<<v->channel;break;
+    }
+    case SWEET_AMP_PREPARE:{
+        uint32_t mask=*(uint32_t *)data;
+        if(!mask || (mask&~3u) || (ac.loaded&mask)!=mask || ac.expired){e=EINVAL;break;}
+        if(ac.prepared){e=EBUSY;break;}
+        e=amp_control_bus();if(e)break;
+        for(unsigned c=0;c<2;c++)if(mask&(1u<<c)){
+            struct sweet_aw_io io={(void *)(uintptr_t)c,amp_control_read,amp_control_write,amp_control_reset,amp_control_sleep};
+            struct sweet_aw_profile v={ac.profile[c].records,ac.profile[c].count};
+            if(sweet_aw2032_prepare(&ac.amp[c],&io,&v)){e=EIO;break;}
+        }
+        if(e)amp_control_stop();else{ac.prepared=mask;amp_control_deadline();}
+        break;
+    }
+    case SWEET_AMP_HEARTBEAT:
+        if(ac.expired){e=ETIMEDOUT;break;}amp_control_deadline();break;
+    case SWEET_AMP_START:{
+        struct sweet_amp_start *v=(void *)data;
+        if(!v->channels || (v->channels&~ac.prepared) || ac.expired || ac.active){e=EINVAL;break;}
+        for(unsigned c=0;c<2;c++)if(v->channels&(1u<<c)){
+            if(sweet_aw2032_start(&ac.amp[c],v->attenuation_eighth_db)){e=EIO;break;}
+        }
+        if(e)amp_control_stop();else{ac.active=v->channels;amp_control_deadline();}
+        break;
+    }
+    case SWEET_AMP_STOP:amp_control_stop();break;
+    case SWEET_AMP_STATUS:{
+        struct sweet_amp_status *v=(void *)data;memset(v,0,sizeof(*v));
+        v->prepared=ac.prepared;v->active=ac.active;v->expired=ac.expired;v->bus_dead=as.dead;
+        for(unsigned c=0;c<2;c++)v->sysst[c]=ac.amp[c].last_status;break;
+    }
+    default:e=ENOTTY;break;
+    }
+out:lck_mtx_unlock(&amp_control_lock);return e;
+}
+static const struct cdevsw amp_control_cdevsw={
+    .d_open=amp_control_open,.d_close=amp_control_close,.d_read=eno_rdwrt,.d_write=eno_rdwrt,
+    .d_ioctl=amp_control_ioctl,.d_stop=eno_stop,.d_reset=eno_reset,.d_ttys=NULL,
+    .d_select=eno_select,.d_mmap=eno_mmap,.d_strategy=eno_strat,.d_reserved_1=eno_getc,.d_reserved_2=eno_putc,.d_type=0,
+};
+static void amp_control_watch(void *arg __unused,wait_result_t wr __unused)
+{
+    for(;;){
+        amp_wait(50);lck_mtx_lock(&amp_control_lock);
+        if(ac.prepared && mach_absolute_time()>=ac.deadline){
+            amp_control_stop();++ac.expired;printf("SWEET AMP: heartbeat expired; both amps reset\n");
+        }else if(ac.active){
+            for(unsigned c=0;c<2;c++)if((ac.active&(1u<<c)) && sweet_aw2032_poll(&ac.amp[c])){
+                printf("SWEET AMP: channel %u clock/fault check failed (%#x); both amps reset\n",c,ac.amp[c].last_status);
+                amp_control_stop();++ac.expired;break;
+            }
+        }
+        lck_mtx_unlock(&amp_control_lock);
+    }
+}
+extern void sweet_pcm_dev_init(void);
+static void amp_control_init(void)
+{
+    sweet_pcm_dev_init();
+    /* Start the watchdog before publishing a device that can enable output. */
+    thread_t th;if(kernel_thread_start(amp_control_watch,NULL,&th)!=KERN_SUCCESS){printf("SWEET AMP: no watchdog; controller disabled\n");return;}
+    thread_deallocate(th);
+    int major=cdevsw_add(-1,&amp_control_cdevsw);
+    if(major<0){printf("SWEET AMP: controller registration failed\n");return;}
+    if(!devfs_make_node(makedev(major,0),DEVFS_CHAR,UID_ROOT,GID_WHEEL,0600,"sweet-amp")){
+        printf("SWEET AMP: no device node; controller disabled\n");return;
+    }
+    printf("SWEET AMP: /dev/sweet-amp ready; heartbeat 3000ms, faults polled50ms\n");
+}
diff --git a/bsd/dev/sweet_amp_ctl.h b/bsd/dev/sweet_amp_ctl.h
new file mode 100644
index 0000000..d150a71
--- /dev/null
+++ b/bsd/dev/sweet_amp_ctl.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SWEET_AMP_CTL_H
+#define SWEET_AMP_CTL_H
+#ifdef KERNEL
+#include <sys/types.h>
+#include <sys/ioccom.h>
+#else
+#include <stdint.h>
+#include <sys/ioctl.h>
+#endif
+#define SWEET_AMP_DEVICE "/dev/sweet-amp"
+#define SWEET_AMP_PROFILE_MAX 64u
+struct sweet_amp_profile {uint32_t channel,count;uint8_t records[SWEET_AMP_PROFILE_MAX*4];};
+struct sweet_amp_start {uint32_t channels,attenuation_eighth_db;};
+struct sweet_amp_status {uint32_t prepared,active,expired,bus_dead;uint32_t sysst[2];};
+#define SWEET_AMP_LOAD _IOW('A',1,struct sweet_amp_profile)
+#define SWEET_AMP_PREPARE _IOW('A',2,uint32_t)
+#define SWEET_AMP_HEARTBEAT _IO('A',3)
+#define SWEET_AMP_START _IOW('A',4,struct sweet_amp_start)
+#define SWEET_AMP_STOP _IO('A',5)
+#define SWEET_AMP_STATUS _IOR('A',6,struct sweet_amp_status)
+#endif
diff --git a/bsd/dev/sweet_audiohal.c b/bsd/dev/sweet_audiohal.c
new file mode 100644
index 0000000..8eafa12
--- /dev/null
+++ b/bsd/dev/sweet_audiohal.c
@@ -0,0 +1,171 @@
+/*
+ * 0196: iOS's VirtualAudio HAL plug-in back in /Library/Audio/Plug-Ins/HAL.
+ *
+ * Image v12 (2026-10-17) moved VirtualAudio.plugin to /Library/Audio/Plug-Ins/HAL.disabled: with no
+ * audio device at all it crashed mediaserverd (no default virtual device 'vdef'). Since 0160 the
+ * SweetAudio.driver HAL plug-in (userspace/audio) gives CoreAudio its Speaker, Hawking (mic), Actuator
+ * (haptics) and Codec devices, but without VirtualAudio iOS has no routes on top of them: the
+ * Actuator is never played (0195: "serving /dev/sweet-haptic (0 frames)") and Bluetooth A2DP has no
+ * output to route to. The sunfish port (Pixel 4a, SM7150; ios-flame docs/features/audio.md
+ * 2026-10-30 au1/U11 and haptics.md hp3) found the same: VirtualAudio + its RedwoodAudio-derived
+ * plug-in = AirPods play music and iOS haptics reach the motor; VirtualAudio only creates devices
+ * for the UIDs "Actuator" and "Null_Device".
+ *
+ *   sweetvaudio=1  move HAL.disabled/VirtualAudio.plugin -> HAL/ (only while SweetAudio.driver is
+ *                  installed), before mediaserverd scans the folder; if mediaserverd already runs,
+ *                  it is killed once so launchd restarts it with the plug-in
+ *   sweetvaudio=0  move it back to HAL.disabled (the pre-0196 state)
+ *   absent         nothing is moved; the state is only logged
+ * The move is on disk (persists). Undo by hand over SSH:
+ *   mv /Library/Audio/Plug-Ins/HAL/VirtualAudio.plugin /Library/Audio/Plug-Ins/HAL.disabled/
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/proc_internal.h>
+#include <sys/signal.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+
+extern int sweet_vfs_rename(const char *from, const char *to);
+extern int sweet_vfs_mkdir(const char *path, int mode);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_audiohal_init(void);
+
+#define VA_ON       "/Library/Audio/Plug-Ins/HAL/VirtualAudio.plugin"
+#define VA_OFF      "/Library/Audio/Plug-Ins/HAL.disabled/VirtualAudio.plugin"
+#define VA_HAL_DIR  "/Library/Audio/Plug-Ins/HAL"
+#define VA_OFF_DIR  "/Library/Audio/Plug-Ins/HAL.disabled"
+#define SWEET_DRV   "/System/Library/Audio/Plug-Ins/HAL/SweetAudio.driver/SweetAudio"
+#define BT_DRV      "/System/Library/Audio/Plug-Ins/HAL/BTAudioHALPlugin.driver"
+
+static int ah_mode = -1;
+static int ah_chan;
+
+static void
+ah_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ah_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+ah_exists(const char *path)
+{
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, vfs_context_kernel()) != 0) {
+		return false;
+	}
+	vnode_put(vp);
+	return true;
+}
+
+/* pid of the first process with this name, 0 if none */
+static int
+ah_find(const char *name)
+{
+	for (int pid = 1; pid < 4096; pid++) {
+		proc_t p = proc_find(pid);
+		if (p == PROC_NULL) {
+			continue;
+		}
+		bool match = strcmp(proc_best_name(p), name) == 0;
+		proc_rele(p);
+		if (match) {
+			return pid;
+		}
+	}
+	return 0;
+}
+
+static void
+ah_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	/* the root file system: poll for it (we start from the UFS driver, before mountroot) */
+	unsigned waited = 0;
+	while (rootvnode == NULLVP && waited < 120000) {
+		ah_sleep(20);
+		waited += 20;
+	}
+	if (rootvnode == NULLVP) {
+		printf("SWEET AUDIOHAL: no root file system after 120 s\n");
+		goto out;
+	}
+	int err = 0;
+	bool on = false, off = false;
+	for (unsigned tries = 0; tries < 600; tries++) {
+		on = ah_exists(VA_ON);
+		off = ah_exists(VA_OFF);
+		bool drv = ah_exists(SWEET_DRV), bt = ah_exists(BT_DRV);
+		if (tries == 0) {
+			printf("SWEET AUDIOHAL: VirtualAudio in HAL %d, in HAL.disabled %d; SweetAudio.driver %d, "
+			    "BTAudioHALPlugin %d; sweetvaudio=%d; mediaserverd pid %d\n",
+			    on, off, drv, bt, ah_mode, ah_find("mediaserverd"));
+		}
+		if (ah_mode < 0) {
+			goto out;
+		}
+		const char *from = NULL, *to = NULL;
+		if (ah_mode == 1 && !on && off) {
+			if (!drv) {
+				printf("SWEET AUDIOHAL: SweetAudio.driver missing: VirtualAudio left disabled "
+				    "(it crashes mediaserverd without an audio device)\n");
+				goto out;
+			}
+			(void)sweet_vfs_mkdir(VA_HAL_DIR, 0755);
+			from = VA_OFF;
+			to = VA_ON;
+		} else if (ah_mode == 0 && on && !off) {
+			(void)sweet_vfs_mkdir(VA_OFF_DIR, 0755);
+			from = VA_ON;
+			to = VA_OFF;
+		} else {
+			printf("SWEET AUDIOHAL: nothing to move (sweetvaudio=%d, in HAL %d, in HAL.disabled %d)\n",
+			    ah_mode, on, off);
+			goto out;
+		}
+		err = sweet_vfs_rename(from, to);
+		if (err == 0) {
+			int pid = ah_find("mediaserverd");
+			printf("SWEET AUDIOHAL: moved %s -> %s after %u ms (try %u); mediaserverd pid %d%s\n",
+			    from, to, waited, tries, pid, pid ? ": killed, launchd restarts it" : "");
+			if (pid) {
+				proc_signal(pid, SIGKILL);
+			}
+			goto out;
+		}
+		if (tries == 0 || err != EROFS) {
+			printf("SWEET AUDIOHAL: rename %s -> %s: %d (retrying)\n", from, to, err);
+		}
+		ah_sleep(100);
+		waited += 100;
+	}
+	printf("SWEET AUDIOHAL: gave up after 60 s, last error %d\n", err);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_audiohal_init(void)
+{
+	static bool started;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("sweetvaudio", &ah_mode, sizeof(ah_mode));
+	thread_t th;
+	if (kernel_thread_start(ah_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_aw2032.c b/bsd/dev/sweet_aw2032.c
new file mode 100644
index 0000000..cdea282
--- /dev/null
+++ b/bsd/dev/sweet_aw2032.c
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: MIT */
+/* Functional implementation from the public Xiaomi/Awinic PID2032 register ABI:
+ * MiCode/vendor_qcom_opensource_audio-kernel 65be95690af834887f876ca6d4a46df7a0ec50ac,
+ * aw_device.c, aw_init.c, aw_pid_2032_reg.h and aw_bin_parse.c. No vendor profile
+ * values are embedded here. This intentionally supports a bounded diagnostic,
+ * not continuous playback without a supervising owner and fault monitoring. */
+#include "sweet_aw2032.h"
+#ifdef KERNEL
+#include <sys/systm.h>
+#else
+#include <string.h>
+#endif
+static uint16_t g16(const uint8_t *p){return (uint16_t)p[0]|(uint16_t)p[1]<<8;}
+static uint32_t g32(const uint8_t *p){return g16(p)|(uint32_t)g16(p+2)<<16;}
+static unsigned crc8(const uint8_t *p,size_t n)
+{
+ unsigned c=0;for(size_t i=0;i<n;i++){unsigned v=p[i];for(unsigned j=0;j<8;j++){c=(c^v)&1?((c^0x18)>>1)|0x80:c>>1;v>>=1;}}return c;
+}
+/* Writable profile registers only. Excludes ID/reset, status and efuse/OTP. */
+static int profile_reg(unsigned r)
+{
+ return (r>=3 && r<=15) || r==0x15 || r==0x20 || (r>=0x30 && r<=0x38) ||
+        r==0x50 || (r>=0x52 && r<=0x56) || r==0x59 || r==0x5a || (r>=0x60 && r<=0x6c);
+}
+static int validate_profile(const struct sweet_aw_profile *p)
+{
+ if(!p || !p->records || !p->count || p->count>64)return -1;
+ uint64_t seen[2]={0,0};unsigned mandatory=0;
+ for(size_t i=0;i<p->count;i++){
+  unsigned r=g16(p->records+4*i);
+  uint16_t value=g16(p->records+4*i+2);
+  if(r==5 && (value>>12)*48+((value>>6)&63)>720)return -1;
+  if(!profile_reg(r) || (seen[r/64]&(1ull<<(r%64))))return -1;
+  seen[r/64]|=1ull<<(r%64);
+  if(r>=3 && r<=7)mandatory|=1u<<(r-3);
+ }
+ return mandatory==31?0:-1;
+}
+int sweet_aw_profile_select(const uint8_t *b,size_t n,unsigned channel,struct sweet_aw_profile *out)
+{
+ if(out)memset(out,0,sizeof(*out));
+ if(!b || !out || channel>1 || n<80 || n>65536 || g32(b)!=0x0a15f908 || g32(b+64)!=1)return -1;
+ uint32_t table=g32(b+60),count=g32(b+56),length=g32(b+52);
+ if(table!=80 || !count || count>16 || length!=count*64 || length>n-table)return -1;
+ struct sweet_aw_profile chosen={0,0};
+ for(uint32_t i=0;i<count;i++){
+  const uint8_t *e=b+table+64*i;size_t bytes=g32(e+32),at=g32(e+36);
+  if(at<table+length || at>n || bytes>n-at || crc8(b+at,bytes)!=g32(e+40))return -1;
+  for(uint32_t j=0;j<i;j++){
+   const uint8_t *a=b+table+64*j;size_t other=g32(a+36),size=g32(a+32);
+   if(at<other+size && other<at+bytes)return -1;
+  }
+  if(g32(e)!=2 || g16(e+20)!=channel || g16(e+26)!=0)continue;
+  if(chosen.records || g32(e+28)!=4 || bytes<64)return -1;
+  const uint8_t *d=b+at;uint32_t sum=0;for(size_t k=4;k<bytes;k++)sum+=d[k];
+  if(sum!=g32(d) || g32(d+4)!=0x01000000 || g32(d+8)!=0 || g32(d+12)!=1 ||
+     g32(d+16)!=bytes-60 || g32(d+32)!=2 || g32(d+36)!=2)return -1;
+  uint32_t regs=g32(d+60);if(!regs || regs>64 || bytes!=64+regs*4)return -1;
+  chosen.records=d+64;chosen.count=regs;if(validate_profile(&chosen))return -1;
+ }
+ if(!chosen.records)return -1;
+ *out=chosen;return 0;
+}
+static unsigned vol_decode(uint16_t v){unsigned a=v>>6;return (a>>6)*48+(a&63);}
+static uint16_t vol_encode(unsigned v){return (uint16_t)((((v/48)<<6)|(v%48))<<6);}
+static int update(struct sweet_aw2032 *a,uint8_t r,uint16_t mask,uint16_t bits)
+{
+ uint16_t v;if(a->io.read(a->io.ctx,r,&v))return -1;
+ return a->io.write(a->io.ctx,r,(v&~mask)|(bits&mask))?-1:0;
+}
+static int volume(struct sweet_aw2032 *a,unsigned v){return update(a,5,0xffc0,vol_encode(v));}
+static void sleep_ms(struct sweet_aw2032 *a,unsigned n){a->io.sleep_ms(a->io.ctx,n);}
+void sweet_aw2032_stop(struct sweet_aw2032 *a)
+{
+ if(!a || !a->io.reset)return;
+ /* Best effort over I2C, then hardware reset even if the bus has failed. */
+ if(a->verified && a->io.read && a->io.write && a->io.sleep_ms){
+  (void)volume(a,720);(void)update(a,5,0x10,0x10);(void)update(a,7,1,0);
+  (void)update(a,4,2,2);sleep_ms(a,1);(void)update(a,4,1,1);
+ }
+ (void)a->io.reset(a->io.ctx,1);a->active=a->prepared=a->verified=0;
+}
+int sweet_aw2032_prepare(struct sweet_aw2032 *a,const struct sweet_aw_io *io,const struct sweet_aw_profile *p)
+{
+ if(!a || !io || !io->read || !io->write || !io->reset || !io->sleep_ms || validate_profile(p))return -1;
+ memset(a,0,sizeof(*a));a->io=*io;uint16_t id,iv,vv;
+ if(io->reset(io->ctx,1))goto reset_only;
+ sleep_ms(a,2);
+ if(io->reset(io->ctx,0))goto reset_only;
+ sleep_ms(a,20);
+ if(io->read(io->ctx,0,&id) || id!=0x2032)goto reset_only;
+ a->verified=1;
+ if(update(a,4,3,3) || update(a,5,0x10,0x10) || volume(a,720))goto fail;
+ for(size_t i=0;i<p->count;i++){
+  unsigned r=g16(p->records+4*i);uint16_t v=g16(p->records+4*i+2);
+  if(r==0x56)continue; /* device-specific voltage calibration, never profile replay */
+  if(r==3)v=0xefbf; /* stock default mask; owner polls SYSST instead of enabling IRQs */
+  if(r==4)v|=3; /* keep both power stages off during profile loading */
+  if(r==5){a->profile_volume=(uint16_t)vol_decode(v);v=(v&0x3f)|0x10|vol_encode(720);}
+  if(r==6)v=(v&~0xffu)|8u; /* 48kHz,16-bit,32 BCLK/frame; keep RX/channel selection */
+  if(r==7)v&=~1u; /* feedback off until startup */
+  if(r==0x66)v|=0x4000; /* stock CCO mux bypass for 48kHz */
+  if(io->write(io->ctx,(uint8_t)r,v))goto fail;
+ }
+ if(io->read(io->ctx,0x7a,&iv) || io->read(io->ctx,0x78,&vv))goto fail;
+ int ical=iv&1023,vcal=vv&1023;if(ical&512)ical-=1024;if(vcal&512)vcal-=1024;
+ int numerator=1000+ical,denominator=1000+vcal;
+ if(numerator<=0 || denominator<=0)goto fail;
+ uint32_t calibrated=(uint32_t)(8192u*(uint32_t)numerator/(uint32_t)denominator);
+ if(calibrated>65535 || io->write(io->ctx,0x56,(uint16_t)calibrated))goto fail;
+ a->prepared=1;return 0;
+fail:sweet_aw2032_stop(a);return -1;
+reset_only:(void)io->reset(io->ctx,1);return -1;
+}
+static int status_ok(struct sweet_aw2032 *a)
+{
+ uint16_t s;if(a->io.read(a->io.ctx,1,&s))return -1;a->last_status=s;
+ /* Clock stable + PLL lock, without over-voltage/current/temp, under-voltage or missing clock. */
+ if(s&0x482a)return -2; /* 0224: stock faults UVLS|BSTOCS|NOCLKS|OCDS|OTHS; OVPS/OVP2S = self-limiting */
+ return (s&0x11)==0x11;
+}
+int sweet_aw2032_start(struct sweet_aw2032 *a,unsigned attenuation)
+{
+ if(!a || !a->prepared || a->active)return -1;
+ /* 0224: floor is the stock Music profile level (never louder than vendor). */
+ if(attenuation<a->profile_volume)attenuation=a->profile_volume;
+ if(attenuation>720)attenuation=720;
+ if(update(a,7,1,1) || update(a,4,1,0))goto fail;
+ sleep_ms(a,2);
+ if(update(a,4,2,0))goto fail;
+ sleep_ms(a,1);
+ unsigned i;for(i=0;i<10;i++){int st=status_ok(a);if(st<0)goto fail;if(st==1)break;sleep_ms(a,2);}if(i==10)goto fail;
+ uint16_t discard;if(a->io.read(a->io.ctx,2,&discard) || a->io.read(a->io.ctx,2,&discard))goto fail;
+ if(update(a,5,0x10,0))goto fail;
+ for(unsigned v=720;v>attenuation;){v=v-attenuation>48?v-48:attenuation;if(volume(a,v))goto fail;
+ sleep_ms(a,1);}
+ a->active=1;return 0;
+fail:sweet_aw2032_stop(a);return -1;
+}
+int sweet_aw2032_poll(struct sweet_aw2032 *a)
+{
+ if(!a || !a->active)return -1;
+ if(status_ok(a)==1)return 0;
+ sweet_aw2032_stop(a);return -1;
+}
diff --git a/bsd/dev/sweet_aw2032.h b/bsd/dev/sweet_aw2032.h
new file mode 100644
index 0000000..157965e
--- /dev/null
+++ b/bsd/dev/sweet_aw2032.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SWEET_AW2032_H
+#define SWEET_AW2032_H
+#ifdef KERNEL
+#include <sys/types.h>
+#include <stddef.h>
+#include <stdint.h>     /* xnu-12377: sys/types.h no longer brings uint8_t into the kernel */
+#else
+#include <stddef.h>
+#include <stdint.h>
+#endif
+/* ACF is supplied privately from the device's vendor partition, never embedded.
+ * Only per-device Music register profiles are supported; no DSP/OTP programming. */
+struct sweet_aw_profile {const uint8_t *records;size_t count;};
+int sweet_aw_profile_select(const uint8_t *acf,size_t bytes,unsigned channel,struct sweet_aw_profile *out);
+struct sweet_aw_io {
+ void *ctx;
+ int (*read)(void *,uint8_t,uint16_t *);
+ int (*write)(void *,uint8_t,uint16_t);
+ int (*reset)(void *,int asserted);
+ void (*sleep_ms)(void *,unsigned);
+};
+struct sweet_aw2032 {
+ struct sweet_aw_io io;
+ unsigned prepared,active,verified;
+ uint16_t profile_volume,last_status;
+};
+/* Hardware reset, chip-ID check, profile under mute/powerdown, per-chip efuse
+ * calibration, 48kHz/16bit format. Any error asserts the hardware reset. */
+int sweet_aw2032_prepare(struct sweet_aw2032 *,const struct sweet_aw_io *,const struct sweet_aw_profile *);
+/* Never louder than the vendor profile volume (0224 dropped the 24dB bring-up floor). Caller must first have
+ * confirmed PCM completions, then poll faults and stop within a bounded trial. */
+int sweet_aw2032_start(struct sweet_aw2032 *,unsigned attenuation_eighth_db);
+int sweet_aw2032_poll(struct sweet_aw2032 *);
+void sweet_aw2032_stop(struct sweet_aw2032 *);
+#endif
diff --git a/bsd/dev/sweet_bb_dev.c b/bsd/dev/sweet_bb_dev.c
new file mode 100644
index 0000000..def3b45
--- /dev/null
+++ b/bsd/dev/sweet_bb_dev.c
@@ -0,0 +1,119 @@
+/*
+ * /dev/sweet-bb: the cellular bridge's QRTR side (iokit/Kernel/arm/SweetBaseband.inc, UniXNU QcomBaseband).
+ * The modem's QRTR link belongs to the userland wland daemon, so wland reads the QMI requests CommCenter/ABM
+ * send on the qmux channels from here and writes back what the modem says. Records (little endian): u32 type,
+ * a, b, c, d, len, then len bytes padded to 4 (types: SweetBaseband.inc). A read never waits: no records, 0
+ * bytes. Only with the boot-arg sweetbb=1; root only. Compiled as part of flame_wlan.c (#include at its end).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+
+extern int sweet_bb_enabled(void);
+extern void sweet_bb_wland_write(uint32_t type, uint32_t a, uint32_t b, uint32_t c, uint32_t d, const void *data, uint32_t len);
+extern uint32_t sweet_bb_wland_read(uint8_t *buf, uint32_t room);
+
+#define SBB_ROOM   (64u * 1024u + 4096u)
+#define SBB_MAXLEN (64u * 1024u)
+
+static LCK_GRP_DECLARE(sbb_lck_grp, "sweet-bb");
+static LCK_MTX_DECLARE(sbb_mtx, &sbb_lck_grp);
+static uint8_t *sbb_buf;	/* one reader/writer at a time: under sbb_mtx */
+static uint32_t sbb_opens;
+
+static int
+sbb_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	lck_mtx_lock(&sbb_mtx);
+	if (!sbb_buf) {
+		sbb_buf = kalloc_data(SBB_ROOM, Z_WAITOK | Z_ZERO);
+	}
+	if (!sbb_opens++) {
+		printf("SWEET BB: /dev/sweet-bb opened (wland)\n");
+	}
+	lck_mtx_unlock(&sbb_mtx);
+	return sbb_buf ? 0 : ENOMEM;
+}
+
+static int
+sbb_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sbb_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int error = 0;
+	lck_mtx_lock(&sbb_mtx);
+	user_ssize_t want = uio_resid(uio);
+	uint32_t room = want < (user_ssize_t)SBB_ROOM ? (uint32_t)want : SBB_ROOM;
+	uint32_t n = sbb_buf ? sweet_bb_wland_read(sbb_buf, room) : 0;
+	if (n) {
+		error = uiomove((caddr_t)sbb_buf, (int)n, uio);
+	}
+	lck_mtx_unlock(&sbb_mtx);
+	return error;
+}
+
+static int
+sbb_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int error = 0;
+	lck_mtx_lock(&sbb_mtx);
+	while (!error && sbb_buf && uio_resid(uio) >= 24) {
+		uint32_t w[6];
+		if ((error = uiomove((caddr_t)w, 24, uio)) != 0) {
+			break;
+		}
+		uint32_t len = w[5], padded = (len + 3u) & ~3u;
+		if (len > SBB_MAXLEN || uio_resid(uio) < padded) {
+			error = EINVAL;
+			break;
+		}
+		if (padded && (error = uiomove((caddr_t)sbb_buf, (int)padded, uio)) != 0) {
+			break;
+		}
+		sweet_bb_wland_write(w[0], w[1], w[2], w[3], w[4], sbb_buf, len);
+	}
+	lck_mtx_unlock(&sbb_mtx);
+	return error;
+}
+
+static const struct cdevsw sbb_cdevsw = {
+	.d_open       = sbb_open,
+	.d_close      = sbb_close,
+	.d_read       = sbb_read,
+	.d_write      = sbb_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void sweet_bb_dev_init(void);
+void
+sweet_bb_dev_init(void)
+{
+	if (!sweet_bb_enabled()) {
+		return;
+	}
+	int major = cdevsw_add(-1, &sbb_cdevsw);
+	if (major < 0) {
+		printf("SWEET BB: cdevsw_add failed (%d)\n", major);
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "sweet-bb");
+	printf("SWEET BB: /dev/sweet-bb ready (major %d); AppleBaseband services follow wland's READY\n", major);
+}
diff --git a/bsd/dev/sweet_bt.c b/bsd/dev/sweet_bt.c
new file mode 100644
index 0000000..d4fa3e3
--- /dev/null
+++ b/bsd/dev/sweet_bt.c
@@ -0,0 +1,2372 @@
+/*
+ * Sweet (Redmi Note 10 Pro, SM7150) Bluetooth: the Qualcomm WCN3990's BT core over the
+ * QUP0 SE3 GENI UART (hsuart0, 0x88c000), HCI in the kernel (power pulse, rampatch + NVM download,
+ * in-band sleep), then an H4 transport for iOS's bluetoothd/BlueTool through the kernel control
+ * com.apple.uart.bluetooth (bsd/dev/sweet_bt_hci.c).
+ *
+ * Ported from Bergamota (ry-diffusion, Poco F1 / SDM845, xnu patches 0104-0133 beryllium_wlan.c;
+ * that repository has no license file): only its Bluetooth stage. The WLAN probe/inventory parts are left out: they read the apps
+ * SMMU and SMEM, and on sweet a CPU load from the apps SMMU stalls once the system is up (0141).
+ * SM7150 differences (Linux gcc-sm7150.c / pinctrl-sm7150.c, sweet DT): SE3 instead of SE3
+ * (CBCR 0x173c0, RCG 0x173c4, vote bit 13), TLMM SOUTH tile 0x3d00000 with GPIO 38-41 (qup03 = 1),
+ * rails L10A (vdd-io), L1C (xtal), L2C (core), L10C (pa). Firmware (crbtfw21.tlv, crnv21.bin from
+ * sweet's own bluetooth partition) comes from ADT properties of /arm-io/bluetooth, as the GPU's.
+ *
+ * Off unless sweetbt=1 (or sweetwlan=2 for the bring-up stage alone).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <machine/atomic.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_vreg_set(const char *res, unsigned mv, bool enable);
+void sweet_bt_init(void);
+struct bt_hci_ops {
+	bool (*tx)(const uint8_t *pkt, unsigned len);
+	unsigned (*baud)(unsigned requested);
+};
+extern void sweet_bt_hci_register(const struct bt_hci_ops *ops, unsigned sk_alias, unsigned log_budget);
+extern void sweet_bt_hci_rx_packet(const uint8_t *pkt, unsigned len);
+extern void sweet_bt_hci_rx_service(void);
+extern void sweet_bt_hci_stats_periodic(bool force);
+extern bool sweet_bt_hci_connected(void);
+
+#ifndef MIN
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#endif
+#ifndef MAX
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#endif
+
+static uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* Firmware blobs from the ADT (tools/adt-add-bluetooth.py puts fw-<file name> under /arm-io/bluetooth).
+ * A writable copy: the NVM is edited before it is sent. */
+static bool
+sweet_bt_fw_get(const char *file, void **buf, size_t *len)
+{
+	DTEntry node;
+	const void *data = NULL;
+	unsigned int size = 0;
+	char prop[32];
+	snprintf(prop, sizeof(prop), "fw-%s", file);
+	if (SecureDTLookupEntry(NULL, "/arm-io/bluetooth", &node) != kSuccess ||
+	    SecureDTGetProperty(node, prop, &data, &size) != kSuccess || size == 0) {
+		return false;
+	}
+	void *copy = kalloc_data(size, Z_WAITOK);
+	if (copy == NULL) {
+		return false;
+	}
+	memcpy(copy, data, size);
+	*buf = copy;
+	*len = size;
+	return true;
+}
