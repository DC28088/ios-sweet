diff --git a/iokit/Kernel/arm/MiniIONetworkStack.cpp b/iokit/Kernel/arm/MiniIONetworkStack.cpp
new file mode 100644
index 0000000..081fd35
--- /dev/null
+++ b/iokit/Kernel/arm/MiniIONetworkStack.cpp
@@ -0,0 +1,114 @@
+/*
+ * MiniIONetworkStack: a stand-in for IONetworkStack of Apple's IONetworkingFamily, as seen by
+ * configd's interface namer.
+ *
+ * The real one gives the BSD names (en0, en1, ...) to the IONetworkInterface objects of the
+ * drivers, when the interface namer asks. Here interfaces are made with the BSD interface KPI
+ * (bsd/dev/redwood_net.c) and are born with their names, so there is never anything to name.
+ * But the namer wants this object all the same: until it has opened it, it does not say in
+ * configd's store that the registry has gone quiet (the key Plugin:InterfaceNamer, "*QUIET*"),
+ * and gives up only after five minutes ("*TIMEOUT*"). SystemConfiguration's
+ * SCNetworkInterfaceCopyAll() waits for one of the two, and with it whoever asks for the list of
+ * interfaces: wifid as soon as it has a device, and behind wifid SpringBoard.
+ *
+ * So: the service, a user client that can be opened, and a refusal of the naming request.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+extern "C" void MiniIONetworkStackStart(void);
+
+class IONetworkStack : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkStack);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+bool
+IONetworkStack::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	setName("IONetworkStack");
+	registerService();
+	return true;
+}
+
+class IONetworkStackUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+bool
+IONetworkStackUserClient::start(IOService * provider)
+{
+	char who[32] = "?";
+
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	/* whether the registry is quiet at this moment is what the namer goes on to ask */
+	proc_selfname(who, sizeof(who));
+	IOLog("MiniIONetworkStack: opened by %s; the registry's busy state is %u\n", who,
+	    (unsigned) IOService::getServiceRoot()->getBusyState());
+	return true;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+/* "Name this interface" (a dictionary: IONetworkStackUserCommand, IOPathMatch, IOInterfaceUnit). */
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject * properties)
+{
+	static unsigned said;
+
+	if (said++ < 4) {
+		IOLog("MiniIONetworkStack: asked to name an interface: there are none of that kind\n");
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+void
+MiniIONetworkStackStart(void)
+{
+	/* where the real one is: IOService:/IOResources/IONetworkStack */
+	IOService * resources = IOService::getResourceService();
+	IONetworkStack * stack = OSTypeAlloc(IONetworkStack);
+
+	if (resources == NULL || stack == NULL || !stack->init() || !stack->attach(resources)) {
+		OSSafeReleaseNULL(stack);
+		IOLog("MiniIONetworkStack: cannot create the service\n");
+		return;
+	}
+	if (!stack->start(resources)) {
+		stack->detach(resources);
+	}
+	stack->release();
+}
diff --git a/iokit/Kernel/arm/RedwoodWLAN.cpp b/iokit/Kernel/arm/RedwoodWLAN.cpp
new file mode 100644
index 0000000..790a979
--- /dev/null
+++ b/iokit/Kernel/arm/RedwoodWLAN.cpp
@@ -0,0 +1,140 @@
+/*
+ * RedwoodWLAN: the registry entries by which iOS finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (bsd/dev/redwood_net.c) and has no IOKit object behind
+ * it of its own; iOS looks for two, as IO80211Family would have made them:
+ *
+ *   - wifid's device is whatever service has the property IO80211InterfaceRole =
+ *     "Infrastructure", and IO80211.framework binds to an interface through a service whose
+ *     IOInterfaceName is the interface's name. The service has no user client, on purpose:
+ *     the framework's attempt to open one fails, it says "Falling back to IOCTL path", and
+ *     from then on every request is an ioctl on a socket, which bsd/dev/redwood_apple80211.c
+ *     answers.
+ *   - SystemConfiguration (SCNetworkInterfaceCopyAll) lists the network interfaces it finds as
+ *     objects of the class IONetworkInterface, and calls one a Wi-Fi interface when its parent
+ *     is of the class IO80211Controller; type, unit, name and built-in-ness are properties of
+ *     the interface, the hardware address one of the controller. configd makes a network
+ *     service (DHCP and the rest) for an interface it has listed, and only an interface with a
+ *     service can be the one the system routes through -- which wifid waits for after a join
+ *     ("failed to become routable interface") before Settings ticks the network.
+ *
+ * So: a controller of the class IO80211Controller under the platform, and below it one object
+ * that is both, an IONetworkInterface with wifid's properties. Both classes are ours, named as
+ * IO80211Family and IONetworkingFamily name theirs; neither has anything but properties.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void RedwoodWLANStart(const char * interface, const uint8_t * address);
+
+class IO80211Controller : public IOService
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class RedwoodWLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(RedwoodWLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodWLAN, IONetworkInterface);
+
+/* There is none (see the top); that somebody asked shows that the service was found. */
+IOReturn
+RedwoodWLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("RedwoodWLAN: a user client of type %u is asked for: there is none\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+/* Once, when the interface of a radio exists. */
+void
+RedwoodWLANStart(const char * interface, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	RedwoodWLAN * wlan = OSTypeAlloc(RedwoodWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		IOLog("RedwoodWLAN: cannot create the services\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	if ((controller = (IO80211Controller *) publish(controller, platform, "RedwoodWLANController")) == NULL) {
+		wlan->release();
+		IOLog("RedwoodWLAN: the controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (interface[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "RedwoodWLAN") == NULL) {
+		IOLog("RedwoodWLAN: the service did not start\n");
+	} else {
+		wlan->release();
+	}
+	controller->release();
+}
+
+/* The cellular bridge (sweetbb=1): AppleBaseband services for CommCenter/ABM over /dev/sweet-bb and wland. */
+#include "SweetBaseband.inc"
diff --git a/iokit/Kernel/arm/SweetAMFI.cpp b/iokit/Kernel/arm/SweetAMFI.cpp
new file mode 100644
index 0000000..0c26208
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAMFI.cpp
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: MIT
+ * Adapted from Yofuness/ios-flame sunfish f09fdb58 / patch0103.
+ * Copyright (c) 2026 dipa-studio. See repository MIT LICENSE.
+ * A stand-in for AppleMobileFileIntegrity's IOService, which this kernel
+ * does not have (no AMFI kext). Userland looks it up by class name:
+ * ExtensionFoundation's +[NSDictionary _EX_dictionaryWithSignedURL:] reads
+ * signed caches (the extension point cache) only after asking AMFI whether
+ * the file's cdhash is in the trust cache. Without an answer, sandboxed
+ * readers (lsd) get no extension point cache, so MobileInstallation rejects
+ * every app extension ("Extension cache does not have an entry for ..."),
+ * LaunchServices registers none, and e.g. PosterBoard finds no poster
+ * providers (black wallpaper).
+ *
+ * User client, IOConnectCallMethod:
+ *   6 trust cache query  [1] + struct cdhash -> 0 (trusted)
+ * Every cdhash is trusted: code signing is not enforced here anyway, and
+ * there is no trust cache to look in. Other selectors are logged once and
+ * answered kIOReturnUnsupported, which is what their callers already got
+ * from the missing service. Opt-in boot-arg sweetamfi=1 enables this diagnostic service.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <pexpert/pexpert.h>
+
+class AppleMobileFileIntegrity : public IOService {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+IOService *
+AppleMobileFileIntegrity::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("sweetamfi", &on, sizeof(on));
+	return on ? IOService::probe(provider, score) : NULL;
+}
+
+bool
+AppleMobileFileIntegrity::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleMobileFileIntegrityUserClient");
+	registerService();
+	IOLog("SWEET AMFI: AppleMobileFileIntegrity published (trust cache queries answer trusted)\n");
+	return true;
+}
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+
+IOReturn
+AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	(void)dispatch; (void)target; (void)reference;
+	if (!args) return kIOReturnBadArgument;
+	static uint32_t logged; /* one line per selector */
+	if (selector == 6) {
+		// Only the cache-trust query shape used by ExtensionFoundation. This
+		// service does not implement signature validation or entitlements.
+		if (!args->structureInput ||
+		    (args->structureInputSize != 20 && args->structureInputSize != 32) ||
+		    args->scalarInputCount > 1 ||
+		    (args->scalarInputCount == 1 && (!args->scalarInput || args->scalarInput[0] != 1)) ||
+		    args->scalarOutputCount || args->structureOutputSize)
+			return kIOReturnBadArgument;
+		if (!(logged & (1u << 6))) {
+			logged |= 1u << 6;
+			IOLog("SWEET AMFI: trust cache query (%u-byte cdhash): trusted\n", args->structureInputSize);
+		}
+		return kIOReturnSuccess;
+	}
+	if (selector < 32 && !(logged & (1u << selector))) {
+		logged |= 1u << selector;
+		IOLog("SWEET AMFI: selector %u (in %u/%u) unsupported\n", selector, args->scalarInputCount,
+		    args->structureInputSize);
+	}
+	return kIOReturnUnsupported;
+}
+#endif
diff --git a/iokit/Kernel/arm/SweetAdreno.cpp b/iokit/Kernel/arm/SweetAdreno.cpp
index 2fc64a8..1c8def5 100644
--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -146,13 +146,14 @@ OSDefineMetaClassAndStructors(SweetAdrenoUserClient, IOUserClient);
 /*
  * Same implementation under the class name the real iOS sandbox profiles allow for
  * GPU clients (iokit-user-client-class lists "AGXDeviceUserClient": docs/GPU_PHASE0_DISCOVERY.md).
- * Selected with boot-arg sweetgpuuc=1; the service is not an IOAccelerator, so Metal never meets it.
+ * xnu-12377 merge (ios-sweet): AGXDeviceUserClient is the sweet board's Adreno 618 client (SweetNativeAdrenoClient.cpp),
+ * so this Poco F1 one is SweetA630AGXUserClient here. Selected with boot-arg sweetgpuuc=1; the service is not an IOAccelerator, so Metal never meets it.
