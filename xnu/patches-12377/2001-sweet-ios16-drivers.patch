 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/* sweet board (ios-sweet 0199/0229): the one RW channel page mapped so far by the SM6150 write paths */
+static vm_offset_t sp_chnl;
+static uint16_t sp_chnl_apid = 0xffffu;
+
+/*
+ * 0199 (sweet board): the SM6150 PMIC write path, sweet_spmi_write_sm6150 (Bergamota's sweet_spmi_write is the Poco F1 one) (bsd/dev/sweet_charger.c, sweetcharge=2). A fixed list of SMB5
+ * charger registers on SID 0 (Xiaomi sweet smb5-reg.h): charging enable 0x1042, fast-charge current
+ * 0x1061, USB input suspend 0x1340, ICL override 0x1342, load cfg 0x1365, ICL options 0x1366, input
+ * current limit 0x1370, watchdog pet 0x1643. The APID must be owned by EE 0 (apps). EXT_WRITEL on
+ * the APID's RW channel (Linux spmi-pmic-arb v5 offsets: CMD 0, STATUS 8, WDATA0 0x10). A FAILURE or
+ * DROPPED status (a bus collision with another master) is resent up to 3 times, 150 us apart
+ * (ios-flame 0280).
+ */
+int
+sweet_spmi_write_sm6150(unsigned sid, unsigned addr, uint8_t val)
+{
+	static const uint16_t allowed[] = {0x1042, 0x1061, 0x1340, 0x1342, 0x1365, 0x1366, 0x1370, 0x1643};
+	bool listed = false;
+	for (unsigned i = 0; i < sizeof(allowed) / sizeof(allowed[0]); i++) {
+		listed |= allowed[i] == addr;
+	}
+	if (sid != 0 || !listed) {
+		printf("SWEET CHARGER: refused PMIC write sid %u %#x <- %#x\n", sid, addr, val);
+		return EPERM;
+	}
+	if (!sp_ready) {
+		return ENXIO;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return ENXIO;
+	}
+	unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u;
+	if (owner != 0) {
+		IOLockUnlock(sp_lock);
+		printf("SWEET CHARGER: APID %u (%#x) owned by EE %u, not 0: no write\n", apid, addr >> 8, owner);
+		return EPERM;
+	}
+	if (sp_chnl_apid != apid) {
+		vm_offset_t m = ml_io_map(SP_CHNL_PA + 0x10000u * apid, 0x1000);
+		if (!m) {
+			IOLockUnlock(sp_lock);
+			return ENOMEM;
+		}
+		sp_chnl = m;
+		sp_chnl_apid = apid;
+	}
+	int result = ETIMEDOUT;
+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(sp_chnl + 0x10u) = val; /* WDATA0 */
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(sp_chnl + 0x00u) = ((addr & 0xffu) << 4); /* EXT_WRITEL (opcode 0), BC=0 */
+		__asm__ volatile("dsb osh" ::: "memory");
+		uint32_t status = 0;
+		unsigned i;
+		for (i = 0; i < 1000; ++i) {
+			status = sp_rd(sp_chnl, 0x08u);
+			if (status & 1u) {
+				break;
+			}
+			delay(1);
+		}
+		if (i == 1000) {
+			sp_poisoned[apid] = true;
+			printf("SWEET CHARGER: SPMI write timeout %#x APID=%u disabled\n", addr, apid);
+			result = ETIMEDOUT;
+			break;
+		}
+		if (!(status & 0x0eu)) {
+			result = 0;
+			break;
+		}
+		result = EIO;
+		if (!(status & 0x0au) || attempt == 2) {     /* DENIED, or retries used up */
+			printf("SWEET CHARGER: SPMI write %#x status %#x\n", addr, status);
+			break;
+		}
+		delay(150);
+	}
+	IOLockUnlock(sp_lock);
+	return result;
+}
+
+/*
+ * 0229: the panel reset = PM6150L (SID 4) GPIO 9 (Xiaomi sweet DT: qcom,platform-reset-gpio =
+ * <&pm6150l_gpios 9 0>; pm6150l_gpios = pinctrl@c000, GPIOn at 0xc000 + (n - 1) * 0x100). Only
+ * that peripheral: read TYPE 0x04 / SUBTYPE 0x05 / MODE_CTL 0x40 / DIG_OUT_SOURCE_CTL 0x44 /
+ * EN_CTL 0x46 (Linux pinctrl-spmi-gpio LV/MV layout) and write only 0x44 bit 7 (an LV/MV GPIO
+ * outputs its "invert" bit with source 0). Refuses unless ABL left it an enabled digital output.
+ * Returns 0 and the level read back, or an errno.
+ */
+static int
+sp_panel_read(unsigned addr, uint8_t *out)
+{
+	uint16_t apid = sp_find_apid((4u << 8) | 0xc8u);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		return ENXIO;
+	}
+	unsigned off = 0x80u * apid;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return EIO;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET PANEL: SPMI read timeout sid 4 %#x APID=%u disabled\n", addr, apid);
+	return ETIMEDOUT;
+}
+
+int sweet_spmi_panel_reset(int level);
+int
+sweet_spmi_panel_reset(int level)
+{
+	static unsigned logged;
+	if (!sp_ready) {
+		return ENXIO;
+	}
+	IOLockLock(sp_lock);
+	uint8_t type = 0, subtype = 0, mode = 0, src = 0, en = 0;
+	int error = sp_panel_read(0xc804, &type);
+	if (!error) error = sp_panel_read(0xc805, &subtype);
+	if (!error) error = sp_panel_read(0xc840, &mode);
+	if (!error) error = sp_panel_read(0xc844, &src);
+	if (!error) error = sp_panel_read(0xc846, &en);
+	uint16_t apid = sp_find_apid((4u << 8) | 0xc8u);
+	unsigned owner = apid == SP_NO_APID ? 7u : (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u);
+	if (logged++ < 4 || error) {
+		printf("SWEET PANEL: reset GPIO pm6150l 9: read %d type %#x subtype %#x mode %#x out %#x en %#x owner EE%u\n",
+		    error, type, subtype, mode, src, en, owner);
+	}
+	if (!error && (type != 0x10 || (subtype != 0x10 && subtype != 0x11) || ((mode & 3u) != 1 && (mode & 3u) != 2) ||
+	    !(en & 0x80u) || (src & 0x0fu) != 0 || owner != 0)) {
+		error = EPERM;    /* not the enabled LV/MV digital output Linux would drive: leave it */
+	}
+	if (!error) {
+		if (sp_chnl_apid != apid) {
+			vm_offset_t m = ml_io_map(SP_CHNL_PA + 0x10000u * apid, 0x1000);
+			if (!m) {
+				IOLockUnlock(sp_lock);
+				return ENOMEM;
+			}
+			sp_chnl = m;
+			sp_chnl_apid = apid;
+		}
+		const uint8_t val = (uint8_t)((src & 0x7fu) | (level ? 0x80u : 0u));
+		error = ETIMEDOUT;
+		for (unsigned attempt = 0; attempt < 3; attempt++) {
+			__asm__ volatile("dmb oshst" ::: "memory");
+			*(volatile uint32_t *)(sp_chnl + 0x10u) = val;
+			__asm__ volatile("dmb oshst" ::: "memory");
+			*(volatile uint32_t *)(sp_chnl + 0x00u) = (0x44u << 4);   /* EXT_WRITEL 0xc844 */
+			__asm__ volatile("dsb osh" ::: "memory");
+			uint32_t status = 0;
+			unsigned i;
+			for (i = 0; i < 1000 && !((status = sp_rd(sp_chnl, 0x08u)) & 1u); ++i) {
+				delay(1);
+			}
+			if (i == 1000) {
+				sp_poisoned[apid] = true;
+				break;
+			}
+			if (!(status & 0x0eu)) {
+				error = 0;
+				break;
+			}
+			error = EIO;
+			if (!(status & 0x0au)) {
+				break;
+			}
+			delay(150);
+		}
+		uint8_t back = 0;
+		if (!error && !sp_panel_read(0xc844, &back) && ((back >> 7) & 1u) != (level ? 1u : 0u)) {
+			error = EIO;
+		}
+	}
+	IOLockUnlock(sp_lock);
+	return error;
+}
