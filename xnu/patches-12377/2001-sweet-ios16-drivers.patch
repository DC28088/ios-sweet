+struct Backend {
+ NativeAdrenoVm *vm=nullptr;
+ NativeAdrenoSubmit *submit=nullptr;
+ NativeAdrenoRing *ring=nullptr;
+ IOLock *lock=nullptr;
+ NativeAdrenoRingClock clock{};
+ NativeAdrenoTimer timer;
+ NativeAdrenoStatus status;
+ NativeAdrenoAbiDeviceInfo info{};
+ int (*health)(void *)=nullptr;
+ bool published=false,opened=false,lost=false,cpu_present=false;
+ bool pipeline=true;   // sweetpipeline=0 restores a full drain before every submit/map
+ bool present_locked=false;   // sweetpresentlock=1: present holds the lock across drain and copy
+ bool present_swap_fence=false;   // sweetpresentfence=1: wait for the SwapEnd-time fence
+ bool wait_unlocked=true;   // sweetwaitlock=1: WaitFence spins with the lock held, as before 0144
+ /* Slot 0 is backboardd's original window. Extra slots are separate 256 MiB
+  * windows of the same 2 GiB arena above it, each with its own queue range,
+  * so one client's IOVAs can never collide with another's. */
