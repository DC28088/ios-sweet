+    }
+    if(pooled && pool_blocks)native_adreno_pool_stats[2]=native_adreno_pool_stats[2]+1;
+    IOOptionBits options=static_cast<IOOptionBits>(kIODirectionInOut)|static_cast<IOOptionBits>(kIOMemoryMapperNone);
+    if(contiguous)options|=kIOMemoryPhysicallyContiguous;
+    descriptor_=IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,options,capacity,(limit-1)&~uint64_t(PAGE_SIZE-1));
+    if(!descriptor_)return kIOReturnNoMemory;
+    status=descriptor_->prepare();
+    if(status!=kIOReturnSuccess) {descriptor_->release();descriptor_=nullptr;return status;}
+    prepared_=true;bytes_=bytes;allocated_bytes_=capacity;mapping_=descriptor_->getBytesNoCopy();
+    status=kIOReturnUnsupported;
+    if(!mapping_ || ((uintptr_t)mapping_&(PAGE_SIZE-1)) || capacity>UINTPTR_MAX-(uintptr_t)mapping_ ||
+        descriptor_->getLength()!=capacity)goto failed;
+    owned_capacity_=capacity/PAGE_SIZE;
+    owned_spans_=IONew(NativeAdrenoPhysicalSpan,owned_capacity_);
+    if(!owned_spans_) {status=kIOReturnNoMemory;goto failed;}
+    for(size_t offset=0;offset<capacity;offset+=PAGE_SIZE) {
+        IOByteCount length=0;
+        const addr64_t physical=descriptor_->getPhysicalSegment(offset,&length,kIOMemoryMapperNone);
+        if(!physical || (physical&(PAGE_SIZE-1)) || length<PAGE_SIZE || physical>=limit || PAGE_SIZE>limit-physical ||
+            (contiguous && offset && physical!=owned_spans_[0].physical+offset)) {status=kIOReturnUnsupported;goto failed;}
+        if(owned_count_ && physical==owned_spans_[owned_count_-1].physical+owned_spans_[owned_count_-1].bytes)
+            owned_spans_[owned_count_-1].bytes+=PAGE_SIZE;
+        else owned_spans_[owned_count_++]={offset,physical,PAGE_SIZE};
+    }
+    span_capacity_=bytes/4096;
+    spans_=IONew(NativeAdrenoPhysicalSpan,span_capacity_);
+    if(!spans_) {status=kIOReturnNoMemory;goto failed;}
+    for(size_t offset=0;offset<bytes;offset+=4096) {
+        IOByteCount length=0;
+        addr64_t physical=descriptor_->getPhysicalSegment(offset,&length,kIOMemoryMapperNone);
+        if(!physical || (physical&4095) || length<4096 || physical>=limit || 4096>limit-physical)
+            {status=kIOReturnUnsupported;goto failed;}
+        if(contiguous && offset && physical!=spans_[0].physical+offset)
+            {status=kIOReturnUnsupported;goto failed;}
+        if(span_count_ && physical==spans_[span_count_-1].physical+spans_[span_count_-1].bytes)
+            spans_[span_count_-1].bytes+=4096;
