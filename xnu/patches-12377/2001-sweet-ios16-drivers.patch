+/* 0x70000000.. holds the kernel's CP firmware/ring/fence (A618_CP_IOVA): the
+ * 0129 windows overlapped it and every extra BoMap was refused as Busy. */
+enum : uint64_t {ExtraWindowStart=0x80000000,ExtraWindowBytes=0x10000000};
+/* Processes that receive a Metal device besides backboardd. AegirPoster (the
+ * configured iOS 16 wallpaper) aborts without one; sweetm2extra=0 disables. */
+bool extra_client(const char *name)
+{
+ static const char *const names[]={"AegirPoster"};
+ for(const char *n:names)if(!strcmp(name,n))return true;
+ return false;
+}
+// Release/acquire publishes the completed backend to the framebuffer workloop.
+static bool presentation_ready=false;
+char last_submitter[32];   // process of the newest successful submit (diagnostics)
+bool healthy()
+{
+ if(backend.lost)return false;
+ const bool fault=!backend.health || backend.health(nullptr);
+ if(fault || backend.vm->poisoned() || backend.submit->poisoned() || backend.ring->poisoned()) {
+  backend.lost=true;backend.status.noteFault();
+  char why[96];
+  snprintf(why,sizeof why,"%s%s%s%s last_submit=%s fence=%u/%u",fault?"hw-fault ":"",
+    backend.vm->poisoned()?"vm ":"",backend.submit->poisoned()?"submit ":"",
+    backend.ring->poisoned()?"ring ":"",last_submitter,backend.ring->completedFence(),backend.ring->lastSubmitted());
+  sweet_native_adreno_fault_report(why);
+  return false;
+ }
+ return true;
+}
+IOReturn quiesce()
+{
+ if(!healthy())return kIOReturnIOError;
+ IOReturn result=backend.submit->waitAll(&backend.clock,1000000);
+ if(!result)result=backend.ring->drainA6xx(&backend.clock,1000000);
+ if(result) {
+  // 0130 hardware: the backend was lost here (no faulted() term) right after
+  // an AegirPoster instance was killed; say so with the CP state.
+  backend.lost=true;backend.status.noteFault();
+  char why[96];
+  snprintf(why,sizeof why,"quiesce %#x last_submit=%s fence=%u/%u",result,last_submitter,
+    backend.ring->completedFence(),backend.ring->lastSubmitted());
+  sweet_native_adreno_fault_report(why);
+ }
+ return result;
+}
+}
+/* The panel is CPU-copied, unlike a display engine that consumes a GPU fence.
+ * Hold the shared submission/VM gate across quiescence and the source copy so
+ * another submit cannot overwrite its source during the CPU read. This waits
+ * real CP fences; it never declares pending work complete. */
+/* 1 = lock held until present_end (sweetpresentlock=1: full drain, then the
+ * copy under the lock, as 0125-0131). 2 = gate passed without the lock: wait
+ * only for the newest fence submitted when presenting starts, with the lock
+ * taken just for each instantaneous check. CACHE_FLUSH_TS writes that fence
+ * after the frame's render output, and present() still does the physical
+ * cache acquire. 0127 hardware: holding the lock 15-22ms per present
+ * serialized CoreAnimation's submissions behind the copy. */
+/* Newest fence handed out (0 before publication); read without the lock:
+ * a monotonic counter, used only to pick a wait target. */
+extern "C" uint32_t sweet_native_adreno_last_fence(void)
+{
+ if(!__atomic_load_n(&presentation_ready,__ATOMIC_ACQUIRE) || !backend.ring)return 0;
+ return backend.ring->lastSubmitted();
+}
+/* swap_fence: sweet_native_adreno_last_fence() when SwapEnd recorded the frame.
+ * sweetpresentfence=1 waits for that one (the frame being shown) instead of
+ * the newest fence, which may belong to CoreAnimation's next frame. */
+extern "C" int sweet_native_adreno_cpu_present_begin(uint32_t swap_fence)
+{
+ if(!__atomic_load_n(&presentation_ready,__ATOMIC_ACQUIRE) || !backend.cpu_present)return 0;
+ const uint64_t began=backend.clock.now_us(backend.clock.cookie);
+ static unsigned presents=0;
+ if(backend.present_locked) {
+  IOLockLock(backend.lock);
+  const IOReturn result=quiesce();
+  if(++presents<=4 || presents%120==0)
+   IOLog("SWEET RENDER: CPU present gate %u wait_us=%llu result=%#x locked\n",presents,
+     backend.clock.now_us(backend.clock.cookie)-began,result);
+  if(result) {IOLockUnlock(backend.lock);return -1;}
+  return 1;
+ }
+ IOLockLock(backend.lock);
+ const bool ok=healthy();
+ const uint32_t newest=ok?backend.ring->lastSubmitted():0;
+ const uint32_t target=backend.present_swap_fence && swap_fence && swap_fence-newest>0x80000000u?swap_fence:newest;
+ IOLockUnlock(backend.lock);
+ IOReturn result=ok?kIOReturnSuccess:kIOReturnIOError;
+ while(ok && target) {
+  IOLockLock(backend.lock);
+  result=healthy()?backend.submit->observeFence(target,&backend.clock,0):kIOReturnIOError;
+  IOLockUnlock(backend.lock);
+  if(result!=kIOReturnTimeout)break;
+  if(backend.clock.now_us(backend.clock.cookie)-began>=1000000)break;
+  IODelay(50);
+ }
+ if(++presents<=4 || presents%120==0)
+  IOLog("SWEET RENDER: CPU present gate %u fence=%u wait_us=%llu result=%#x unlocked\n",presents,target,
+    backend.clock.now_us(backend.clock.cookie)-began,result);
+ return result?-1:2;
+}
+extern "C" void sweet_native_adreno_cpu_present_end(int state)
+{
+ if(state==1)IOLockUnlock(backend.lock);
+}
+/* Per-window GPU and lock telemetry (0144). Busy is sampled from the
+ * framebuffer's 120 Hz timer: the newest fence still incomplete. A sample
+ * that finds the lock taken is counted apart rather than guessed. */
+namespace {
+struct MethodStat {uint64_t calls,us;};
+MethodStat method_stats[NativeAdrenoMethodSubmitResources+1];
+uint64_t lock_wait_us,lock_wait_max_us,lock_takes,wait_polls;
+unsigned busy_samples,idle_samples,locked_samples;
+uint64_t window_began_us;
+/* 0171: which blocks of the GPU are busy while a fence is outstanding (RBBM_STATUS, a6xx.xml bit names). Read only then,
+ * so the core is awake; a statistical profile of the 10 s window, not a count of cycles. */
+unsigned rbbm_samples,rbbm_idle,rbbm_bits[24];
+volatile uint32_t *rbbm_status;
+const char *const rbbm_names[24]={"CXM","CPM","CP","DBGC","VBIF","TSE","RAS","RB","CCU","A2D","LRZ","DCOM","DCALL","VSD","TESS",
+ "VFD","VPC","UCHE","SP","TPL1","VSC","HLSQ","IGNCP","IGN"};
+}
+extern "C" vm_offset_t ml_io_map(vm_offset_t,vm_size_t);
+extern "C" void sweet_native_adreno_sample_busy(void)
+{
+ if(!__atomic_load_n(&presentation_ready,__ATOMIC_ACQUIRE) || !backend.ring)return;
+ if(!IOLockTryLock(backend.lock)) {++locked_samples;return;}
+ const uint32_t newest=healthy()?backend.ring->lastSubmitted():0;
+ const IOReturn state=newest?backend.submit->observeFence(newest,&backend.clock,0):kIOReturnSuccess;
+ if(state==kIOReturnTimeout)++busy_samples;else ++idle_samples;
+  if(state==kIOReturnTimeout) {
+  if(!rbbm_status) {const vm_offset_t core=ml_io_map(0x05000000,0x40000);if(core)rbbm_status=(volatile uint32_t *)(core+0x840);}
+  const uint32_t st=rbbm_status?*rbbm_status:0xffffffffu;
+  if(st!=0xffffffffu) {
+   ++rbbm_samples;
+   if(!(st&~1u))++rbbm_idle;
+   for(unsigned b=0;b<24;b++)if(st&(1u<<b))++rbbm_bits[b];
+  }
+ }
+ IOLockUnlock(backend.lock);
+}
+/* Called with the lock held after each method; prints once per 10 s. */
+static void method_window(void)
+{
+ const uint64_t now=backend.clock.now_us(backend.clock.cookie);
+ if(!window_began_us) {window_began_us=now;return;}
+ if(now-window_began_us<10000000)return;
+ static const char *const names[]={"0","query","alloc","map","free","submit","wait","ts","status","setmeta","getmeta","mkq","rmq","cpumap","cpuunmap","devinfo","import","submit-res"};
+ char line[320];size_t at=0;
+ for(unsigned i=1;i<=NativeAdrenoMethodSubmitResources && at<sizeof line;i++) {
+  if(!method_stats[i].calls)continue;
+  at+=snprintf(line+at,sizeof line-at," %s=%llu/%llu",i<sizeof names/sizeof names[0]?names[i]:"?",
+    method_stats[i].calls,method_stats[i].us/method_stats[i].calls);
+ }
+ if(at>=sizeof line)at=sizeof line-1;
+ line[at]=0;
+ const unsigned sampled=busy_samples+idle_samples;
+ IOLog("SWEET RENDER: window_ms=%llu gpu_busy_pct=%u samples=%u locked=%u lock_avg_us=%llu lock_max_us=%llu wait_polls=%llu pool_mib=%u/%u peak pooled=%u fallback=%u calls/avg_us:%s\n",
+   (now-window_began_us)/1000,sampled?busy_samples*100/sampled:0,sampled,locked_samples,
+   lock_takes?lock_wait_us/lock_takes:0,lock_wait_max_us,wait_polls,native_adreno_pool_stats[3],native_adreno_pool_stats[4],
+   native_adreno_pool_stats[1],native_adreno_pool_stats[2],line);
+ if(rbbm_samples) {
+  char blocks[400];size_t n=0;
+  for(unsigned b=0;b<24 && n<sizeof blocks-16;b++)if(rbbm_bits[b]*100/rbbm_samples>=3)
+   n+=snprintf(blocks+n,sizeof blocks-n," %s=%u",rbbm_names[b],rbbm_bits[b]*100/rbbm_samples);
+  blocks[n]=0;
+  IOLog("SWEET RENDER: rbbm samples=%u (fence outstanding) idle=%u%% busy blocks%%:%s\n",rbbm_samples,rbbm_idle*100/rbbm_samples,blocks);
+ }
+ rbbm_samples=rbbm_idle=0;memset(rbbm_bits,0,sizeof rbbm_bits);
+ memset(method_stats,0,sizeof method_stats);
+ lock_wait_us=lock_wait_max_us=lock_takes=wait_polls=0;busy_samples=idle_samples=locked_samples=0;
+ window_began_us=now;
+}
+static void lock_timed(void)
+{
+ const uint64_t asked=backend.clock.now_us(backend.clock.cookie);
+ IOLockLock(backend.lock);
+ const uint64_t waited=backend.clock.now_us(backend.clock.cookie)-asked;
+ lock_wait_us+=waited;++lock_takes;if(waited>lock_wait_max_us)lock_wait_max_us=waited;
+}
