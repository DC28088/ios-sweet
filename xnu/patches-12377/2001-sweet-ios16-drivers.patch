+/* Read GPLL0 and the even post-divider; the ftbl rates assume 600 / 300 MHz. */
+static bool
+wl_gpll0_check(void)
+{
+	uint32_t mode = wl_rd(wl.gcc, PLL_MODE), l = wl_rd(wl.gcc, PLL_L_VAL);
+	uint32_t user = wl_rd(wl.gcc, PLL_USER_CTL), frac = wl_rd(wl.gcc, PLL_FRAC) & 0xffffu;
+	unsigned pd = (user >> 8) & 0xf;
+	unsigned div = pd == 0 ? 1 : pd == 1 ? 2 : pd == 3 ? 4 : pd == 7 ? 8 : 0;
+	uint64_t main_hz = XO_HZ * (l & 0xffffu) + ((XO_HZ * frac) >> 16);
+	uint64_t even_hz = div ? main_hz / div : 0;
+	unsigned skip = 0;
+
+	printf("SWEET BT: GPLL0 mode %#x (lock %u) L %u frac %#x user-ctl %#x vote 0x52000=%#x -> main %llu Hz, "
+	    "even (post-div %u) %llu Hz\n", mode, mode >> 31, l, frac, user, wl_rd(wl.gcc, 0x52000), main_hz,
+	    div, even_hz);
+	(void)PE_parse_boot_argn("sweetwlanskippll", &skip, sizeof(skip));
+	if (!(mode & PLL_LOCK_DET)) {
+		printf("SWEET BT: GPLL0 is not locked: the S3 RCG source is dead, stop\n");
+		return false;
+	}
+	bool main_ok = main_hz > GPLL0_HZ - GPLL0_HZ / 1000 && main_hz < GPLL0_HZ + GPLL0_HZ / 1000;
+	bool even_ok = even_hz > GPLL0_HZ / 2 - GPLL0_HZ / 2000 && even_hz < GPLL0_HZ / 2 + GPLL0_HZ / 2000;
+	if (!main_ok || !even_ok) {
+		if (skip) {
+			printf("SWEET BT: GPLL0 rates off the expected 600/300 MHz but sweetwlanskippll=1: using the "
+			    "nominal ftbl anyway (baud will be off)\n");
+			return true;
+		}
+		printf("SWEET BT: GPLL0 is not 600 MHz / even 300 MHz (decode of PLL regs may be wrong; "
+		    "sweetwlanskippll=1 overrides): stop\n");
+		return false;
+	}
+	wl_gpll0_main_hz = main_hz;
+	wl_gpll0_even_hz = even_hz;
+	printf("SWEET BT: GPLL0 600 MHz / GPLL0_OUT_EVEN 300 MHz confirmed\n");
+	return true;
+}
+
+/* clk-rcg2.c update_config(): set CMD_UPDATE, wait for the hardware to clear it */
+static bool
+wl_rcg_update(void)
+{
+	uint32_t cmd = wl_rd(wl.gcc, RCG_S3 + RCG_CMD);
+	wl_wr(wl.gcc, RCG_S3 + RCG_CMD, cmd | CMD_UPDATE);
+	for (unsigned i = 0; i < 2000; i++) {
+		if (!(wl_rd(wl.gcc, RCG_S3 + RCG_CMD) & CMD_UPDATE)) {
+			printf("SWEET BT: RCG CMD %#x -> UPDATE set (wrote %#x), cleared after %u polls, cmd now %#x\n",
+			    cmd, cmd | CMD_UPDATE, i, wl_rd(wl.gcc, RCG_S3 + RCG_CMD));
+			return true;
+		}
+		delay(10);
+	}
+	printf("SWEET BT: RCG UPDATE did not clear: cmd %#x\n", wl_rd(wl.gcc, RCG_S3 + RCG_CMD));
+	return false;
+}
+
+/* clk-rcg2.c __clk_rcg2_configure(): M, N, D, then CFG, then UPDATE */
+static bool
+wl_rcg_write(uint32_t m, uint32_t n, uint32_t d, uint32_t cfg_bits, bool with_mnd)
+{
+	uint32_t cfg;
+	bool ok = true;
+	if (with_mnd) {
+		ok &= wl_wrv(wl.gcc, "GCC", RCG_S3 + RCG_M, m & RCG_MND_MASK, RCG_MND_MASK);
+		ok &= wl_wrv(wl.gcc, "GCC", RCG_S3 + RCG_N, n & RCG_MND_MASK, RCG_MND_MASK);
+		ok &= wl_wrv(wl.gcc, "GCC", RCG_S3 + RCG_D, d & RCG_MND_MASK, RCG_MND_MASK);
+	}
+	cfg = (wl_rd(wl.gcc, RCG_S3 + RCG_CFG) & ~RCG_CFG_MASK) | (cfg_bits & RCG_CFG_MASK);
+	ok &= wl_wrv(wl.gcc, "GCC", RCG_S3 + RCG_CFG, cfg, RCG_CFG_MASK);
+	if (!ok) {
+		return false;
+	}
+	return wl_rcg_update();
+}
+
+/*
+ * DFS (clk-rcg2.c clk_rcg2_dfs): the RCG holds 8 preset performance levels and the serial engine picks
+ * one with SE_CLK_SEL (qcom-geni-se.c geni_se_clk_freq_match, as Linux runs sm7150's QUP clocks). sweet's
+ * touch SE7 RCG reads dfs=0x21. In DFS mode the RCG is never written: only SE_CLK_SEL and the divider.
+ */
+static bool wl_dfs;
+static uint64_t wl_dfs_hz[8];
+
+static uint64_t
+wl_dfs_level_hz(unsigned lvl)
+{
+	uint32_t cfg = wl_rd(wl.gcc, RCG_S3 + 0x1c + 0x24 * lvl);
+	uint32_t m = wl_rd(wl.gcc, RCG_S3 + 0x20 + 0x24 * lvl);
+	uint32_t nr = wl_rd(wl.gcc, RCG_S3 + 0x24 + 0x24 * lvl);
+	unsigned src = (cfg >> 8) & 7, hid = cfg & 0x1f, mode = (cfg >> 12) & 3;
+	uint64_t parent = src == 0 ? XO_HZ : src == 1 ? wl_gpll0_main_hz : src == 6 ? wl_gpll0_even_hz : 0;
+	if (!parent || cfg == 0xffffffffu) {
+		return 0;
+	}
+	uint64_t hz = parent * 2 / (hid + 1);
+	if (mode && m) {
+		uint32_t n = (~nr + m) & 0xffffu;
+		if (n == 0) {
+			return 0;
+		}
+		hz = hz * m / n;
+	}
+	return hz;
+}
+
+static bool
+wl_rcg_save(void)
+{
+	if (wl.rcg_saved) {
+		return true;
+	}
+	if (wl_rd(wl.gcc, RCG_S3 + RCG_DFS_ENABLE) & 1) {
+		wl_dfs = true;
+		for (unsigned l = 0; l < 8; l++) {
+			wl_dfs_hz[l] = wl_dfs_level_hz(l);
+			printf("SWEET BT: S3 DFS level %u: %llu Hz\n", l, wl_dfs_hz[l]);
+		}
+		printf("SWEET BT: S3 RCG in DFS mode (dfs-cmd %#x): levels picked through SE_CLK_SEL, RCG untouched\n",
+		    wl_rd(wl.gcc, RCG_S3 + RCG_DFS_ENABLE));
+		return true;
+	}
+	wl.rcg_orig[0] = wl_rd(wl.gcc, RCG_S3 + RCG_CFG);
+	wl.rcg_orig[1] = wl_rd(wl.gcc, RCG_S3 + RCG_M);
+	wl.rcg_orig[2] = wl_rd(wl.gcc, RCG_S3 + RCG_N);
+	wl.rcg_orig[3] = wl_rd(wl.gcc, RCG_S3 + RCG_D);
+	wl.rcg_saved = true;
+	printf("SWEET BT: S3 RCG saved: cmd %#x cfg %#x m %#x n %#x d %#x\n", wl_rd(wl.gcc, RCG_S3),
+	    wl.rcg_orig[0], wl.rcg_orig[1], wl.rcg_orig[2], wl.rcg_orig[3]);
+	return true;
+}
+
+static void
+wl_rcg_restore(void)
+{
+	if (wl_dfs || !wl.rcg_saved) {
+		return;
+	}
+	printf("SWEET BT: restoring the original S3 RCG config\n");
+	/* the saved CFG is written verbatim (HW_CLK_CTRL included): mask = all bits */
+	bool ok = wl_wrv(wl.gcc, "GCC(restore)", RCG_S3 + RCG_M, wl.rcg_orig[1], RCG_MND_MASK);
+	ok &= wl_wrv(wl.gcc, "GCC(restore)", RCG_S3 + RCG_N, wl.rcg_orig[2], RCG_MND_MASK);
+	ok &= wl_wrv(wl.gcc, "GCC(restore)", RCG_S3 + RCG_D, wl.rcg_orig[3], RCG_MND_MASK);
+	ok &= wl_wrv(wl.gcc, "GCC(restore)", RCG_S3 + RCG_CFG, wl.rcg_orig[0], RCG_CFG_MASK);
+	ok &= wl_rcg_update();
+	printf("SWEET BT: S3 RCG restore %s (cbcr s3 %#x)\n", ok ? "ok" : "FAILED", wl_rd(wl.gcc, CBCR_S3));
+	wl.rcg_saved = false;
+	wl.rcg_row = -1;
+}
+
+/* qcom_geni_serial.c get_clk_cfg(): first ftbl row that divides baud * oversampling exactly */
+static int
+wl_pick_row(unsigned baud, unsigned *div)
+{
+	uint64_t unit = (uint64_t)baud * wl.os;
+	for (unsigned i = 0; i < WL_NFTBL; i++) {
+		uint64_t hz = wl_ftbl[i].hz;
+		if (hz >= unit && hz % unit == 0 && hz / unit <= 4095) {
+			*div = (unsigned)(hz / unit);
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+/* log what each baud of interest needs; no register is touched */
+static void
+wl_baud_plan(void)
+{
+	static const unsigned bauds[] = { 2400, 115200, 3000000, WL_BT_OPER_BAUD };
+	for (unsigned i = 0; i < sizeof(bauds) / sizeof(bauds[0]); i++) {
+		unsigned div = 0;
+		int r = wl_pick_row(bauds[i], &div);
+		if (r < 0) {
+			printf("SWEET BT: baud plan %u: NO exact ftbl row (oversampling %u)\n", bauds[i], wl.os);
+			continue;
+		}
+		uint64_t hz = wl_row_hz(&wl_ftbl[r]);
+		printf("SWEET BT: baud plan %u: ftbl row %d %u Hz (src %u hid %u m %u n %u, measured %llu Hz) / "
+		    "(div %u * os %u) = %llu baud%s\n", bauds[i], r, wl_ftbl[r].hz, wl_ftbl[r].src,
+		    wl_ftbl[r].hid, wl_ftbl[r].m, wl_ftbl[r].n, hz, div, wl.os, hz / ((uint64_t)div * wl.os),
+		    hz == wl_ftbl[r].hz ? " exact" : " (GPLL0 off nominal)");
+	}
+}
+
+static bool
+wl_rcg_set_row(int r)
+{
+	const struct wl_rcg_row *f = &wl_ftbl[r];
+	uint32_t cfg = ((uint32_t)f->hid & CFG_SRC_DIV_MASK) | ((uint32_t)f->src << CFG_SRC_SEL_SHIFT);
+	if (f->n && f->m != f->n) {
+		cfg |= CFG_MODE_DUAL_EDGE;
+	}
+	/* M = m, N = ~(n - m), D = ~n (16 bit); HW_CLK_CTRL is cleared like Linux does */
+	printf("SWEET BT: S3 RCG -> %u Hz: src %u hid %u m %u n %u cfg %#x\n", f->hz, f->src, f->hid, f->m,
+	    f->n, cfg);
+	if (!wl_rcg_write(f->m, f->n ? ~(uint32_t)(f->n - f->m) : 0, f->n ? ~(uint32_t)f->n : 0, cfg, f->n != 0)) {
+		return false;
+	}
+	if (!cbcr_on(CBCR_S3)) {
+		printf("SWEET BT: S3 branch went off after the RCG update (cbcr %#x)\n", wl_rd(wl.gcc, CBCR_S3));
+		return false;
+	}
+	printf("SWEET BT: S3 RCG now cmd %#x cfg %#x m %#x n %#x d %#x, cbcr s3 %#x\n", wl_rd(wl.gcc, RCG_S3),
+	    wl_rd(wl.gcc, RCG_S3 + RCG_CFG), wl_rd(wl.gcc, RCG_S3 + RCG_M), wl_rd(wl.gcc, RCG_S3 + RCG_N),
+	    wl_rd(wl.gcc, RCG_S3 + RCG_D), wl_rd(wl.gcc, CBCR_S3));
+	return true;
+}
+
+/* program the RCG row and GENI divider for a baud rate (qcom_geni_serial_set_termios) */
+static bool
+wl_baud_dfs(unsigned baud)
+{
+	uint64_t unit = (uint64_t)baud * wl.os;
+	int lvl = -1;
+	unsigned div = 0;
+	for (unsigned l = 0; l < 8 && lvl < 0; l++) {
+		uint64_t hz = wl_dfs_hz[l];
+		if (hz >= unit && hz % unit == 0 && hz / unit <= 4095) {
+			lvl = (int)l;
+			div = (unsigned)(hz / unit);
+		}
+	}
+	if (lvl < 0) {
+		printf("SWEET BT: no DFS level gives %u baud exactly (oversampling %u)\n", baud, wl.os);
+		return false;
+	}
+	wl_rx_stop();
+	if (!wl.se_saved) {
+		wl.se_orig[0] = wl_rd(wl.se, SE_M_CLK_CFG);
+		wl.se_orig[1] = wl_rd(wl.se, SE_S_CLK_CFG);
+		wl.se_orig[2] = wl_rd(wl.se, SE_CLK_SEL);
+		wl.se_saved = true;
+	}
+	uint32_t ser = (div << 4) | 1u;
+	bool ok = wl_wrv(wl.se, "SE3", SE_CLK_SEL, (uint32_t)lvl, 0x7);
+	ok &= wl_wrv(wl.se, "SE3", SE_M_CLK_CFG, ser, 0xfff1u);
+	ok &= wl_wrv(wl.se, "SE3", SE_S_CLK_CFG, ser, 0xfff1u);
+	if (!ok) {
+		return false;
+	}
+	wl.baud = baud;
+	printf("SWEET BT: UART %u baud: DFS level %d (%llu Hz), GENI divider %u, oversampling %u\n",
+	    baud, lvl, wl_dfs_hz[lvl], div, wl.os);
+	return true;
+}
+
+static bool
+wl_baud(unsigned baud)
+{
+	if (wl_dfs) {
+		return wl_baud_dfs(baud);
+	}
+	unsigned div = 0;
+	int r = wl_pick_row(baud, &div);
+	if (r < 0) {
+		printf("SWEET BT: no exact S3 rate for %u baud (oversampling %u)\n", baud, wl.os);
+		return false;
+	}
+	wl_rx_stop();
+	if (!wl.se_saved) {
+		wl.se_orig[0] = wl_rd(wl.se, SE_M_CLK_CFG);
+		wl.se_orig[1] = wl_rd(wl.se, SE_S_CLK_CFG);
+		wl.se_orig[2] = wl_rd(wl.se, SE_CLK_SEL);
+		wl.se_saved = true;
+		printf("SWEET BT: SE3 clock regs saved: m_clk_cfg %#x s_clk_cfg %#x clk_sel %#x\n",
+		    wl.se_orig[0], wl.se_orig[1], wl.se_orig[2]);
+	}
+	if (wl.rcg_row != r) {
+		if (!wl_rcg_set_row(r)) {
+			return false;
+		}
+		wl.rcg_row = r;
+	}
+	uint32_t ser = (div << 4) | 1u;               /* CLK_DIV [15:4], SER_CLK_EN */
+	bool ok = wl_wrv(wl.se, "SE3", SE_CLK_SEL, 0, 0x7);   /* DFS off: level is unused */
+	ok &= wl_wrv(wl.se, "SE3", SE_M_CLK_CFG, ser, 0xfff1u);
+	ok &= wl_wrv(wl.se, "SE3", SE_S_CLK_CFG, ser, 0xfff1u);
+	if (!ok) {
+		return false;
+	}
+	wl.baud = baud;
+	printf("SWEET BT: UART %u baud: S3 root %llu Hz (ftbl row %d), GENI divider %u, oversampling %u\n",
+	    baud, wl_row_hz(&wl_ftbl[r]), r, div, wl.os);
+	return true;
+}
+
+static void
+wl_se_clk_restore(void)
+{
+	if (!wl.se_saved) {
+		return;
+	}
+	(void)wl_wrv(wl.se, "SE3(restore)", SE_M_CLK_CFG, wl.se_orig[0], 0xfff1u);
+	(void)wl_wrv(wl.se, "SE3(restore)", SE_S_CLK_CFG, wl.se_orig[1], 0xfff1u);
+	(void)wl_wrv(wl.se, "SE3(restore)", SE_CLK_SEL, wl.se_orig[2], 0x7);
+	wl.se_saved = false;
+}
+
+static void
+wl_flow(bool hw)
+{
+	uint32_t v = wl_rd(wl.se, SE_UART_TX_TRANS_CFG);
+	hw = hw && !wl.bt_noflow;                     /* sweetbtnoflow=1: CTS never honoured */
+	v = hw ? (v & ~UART_CTS_MASK) : (v | UART_CTS_MASK);
+	wl_wr(wl.se, SE_UART_TX_TRANS_CFG, v);
+}
+
+/* ms since boot, for the IBS / raw RX trace */
+static unsigned
+wl_ms(void)
+{
+	uint64_t t, ns;
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return (unsigned)(ns / 1000000ull);
+}
+
+/*
+ * Flow control state for the post-NVM diagnosis: the GENI UART config (CTS mask = bit 1 of TX_TRANS_CFG,
+ * auto RFR unless MANUAL_RFR bit 31 is set: bit 0 ready, bit 1 not ready), GENI_IOS (CTS pin level, bit 1,
+ * active low) and the four TLMM input levels (CTS gpio45, RFR gpio46, TX gpio47, RX gpio48).
+ */
+static void
+wl_flow_diag(const char *label)
+{
+	uint32_t pin[4];
+	for (unsigned i = 0; i < 4; i++) {
+		pin[i] = wl_rd(wl.tlmm, (45 + i) * 0x1000u + 4) & 1;
+	}
+	printf("SWEET BT: BT flow (%s) at %u ms: baud %u tx_trans_cfg %#x (CTS %s) rx_trans_cfg %#x manual_rfr %#x "
+	    "ios %#x (CTS pin %s) gpio in: CTS %u RFR %u TX %u RX %u, s_status %#x rx_fifo %#x\n", label,
+	    wl_ms(), wl.baud, wl_rd(wl.se, SE_UART_TX_TRANS_CFG),
+	    (wl_rd(wl.se, SE_UART_TX_TRANS_CFG) & UART_CTS_MASK) ? "ignored" : "honoured",
+	    wl_rd(wl.se, SE_UART_RX_TRANS_CFG), wl_rd(wl.se, SE_UART_MANUAL_RFR), wl_rd(wl.se, SE_GENI_IOS),
+	    (wl_rd(wl.se, SE_GENI_IOS) & 2) ? "high = controller not ready" : "low = controller ready", pin[0], pin[1],
+	    pin[2], pin[3], wl_rd(wl.se, SE_STATUS), wl_rd(wl.se, SE_RX_FIFO_STATUS));
+}
+
+/* geni_se_config_packing(8, 4, false, true, true) */
+static void
+wl_packing(void)
+{
+	uint32_t cfg[4] = { 0 };
+	for (int i = 0; i < 4; i++) {
+		cfg[i] = ((uint32_t)(i * 8) << 5) | (7u << 1);
+	}
+	cfg[3] |= 1u;                                 /* stop bit */
+	uint32_t c0 = cfg[0] | (cfg[1] << 10), c1 = cfg[2] | (cfg[3] << 10);
+	wl_wr(wl.se, SE_TX_PACKING0, c0);
+	wl_wr(wl.se, SE_TX_PACKING1, c1);
+	wl_wr(wl.se, SE_RX_PACKING0, c0);
+	wl_wr(wl.se, SE_RX_PACKING1, c1);
+	wl_wr(wl.se, SE_BYTE_GRAN, 0);
+}
+
+static bool
+wl_uart_open(void)
+{
+	uint32_t fw = wl_rd(wl.se, SE_FW_REV);
+	if (((fw >> 8) & 0xff) != SE_PROTO_UART) {
+		printf("SWEET BT: SE3 protocol is %u, not UART (QUP firmware not loaded for UART): stop\n",
+		    (fw >> 8) & 0xff);
+		return false;
+	}
+	if (wl_rd(wl.se, SE_STATUS) & ((1u << 0) | (1u << 12))) {
+		printf("SWEET BT: SE3 busy (status %#x): stop\n", wl_rd(wl.se, SE_STATUS));
+		return false;
+	}
+	/* qcom_geni_serial.c: sampling rate is halved for QUP hardware >= 2.5 */
+	wl.os = UART_OVERSAMPLING;
+	if (wl.wrap) {
+		uint32_t ver = wl_rd(wl.wrap, QUP_HW_VER_REG);
+		if (ver != 0 && ver != 0xffffffffu && ver >= QUP_SE_VERSION_2_5) {
+			wl.os = UART_OVERSAMPLING / 2;
+		}
+		printf("SWEET BT: QUP wrapper0 HW version %#x -> UART oversampling %u\n", ver, wl.os);
+	} else {
+		printf("SWEET BT: QUP wrapper0 not mapped: assuming UART oversampling %u\n", wl.os);
+	}
+	wl.tx_depth = (wl_rd(wl.se, SE_HW_PARAM_0) >> 16) & 0x3f;
+	wl.rx_depth = (wl_rd(wl.se, SE_HW_PARAM_1) >> 16) & 0x3f;
+	if (wl.tx_depth < 8 || wl.rx_depth < 8) {
+		printf("SWEET BT: odd FIFO depths tx %u rx %u (hw-param %#x/%#x): stop\n", wl.tx_depth,
+		    wl.rx_depth, wl_rd(wl.se, SE_HW_PARAM_0), wl_rd(wl.se, SE_HW_PARAM_1));
+		return false;
+	}
+	/* geni_se_io_init + io_set_mode + init */
+	wl_wr(wl.se, SE_CGC_CTRL, wl_rd(wl.se, SE_CGC_CTRL) | 0x7fu);
+	wl_wr(wl.se, SE_DMA_GENERAL_CFG, wl_rd(wl.se, SE_DMA_GENERAL_CFG) | 0xfu);
+	wl_wr(wl.se, SE_OUTPUT_CTRL, 0x7fu);
+	wl_wr(wl.se, SE_FORCE_DEFAULT, 1u);
+	wl_wr(wl.se, SE_GSI_EVENT_EN, 0);
+	wl_wr(wl.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	wl_wr(wl.se, SE_S_IRQ_CLEAR, 0xffffffffu);
+	wl_wr(wl.se, SE_DMA_TX_IRQ_CLR, 0xffffffffu);
+	wl_wr(wl.se, SE_DMA_RX_IRQ_CLR, 0xffffffffu);
+	/* geni_se_io_set_mode(): M/S GENI interrupts on, DMA TX/RX off (FIFO mode) */
+	wl_wr(wl.se, SE_IRQ_EN, (wl_rd(wl.se, SE_IRQ_EN) | GENI_M_IRQ_EN | GENI_S_IRQ_EN) &
+	    ~(DMA_TX_IRQ_EN | DMA_RX_IRQ_EN));
+	wl_wr(wl.se, SE_DMA_MODE_EN, wl_rd(wl.se, SE_DMA_MODE_EN) & ~1u);
+	wl_packing();
+	wl_wr(wl.se, SE_RX_WM, 2);
+	wl_wr(wl.se, SE_RX_RFR_WM, wl.rx_depth - 2);
+	wl_wr(wl.se, SE_UART_RX_STALE, 160);          /* DEFAULT_BITS_PER_CHAR * STALE_TIMEOUT */
+	wl_wr(wl.se, SE_UART_TX_WORD_LEN, 8);
+	wl_wr(wl.se, SE_UART_RX_WORD_LEN, 8);
+	wl_wr(wl.se, SE_UART_TX_STOP_LEN, 0);
+	wl_wr(wl.se, SE_UART_TX_PARITY, 0);
+	wl_wr(wl.se, SE_UART_RX_PARITY, 0);
+	wl_wr(wl.se, SE_UART_RX_TRANS_CFG, 0);
+	wl_wr(wl.se, SE_UART_TX_TRANS_CFG, UART_CTS_MASK);    /* flow control off */
+	wl_wr(wl.se, SE_UART_MANUAL_RFR, 0);
+	return true;
+}
+
+static void
+wl_rx_start(void)
+{
+	wl.rx_st = 0;
+	wl_wr(wl.se, SE_S_IRQ_CLEAR, 0xffffffffu);
+	wl_wr(wl.se, SE_S_CMD0, UART_START_READ << 27);
+}
+
+static void
+wl_rx_stop(void)
+{
+	if (wl_rd(wl.se, SE_STATUS) & (1u << 12)) {
+		wl_wr(wl.se, SE_S_CMD_CTRL, 1u << 2);     /* cancel */
+		for (unsigned i = 0; i < 2000 && (wl_rd(wl.se, SE_STATUS) & (1u << 12)); i++) {
+			delay(10);
+		}
+		if (wl_rd(wl.se, SE_STATUS) & (1u << 12)) {
+			wl_wr(wl.se, SE_S_CMD_CTRL, 1u << 1); /* abort */
+			for (unsigned i = 0; i < 2000 && (wl_rd(wl.se, SE_STATUS) & (1u << 12)); i++) {
+				delay(10);
+			}
+		}
+	}
+	wl_wr(wl.se, SE_S_IRQ_CLEAR, 0xffffffffu);
+}
+
+/*
+ * hci_qca.c in-band sleep (IBS): single bytes between H4 packets, 0xfe SLEEP_IND, 0xfd
+ * WAKE_IND, 0xfc WAKE_ACK. They are recognised only at a packet boundary (an event is
+ * 0x04, code, length, payload), acted on and kept out of wl.rxq. The ACK for a
+ * controller wake-up is sent later by wl_ibs_service(), never in the middle of a TX packet.
+ */
+#define IBS_SLEEP_IND   0xfeu
+#define IBS_WAKE_IND    0xfdu
+#define IBS_WAKE_ACK    0xfcu
+
+static void wl_xport_feed(uint8_t b);
+
+static void
+wl_rx_feed(uint8_t b)
+{
+	if (wl.xport) {
+		wl_xport_feed(b);
+		return;
+	}
+	if (wl.rx_st == 0 && b >= IBS_WAKE_ACK && b <= IBS_SLEEP_IND) {
+		const char *n = b == IBS_WAKE_ACK ? "WAKE_ACK" : b == IBS_WAKE_IND ? "WAKE_IND" : "SLEEP_IND";
+		if (b == IBS_SLEEP_IND) {
+			wl.ibs_asleep = true;
+			wl.ibs_sleeps++;
+		} else {
+			wl.ibs_asleep = false;
+			if (b == IBS_WAKE_IND) {
+				wl.ibs_ack_pending = true;
+			}
+		}
+		if (wl.ibs_logged < 16) {
+			wl.ibs_logged++;
+			printf("SWEET BT: BT IBS: RX %s (%#04x) at %u ms\n", n, b, wl_ms());
+		}
+		return;
+	}
+	if (wl.rxn < sizeof(wl.rxq)) {
+		wl.rxq[wl.rxn++] = b;
+	}
+	switch (wl.rx_st) {
+	case 0:
+		wl.rx_st = (b == 0x04) ? 1 : 0;         /* anything else: resync, like the event parsers do */
+		break;
+	case 1:
+		wl.rx_st = 2;
+		break;
+	case 2:
+		wl.rx_left = b;
+		wl.rx_st = b ? 3 : 0;
+		break;
+	default:
+		if (--wl.rx_left == 0) {
+			wl.rx_st = 0;
+		}
+		break;
+	}
+}
+
+/* drain the RX FIFO into wl.rxq */
+static void
+wl_rx_poll(void)
+{
+	/* qcom_geni_serial_isr(): ack RX events; a completed S command (stale/last) is re-armed */
+	uint32_t irq = wl_rd(wl.se, SE_S_IRQ_STATUS);
+	uint32_t st = wl_rd(wl.se, SE_RX_FIFO_STATUS);
+	if (irq & (S_CMD_DONE | S_RX_FIFO_RD_ERR | S_RX_FIFO_WR_ERR | S_RX_FIFO_WATERMARK | S_RX_FIFO_LAST)) {
+		if (irq & (S_RX_FIFO_RD_ERR | S_RX_FIFO_WR_ERR)) {
+			wl.xs_fifo_err++;
+			if (!wl.xport || wl.xs_fifo_err <= 8) {
+				printf("SWEET BT: UART RX FIFO error (s_irq %#x)\n", irq);
+			}
+		}
+		wl_wr(wl.se, SE_S_IRQ_CLEAR, irq);
+		if ((irq & S_CMD_DONE) && !(wl_rd(wl.se, SE_STATUS) & (1u << 12))) {
+			wl_wr(wl.se, SE_S_CMD0, UART_START_READ << 27);
+		}
+	}
+	uint32_t words = st & 0x1ffffffu;
+	wl.xs_polls++;
+	if (!words) {
+		return;
+	}
+	uint32_t bytes = 4 * (words - 1);
+	uint32_t lastv = (st >> 28) & 7;
+	bytes += ((st >> 31) && lastv) ? lastv : 4;
+	wl.xs_bytes += bytes;
+	if (bytes > wl.xs_maxburst) {
+		wl.xs_maxburst = bytes;
+	}
+	if (words > wl.xs_maxwords) {
+		wl.xs_maxwords = words;
+	}
+	uint8_t raw[32];
+	unsigned nraw = 0, total = bytes;
+	for (uint32_t w = 0; w < words; w++) {
+		uint32_t v = wl_rd(wl.se, SE_RX_FIFO);
+		for (unsigned k = 0; k < 4 && bytes; k++, bytes--) {
+			if (nraw < sizeof(raw)) {
+				raw[nraw++] = (uint8_t)(v >> (8 * k));
+			}
+			wl_rx_feed((uint8_t)(v >> (8 * k)));
+		}
+	}
+	if (wl.raw_budget) {
+		/* every RX batch as it came off the wire (IBS bytes included), until the budget is used up */
+		char line[3 * 32 + 1];
+		unsigned o = 0;
+		wl.raw_budget--;
+		for (unsigned i = 0; i < nraw; i++) {
+			o += (unsigned)snprintf(line + o, sizeof(line) - o, "%02x ", raw[i]);
+		}
+		printf("SWEET BT: BT RX raw at %u ms (%u bytes, baud %u): %s\n", wl_ms(), total, wl.baud, line);
+	}
+}
+
+static bool
+wl_tx(const uint8_t *buf, unsigned len, unsigned baud)
+{
+	if (len == 0 || len > 4u * (wl.tx_depth - 2)) {
+		return false;
+	}
+	for (unsigned i = 0; i < 1000 && (wl_rd(wl.se, SE_STATUS) & 1u); i++) {
+		delay(10);
+	}
+	wl_wr(wl.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	wl_wr(wl.se, SE_TX_WM, 2);
+	wl_wr(wl.se, SE_UART_TX_TRANS_LEN, len);
+	wl_wr(wl.se, SE_M_CMD0, UART_START_TX << 27);
+	for (unsigned i = 0; i < len; i += 4) {
+		uint32_t w = 0;
+		for (unsigned k = 0; k < 4 && i + k < len; k++) {
+			w |= (uint32_t)buf[i + k] << (8 * k);
+		}
+		wl_wr(wl.se, SE_TX_FIFO, w);
+	}
+	/* 12 bit times per byte plus 50 ms; flow control may hold the transmitter */
+	uint64_t us = ((uint64_t)len * 12 * 1000000ull) / baud + 50000 + wl.tx_extra_us;
+	bool done = false;
+	for (uint64_t t = 0; t < us; t += 20) {
+		if (wl_rd(wl.se, SE_M_IRQ_STATUS) & M_CMD_DONE) {
+			done = true;
+			break;
+		}
+		delay(20);
+	}
+	if (!done) {
+		wl_wr(wl.se, SE_M_CMD_CTRL, 1u << 1);     /* abort */
+		for (unsigned i = 0; i < 1000 && !(wl_rd(wl.se, SE_M_IRQ_STATUS) & M_CMD_ABORT); i++) {
+			delay(10);
+		}
+		wl_wr(wl.se, SE_M_IRQ_CLEAR, M_CMD_ABORT);
+		printf("SWEET BT: UART TX of %u bytes timed out (aborted)\n", len);
+		return false;
+	}
+	wl_wr(wl.se, SE_M_IRQ_CLEAR, M_CMD_DONE);
+	return true;
+}
+
+static void
+wl_power_pulse(bool on, unsigned baud)
+{
+	uint8_t b = on ? QCA_POWER_ON_PULSE : QCA_POWER_OFF_PULSE;
+	wl_rx_stop();
+	wl_flow(false);
+	(void)wl_tx(&b, 1, baud);
+	wl_sleep(on ? 100 : 10);
+	wl_rx_start();
+	wl.rxn = 0;
+}
+
+static void
+wl_print_hex(const char *what, const uint8_t *b, unsigned n)
+{
+	char line[3 * 48 + 1];
+	unsigned o = 0;
+	for (unsigned i = 0; i < n && o + 3 < sizeof(line); i++) {
+		o += (unsigned)snprintf(line + o, sizeof(line) - o, "%02x ", b[i]);
+	}
+	printf("SWEET BT: HCI %s: %s\n", what, line);
+}
+
+/* ---------------------------------------------------------------- HCI transport */
+
+#define WL_EVT_CC       1u      /* Command Complete / Command Status for the opcode */
+#define WL_EVT_VSE      2u      /* vendor specific event (0xff) */
+
+static uint8_t wl_pkt[4 + 255];
+
+/* drop the first n bytes of the RX queue */
+static void
+wl_rxq_drop(unsigned n)
+{
+	if (n >= wl.rxn) {
+		wl.rxn = 0;
+		return;
+	}
+	memmove(wl.rxq, wl.rxq + n, wl.rxn - n);
+	wl.rxn -= n;
+}
+
+/* the controller woke up on its own (0xfd): acknowledge it with 0xfc, between packets only */
+static void
+wl_ibs_service(void)
+{
+	if (wl.ibs_ack_pending) {
+		uint8_t b = IBS_WAKE_ACK;
+		wl.ibs_ack_pending = false;
+		(void)wl_tx(&b, 1, wl.baud ? wl.baud : 115200);
+		if (wl.ibs_logged < 16) {
+			wl.ibs_logged++;
+			printf("SWEET BT: BT IBS: TX WAKE_ACK (0xfc)\n");
+		}
+	}
+}
+
+/*
+ * host side (qca_enqueue + the tx_wait_timer of hci_qca.c): before a packet, wake a sleeping
+ * controller with 0xfd and wait for 0xfc (or the controller's own 0xfd) - 100 ms per attempt,
+ * up to 3 attempts, each one logged. A controller WAKE_IND while we wait counts as the answer
+ * (it is acknowledged by wl_ibs_service()).
+ */
+static void
+wl_ibs_wake(void)
+{
+	/* transport mode wakes the controller often: only the first 24 handshakes are logged */
+	bool v = !wl.xport || wl.ibs_xlog < 24;
+	if (!wl.ibs_asleep) {
+		return;
+	}
+	if (wl.xport) {
+		wl.ibs_xlog++;
+		wl.xs_ibs_wake++;
+	}
+	for (unsigned attempt = 1; attempt <= 3 && wl.ibs_asleep; attempt++) {
+		uint8_t b = IBS_WAKE_IND;
+		if (v) {
+			printf("SWEET BT: BT IBS: controller asleep, TX WAKE_IND (0xfd) attempt %u/3 at %u ms\n", attempt, wl_ms());
+		}
+		(void)wl_tx(&b, 1, wl.baud ? wl.baud : 115200);
+		for (unsigned t = 0; t < 100 && wl.ibs_asleep; t++) {
+			wl_rx_poll();
+			if (wl.ibs_asleep) {
+				delay(1000);
+			}
+		}
+		if (v) {
+			printf("SWEET BT: BT IBS: attempt %u: %s at %u ms\n", attempt, wl.ibs_asleep ? "no WAKE_ACK" :
+			    "WAKE_ACK/WAKE_IND received", wl_ms());
+		}
+	}
+	if (wl.ibs_asleep) {
+		wl.xs_ibs_wake_fail++;
+		printf("SWEET BT: BT IBS: no answer to 3 wake attempts, sending anyway\n");
+		wl.ibs_asleep = false;
+	}
+	wl_ibs_service();
+}
+
+/* TX of any length: split into pieces the FIFO accepts, keep the RX FIFO drained in between */
+static bool
+wl_tx_buf(const uint8_t *buf, unsigned len)
+{
+	unsigned chunk = 4u * (wl.tx_depth - 2);
+	while (len) {
+		unsigned n = MIN(len, chunk);
+		if (!wl_tx(buf, n, wl.baud ? wl.baud : 115200)) {
+			return false;
+		}
+		buf += n;
+		len -= n;
+		wl_rx_poll();
+	}
+	return true;
+}
+
+/* H4 command packet out, nothing waited for and the RX queue untouched */
+static bool
+wl_hci_send(uint16_t opcode, const uint8_t *params, unsigned plen)
+{
+	if (plen > 255) {
+		return false;
+	}
+	wl_ibs_service();
+	if (!wl.bt_nowake) {
+		wl_ibs_wake();
+	}
+	wl_pkt[0] = 0x01;
+	wl_pkt[1] = (uint8_t)opcode;
+	wl_pkt[2] = (uint8_t)(opcode >> 8);
+	wl_pkt[3] = (uint8_t)plen;
+	if (plen) {
+		memcpy(wl_pkt + 4, params, plen);
+	}
+	return wl_tx_buf(wl_pkt, 4 + plen);
+}
+
+/* does a run of unmatched bytes look like an HCI event with a damaged bit pattern? */
+static void
+wl_garbage_hint(const uint8_t *b, unsigned n)
+{
+	char a[3 * 16 + 1], r[3 * 16 + 1];
+	unsigned oa = 0, or = 0;
+	for (unsigned i = 0; i < n && i < 16; i++) {
+		uint8_t rev = 0;
+		for (unsigned k = 0; k < 8; k++) {
+			rev |= (uint8_t)(((b[i] >> k) & 1) << (7 - k));
+		}
+		oa += (unsigned)snprintf(a + oa, sizeof(a) - oa, "%02x ", b[i] & 0x7f);
+		or += (unsigned)snprintf(r + or, sizeof(r) - or, "%02x ", rev);
+	}
+	printf("SWEET BT: BT RX garbage hint (an event would start 04 xx len): MSB cleared: %s| bit reversed: %s\n", a, r);
+}
+
+/*
+ * Wait for one event of the wanted kind. The event and every byte before it are
+ * removed from the RX queue; rsp = event code, parameter length, parameters
+ * (at most 48 bytes).
+ */
+static int
+wl_hci_wait(uint16_t opcode, unsigned want, uint8_t *rsp, unsigned *rlen, unsigned timeout_ms)
+{
+	for (unsigned t = 0; t < timeout_ms; t++) {
+		wl_rx_poll();
+		wl_ibs_service();
+		unsigned pos = 0;
+		while (pos < wl.rxn) {
+			if (wl.rxq[pos] != 0x04) {
+				pos++;                      /* not an event: resync */
+				continue;
+			}
+			if (pos + 3 > wl.rxn) {
+				break;
+			}
+			unsigned elen = wl.rxq[pos + 2];
+			if (pos + 3 + elen > wl.rxn) {
+				break;
+			}
+			uint8_t evt = wl.rxq[pos + 1];
+			const uint8_t *d = &wl.rxq[pos + 3];
+			bool match = ((want & WL_EVT_CC) &&
+			    ((evt == 0x0e && elen >= 3 && (d[1] | (d[2] << 8)) == opcode) ||
+			    (evt == 0x0f && elen >= 4 && (d[2] | (d[3] << 8)) == opcode))) ||
+			    ((want & WL_EVT_VSE) && evt == 0xff);
+			if (match) {
+				*rlen = MIN(elen + 2, 48u);
+				rsp[0] = evt;
+				rsp[1] = (uint8_t)elen;
+				memcpy(rsp + 2, d, *rlen - 2);
+				wl_rxq_drop(pos + 3 + elen);
+				return 0;
+			}
+			pos += 3 + elen;
+		}
+		delay(1000);
+	}
+	if (wl.rxn) {
+		wl_print_hex("(unmatched RX bytes at timeout)", wl.rxq, MIN(wl.rxn, 48u));
+		wl_garbage_hint(wl.rxq, MIN(wl.rxn, 16u));
+	}
+	return ETIMEDOUT;
+}
+
+/* One HCI command; prints and returns the first matching event in rsp. */
+static int
+wl_hci_cmd(uint16_t opcode, const uint8_t *params, unsigned plen, uint8_t *rsp, unsigned *rlen,
+    unsigned timeout_ms)
+{
+	unsigned want = WL_EVT_CC | ((opcode >> 10) == 0x3f ? WL_EVT_VSE : 0);
+	int err = ETIMEDOUT;
+	/*
+	 * A controller that goes to sleep (SLEEP_IND) after taking our packet, or while we sent it,
+	 * may have dropped it: when no reply comes and it is asleep, wake it (wl_hci_send does that)
+	 * and send the command again, up to 3 sends in total. Otherwise keep waiting.
+	 */
+	for (unsigned attempt = 1; attempt <= 3; attempt++) {
+		unsigned sleeps = wl.ibs_sleeps;
+		wl.rxn = 0;
+		if (!wl_hci_send(opcode, params, plen)) {
+			return EIO;
+		}
+		if (attempt == 3) {
+			return wl_hci_wait(opcode, want, rsp, rlen, timeout_ms);
+		}
+		err = wl_hci_wait(opcode, want, rsp, rlen, MIN(timeout_ms, 500u));
+		if (!err) {
+			return 0;
+		}
+		if (!wl.ibs_asleep && wl.ibs_sleeps == sleeps) {
+			return wl_hci_wait(opcode, want, rsp, rlen, timeout_ms > 500 ? timeout_ms - 500 : 1);
+		}
+		printf("SWEET BT: BT IBS: no reply to command %#06x (send %u/3) and the controller went to sleep "
+		    "(%u SLEEP_IND, asleep %d) at %u ms: wake and resend\n", opcode, attempt, wl.ibs_sleeps - sleeps,
+		    wl.ibs_asleep, wl_ms());
+	}
+	return err;
+}
+
+/* consume every complete event already queued; false when one reports an error */
+static bool
+wl_evt_drain(const char *ctx)
+{
+	bool ok = true;
+	unsigned pos = 0;
+	wl_rx_poll();
+	wl_ibs_service();
+	while (pos < wl.rxn) {
+		if (wl.rxq[pos] != 0x04) {
+			pos++;
+			continue;
+		}
+		if (pos + 3 > wl.rxn) {
+			break;
+		}
+		unsigned elen = wl.rxq[pos + 2];
+		if (pos + 3 + elen > wl.rxn) {
+			break;
+		}
+		uint8_t evt = wl.rxq[pos + 1];
+		const uint8_t *d = &wl.rxq[pos + 3];
+		if (evt == 0x0e && elen >= 4) {
+			if (d[3] != 0) {
+				printf("SWEET BT: BT fw %s: Command Complete for %#06x status %#x\n", ctx,
+				    d[1] | (d[2] << 8), d[3]);
+				ok = false;
+			} else {
+				wl.ev_cc++;
+			}
+		} else if (evt == 0xff && elen >= 3 && d[0] == 0 && d[1] == 4 && d[2] != 0) {
+			printf("SWEET BT: BT fw %s: TLV download vendor event status %#x\n", ctx, d[2]);
+			ok = false;
+		} else {
+			wl.ev_other++;
+			if (wl.ev_other <= 8) {
+				wl_print_hex("BT fw event during download", &wl.rxq[pos], 3 + elen);
+			}
+		}
+		pos += 3 + elen;
+	}
+	wl_rxq_drop(pos);
+	return ok;
+}
+
+/* ---------------------------------------------------------------- QCA WCN3990 setup */
+/* drivers/bluetooth/btqca.[ch] + hci_qca.c qca_setup(), no IBS */
+
+#define QCA_EDL_PATCH_CMD_OPCODE        0xfc00u
+#define QCA_EDL_PATCH_VER_REQ_CMD       0x19u
+#define QCA_EDL_PATCH_TLV_REQ_CMD       0x1eu
+#define QCA_EDL_SET_BAUDRATE_OPCODE     0xfc48u
+#define QCA_MAX_SIZE_PER_TLV_SEGMENT    243u
+#define QCA_EDL_CMD_REQ_RES_EVT         0x00u
+#define QCA_EDL_APP_VER_RES_EVT         0x02u
+#define QCA_EDL_TVL_DNLD_RES_EVT        0x04u
+#define QCA_EDL_TAG_ID_HCI              17u
+#define QCA_EDL_TAG_ID_DEEP_SLEEP       27u
+#define QCA_TLV_TYPE_PATCH              1u
+#define QCA_WCN3991_SOC_ID              0x40014320u
+#define WL_BT_FW_PATCH                  "crbtfw21.tlv"  /* fallback names (Android's, rom 2.1) */
+#define WL_BT_FW_NVM                    "crnv21.bin"
+
+
+struct wl_qca_ver {
+	uint32_t product_id, soc_id, soc_ver;
+	uint16_t patch_ver, rom_ver;
+	unsigned rom;                   /* get rom_ver of qca_uart_setup(): the 21 in crbtfw21 */
+};
+
+/* qca_read_soc_version(): EDL_PATCH_VER_REQ_CMD, struct qca_btsoc_version in the vendor event */
+static bool
+wl_qca_read_version(struct wl_qca_ver *v, const char *label)
+{
+	static const uint8_t req[1] = { QCA_EDL_PATCH_VER_REQ_CMD };
+	uint8_t rsp[48];
+	unsigned rlen = 0;
+	int err = wl_hci_cmd(QCA_EDL_PATCH_CMD_OPCODE, req, 1, rsp, &rlen, 1000);
+	if (err) {
+		printf("SWEET BT: QCA %s: no event (%d)\n", label, err);
+		return false;
+	}
+	wl_print_hex(label, rsp, rlen);
+	/* rsp: evt, len, edl.cresp, edl.rtype, product_id le32, patch_ver le16, rom_ver le16, soc_id le32 */
+	if (rsp[0] != 0xff || rlen < 16 || rsp[2] != QCA_EDL_CMD_REQ_RES_EVT || rsp[3] != QCA_EDL_APP_VER_RES_EVT) {
+		printf("SWEET BT: QCA %s: not a version response\n", label);
+		return false;
+	}
+	v->product_id = le32(rsp + 4);
+	v->patch_ver = le16(rsp + 8);
+	v->rom_ver = le16(rsp + 10);
+	v->soc_id = le32(rsp + 12);
+	/* btqca.c: upper 2 bytes from the SoC id, lower 2 bytes the ROM version */
+	v->soc_ver = (v->soc_id << 16) | v->rom_ver;
+	/* qca_uart_setup(): rom_ver = ((soc_ver & 0x0f00) >> 4) | (soc_ver & 0x0f) */
+	v->rom = ((v->soc_ver & 0x00000f00u) >> 4) | (v->soc_ver & 0x0000000fu);
+	printf("SWEET BT: BT fw QCA %s: product ID %#010x, patch version %#06x, ROM version %#06x, SoC ID %#010x "
+	    "-> soc_ver %#010x, rom_ver %#04x\n", label, v->product_id, v->patch_ver, v->rom_ver, v->soc_id,
+	    v->soc_ver, v->rom);
+	return true;
+}
+
+/* enum qca_baudrate of btqca.h */
+static int
+wl_qca_baud_code(unsigned baud)
+{
+	switch (baud) {
+	case 115200:  return 0;
+	case 230400:  return 5;
+	case 460800:  return 7;
+	case 921600:  return 10;
+	case 1000000: return 11;
+	case 2000000: return 13;
+	case 3000000: return 14;
+	case 3200000: return 17;
+	default:      return -1;
+	}
+}
+
+/* HCI Read Local Version at the current baud, decoded; Read_Local_Version_Information */
+static bool
+wl_hci_read_local_version(const char *label)
+{
+	uint8_t rsp[48];
+	unsigned rlen = 0;
+	int err = wl_hci_cmd(0x1001, NULL, 0, rsp, &rlen, 1000);
+	if (err) {
+		printf("SWEET BT: HCI Read Local Version (%s): no event (%d)\n", label, err);
+		return false;
+	}
+	wl_print_hex(label, rsp, rlen);
+	if (rsp[0] != 0x0e || rlen < 14 || rsp[5] != 0) {
+		printf("SWEET BT: HCI Read Local Version (%s): bad reply\n", label);
+		return false;
+	}
+	printf("SWEET BT: HCI Read Local Version (%s): HCI version %u revision %#06x, LMP version %u, "
+	    "manufacturer %#06x, LMP subversion %#06x\n", label, rsp[6], le16(rsp + 7), rsp[9], le16(rsp + 10),
+	    le16(rsp + 12));
+	return true;
+}
+
+/*
+ * hci_qca.c qca_set_speed() for WCN399x: flow control off, EDL_SET_BAUDRATE_CMD
+ * (vendor 0xfc48, one byte qca_baudrate) goes out at the old speed without waiting,
+ * 10 ms for the controller, switch the host UART, flow control on, then the
+ * controller's vendor event arrives at the new speed (Linux drops it). Verified
+ * here with HCI Read Local Version at the new rate.
+ */
+static bool
+wl_qca_set_baud(unsigned baud)
+{
+	uint8_t rsp[48];
+	unsigned rlen = 0, old = wl.baud;
+	unsigned div = 0;
+	int code = wl_qca_baud_code(baud);
+	if (code < 0 || wl_pick_row(baud, &div) < 0) {
+		printf("SWEET BT: BT fw: %u baud not usable (QCA code %d, S3 row %d)\n", baud, code,
+		    wl_pick_row(baud, &div));
+		return false;
+	}
+	printf("SWEET BT: BT fw: EDL_SET_BAUDRATE_CMD %#06x code %#x (%u baud), host %u -> %u baud\n",
+	    QCA_EDL_SET_BAUDRATE_OPCODE, code, baud, old, baud);
+	wl_flow(false);
+	wl.rxn = 0;
+	uint8_t c = (uint8_t)code;
+	if (!wl_hci_send(QCA_EDL_SET_BAUDRATE_OPCODE, &c, 1)) {
+		printf("SWEET BT: BT fw: baud command TX failed\n");
+		return false;
+	}
+	wl_sleep(10);
+	if (!wl_baud(baud)) {
+		printf("SWEET BT: BT fw: host UART could not switch to %u baud\n", baud);
+		return false;
+	}
+	wl.rxn = 0;
+	wl_rx_start();
+	if (wl_hci_wait(QCA_EDL_SET_BAUDRATE_OPCODE, WL_EVT_CC | WL_EVT_VSE, rsp, &rlen, 100) == 0) {
+		wl_print_hex("baud change event at the new rate", rsp, rlen);
+	} else {
+		printf("SWEET BT: BT fw: no baud change event at %u baud (Linux drops it anyway)\n", baud);
+	}
+	wl_flow(true);
+	if (!wl_hci_read_local_version("at new baud")) {
+		printf("SWEET BT: BT fw: controller does not answer at %u baud\n", baud);
+		return false;
+	}
+	printf("SWEET BT: BT fw: controller answers at %u baud\n", baud);
+	return true;
+}
+
+/* qca_tlv_check_data(), TLV_TYPE_PATCH: log the header, return download_mode */
+static bool
+wl_qca_patch_check(const uint8_t *fw, size_t size, unsigned *mode)
+{
+	if (size < 28) {
+		printf("SWEET BT: BT fw patch: only %u bytes\n", (unsigned)size);
+		return false;
+	}
+	uint32_t type_len = le32(fw);
+	if ((type_len & 0xff) != QCA_TLV_TYPE_PATCH) {
+		printf("SWEET BT: BT fw patch: TLV type %#x is not a patch (1)\n", type_len & 0xff);
+		return false;
+	}
+	/* tlv_type_hdr {type_len} + tlv_type_patch {total_size, data_length, format_version, signature,
+	 * download_mode, reserved1, product_id, rom_build, patch_version, reserved2, entry} */
+	printf("SWEET BT: BT fw patch: TLV type %u length %u (file %u), total_size %u, data_length %u, "
+	    "format %u, signature %u, download_mode %u, product %#06x, rom_build %#06x, patch_version %#06x, "
+	    "entry %#x\n", type_len & 0xff, type_len >> 8, (unsigned)size, le32(fw + 4), le32(fw + 8), fw[12], fw[13], fw[14],
+	    le16(fw + 16), le16(fw + 18), le16(fw + 20), le32(fw + 24));
+	if ((type_len >> 8) != size - 4) {
+		printf("SWEET BT: BT fw patch: note: TLV length %u != file size - 4\n", type_len >> 8);
+	}
+	*mode = fw[14] <= 3 ? fw[14] : 0;
+	return true;
+}
+
+struct wl_nvm_scan {
+	unsigned start, ntags, idx17, idx27, stop_idx, stop_tag;
+};
+
+/* walk tlv_type_nvm entries {tag_id, tag_len, reserve1, reserve2, data[tag_len]} from start */
+static void
+wl_nvm_scan_at(const uint8_t *d, size_t limit, unsigned start, struct wl_nvm_scan *s)
+{
+	unsigned idx = start, prev = 0;
+	memset(s, 0, sizeof(*s));
+	s->start = start;
+	while (idx + 12 <= limit) {
+		unsigned id = le16(d + idx), len = le16(d + idx + 2);
+		if (id == 0 || id > 0x400 || id <= prev || idx + 12 + len > limit) {
+			s->stop_tag = id;
+			break;
+		}
+		if (id == QCA_EDL_TAG_ID_HCI) {
+			s->idx17 = idx;
+		} else if (id == QCA_EDL_TAG_ID_DEEP_SLEEP) {
+			s->idx27 = idx;
+		}
+		s->ntags++;
+		prev = id;
+		idx += 12 + len;
+	}
+	s->stop_idx = idx;
+}
+
+/*
+ * qca_tlv_check_data(), TLV_TYPE_NVM: HCI transport tag (17): data[0] |= 0x80
+ * (software in-band sleep), UART baud rate code in data[2] on WCN3990 (data[1] only
+ * on WCN3991 and later: btqca.c 'soc_type >= QCA_WCN3991'); deep sleep
+ * tag (27): data[0] |= 0x01. Linux enables both because it runs IBS; this stage
+ * has no IBS (a sleeping controller would need the 0xfd/0xfc/0xfe protocol), so
+ * unless sweetbtibs=1 the two bits are cleared instead.
+ */
+static bool
+wl_qca_nvm_edit(uint8_t *fw, size_t size, int baud_code)
+{
+	if (size < 16) {
+		printf("SWEET BT: BT fw NVM: only %u bytes\n", (unsigned)size);
+		return false;
+	}
+	uint32_t type_len = le32(fw);
+	size_t limit = MIN(size, (size_t)4 + (type_len >> 8));
+	printf("SWEET BT: BT fw NVM: TLV type %u length %u (file %u)\n", type_len & 0xff, type_len >> 8, (unsigned)size);
+	struct wl_nvm_scan a, b;
+	wl_nvm_scan_at(fw, limit, 4, &a);       /* Linux: tlv->data */
+	wl_nvm_scan_at(fw, limit, 8, &b);       /* some images carry one more header word */
+	const struct wl_nvm_scan *s = b.ntags > a.ntags ? &b : &a;
+	if (s->start != 4) {
+		printf("SWEET BT: BT fw NVM: tags start at offset %u (extra header word %#010x), not at 4 as "
+		    "in Linux's struct tlv_type_hdr\n", s->start, le32(fw + 4));
+	}
+	printf("SWEET BT: BT fw NVM: %u tags from offset %u, stopped at %u (tag id %#x); HCI tag 17 at %u, "
+	    "deep sleep tag 27 at %u\n", s->ntags, s->start, s->stop_idx, s->stop_tag, s->idx17, s->idx27);
+	if (s->ntags < 3) {
+		printf("SWEET BT: BT fw NVM: tag layout not recognised, NVM sent unmodified\n");
+		return true;
+	}
+	if (s->idx17 && le16(fw + s->idx17 + 2) >= 3) {
+		/*
+		 * WCN3990: the baud code is data[2]; data[1] is another UART
+		 * setting (0x01 in both Android's and linux-firmware's crnv21).
+		 * Writing the baud into data[1] (0118-0132) garbled every event
+		 * after the NVM took effect ('84 08 81 20 08' for a reset reply).
+		 */
+		uint8_t *t = fw + s->idx17 + 12;
+		uint8_t old0 = t[0], old1 = t[1], old2 = t[2];
+		t[0] = wl.bt_ibs ? (t[0] | 0x80) : (t[0] & ~0x80);
+		t[2] = (uint8_t)baud_code;
+		printf("SWEET BT: BT fw NVM: HCI tag: data[0] %#04x -> %#04x (IBS %s), data[1] %#04x kept, "
+		    "data[2] (baud) %#04x -> %#04x\n", old0, t[0], wl.bt_ibs ? "on" : "off", old1, old2, t[2]);
+	} else {
+		printf("SWEET BT: BT fw NVM: no HCI tag 17, baud not patched\n");
+	}
+	if (s->idx27 && le16(fw + s->idx27 + 2) >= 1) {
+		uint8_t *t = fw + s->idx27 + 12;
+		uint8_t old0 = t[0];
+		t[0] = wl.bt_ibs ? (t[0] | 0x01) : (t[0] & ~0x01);
+		printf("SWEET BT: BT fw NVM: deep sleep tag: data[0] %#04x -> %#04x (deep sleep %s)\n", old0, t[0],
+		    wl.bt_ibs ? "on" : "off");
+	} else {
+		printf("SWEET BT: BT fw NVM: no deep sleep tag 27\n");
+	}
+	return true;
+}
+
+/*
+ * qca_download_firmware() + qca_tlv_send_segment(): the whole TLV file (header
+ * included) goes out in vendor 0xfc00 commands {0x1e, len, data[len]}, 243 bytes
+ * per segment. download_mode (patch header; NVM is always 0): bit 0 = no vendor
+ * event for the segment, bit 1 = no command complete. WCN399x patches say 3: only
+ * the last segment (or any short one) is acknowledged, by the vendor event
+ * {cresp 0, rtype 4, result}; mode 1 waits for the command complete instead.
+ */
+static bool
+wl_qca_send_tlv(const char *what, const uint8_t *fw, size_t size, unsigned mode)
+{
+	unsigned total = (unsigned)((size + QCA_MAX_SIZE_PER_TLV_SEGMENT - 1) / QCA_MAX_SIZE_PER_TLV_SEGMENT);
+	unsigned seg = 0, next_pct = 10;
+	size_t off = 0;
+	bool cc_wait = (mode == 1);
+	uint8_t cmd[QCA_MAX_SIZE_PER_TLV_SEGMENT + 2], rsp[48];
+	unsigned rlen;
+
+	wl.rxn = 0;
+	wl.ev_cc = wl.ev_other = 0;
+	wl.tx_extra_us = 500000;
+	printf("SWEET BT: BT fw %s: %u bytes in %u segments of %u, download_mode %u (%s)\n", what, (unsigned)size, total,
+	    QCA_MAX_SIZE_PER_TLV_SEGMENT, mode, mode == 3 ? "only the last segment is acknowledged" :
+	    mode == 1 ? "command complete per segment" : "vendor event per segment");
+	while (off < size) {
+		unsigned n = (unsigned)MIN(size - off, (size_t)QCA_MAX_SIZE_PER_TLV_SEGMENT);
+		bool last = (off + n >= size) || n < QCA_MAX_SIZE_PER_TLV_SEGMENT;
+		unsigned m = last ? 0 : mode;   /* "the last segment is always acked regardless of download mode" */
+		cmd[0] = QCA_EDL_PATCH_TLV_REQ_CMD;
+		cmd[1] = (uint8_t)n;
+		memcpy(cmd + 2, fw + off, n);
+		if (!wl_hci_send(QCA_EDL_PATCH_CMD_OPCODE, cmd, n + 2)) {
+			printf("SWEET BT: BT fw %s: segment %u/%u: TX failed\n", what, seg + 1, total);
+			goto fail;
+		}
+		if (m == 0 || m == 2) {
+			if (wl_hci_wait(QCA_EDL_PATCH_CMD_OPCODE, WL_EVT_VSE, rsp, &rlen, last ? 10000 : 2000)) {
+				printf("SWEET BT: BT fw %s: segment %u/%u: no vendor event\n", what, seg + 1, total);
+				goto fail;
+			}
+			if (rlen < 5 || rsp[2] != QCA_EDL_CMD_REQ_RES_EVT || rsp[3] != QCA_EDL_TVL_DNLD_RES_EVT ||
+			    rsp[4] != 0) {
+				printf("SWEET BT: BT fw %s: segment %u/%u: TLV with invalid response or error status\n",
+				    what, seg + 1, total);
+				wl_print_hex("segment vendor event", rsp, rlen);
+				goto fail;
+			}
+		} else if (m == 1 && cc_wait) {
+			if (wl_hci_wait(QCA_EDL_PATCH_CMD_OPCODE, WL_EVT_CC, rsp, &rlen, 100)) {
+				printf("SWEET BT: BT fw %s: segment %u/%u: no command complete, not waiting for them "
+				    "any more\n", what, seg + 1, total);
+				cc_wait = false;
+			} else if (rsp[0] == 0x0e && rlen >= 6 && rsp[5] != 0) {
+				printf("SWEET BT: BT fw %s: segment %u/%u: command complete status %#x\n", what,
+				    seg + 1, total, rsp[5]);
+				goto fail;
+			}
+		}
+		if (!wl_evt_drain(what)) {
+			printf("SWEET BT: BT fw %s: segment %u/%u: controller reported an error\n", what, seg + 1, total);
+			goto fail;
+		}
+		off += n;
+		seg++;
+		while (next_pct <= 100 && (uint64_t)seg * 100 >= (uint64_t)total * next_pct) {
+			printf("SWEET BT: BT fw %s: segment %u/%u (%u%%), %u/%u bytes\n", what, seg, total, next_pct,
+			    (unsigned)off, (unsigned)size);
+			next_pct += 10;
+		}
+	}
+	wl.tx_extra_us = 0;
+	printf("SWEET BT: BT fw %s: download complete, last segment acknowledged (%u command complete, %u other "
+	    "events along the way)\n", what, wl.ev_cc, wl.ev_other);
+	return true;
+fail:
+	wl.tx_extra_us = 0;
+	printf("SWEET BT: BT fw %s: download FAILED after %u/%u segments (%u/%u bytes)\n", what, seg, total, (unsigned)off,
+	    (unsigned)size);
+	return false;
+}
+
+/* Linux name first, then Android's file names */
+static bool
+wl_qca_fw_load(const char *name, const char *fallback, void **buf, size_t *len)
+{
+	if (sweet_bt_fw_get(name, buf, len)) {
+		printf("SWEET BT: BT fw: loaded %s (%u bytes)\n", name, (unsigned)*len);
+		return true;
+	}
+	if (strcmp(name, fallback) == 0) {
+		printf("SWEET BT: BT fw: %s not in the ADT (/arm-io/bluetooth fw-<name>)\n", name);
+		return false;
+	}
+	printf("SWEET BT: BT fw: %s not found, falling back to %s\n", name, fallback);
+	if (sweet_bt_fw_get(fallback, buf, len)) {
+		printf("SWEET BT: BT fw: loaded %s (%u bytes)\n", fallback, (unsigned)*len);
+		return true;
+	}
+	printf("SWEET BT: BT fw: %s not found either\n", fallback);
+	return false;
+}
+
+/*
+ * First command after the NVM. Linux (qca_uart_setup) sends HCI Reset (10 s timeout) right away, with
+ * QCA_IBS_DISABLED set so the host ignores IBS entirely during setup (no wake handshake, SLEEP_IND from the
+ * controller is only noted). Here: sweetbtnowake=1 (default) does the same; with sweetbtprobe=1 (default)
+ * a silent controller is probed further: for the current baud and then 115200, 3200000 and 921600 (the speed
+ * the controller may have fallen back to or switched to when the NVM applied) the Reset is tried directly
+ * and again after an explicit 0xfd wake handshake, 1.5 s each, with the raw RX bytes (sweetbtraw budget)
+ * and the flow control state logged for every step.
+ */
+static int
+wl_bt_post_nvm_reset(uint8_t *rsp, unsigned *rlen)
+{
+	static const unsigned cand[] = { 0, 115200, 3200000, 921600 };
+	unsigned first = wl.baud, div;
+	int err = ETIMEDOUT;
+
+	wl_flow_diag("after NVM");
+	if (wl.bt_rfr) {
+		wl_wr(wl.se, SE_UART_MANUAL_RFR, (1u << 31) | 1u);      /* RFR forced ready */
+		printf("SWEET BT: BT flow: RFR forced ready (sweetbtrfr=1)\n");
+		wl_flow_diag("RFR forced");
+	}
+	if (!wl.bt_probe) {
+		return wl_hci_cmd(0x0c03, NULL, 0, rsp, rlen, 10000);   /* qca_send_reset */
+	}
+	for (unsigned i = 0; i < sizeof(cand) / sizeof(cand[0]); i++) {
+		unsigned baud = cand[i] ? cand[i] : first;
+		if (i > 0 && baud == first) {
+			continue;
+		}
+		if (baud != wl.baud) {
+			if (wl_pick_row(baud, &div) < 0 || !wl_baud(baud)) {
+				printf("SWEET BT: BT probe: cannot run the UART at %u baud, skipped\n", baud);
+				continue;
+			}
+			wl.rxn = 0;
+			wl_rx_start();
+		}
+		for (unsigned wake = 0; wake < 2; wake++) {
+			wl.raw_budget = 16;
+			wl.rxn = 0;
+			wl_flow_diag(wake ? "probe, before wake" : "probe, before reset");
+			printf("SWEET BT: BT probe: HCI Reset at %u baud, %s at %u ms\n", baud,
+			    wake ? "after a 0xfd wake handshake" : "sent directly", wl_ms());
+			if (wake) {
+				wl.ibs_asleep = true;
+				wl_ibs_wake();
+			}
+			if (!wl_hci_send(0x0c03, NULL, 0)) {
+				printf("SWEET BT: BT probe: Reset TX failed\n");
+				continue;
+			}
+			err = wl_hci_wait(0x0c03, WL_EVT_CC, rsp, rlen, 1500);
+			wl_flow_diag(err ? "probe, no reply" : "probe, reply");
+			if (!err) {
+				printf("SWEET BT: BT probe: Reset answered at %u baud (%s)\n", baud,
+				    wake ? "after wake" : "direct");
+				return 0;
+			}
+		}
+	}
+	return err;
+}
+
+/*
+ * qca_uart_setup() for QCA_WCN3990 plus hci_qca.c qca_setup(). Order here:
+ * rampatch, 10 ms, NVM, HCI Reset, QCA baud change to wl.bt_baud + Read Local Version
+ * there, Read BD_ADDR. (sweetbtfast=1: baud change first, as Linux does, so the
+ * 223 kB go out at the operating speed instead of 115200.)
+ */
+static bool
+wl_bt_fw(const struct wl_qca_ver *v)
+{
+	char pname[32], nname[32];
+	void *pbuf = NULL, *nbuf = NULL;
+	size_t plen = 0, nlen = 0;
+	unsigned mode = 0, div = 0;
+	uint8_t rsp[48];
+	unsigned rlen = 0;
+	bool ok = false;
+	int err;
+
+	snprintf(pname, sizeof(pname), "crbtfw%02x.tlv", v->rom);
+	snprintf(nname, sizeof(nname), v->soc_id == QCA_WCN3991_SOC_ID ? "crnv%02xu.bin" : "crnv%02x.bin", v->rom);
+	printf("SWEET BT: BT fw: btqca.c names for WCN3990 soc_ver %#010x: qca/%s, qca/%s%s\n", v->soc_ver, pname,
+	    nname, (!strcmp(pname, WL_BT_FW_PATCH) && !strcmp(nname, WL_BT_FW_NVM)) ? " (same as the Android files)" :
+	    " (differs from the Android files crbtfw21.tlv/crnv21.bin)");
+	int oper_code = wl_qca_baud_code(wl.bt_baud);
+	if (oper_code < 0 || wl_pick_row(wl.bt_baud, &div) < 0) {
+		printf("SWEET BT: BT fw: sweetbtbaud=%u has no QCA code or no exact S3 rate: no download\n", wl.bt_baud);
+		return false;
+	}
+	if (!wl_qca_fw_load(pname, WL_BT_FW_PATCH, &pbuf, &plen) || !wl_qca_fw_load(nname, WL_BT_FW_NVM, &nbuf, &nlen)) {
+		printf("SWEET BT: BT fw: firmware files not available: no download\n");
+		goto out;
+	}
+	/* NVM baud tag: the speed the controller will find itself at after the NVM (Linux: the operating speed) */
+	unsigned dl_baud = wl.bt_fast ? wl.bt_baud : 115200;
+	if (!wl_qca_patch_check(pbuf, plen, &mode) || !wl_qca_nvm_edit(nbuf, nlen, wl_qca_baud_code(dl_baud))) {
+		goto out;
+	}
+	printf("SWEET BT: BT fw: patch version in file %#06x, in controller %#06x\n", le16((uint8_t *)pbuf + 20),
+	    v->patch_ver);
+	if (wl.bt_fast && !wl_qca_set_baud(wl.bt_baud)) {
+		goto out;
+	}
+	if (!wl_qca_send_tlv("patch", pbuf, plen, mode)) {
+		goto out;
+	}
+	wl_sleep(10);           /* "give the controller some time to get ready to receive the NVM" */
+	if (!wl_qca_send_tlv("NVM", nbuf, nlen, 0)) {
+		goto out;
+	}
+	printf("SWEET BT: BT fw: waiting %u ms after the NVM (sweetbtnvmdelay; Linux: none)\n", wl.bt_nvmdelay);
+	wl_sleep(wl.bt_nvmdelay);
+	wl.raw_budget = 40;     /* log the raw RX bytes (with timestamps) around the reset and the wake-up */
+	/*
+	 * qca_send_reset(): plain HCI Reset, HCI_INIT_TIMEOUT (10 s). Linux has no further delay after the NVM
+	 * (only the 10 ms before it). The controller restarts with the patch and may announce itself with an
+	 * IBS WAKE_IND first (boot 0124: "00 fd"), which has to be acknowledged before it sends anything.
+	 */
+	{
+		for (unsigned i = 0; i < 20; i++) {     /* up to 200 ms: let a pending WAKE_IND in and answer it */
+			wl_rx_poll();
+			wl_ibs_service();
+			wl_sleep(10);
+		}
+	}
+	err = wl_bt_post_nvm_reset(rsp, &rlen);
+	if (err) {
+		printf("SWEET BT: BT fw: HCI Reset after download: no event (%d)\n", err);
+		goto out;
+	}
+	wl_print_hex("Reset event after download", rsp, rlen);
+	wl.bt_nowake = 0;       /* setup's QCA_IBS_DISABLED ends with the reset: from here on the wake handshake applies */
+	{
+		struct wl_qca_ver nv;
+		(void)wl_qca_read_version(&nv, "version after download");
+	}
+	if (!wl.bt_fast || wl.baud != wl.bt_baud) {
+		/* the probe may have found the controller at another speed than the one we set */
+		if (wl.baud != wl.bt_baud) {
+			printf("SWEET BT: BT fw: controller is at %u baud, not %u: changing again\n", wl.baud, wl.bt_baud);
+		}
+		if (!wl_qca_set_baud(wl.bt_baud)) {
+			goto out;
+		}
+	} else if (!wl_hci_read_local_version("after download")) {
+		goto out;
+	}
+	err = wl_hci_cmd(0x1009, NULL, 0, rsp, &rlen, 1000);        /* Read_BD_ADDR */
+	if (err || rsp[0] != 0x0e || rlen < 12 || rsp[5] != 0) {
+		printf("SWEET BT: BT fw: Read BD_ADDR failed (%d)\n", err);
+		goto out;
+	}
+	printf("SWEET BT: BT fw BD_ADDR %02x:%02x:%02x:%02x:%02x:%02x\n", rsp[11], rsp[10], rsp[9], rsp[8],
+	    rsp[7], rsp[6]);
+	ok = true;
+out:
+	if (pbuf) {
+		sweet_bt_fw_put(pbuf, plen);
+	}
+	if (nbuf) {
+		sweet_bt_fw_put(nbuf, nlen);
+	}
+	return ok;
+}
+
+/* ---------------------------------------------------------------- iOS HCI transport (sweetbt=1) */
+
+#define WL_BD_DEFAULT   { 0x02, 0x00, 0x5e, 0x77, 0xb0, 0x01 }  /* tools/mkadt.py mac-address-bluetooth0 */
+#define QCA_EDL_WRITE_BD_ADDR_OPCODE    0xfc14u                 /* btqca.h EDL_WRITE_BD_ADDR_OPCODE */
+
+/* ADT /arm-io/bluetooth local-mac-address (what bluetoothd/BlueTool read), else the synthetic default */
+static void
+wl_bt_adt_bdaddr(uint8_t out[6])
+{
+	static const uint8_t def[6] = WL_BD_DEFAULT;
+	DTEntry node;
+	const void *data = NULL;
+	unsigned int size = 0;
+
+	memcpy(out, def, 6);
+	if (SecureDTLookupEntry(NULL, "/arm-io/bluetooth", &node) == kSuccess &&
+	    SecureDTGetProperty(node, "local-mac-address", &data, &size) == kSuccess && size == 6) {
+		memcpy(out, data, 6);
+		printf("SWEET BT: ADT /arm-io/bluetooth local-mac-address %02x:%02x:%02x:%02x:%02x:%02x\n", out[0],
+		    out[1], out[2], out[3], out[4], out[5]);
+	} else {
+		printf("SWEET BT: no ADT /arm-io/bluetooth local-mac-address, using %02x:%02x:%02x:%02x:%02x:%02x\n",
+		    out[0], out[1], out[2], out[3], out[4], out[5]);
+	}
+}
+
+/* Read_BD_ADDR into addr (most significant byte first) */
+static bool
+wl_bt_read_bdaddr(uint8_t addr[6])
+{
+	uint8_t rsp[48];
+	unsigned rlen = 0;
+	int err = wl_hci_cmd(0x1009, NULL, 0, rsp, &rlen, 1000);
+	if (err || rsp[0] != 0x0e || rlen < 12 || rsp[5] != 0) {
+		printf("SWEET BT: Read BD_ADDR failed (%d)\n", err);
+		return false;
+	}
+	for (unsigned i = 0; i < 6; i++) {
+		addr[i] = rsp[11 - i];
+	}
+	return true;
+}
+
+/*
+ * qca_set_bdaddr() of btqca.c: vendor 0xfc14, baswap()ed: most significant byte first, the
+ * answer is a vendor event (or a Command Complete). The ADT value is what userland believes
+ * (local-mac-address), so the controller has to report the same one in Read_BD_ADDR.
+ */
+static void
+wl_bt_set_bdaddr(const uint8_t want[6])
+{
+	uint8_t cur[6], par[6], rsp[48];
+	unsigned rlen = 0;
+	int err;
+
+	if (!wl_bt_read_bdaddr(cur)) {
+		return;
+	}
+	printf("SWEET BT: controller BD_ADDR %02x:%02x:%02x:%02x:%02x:%02x, wanted %02x:%02x:%02x:%02x:%02x:%02x\n",
+	    cur[0], cur[1], cur[2], cur[3], cur[4], cur[5], want[0], want[1], want[2], want[3], want[4], want[5]);
+	if (!memcmp(cur, want, 6)) {
+		printf("SWEET BT: BD_ADDR already matches\n");
+		return;
+	}
+	for (unsigned i = 0; i < 6; i++) {
+		par[i] = want[i];	/* boot 0137: LSB first came back byte-reversed */
+	}
+	err = wl_hci_cmd(QCA_EDL_WRITE_BD_ADDR_OPCODE, par, 6, rsp, &rlen, 1000);
+	if (err) {
+		printf("SWEET BT: set BD_ADDR (0xfc14): no event (%d)\n", err);
+	} else {
+		wl_print_hex("set BD_ADDR (0xfc14) reply", rsp, rlen);
+	}
+	for (unsigned pass = 0; pass < 2; pass++) {
+		if (wl_bt_read_bdaddr(cur) && !memcmp(cur, want, 6)) {
+			printf("SWEET BT: BD_ADDR now %02x:%02x:%02x:%02x:%02x:%02x%s\n", cur[0], cur[1], cur[2], cur[3],
+			    cur[4], cur[5], pass ? " (after HCI Reset)" : "");
+			return;
+		}
+		if (pass == 0) {
+			/* some controllers apply the address on the next reset */
+			printf("SWEET BT: BD_ADDR not applied yet (%02x:%02x:%02x:%02x:%02x:%02x): HCI Reset and read again\n",
+			    cur[0], cur[1], cur[2], cur[3], cur[4], cur[5]);
+			(void)wl_hci_cmd(0x0c03, NULL, 0, rsp, &rlen, 3000);
+		}
+	}
+	printf("SWEET BT: BD_ADDR MISMATCH after 0xfc14: userland will see %02x:%02x:%02x:%02x:%02x:%02x from the ADT "
+	    "but the controller reports another; set BT_DEVICE_ADDRESS accordingly\n", want[0], want[1], want[2],
+	    want[3], want[4], want[5]);
+}
+
+/*
+ * RX framing for userland. One byte at a time, from wl_rx_poll() under the UART lock. IBS bytes
+ * (0xfc WAKE_ACK, 0xfd WAKE_IND, 0xfe SLEEP_IND) are only valid between packets, as in
+ * hci_qca.c; they are acted on here and never reach the socket. Everything else is framed
+ * into whole H4 packets (event 04: code, len; ACL 02: handle, len16; SCO 03: handle, len8;
+ * ISO 05: handle, len14) and passed on; an unknown type byte is dropped (resync, as the Apple
+ * readers do).
+ */
+static void
+wl_xport_feed(uint8_t b)
+{
+	static const uint8_t hdr[6] = { 0, 3, 4, 3, 2, 4 };    /* header bytes after the type byte, indexed by type: 1 cmd, 2 acl, 3 sco, 4 evt, 5 iso */
+
+	if (wl.xs_st == 0) {
+		if (b >= IBS_WAKE_ACK && b <= IBS_SLEEP_IND) {
+			if (b == IBS_SLEEP_IND) {
+				wl.ibs_asleep = true;
+				wl.ibs_sleeps++;
+			} else {
+				wl.ibs_asleep = false;
+				if (b == IBS_WAKE_IND) {
+					wl.ibs_ack_pending = true;
+				}
+			}
+			if (wl.ibs_xlog < 24) {
+				wl.ibs_xlog++;
+				printf("SWEET BT: BT IBS: RX %s (%#04x) at %u ms\n", b == IBS_WAKE_ACK ? "WAKE_ACK" :
+				    b == IBS_WAKE_IND ? "WAKE_IND" : "SLEEP_IND", b, wl_ms());
+			}
+			return;
+		}
+		if (b < 2 || b > 5) {
+			/* 0x01 (command) never comes from a controller; anything else is garbage */
+			if (wl.xs_garbage++ < 8) {
+				printf("SWEET BT: RX: byte %#04x between packets is not an H4 type, dropped\n", b);
+			}
+			return;
+		}
+		wl.xs_pkt[0] = b;
+		wl.xs_have = 1;
+		wl.xs_type = b;
+		wl.xs_total = 0;
+		wl.xs_st = 1;
+		return;
+	}
+	wl.xs_pkt[wl.xs_have++] = b;
+	if (wl.xs_st == 1 && wl.xs_have == 1u + hdr[wl.xs_type]) {
+		unsigned pl;
+		switch (wl.xs_type) {
+		case 4:  pl = wl.xs_pkt[2]; break;
+		case 3:  pl = wl.xs_pkt[3]; break;
+		case 2:  pl = wl.xs_pkt[3] | (wl.xs_pkt[4] << 8); break;
+		default: pl = (wl.xs_pkt[3] | (wl.xs_pkt[4] << 8)) & 0x3fff; break;
+		}
+		wl.xs_total = wl.xs_have + pl;
+		if (wl.xs_total > sizeof(wl.xs_pkt)) {
+			if (wl.xs_oversize++ < 8) {
+				printf("SWEET BT: RX: %u byte H4 packet (type %u) does not fit, dropped\n", wl.xs_total, wl.xs_type);
+			}
+			wl.xs_st = 0;
+			return;
+		}
+		wl.xs_st = 2;
+	}
+	if (wl.xs_st == 2 && wl.xs_have == wl.xs_total) {
+		sweet_bt_hci_rx_packet(wl.xs_pkt, wl.xs_have);
+		wl.xs_st = 0;
+	}
+}
+
+/* a TX packet from userland (the kctl send path): wake the controller if it sleeps, then transmit */
+static bool
+wl_xport_tx(const uint8_t *pkt, unsigned len)
+{
+	bool ok;
+
+	os_atomic_add(&wl.tx_waiters, 1, relaxed);
+	lck_mtx_lock(&wl_hw_lock);
+	os_atomic_sub(&wl.tx_waiters, 1, relaxed);
+	wl_ibs_service();
+	wl_ibs_wake();
+	ok = wl_tx_buf(pkt, len);
+	lck_mtx_unlock(&wl_hw_lock);
+	return ok;
+}
+
+/* termios speed request: the line stays at the speed the firmware step left it at */
+static unsigned
+wl_xport_baud(unsigned requested)
+{
+	(void)requested;
+	return wl.baud;
+}
+
+static const struct bt_hci_ops wl_xport_ops = { wl_xport_tx, wl_xport_baud };
+
+static void
+wl_sleep_us(unsigned us)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(us, NSEC_PER_USEC, &deadline);
+	(void)assert_wait_deadline(&wl.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+wl_xport_start(void)
+{
+	uint8_t want[6];
+
+	if (wl.baud != wl.bt_baud) {
+		printf("SWEET BT: transport not started: UART is at %u baud, not %u\n", wl.baud, wl.bt_baud);
+		return false;
+	}
+	wl_bt_adt_bdaddr(want);
+	memcpy(wl.bdaddr, want, 6);
+	if (wl.bt_setaddr) {
+		wl_bt_set_bdaddr(want);
+	}
+	wl.xport = true;
+	wl.raw_budget = 0;
+	wl.ibs_xlog = 0;
+	wl.xs_st = 0;
+	wl.rxn = 0;
+	wl_rx_stop();
+	wl_flow(true);                  /* lossless at 3 Mbaud depends on RFR/CTS */
+	wl_rx_start();
+	sweet_bt_hci_register(&wl_xport_ops, wl.bt_sk, wl.bt_log);
+	printf("SWEET BT: transport up: UART %u baud, RX FIFO %u words, ring 64 KiB, IBS %s, BD_ADDR %02x:%02x:%02x:%02x:%02x:%02x\n",
+	    wl.baud, wl.rx_depth, wl.bt_ibs ? "in the NVM (handled here)" : "off in the NVM (handled here if it appears)",
+	    want[0], want[1], want[2], want[3], want[4], want[5]);
+	return true;
+}
+
+/*
+ * The RX loop, forever on the stage thread. Polled, not interrupt driven (no GENI IRQ plumbing in
+ * this tree): hardware flow control keeps it lossless. The FIFO holds rx_depth words; RFR drops at
+ * rx_depth - 2 words, so after the poll that last drained the FIFO the controller can send
+ * (rx_depth - 2) * 4 bytes before it is held off: about 190 us at 3 Mbaud (10 bits per byte) for
+ * a 16-word FIFO. While traffic flows the loop therefore polls every ~30 us; after 200 empty
+ * polls it sleeps 300 us per round (first byte of a burst waits at most that, and the FIFO plus
+ * RFR absorb it), 2 ms when no client is connected. The ring (64 KiB) only absorbs a slow
+ * userland. A line "SWEET BT: UART RX ..." every 10 s shows the measured maximum FIFO fill
+ * (max words vs depth) and FIFO error count; a FIFO error would mean the margin was exceeded.
+ */
+static void
+wl_xport_run(void)
+{
+	unsigned idle = 0, last_ms = wl_ms(), lines = 0;
+	uint64_t last_bytes = 0;
+
+	for (;;) {
+		bool got;
+		uint64_t b0;
+
+		if (os_atomic_load(&wl.tx_waiters, relaxed) > 0) {
+			wl_sleep_us(50);        /* let a transmitter take the lock */
+		}
+		lck_mtx_lock(&wl_hw_lock);
+		b0 = wl.xs_bytes;
+		wl_rx_poll();
+		wl_ibs_service();
+		got = wl.xs_bytes != b0;
+		lck_mtx_unlock(&wl_hw_lock);
+		sweet_bt_hci_rx_service();
+		idle = got ? 0 : idle + 1;
+		if (idle < 200) {
+			delay(30);
+		} else {
+			wl_sleep_us(sweet_bt_hci_connected() ? 300 : 2000);
+		}
+		if (wl_ms() - last_ms >= 10000) {
+			last_ms = wl_ms();
+			if (lines < 60 && (wl.xs_bytes != last_bytes || wl.xs_fifo_err)) {
+				lines++;
+				last_bytes = wl.xs_bytes;
+				printf("SWEET BT: UART RX %llu B in %llu polls, max burst %u B / %u FIFO words (depth %u), FIFO errors %u, "
+				    "garbage %u, IBS: sleeps %u wakes %u (failed %u)\n", wl.xs_bytes, wl.xs_polls, wl.xs_maxburst,
+				    wl.xs_maxwords, wl.rx_depth, wl.xs_fifo_err, wl.xs_garbage, wl.ibs_sleeps, wl.xs_ibs_wake,
+				    wl.xs_ibs_wake_fail);
+				sweet_bt_hci_stats_periodic(false);
+			}
+		}
+	}
+}
+
+static const struct { const char *res; unsigned mv; } wl_bt_rails[] = {
+	{ "ldoa10", 1800 }, { "ldoc1", 1800 }, { "ldoc2", 1304 }, { "ldoc10", 3312 },
+};
+
+static void
+wl_bt(void)
+{
+	uint8_t rsp[48];
+	unsigned rlen = 0, n = 0;
+	int err;
+
+	wl.rcg_row = -1;
+	if (!wl_clocks_on()) {
+		return;
+	}
+	if (!wl_gpll0_check() || !wl_rcg_save()) {
+		goto out_clocks;
+	}
+	/* pins first (Linux order: pinctrl default state, then the UART probes) */
+	if (!wl_pins_uart()) {
+		printf("SWEET BT: UART pin mux did not read back: stop\n");
+		goto out_restore;
+	}
+	wl_dump_gpio();
+	if (!wl_uart_open()) {
+		goto out_restore;
+	}
+	wl_baud_plan();
+	for (n = 0; n < sizeof(wl_bt_rails) / sizeof(wl_bt_rails[0]); n++) {
+		err = sweet_rpmh_vreg_set(wl_bt_rails[n].res, wl_bt_rails[n].mv, true);
+		printf("SWEET BT: rail %s %u mV -> %d\n", wl_bt_rails[n].res, wl_bt_rails[n].mv, err);
+		if (err) {
+			goto out_restore;
+		}
+		wl_sleep(2);
+	}
+	wl_sleep(10);
+	/* qca_regulator_init(): 2400 baud power-off pulse, then 115200 baud power-on pulse */
+	if (!wl_baud(2400)) {
+		goto out_restore;
+	}
+	wl_power_pulse(false, 2400);
+	if (!wl_baud(115200)) {
+		goto out_restore;
+	}
+	wl_power_pulse(true, 115200);
+	wl_flow(true);
+	wl_rx_poll();
+	printf("SWEET BT: after power-on pulse: %u stray RX bytes\n", wl.rxn);
+	wl.rxn = 0;
+
+	err = wl_hci_cmd(0x0c03, NULL, 0, rsp, &rlen, 1000);        /* HCI_Reset */
+	if (err) {
+		printf("SWEET BT: HCI Reset: no event (%d)\n", err);
+	} else {
+		wl_print_hex("Reset event", rsp, rlen);
+	}
+	err = wl_hci_cmd(0x1001, NULL, 0, rsp, &rlen, 1000);        /* Read_Local_Version_Information */
+	if (err) {
+		printf("SWEET BT: HCI Read Local Version: no event (%d)\n", err);
+	} else {
+		wl_print_hex("Read Local Version", rsp, rlen);
+	}
+	{
+		struct wl_qca_ver qv;
+		if (wl_qca_read_version(&qv, "patch version (product/patch/rom/soc follow the header)")) {
+			if (wl.bt_fw) {
+				bool fwok = wl_bt_fw(&qv);
+				printf("SWEET BT: BT fw %s\n", fwok ? "setup complete (patch + NVM downloaded, controller up at the "
+				    "operating baud)" : "setup FAILED or skipped (see above)");
+				if (wl.bt_hci) {
+					/* sweetbt=1: keep the chip, the UART clocks and the pins; the loop never returns */
+					if (fwok && wl_xport_start()) {
+						wl_xport_run();
+					}
+					printf("SWEET BT: transport not started (see above): normal shutdown of the stage\n");
+				}
+			} else {
+				printf("SWEET BT: BT fw: sweetbtfw=0, no download\n");
+			}
+		}
+	}
+	/*
+	 * hci_qca qca_power_off(): 2400 baud power-off pulse (the rails are NOT voted off, see below).
+	 * Only with sweetbtpoweroff=1; by default the controller stays powered (and keeps its firmware)
+	 * so it can be used later.
+	 */
+	wl_rx_stop();
+	if (wl.bt_poweroff) {
+		if (wl_baud(2400)) {
+			wl_power_pulse(false, 2400);
+			printf("SWEET BT: BT power-off pulse sent (sweetbtpoweroff=1)\n");
+		}
+	} else {
+		printf("SWEET BT: BT controller left powered (no power-off pulse; sweetbtpoweroff=1 sends it)\n");
+	}
+out_restore:
+	/*
+	 * The rails are never voted off by this stage. An APPS-DRV RPMh "off" vote also
+	 * drops any "on" vote ABL placed through this DRV: boot 0116hw panicked right
+	 * after voting ldoa7 (1.8 V) off, so something else on the board needs it
+	 * (0117 made keep=1 the default; 0118 removes the off path and sweetwlankeep).
+	 */
+	printf("SWEET BT: rails left on (%u of %u voted by this stage)\n", n,
+	    (unsigned)(sizeof(wl_bt_rails) / sizeof(wl_bt_rails[0])));
+	wl_rx_stop();
+	wl_se_clk_restore();
+	wl_rcg_restore();
+	wl_pins_restore();
+out_clocks:
+	wl_clocks_off();
+	printf("SWEET BT: bluetooth stage done\n");
+}
+
+/* ---------------------------------------------------------------- thread */
+
+static void
+wl_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	printf("SWEET BT: stage %u starts in %u s\n", wl.stage, wl.delay_s);
+	wl_sleep(wl.delay_s * 1000u);
+	if (!wl_map()) {
+		printf("SWEET BT: MMIO mapping failed\n");
+		goto out;
+	}
+	wl_dump_gcc();
+	wl_dump_gpio();
+	wl_dump_se();
+	wl_bt();
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_bt_init(void)
+{
+	unsigned stage = 0, delay_s = 30;
+	thread_t thread;
+
+	if (wl.started) {
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetwlan", &stage, sizeof(stage));
+	{
+		unsigned bt = 0;
+		(void)PE_parse_boot_argn("sweetbt", &bt, sizeof(bt));
+		if (bt) {
+			stage = 2;      /* sweetbt=1 implies the BT stage */
+		}
+	}
+	if (stage != 2) {
+		return;                 /* off by default: no log line, no mapping */
+	}
+	(void)PE_parse_boot_argn("sweetwlandelay", &delay_s, sizeof(delay_s));
+	/* Bluetooth firmware (stage 2): sweetbtfw=1 (default) downloads rampatch + NVM when the files exist */
+	wl.bt_fw = 1;
+	wl.bt_baud = 3000000;           /* 3200000 is the dtsi max-speed and also has an exact S3 rate */
+	(void)PE_parse_boot_argn("sweetbtfw", &wl.bt_fw, sizeof(wl.bt_fw));
+	(void)PE_parse_boot_argn("sweetbtbaud", &wl.bt_baud, sizeof(wl.bt_baud));
+	(void)PE_parse_boot_argn("sweetbtfast", &wl.bt_fast, sizeof(wl.bt_fast));       /* 1: baud change before the download */
+	(void)PE_parse_boot_argn("sweetbtibs", &wl.bt_ibs, sizeof(wl.bt_ibs));          /* 1: Linux NVM IBS/deep-sleep bits */
+	(void)PE_parse_boot_argn("sweetbtpoweroff", &wl.bt_poweroff, sizeof(wl.bt_poweroff));
+	wl.bt_setaddr = 1;              /* sweetbt=1: program the ADT local-mac-address with 0xfc14 */
+	wl.bt_log = 64;                 /* sweetbt=1: HCI packet trace lines */
+	(void)PE_parse_boot_argn("sweetbt", &wl.bt_hci, sizeof(wl.bt_hci));             /* 1: keep the controller, serve com.apple.uart.bluetooth */
+	(void)PE_parse_boot_argn("sweetbtsk", &wl.bt_sk, sizeof(wl.bt_sk));             /* 1: also register com.apple.uart.sk.bluetooth */
+	(void)PE_parse_boot_argn("sweetbtlog", &wl.bt_log, sizeof(wl.bt_log));
+	(void)PE_parse_boot_argn("sweetbtaddr", &wl.bt_setaddr, sizeof(wl.bt_setaddr));
+	wl.bt_nvmdelay = 10;            /* ms after the NVM; Linux: 0 (10 ms only between patch and NVM) */
+	wl.bt_probe = 1;                /* silent after the NVM: try 115200/3200000/921600, with and without wake */
+	wl.bt_nowake = 1;               /* Linux QCA_IBS_DISABLED during setup: no 0xfd wake before commands */
+	(void)PE_parse_boot_argn("sweetbtnvmdelay", &wl.bt_nvmdelay, sizeof(wl.bt_nvmdelay));
+	(void)PE_parse_boot_argn("sweetbtprobe", &wl.bt_probe, sizeof(wl.bt_probe));
+	(void)PE_parse_boot_argn("sweetbtnowake", &wl.bt_nowake, sizeof(wl.bt_nowake));
+	(void)PE_parse_boot_argn("sweetbtrfr", &wl.bt_rfr, sizeof(wl.bt_rfr));          /* 1: force RFR ready after the NVM */
+	(void)PE_parse_boot_argn("sweetbtnoflow", &wl.bt_noflow, sizeof(wl.bt_noflow)); /* 1: ignore CTS (no hw flow control) */
+	wl.started = true;
+	wl.stage = stage;
+	wl.delay_s = delay_s;
+	if (kernel_thread_start(wl_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET BT: kernel_thread_start failed\n");
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_bt_hci.c b/bsd/dev/sweet_bt_hci.c
new file mode 100644
index 0000000..54ac6bc
--- /dev/null
+++ b/bsd/dev/sweet_bt_hci.c
@@ -0,0 +1,761 @@
+/*
+ * Bluetooth HCI transport for iOS userland. From Bergamota (ry-diffusion, Poco F1; beryllium_bt_hci.c,
+ * patches 0136 + 0239; that repository has no license file), used on sweet by bsd/dev/sweet_bt.c.
+ *
+ * What bluetoothd (BT_HCI_TRANSPORT=H4BC:POSIX:com.apple.uart.bluetooth,3000000) and BlueTool
+ * open on A11: a PF_SYSTEM / SYSPROTO_CONTROL SOCK_STREAM socket on the kernel control
+ * "com.apple.uart.bluetooth", read and written as a plain H4 byte stream, termios through
+ * get/setsockopt(SYSPROTO_CONTROL, TIOCGETA = 0x40487413 / TIOCSETA = 0x80487414, struct termios).
+ * docs/BT_IOS_TRANSPORT.md has the evidence.
+ *
+ * The chip side lives in bsd/dev/beryllium_wlan.c (power, firmware, UART, in-band sleep). It hands
+ * this file complete, IBS-free H4 packets (sweet_bt_hci_rx_packet) and takes complete H4 packets to
+ * transmit (struct bt_hci_ops.tx); this file owns the 64 KiB RX ring, the kctl and the termios
+ * answers. Off by default: only registered by the BT stage when boot-arg sweetbt=1 and the
+ * controller came up (sweetwlan=2).
+ *
+ * Lock order: the UART lock (beryllium_wlan.c) is taken before bt.lock; nothing here calls into
+ * the socket layer with either held (ctl_enqueuedata is called with neither).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/kern_control.h>
+#include <sys/kpi_mbuf.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+#include <pexpert/pexpert.h>
+
+struct bt_hci_ops {
+	bool (*tx)(const uint8_t *pkt, unsigned len);   /* one complete H4 packet to the UART (wakes the controller) */
+	unsigned (*baud)(unsigned requested);           /* termios speed request: returns the speed in effect */
+};
+
+void sweet_bt_hci_register(const struct bt_hci_ops *ops, unsigned sk_alias, unsigned log_budget);
+void sweet_bt_hci_rx_packet(const uint8_t *pkt, unsigned len);
+void sweet_bt_hci_rx_service(void);
+void sweet_bt_hci_stats_periodic(bool force);
+bool sweet_bt_hci_connected(void);
+
+#define BT_CTL_NAME     "com.apple.uart.bluetooth"
+#define BT_CTL_NAME_SK  "com.apple.uart.sk.bluetooth"
+#define BT_RING_SIZE    65536u          /* RX ring: 218 ms of a saturated 3 Mbaud line */
+#define BT_RING_MASK    (BT_RING_SIZE - 1)
+#define BT_STAGE_SIZE   4096u           /* bytes per ctl_enqueuedata */
+#define BT_PKT_MAX      4100u           /* 1 + 4 + 4095: enough for ACL (1021 classic / 251 LE) and events */
+#define BT_CTL_RECV     (128u * 1024)
+#define BT_CTL_SEND     (64u * 1024)
+
+#define BT_TIOCGETA     0x40487413u     /* _IOR('t', 19, struct termios), what bluetoothd/BlueTool pass as the option name */
+#define BT_TIOCSETA     0x80487414u     /* _IOW('t', 20, ...) */
+#define BT_TIOCSETAW    0x80487415u
+#define BT_TIOCSETAF    0x80487416u
+#define BT_CRTSCTS      0x30000ul       /* CCTS_OFLOW | CRTS_IFLOW */
+
+/* Darwin LP64 struct termios (72 bytes): tcflag_t / speed_t are unsigned long */
+struct bt_termios {
+	unsigned long c_iflag, c_oflag, c_cflag, c_lflag;
+	unsigned char c_cc[20];
+	unsigned long c_ispeed, c_ospeed;
+};
+_Static_assert(sizeof(struct bt_termios) == 72, "struct termios size");
+
+static LCK_GRP_DECLARE(bt_grp, "sweet_bt_hci");
+static LCK_MTX_DECLARE(bt_lock, &bt_grp);
+
+static struct {
+	const struct bt_hci_ops *ops;
+	kern_ctl_ref ref[2];
+	unsigned nref;
+	bool up;                        /* ctl registered */
+	bool connected;
+	kern_ctl_ref conn_ref;
+	uint32_t conn_unit;
+	unsigned epoch;                 /* bumped on connect: a flush that raced a reset must not advance rd */
+	uint32_t rd, wr;                /* free-running ring counters */
+	unsigned log_budget;
+	/* TX framer (userland writes are a byte stream; the UART gets whole packets) */
+	uint8_t txb[BT_PKT_MAX];
+	unsigned txn, txtotal;
+	struct bt_termios tio;
+	/* statistics */
+	unsigned ring_peak, rx_pkts, rx_drop_pkts, rx_drop_nc, enq_fail, enq_ok;
+	uint64_t rx_bytes, tx_bytes;
+	unsigned tx_pkts, tx_fail, tx_garbage, tios_get, tios_set, baud_req_ignored;
+	unsigned connects;
+	unsigned last_rx_pkts, last_tx_pkts;
+	unsigned compat, compat_fixed, compat_local, err_budget;       /* sweetbtcompat; rewritten / kernel-answered commands */
+} bt;
+
+static uint8_t bt_ring[BT_RING_SIZE];
+static uint8_t bt_stage[BT_STAGE_SIZE];         /* only the single consumer (RX thread) uses it */
+
+/* ------------------------------------------------------------ logging */
+
+static const char *
+bt_h4_name(uint8_t t)
+{
+	switch (t) {
+	case 1:  return "cmd";
+	case 2:  return "acl";
+	case 3:  return "sco";
+	case 4:  return "evt";
+	case 5:  return "iso";
+	default: return "???";
+	}
+}
+
+static void
+bt_log_pkt(const char *dir, const uint8_t *p, unsigned n)
+{
+	char hex[3 * 16 + 1];
+	unsigned o = 0, i;
+
+	if (bt.log_budget == 0) {
+		return;
+	}
+	bt.log_budget--;
+	for (i = 0; i < n && i < 16; i++) {
+		o += (unsigned)snprintf(hex + o, sizeof(hex) - o, "%02x ", p[i]);
+	}
+	if (p[0] == 1 && n >= 4) {
+		printf("SWEET BT: %s cmd opcode %#06x plen %u (%u bytes): %s\n", dir, p[1] | (p[2] << 8), p[3], n, hex);
+	} else if (p[0] == 4 && n >= 3) {
+		printf("SWEET BT: %s evt %#04x plen %u (%u bytes): %s\n", dir, p[1], p[2], n, hex);
+	} else {
+		printf("SWEET BT: %s %s (%u bytes): %s\n", dir, bt_h4_name(p[0]), n, hex);
+	}
+}
+
+/* ------------------------------------------------------------ RX: UART -> ring -> socket */
+
+bool
+sweet_bt_hci_connected(void)
+{
+	return os_atomic_load(&bt.connected, relaxed);
+}
+
+/*
+ * bluetoothd's HCI init (OI stack) treats any failed command as fatal ("HCI initialization
+ * failed"; with 0238+0239 v2 a SIGABRT in Stack_Init). The WCN3990 answers Command Complete with
+ * status 0x01 (Unknown HCI Command) to commands Apple's Broadcom controllers know: the Broadcom
+ * vendor commands of bluetoothd's bcm_vsc.c (0xfce2, 0xfce9, 0xfd47, 0xfd48 on boot
+ * combo2-0240b-bt0239v2). sweetbtcompat=1 turns such an answer into success for standard
+ * commands (OGF != 0x3f), =2 (default) also for vendor commands: the reply then has no return
+ * parameters, which bcm_vsc.c's sub-opcode checker accepts (it returns true on an empty reply);
+ * a read that needs its parameters still fails in bluetoothd and shows up in the log. Every rewrite and every other non-zero status is logged (own budget), so the
+ * next missing command shows up even after the packet trace budget is spent.
+ */
+#define BT_COMPAT_PAD   16u             /* parameter bytes in a rewritten Command Complete */
+
+/* First parameter byte of the last few commands sent, by opcode (for rewritten replies). */
+static struct { uint16_t op; uint8_t p0; } bt_last_cmd[8];
+static unsigned bt_last_cmd_next;
+
+static void
+bt_cmd_note(const uint8_t *cmd, unsigned len)
+{
+	const unsigned n = sizeof(bt_last_cmd) / sizeof(bt_last_cmd[0]);
+	unsigned op, i;
+
+	if (len < 4 || cmd[0] != 1) {
+		return;
+	}
+	op = cmd[1] | (cmd[2] << 8);
+	for (i = 0; i < n && bt_last_cmd[i].op != op; i++) {
+	}
+	if (i == n) {                   /* one slot per opcode: the newest command wins */
+		i = bt_last_cmd_next++ % n;
+	}
+	bt_last_cmd[i].op = (uint16_t)op;
+	bt_last_cmd[i].p0 = cmd[3] != 0 && len >= 5 ? cmd[4] : 0;
+}
+
+static unsigned
+bt_cmd_param0(unsigned op)
+{
+	for (unsigned i = 0; i < sizeof(bt_last_cmd) / sizeof(bt_last_cmd[0]); i++) {
+		if (bt_last_cmd[i].op == op) {
+			return bt_last_cmd[i].p0;
+		}
+	}
+	return 0;
+}
+
+/*
+ * Command watchdog. Boot combo6-0244-bt0239v4: the WCN3990 never answered 0xfce9 sub-opcode 1
+ * (Broadcom LE Meta Enable Features, while it answers the other 0xfce9 sub-opcodes with 0x01), and
+ * bluetoothd gave up: "BD_VSC_LE_META_ENA_FEATURES timedout waiting for controller", "Notifying BT
+ * Firmware Crashed", restart reason 3602. A command sent to the controller that gets neither Command
+ * Complete nor Command Status within BT_CMD_WATCHDOG_MS is answered here like a rewritten one
+ * (success, first parameter byte + zeros). Only one command is tracked (bluetoothd keeps one in
+ * flight: Num_HCI_Command_Packets 1); a late real answer just arrives as an extra event.
+ */
+#define BT_CMD_WATCHDOG_MS      800u
+
+static struct {
+	uint16_t op;
+	uint8_t p0;
+	bool on;
+	uint64_t t;             /* mach_absolute_time of the transmit */
+} bt_pend;
+static unsigned bt_watchdog_fired;
+
+static void
+bt_pend_set(const uint8_t *cmd, unsigned len)
+{
+	if (len >= 4 && cmd[0] == 1) {
+		bt_pend.op = (uint16_t)(cmd[1] | (cmd[2] << 8));
+		bt_pend.p0 = cmd[3] != 0 && len >= 5 ? cmd[4] : 0;
+		bt_pend.t = mach_absolute_time();
+		os_atomic_store(&bt_pend.on, true, release);
+	}
+}
+
+static void
+bt_pend_answered(const uint8_t *p, unsigned len)
+{
+	unsigned op;
+
+	if (len < 7 || p[0] != 4 || !os_atomic_load(&bt_pend.on, acquire)) {
+		return;
+	}
+	if (p[1] == 0x0e) {
+		op = p[4] | (p[5] << 8);
+	} else if (p[1] == 0x0f) {
+		op = p[5] | (p[6] << 8);
+	} else {
+		return;
+	}
+	if (op == bt_pend.op) {
+		os_atomic_store(&bt_pend.on, false, relaxed);
+	}
+}
+
+static void
+bt_pend_check(void)
+{
+	uint64_t ns;
+	uint8_t ev[7 + 16];
+	unsigned i;
+
+	if (!bt.compat || !os_atomic_load(&bt_pend.on, acquire)) {
+		return;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - bt_pend.t, &ns);
+	if (ns < (uint64_t)BT_CMD_WATCHDOG_MS * 1000000ull) {
+		return;
+	}
+	os_atomic_store(&bt_pend.on, false, relaxed);
+	ev[0] = 4;
+	ev[1] = 0x0e;
+	ev[2] = 4 + 16;
+	ev[3] = 1;
+	ev[4] = (uint8_t)bt_pend.op;
+	ev[5] = (uint8_t)(bt_pend.op >> 8);
+	ev[6] = 0;
+	ev[7] = bt_pend.p0;
+	for (i = 8; i < sizeof(ev); i++) {
+		ev[i] = 0;
+	}
+	bt_watchdog_fired++;
+	printf("SWEET BT: compat: opcode %#06x (OGF %#x OCF %#05x, first parameter %#04x) not answered by the controller "
+	    "within %u ms, answered as success by the kernel (%u so far)\n", bt_pend.op, bt_pend.op >> 10,
+	    bt_pend.op & 0x3ff, bt_pend.p0, BT_CMD_WATCHDOG_MS, bt_watchdog_fired);
+	sweet_bt_hci_rx_packet(ev, sizeof(ev));
+}
+
+/*
+ * Commands bluetoothd's init sends unconditionally and fails on when the controller does not list
+ * them (Read Local Supported Commands): { opcode, octet, bit } of the supported-commands mask. They
+ * are answered here with success and never reach the WCN3990. Boot 2026-10-24 combo-0240b-bt0239:
+ * mask octet 18 = 0x83, so bit 3 (Write Default Erroneous Data Reporting) was clear and the OI stack
+ * failed locally: "OI_HCICMD_WriteDefaultErroneousDataReporting (status=628)", "HCI initialization
+ * failed", restart reason 108, without sending the command.
+ */
+static const struct { uint16_t op; uint8_t octet, bit; } bt_local_cmds[] = {
+	{ 0x0c5b, 18, 3 },      /* Write Default Erroneous Data Reporting */
+};
+
+static bool
+bt_hci_local_answer(const uint8_t *cmd, unsigned len)
+{
+	unsigned op, i;
+	uint8_t ev[7];
+
+	if (!bt.compat || len < 4 || cmd[0] != 1) {
+		return false;
+	}
+	op = cmd[1] | (cmd[2] << 8);
+	for (i = 0; i < sizeof(bt_local_cmds) / sizeof(bt_local_cmds[0]); i++) {
+		if (bt_local_cmds[i].op == op) {
+			break;
+		}
+	}
+	if (i == sizeof(bt_local_cmds) / sizeof(bt_local_cmds[0])) {
+		return false;
+	}
+	ev[0] = 4;
+	ev[1] = 0x0e;                   /* Command Complete */
+	ev[2] = 4;
+	ev[3] = 1;                      /* Num_HCI_Command_Packets */
+	ev[4] = cmd[1];
+	ev[5] = cmd[2];
+	ev[6] = 0;                      /* success */
+	bt.compat_local++;
+	printf("SWEET BT: compat: opcode %#06x answered by the kernel (not sent to the controller, %u so far)\n",
+	    op, bt.compat_local);
+	sweet_bt_hci_rx_packet(ev, sizeof(ev));
+	return true;
+}
+
+static unsigned
+bt_hci_compat(uint8_t *p, unsigned len)
+{
+	unsigned op, st;
+
+	if (len < 7 || p[0] != 4) {
+		return len;
+	}
+	if (p[1] == 0x0e) {                     /* Command Complete: 04 0e plen ncmd op op status */
+		op = p[4] | (p[5] << 8);
+		st = p[6];
+	} else if (p[1] == 0x0f) {              /* Command Status: 04 0f plen status ncmd op op */
+		op = p[5] | (p[6] << 8);
+		st = p[3];
+	} else {
+		return len;
+	}
+	if (st == 0) {
+		if (bt.compat && p[1] == 0x0e && op == 0x1002 && len >= 7 + 64) {
+			/* Read Local Supported Commands: list the commands answered by bt_hci_local_answer */
+			for (unsigned i = 0; i < sizeof(bt_local_cmds) / sizeof(bt_local_cmds[0]); i++) {
+				uint8_t *b = &p[7 + bt_local_cmds[i].octet];
+				uint8_t was = *b;
+
+				*b |= (uint8_t)(1u << bt_local_cmds[i].bit);
+				printf("SWEET BT: compat: supported commands octet %u %#04x -> %#04x (opcode %#06x)\n",
+				    bt_local_cmds[i].octet, was, *b, bt_local_cmds[i].op);
+			}
+		}
+		return len;
+	}
+	if (bt.compat && p[1] == 0x0e && st == 0x0c &&
+	    (op == 0x2006 || op == 0x2007 || op == 0x200a || op == 0x200b || op == 0x200c)) {
+		/*
+		 * Command Disallowed for an LE command that changes or reads state the controller is busy
+		 * with: Set Advertising Parameters / Read Advertising Channel Tx Power / Set Advertising
+		 * Enable / Set Scan Parameters / Set Scan Enable while advertising or scanning. Apple's
+		 * Broadcom firmware accepts these; the WCN3990 follows the spec. Boot combo8: bluetoothd
+		 * sets new scan parameters while its first passive scan runs, gets 0x0c, logs "Could not
+		 * start LE scan (leScanParamsLPCoreCb): STATUS 712" and restarts (reason 712). Answered as
+		 * success, return parameters (if any) kept as they are: the running scan or advertising
+		 * simply keeps its previous parameters.
+		 */
+		p[6] = 0;
+		bt.compat_fixed++;
+		printf("SWEET BT: compat: LE opcode %#06x Command Disallowed by the controller, answered as success (%u so far)\n",
+		    op, bt.compat_fixed);
+		return len;
+	}
+	if (bt.compat && p[1] == 0x0e && len == 7 && op != 0 &&
+	    st == 0x01 && ((op >> 10) != 0x3f || bt.compat >= 2)) {
+		/*
+		 * Success instead of Unknown HCI Command (0x01), or Command Disallowed (0x0c) for LE Read
+		 * Advertising Physical Channel Tx Power. bluetoothd's reply parsers read return
+		 * parameters on success: bcm_vsc.c's sub-opcode checker compares the first byte with the
+		 * command's sub-opcode (its first parameter), _BCM_CreateMultiAdvInstParser (0xfd48) reads a
+		 * 1-byte instance, LE 0x2007 a 1-byte Tx power; the generic status-only parser ignores the
+		 * rest. So the reply carries the command's first parameter byte followed by zeros
+		 * (BT_COMPAT_PAD bytes in all). Boot combo5-0243-bt0239v3: an empty success for 0xfd48
+		 * tripped "ByteStream_NumReadBytesAvail(*pBs) >= 1" (abort in bcm_vsc.c:827).
+		 */
+		/*
+		 * The sub-opcode byte must be the one of the command this answers: bcm_vsc.c matches
+		 * 0xfce9/0xfd23 replies to their pending command by it. Combo7: an older 0xfce9 entry gave
+		 * 0x32 instead of 0x01 for LE Meta Enable Features, its completion never ran and
+		 * bluetoothd restarted after 15 s ("timedout waiting for controller", reason 3602).
+		 */
+		unsigned i, p0 = op == bt_pend.op ? bt_pend.p0 : bt_cmd_param0(op);
+
+		p[2] = 4 + BT_COMPAT_PAD;
+		p[6] = 0;
+		p[7] = (uint8_t)p0;
+		for (i = 1; i < BT_COMPAT_PAD; i++) {
+			p[7 + i] = 0;
+		}
+		bt.compat_fixed++;
+		printf("SWEET BT: compat: opcode %#06x (OGF %#x OCF %#05x) status %#04x from the controller, answered as success "
+		    "with %u parameter bytes (first %#04x) (%u so far)\n", op, op >> 10, op & 0x3ff, st, BT_COMPAT_PAD, p0,
+		    bt.compat_fixed);
+		return 7 + BT_COMPAT_PAD;
+	}
+	if (bt.err_budget) {
+		bt.err_budget--;
+		printf("SWEET BT: %s for opcode %#06x (OGF %#x OCF %#05x): status %#04x\n",
+		    p[1] == 0x0e ? "Command Complete" : "Command Status", op, op >> 10, op & 0x3ff, st);
+	}
+	return len;
+}
+
+/* Called by the UART RX path (under the UART lock) with one complete, IBS-free H4 packet. */
+void
+sweet_bt_hci_rx_packet(const uint8_t *pkt, unsigned len)
+{
+	uint8_t ev[3 + 255];
+	unsigned used, i;
+
+	if (!os_atomic_load(&bt.connected, relaxed)) {
+		bt.rx_drop_nc++;
+		return;
+	}
+	if (pkt[0] == 4 && len >= 7 && len <= 3 + 255 && (pkt[1] == 0x0e || pkt[1] == 0x0f)) {
+		bt_pend_answered(pkt, len);
+		/* Command Complete / Status: bt_hci_compat may rewrite it (and make it longer) */
+		for (i = 0; i < len; i++) {
+			ev[i] = pkt[i];
+		}
+		len = bt_hci_compat(ev, len);
+		pkt = ev;
+	}
+	lck_mtx_lock(&bt_lock);
+	used = bt.wr - bt.rd;
+	if (BT_RING_SIZE - used < len) {
+		bt.rx_drop_pkts++;              /* whole packets only: the H4 framing must survive */
+		lck_mtx_unlock(&bt_lock);
+		return;
+	}
+	for (i = 0; i < len; i++) {
+		bt_ring[(bt.wr + i) & BT_RING_MASK] = pkt[i];
+	}
+	bt.wr += len;
+	if (used + len > bt.ring_peak) {
+		bt.ring_peak = used + len;
+	}
+	bt.rx_pkts++;
+	bt.rx_bytes += len;
+	bt_log_pkt("RX", pkt, len);
+	lck_mtx_unlock(&bt_lock);
+}
+
+/*
+ * Called by the RX thread every iteration, without the UART lock. Moves ring bytes into the
+ * socket. A full socket buffer (userland slow) is plain flow control: the bytes stay in the
+ * ring and the next call retries; if the ring itself fills, whole packets are dropped above.
+ */
+void
+sweet_bt_hci_rx_service(void)
+{
+	bt_pend_check();
+	for (unsigned loops = 0; loops < 16; loops++) {
+		kern_ctl_ref ref;
+		uint32_t unit, rd;
+		unsigned n, ep, i;
+		errno_t err;
+
+		lck_mtx_lock(&bt_lock);
+		if (!bt.connected) {
+			lck_mtx_unlock(&bt_lock);
+			return;
+		}
+		ref = bt.conn_ref;
+		unit = bt.conn_unit;
+		ep = bt.epoch;
+		rd = bt.rd;
+		n = bt.wr - rd;
+		if (n > BT_STAGE_SIZE) {
+			n = BT_STAGE_SIZE;
+		}
+		for (i = 0; i < n; i++) {
+			bt_stage[i] = bt_ring[(rd + i) & BT_RING_MASK];
+		}
+		lck_mtx_unlock(&bt_lock);
+		if (n == 0) {
+			return;
+		}
+		err = ctl_enqueuedata(ref, unit, bt_stage, n, 0);
+		if (err != 0) {
+			bt.enq_fail++;          /* ENOBUFS: socket buffer full, retry next round */
+			return;
+		}
+		bt.enq_ok++;
+		lck_mtx_lock(&bt_lock);
+		if (bt.epoch == ep) {
+			bt.rd = rd + n;
+		}
+		lck_mtx_unlock(&bt_lock);
+	}
+}
+
+/* ------------------------------------------------------------ TX: socket -> H4 framer -> UART */
+
+static unsigned
+bt_tx_hdrlen(uint8_t type)
+{
+	switch (type) {
+	case 1:  return 3;      /* opcode, plen */
+	case 2:  return 4;      /* handle, dlen16 */
+	case 3:  return 3;      /* handle, dlen8 */
+	case 5:  return 4;      /* handle, dlen14 */
+	default: return 0;
+	}
+}
+
+static unsigned
+bt_tx_paylen(const uint8_t *p)
+{
+	switch (p[0]) {
+	case 1:  return p[3];
+	case 2:  return p[3] | (p[4] << 8);
+	case 3:  return p[3];
+	default: return (p[3] | (p[4] << 8)) & 0x3fff;
+	}
+}
+
+static void
+bt_tx_feed(const uint8_t *p, size_t n)
+{
+	for (size_t i = 0; i < n; i++) {
+		uint8_t b = p[i];
+
+		if (bt.txn == 0) {
+			if (bt_tx_hdrlen(b) == 0) {
+				if (bt.tx_garbage++ < 8) {
+					printf("SWEET BT: TX: byte %#04x is not an H4 packet type, dropped\n", b);
+				}
+				continue;
+			}
+			bt.txtotal = 0;
+		}
+		bt.txb[bt.txn++] = b;
+		if (bt.txtotal == 0 && bt.txn == 1 + bt_tx_hdrlen(bt.txb[0])) {
+			bt.txtotal = bt.txn + bt_tx_paylen(bt.txb);
+			if (bt.txtotal > sizeof(bt.txb)) {
+				printf("SWEET BT: TX: %s packet of %u bytes does not fit, dropped\n", bt_h4_name(bt.txb[0]),
+				    bt.txtotal);
+				bt.txn = bt.txtotal = 0;
+				continue;
+			}
+		}
+		if (bt.txtotal != 0 && bt.txn == bt.txtotal) {
+			bt_log_pkt("TX", bt.txb, bt.txn);
+			bt_cmd_note(bt.txb, bt.txn);
+			if (bt_hci_local_answer(bt.txb, bt.txn)) {
+				bt.tx_pkts++;
+			} else if ((bt_pend_set(bt.txb, bt.txn), bt.ops->tx(bt.txb, bt.txn))) {
+				bt.tx_pkts++;
+				bt.tx_bytes += bt.txn;
+			} else {
+				bt.tx_fail++;
+				printf("SWEET BT: TX: UART transmit of a %s packet (%u bytes) failed\n",
+				    bt_h4_name(bt.txb[0]), bt.txn);
+			}
+			bt.txn = bt.txtotal = 0;
+		}
+	}
+}
+
+static errno_t
+bt_ctl_send(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, mbuf_t m, int flags)
+{
+#pragma unused(ref, unit, unitinfo, flags)
+	mbuf_t seg;
+
+	for (seg = m; seg != NULL; seg = mbuf_next(seg)) {
+		size_t len = mbuf_len(seg);
+		if (len != 0) {
+			bt_tx_feed((const uint8_t *)mbuf_data(seg), len);
+		}
+	}
+	mbuf_freem(m);
+	return 0;
+}
+
+/* ------------------------------------------------------------ connect / disconnect / termios */
+
+static errno_t
+bt_ctl_connect(kern_ctl_ref ref, struct sockaddr_ctl *sac, void **unitinfo)
+{
+	lck_mtx_lock(&bt_lock);
+	if (bt.connected) {
+		lck_mtx_unlock(&bt_lock);
+		printf("SWEET BT: connect refused: already connected (unit %u)\n", bt.conn_unit);
+		return EBUSY;
+	}
+	bt.connected = true;
+	bt.conn_ref = ref;
+	bt.conn_unit = sac->sc_unit;
+	bt.rd = bt.wr = 0;
+	bt.epoch++;
+	bt.txn = bt.txtotal = 0;
+	bt.connects++;
+	lck_mtx_unlock(&bt_lock);
+	*unitinfo = &bt;
+	printf("SWEET BT: client connected (ctl id %u unit %u)\n", sac->sc_id, sac->sc_unit);
+	return 0;
+}
+
+static errno_t
+bt_ctl_disconnect(kern_ctl_ref ref, u_int32_t unit, void *unitinfo)
+{
+#pragma unused(ref, unitinfo)
+	lck_mtx_lock(&bt_lock);
+	if (bt.connected && bt.conn_unit == unit) {
+		bt.connected = false;
+		bt.rd = bt.wr = 0;
+		bt.epoch++;
+		bt.txn = bt.txtotal = 0;
+	}
+	lck_mtx_unlock(&bt_lock);
+	printf("SWEET BT: client disconnected (unit %u)\n", unit);
+	sweet_bt_hci_stats_periodic(true);
+	return 0;
+}
+
+static errno_t
+bt_ctl_setopt(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, int opt, void *data, size_t len)
+{
+#pragma unused(ref, unit, unitinfo)
+	switch ((unsigned)opt) {
+	case BT_TIOCSETA:
+	case BT_TIOCSETAW:
+	case BT_TIOCSETAF: {
+		struct bt_termios t;
+		unsigned actual;
+
+		if (data == NULL || len != sizeof(t)) {
+			return EINVAL;
+		}
+		memcpy(&t, data, sizeof(t));
+		bt.tios_set++;
+		/*
+		 * The controller's speed was fixed by the vendor baud command during the firmware
+		 * step (3 Mbaud, HW flow control). Accept whatever userland asks for, keep the line as
+		 * it is and answer with the speed really in effect (the get returns it too).
+		 */
+		actual = bt.ops->baud((unsigned)t.c_ospeed);
+		if (t.c_ospeed != actual && bt.baud_req_ignored++ < 8) {
+			printf("SWEET BT: termios set: requested %lu baud, line stays at %u\n", t.c_ospeed, actual);
+		}
+		if (!(t.c_cflag & BT_CRTSCTS) && bt.baud_req_ignored < 8) {
+			printf("SWEET BT: termios set: hardware flow control off requested, kept on\n");
+		}
+		if (bt.tios_set <= 4) {
+			printf("SWEET BT: termios set (opt %#x): iflag %#lx oflag %#lx cflag %#lx lflag %#lx speed %lu/%lu\n",
+			    (unsigned)opt, t.c_iflag, t.c_oflag, t.c_cflag, t.c_lflag, t.c_ispeed, t.c_ospeed);
+		}
+		t.c_ispeed = t.c_ospeed = actual;
+		t.c_cflag |= BT_CRTSCTS;
+		bt.tio = t;
+		return 0;
+	}
+	default:
+		return ENOTSUP;
+	}
+}
+
+static errno_t
+bt_ctl_getopt(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, int opt, void *data, size_t *len)
+{
+#pragma unused(ref, unit, unitinfo)
+	if ((unsigned)opt != BT_TIOCGETA) {
+		return ENOTSUP;
+	}
+	if (data == NULL) {
+		*len = sizeof(bt.tio);
+		return 0;
+	}
+	if (*len < sizeof(bt.tio)) {
+		return EINVAL;
+	}
+	bt.tio.c_ispeed = bt.tio.c_ospeed = bt.ops->baud(0);
+	bt.tio.c_cflag |= BT_CRTSCTS;
+	memcpy(data, &bt.tio, sizeof(bt.tio));
+	*len = sizeof(bt.tio);
+	if (bt.tios_get++ < 4) {
+		printf("SWEET BT: termios get: speed %lu cflag %#lx\n", bt.tio.c_ospeed, bt.tio.c_cflag);
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------ statistics */
+
+void
+sweet_bt_hci_stats_periodic(bool force)
+{
+	if (!bt.up) {
+		return;
+	}
+	if (!force && bt.last_rx_pkts == bt.rx_pkts && bt.last_tx_pkts == bt.tx_pkts) {
+		return;
+	}
+	bt.last_rx_pkts = bt.rx_pkts;
+	bt.last_tx_pkts = bt.tx_pkts;
+	printf("SWEET BT: HCI: rx %u pkts / %llu B (ring peak %u of %u B, dropped %u pkts full + %u not connected, "
+	    "socket full %u of %u enqueues), tx %u pkts / %llu B (%u failed, %u garbage), connects %u\n",
+	    bt.rx_pkts, bt.rx_bytes, bt.ring_peak, BT_RING_SIZE, bt.rx_drop_pkts, bt.rx_drop_nc, bt.enq_fail,
+	    bt.enq_fail + bt.enq_ok, bt.tx_pkts, bt.tx_bytes, bt.tx_fail, bt.tx_garbage, bt.connects);
+}
+
+/* ------------------------------------------------------------ registration */
+
+static errno_t
+bt_reg_one(const char *name, kern_ctl_ref *out)
+{
+	struct kern_ctl_reg r;
+
+	bzero(&r, sizeof(r));
+	strlcpy(r.ctl_name, name, sizeof(r.ctl_name));
+	r.ctl_flags = CTL_FLAG_REG_SOCK_STREAM;         /* not privileged: bluetoothd and BlueTool run as mobile */
+	r.ctl_sendsize = BT_CTL_SEND;
+	r.ctl_recvsize = BT_CTL_RECV;
+	r.ctl_connect = bt_ctl_connect;
+	r.ctl_disconnect = bt_ctl_disconnect;
+	r.ctl_send = bt_ctl_send;
+	r.ctl_setopt = bt_ctl_setopt;
+	r.ctl_getopt = bt_ctl_getopt;
+	return ctl_register(&r, out);
+}
+
+void
+sweet_bt_hci_register(const struct bt_hci_ops *ops, unsigned sk_alias, unsigned log_budget)
+{
+	errno_t err;
+
+	if (bt.up) {
+		return;
+	}
+	bt.ops = ops;
+	bt.log_budget = log_budget;
+	bt.compat = 2;
+	bt.err_budget = 64;
+	(void)PE_parse_boot_argn("sweetbtcompat", &bt.compat, sizeof(bt.compat));
+	printf("SWEET BT: compat %u (unknown commands answered as success: %s)\n", bt.compat,
+	    bt.compat >= 2 ? "standard and Broadcom vendor" : bt.compat ? "standard only" : "off");
+	/* raw mode as bluetoothd would set it (cfmakeraw, 8N1, hw flow control); the speed is filled in on get */
+	bt.tio.c_cflag = 0x38B00ul;
+	bt.tio.c_ispeed = bt.tio.c_ospeed = ops->baud(0);
+	err = bt_reg_one(BT_CTL_NAME, &bt.ref[0]);
+	printf("SWEET BT: kernel control %s registered: %d\n", BT_CTL_NAME, (int)err);
+	if (err != 0) {
+		return;
+	}
+	bt.nref = 1;
+	bt.up = true;
+	if (sk_alias) {
+		/*
+		 * Same stream under the Skywalk name. bluetoothd would still need the IOAOSSKY* socket
+		 * options for it (not implemented), so this is only useful for plain-socket clients.
+		 */
+		err = bt_reg_one(BT_CTL_NAME_SK, &bt.ref[1]);
+		printf("SWEET BT: kernel control %s registered: %d\n", BT_CTL_NAME_SK, (int)err);
+		if (err == 0) {
+			bt.nref = 2;
+		}
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_charger_pm6150.c b/bsd/dev/sweet_charger_pm6150.c
new file mode 100644
index 0000000..5096347
--- /dev/null
+++ b/bsd/dev/sweet_charger_pm6150.c
@@ -0,0 +1,290 @@
+/*
+ * 0199: PM6150 charger (SMB5) input-current setup.
+ *
+ * Observed (0195b, logs/boot-0195b.txt): on USB at 14 %, "SWEET BATTERY: ... -122mA external=1
+ * charging=1": the charger is in fast charge but the battery still drains about 100 mA, so the
+ * input current limit is below the phone's load (the USER: "battery drained even though
+ * connected"). Nothing in this kernel ever configured the charger; it runs with what XBL/ABL left.
+ *
+ * Register map and the input-current-limit sequence are Xiaomi's own sweet kernel
+ * (MiCode/Xiaomi_Kernel_OpenSource sweet-r-oss, drivers/power/supply/qcom/smb5-reg.h, smb5-lib.c
+ * smblib_set_icl_current/smblib_icl_override, qpnp-smb5.c pm6150 charge params): SID 0, CHGR 0x1000,
+ * DCDC 0x1100, BATIF 0x1200, USBIN 0x1300, TYPEC 0x1500, MISC 0x1600; ICL 0x1370 and FCC 0x1061 in
+ * 50 mA steps. The sunfish port's read-only dump of the same PMIC (ios-flame
+ * docs/reference/charger-regs.md) showed XBL leaving FCC 2.0 A / ICL 1.5 A there.
+ *
+ *   sweetcharge=1  read only: one register dump (CHGR/DCDC/BATIF/USBIN/TYPEC/MISC) at start and after
+ *                  each plug-in, a status line on every change and every 60 s
+ *   sweetcharge=2  ... and the input current limit set from the detected source, as smblib does in
+ *                  high-current mode (USBIN_MODE_CHG=1, no ICL override, ICL kept after APSD):
+ *                    Type-C Rp 3.0 A: 2000 mA, Rp 1.5 A: 1500 mA, DCP/QC: 1500 mA, CDP: 1500 mA,
+ *                    float/other: 1000 mA, SDP (a PC port): sweetchgsdp (default 500 = left alone;
+ *                    900 or 1500 only if the charger's AICL is enabled, which backs off on a weak port);
+ *                    capped at sweetchgmax (default 2000, at most 3000). A target of 500 mA or less is
+ *                    never written. FCC (battery charge current) is raised to 2000 mA only if it is
+ *                    lower (0.4 C for the 5020 mAh cell). USB input suspend is cleared, charging enable
+ *                    set when the charger says disabled, the charger watchdog petted when it is enabled.
+ *                  Float voltage, JEITA, termination and safety timers are never written.
+ * Every write is to a fixed whitelist (bsd/dev/sweet_spmi.c sweet_spmi_write_sm6150), read back and logged.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+
+extern kern_return_t thread_terminate(thread_t);
+void sweet_charger_init(void);
+
+#define CHG_STATUS_1    0x1006u
+#define CHG_STATUS_2    0x1007u
+#define CHG_EN_CMD      0x1042u
+#define CHG_FCC         0x1061u
+#define CHG_FV          0x1070u
+#define DCDC_ICL_MAX    0x1106u
+#define DCDC_ICL_STS    0x1107u
+#define DCDC_AICL_STS   0x110au
+#define DCDC_PATH       0x110bu
+#define USB_APSD_STS    0x1307u
+#define USB_APSD_RES    0x1308u
+#define USB_RT_STS      0x1310u
+#define USB_CMD_IL      0x1340u
+#define USB_CMD_ICL_OVR 0x1342u
+#define USB_LOAD_CFG    0x1365u
+#define USB_ICL_OPTS    0x1366u
+#define USB_ICL         0x1370u
+#define USB_AICL_OPTS   0x1380u
+#define TYPEC_SNK_STS   0x1506u
+#define MISC_WD_PET     0x1643u
+#define MISC_WD_CFG     0x1651u
+#define MISC_WD_BITE    0x1653u
+
+static int chg_mode, chg_sdp_ma = 500, chg_max_ma = 2000;
+static int chg_chan;
+static unsigned chg_writes, chg_dumps;
+
+static void
+chg_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&chg_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint8_t
+chg_rd(unsigned addr, bool *ok)
+{
+	uint8_t v = 0;
+	if (sweet_spmi_read(0, addr, &v) != 0) {
+		*ok = false;
+	}
+	return v;
+}
+
+/* masked write, read back; false on any failure */
+static bool
+chg_wr(unsigned addr, uint8_t mask, uint8_t val, const char *why)
+{
+	bool ok = true;
+	uint8_t old = chg_rd(addr, &ok);
+	if (!ok) {
+		printf("SWEET CHARGER: %s: read %#x failed, not written\n", why, addr);
+		return false;
+	}
+	uint8_t want = (uint8_t)((old & ~mask) | (val & mask));
+	if (want == old) {
+		return true;
+	}
+	int err = sweet_spmi_write_sm6150(0, addr, want);
+	uint8_t now = chg_rd(addr, &ok);
+	chg_writes++;
+	printf("SWEET CHARGER: %s: %#x %#04x -> %#04x: err %d, reads %#04x%s\n", why, addr, old, want, err,
+	    now, (!err && ok && (now & mask) == (want & mask)) ? "" : " MISMATCH");
+	return !err && ok && (now & mask) == (want & mask);
+}
+
+static void
+chg_dump(const char *why)
+{
+	static const unsigned bases[] = {0x1000, 0x1100, 0x1200, 0x1300, 0x1500, 0x1600};
+	if (chg_dumps++ >= 6) {
+		return;
+	}
+	printf("SWEET CHARGER: register dump (%s)\n", why);
+	for (unsigned b = 0; b < sizeof(bases) / sizeof(bases[0]); b++) {
+		for (unsigned row = 0; row < 0x90; row += 16) {
+			char line[3 * 16 + 1];
+			unsigned n = 0;
+			for (unsigned i = 0; i < 16; i++) {
+				uint8_t v = 0;
+				if (sweet_spmi_read(0, bases[b] + row + i, &v) == 0) {
+					snprintf(line + n, sizeof(line) - n, " %02x", v);
+				} else {
+					snprintf(line + n, sizeof(line) - n, " ??");
+				}
+				n += 3;
+			}
+			printf("SWEET CHARGER: %04x:%s\n", bases[b] + row, line);
+		}
+	}
+}
+
+static const char *
+chg_state_name(unsigned s)
+{
+	static const char *names[] = {"inhibit", "trickle", "pre", "fast", "taper", "terminate", "pause", "disabled"};
+	return names[s & 7u];
+}
+
+static const char *
+chg_apsd_name(uint8_t res)
+{
+	res &= 0x7fu;
+	return (res & 0x40u) ? "QC3" : (res & 0x20u) ? "QC2" : (res & 0x10u) ? "float" : (res & 0x08u) ? "DCP" :
+	       (res & 0x04u) ? "CDP" : (res & 0x02u) ? "OCP" : (res & 0x01u) ? "SDP" : "none";
+}
+
+/* the source's current from APSD and Type-C, before the cap */
+static int
+chg_target_ma(uint8_t apsd_res, uint8_t snk, bool aicl)
+{
+	int ma = 0;
+	apsd_res &= 0x7fu;
+	if (snk & 0x02u) {
+		ma = 2000;
+	} else if (snk & 0x04u) {
+		ma = 1500;
+	}
+	int a = 0;
+	if (apsd_res & (0x40u | 0x20u | 0x08u | 0x04u)) {
+		a = 1500;
+	} else if (apsd_res & (0x10u | 0x02u)) {
+		a = 1000;
+	} else if (apsd_res & 0x01u) {
+		a = (chg_sdp_ma > 500 && aicl) ? chg_sdp_ma : 500;
+	}
+	ma = a > ma ? a : ma;
+	return ma > chg_max_ma ? chg_max_ma : ma;
+}
+
+static void
+chg_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	chg_sleep(30000);     /* SweetBattery maps the SPMI arbiter at its start */
+	if (sweet_spmi_init() != 0) {
+		printf("SWEET CHARGER: SPMI not ready; stop\n");
+		goto out;
+	}
+	printf("SWEET CHARGER: mode %d (sweetcharge), SDP %d mA, max %d mA\n", chg_mode, chg_sdp_ma, chg_max_ma);
+	chg_dump("start");
+	bool was_present = false, dumped_plug = false;
+	uint8_t last[12] = {0};
+	unsigned tick = 0, quiet = 0, applied_for = 0xffffu;
+	for (;; tick++) {
+		bool ok = true;
+		uint8_t st1 = chg_rd(CHG_STATUS_1, &ok), st2 = chg_rd(CHG_STATUS_2, &ok);
+		uint8_t en = chg_rd(CHG_EN_CMD, &ok), fcc = chg_rd(CHG_FCC, &ok);
+		uint8_t icl_max = chg_rd(DCDC_ICL_MAX, &ok), icl_sts = chg_rd(DCDC_ICL_STS, &ok);
+		uint8_t aicl = chg_rd(DCDC_AICL_STS, &ok), path = chg_rd(DCDC_PATH, &ok);
+		uint8_t apsd = chg_rd(USB_APSD_STS, &ok), res = chg_rd(USB_APSD_RES, &ok);
+		uint8_t rt = chg_rd(USB_RT_STS, &ok), susp = chg_rd(USB_CMD_IL, &ok);
+		uint8_t opts = chg_rd(USB_ICL_OPTS, &ok), ovr = chg_rd(USB_CMD_ICL_OVR, &ok);
+		uint8_t load = chg_rd(USB_LOAD_CFG, &ok), icl = chg_rd(USB_ICL, &ok);
+		uint8_t aopt = chg_rd(USB_AICL_OPTS, &ok), snk = chg_rd(TYPEC_SNK_STS, &ok);
+		uint8_t wd = chg_rd(MISC_WD_CFG, &ok), bite = chg_rd(MISC_WD_BITE, &ok);
+		if (!ok) {
+			if ((tick % 30u) == 0) {
+				printf("SWEET CHARGER: register read failed (tick %u)\n", tick);
+			}
+			chg_sleep(2000);
+			continue;
+		}
+		bool present = (rt & 0x10u) != 0, apsd_done = (apsd & 0x01u) != 0;
+		uint8_t now[12] = {st1 & 7u, st2, en, fcc, icl_sts, path, res, rt & 0x10u, opts, icl, snk, susp};
+		bool changed = memcmp(now, last, sizeof(now)) != 0;
+		if (changed || ++quiet >= 30) {
+			quiet = 0;
+			memcpy(last, now, sizeof(now));
+			printf("SWEET CHARGER: usb %d apsd %#x/%#x %s typec %#x chg %s err %#x en %#x | icl cfg %u mA "
+			    "now %u max %u aicl %#x opts %#x ovr %#x load %#x aiclopt %#x susp %#x | fcc %u mA fv %#x "
+			    "path %#x wd %#x/%#x\n",
+			    present, apsd, res, chg_apsd_name(res), snk, chg_state_name(st1), st2, en, icl * 50u,
+			    icl_sts * 50u, icl_max * 50u, aicl, opts, ovr, load, aopt, susp, fcc * 50u,
+			    chg_rd(CHG_FV, &ok), path, wd, bite);
+		}
+		if (present && !was_present) {
+			dumped_plug = false;
+			applied_for = 0xffffu;
+		}
+		was_present = present;
+		if (present && apsd_done && !dumped_plug) {
+			dumped_plug = true;
+			chg_dump("plugged in, APSD done");
+		}
+		/* the charger watchdog, if XBL armed it: pet every pass (bite is 8 s at the shortest) */
+		if (chg_mode >= 2 && (wd & 0x02u)) {
+			(void)sweet_spmi_write_sm6150(0, MISC_WD_PET, 0x01);
+		}
+		if (chg_mode >= 2 && present && apsd_done && chg_writes < 200) {
+			int target = chg_target_ma(res, snk, (aopt & 0x04u) != 0);
+			unsigned key = ((unsigned)res << 8) | snk;
+			/* re-check every 10 s: a re-run APSD/replug can put the hardware's own limit back */
+			if (key != applied_for || (tick % 5u) == 0) {
+				if (key != applied_for) {
+					printf("SWEET CHARGER: source %s (apsd %#x, typec %#x, aicl %s): target %d mA\n",
+					    chg_apsd_name(res), res, snk, (aopt & 0x04u) ? "on" : "off", target);
+				}
+				applied_for = key;
+				if (susp & 0x01u) {
+					(void)chg_wr(USB_CMD_IL, 0x01, 0x00, "USB input unsuspend");
+				}
+				if (target > 500 && icl != (uint8_t)(target / 50)) {
+					/* smblib_set_icl_current, high-current path: limit, then SW_OVERRIDE_HC_MODE */
+					(void)(chg_wr(USB_ICL, 0xff, (uint8_t)(target / 50), "input current limit") &&
+					    chg_wr(USB_ICL_OPTS, 0x01, 0x01, "HC mode (USBIN_MODE_CHG)") &&
+					    chg_wr(USB_CMD_ICL_OVR, 0x01, 0x00, "no ICL override") &&
+					    chg_wr(USB_LOAD_CFG, 0x10, 0x10, "keep ICL after APSD"));
+				}
+				if (fcc < 2000u / 50u) {
+					(void)chg_wr(CHG_FCC, 0xff, 2000u / 50u, "fast charge current");
+				}
+				if ((st1 & 7u) == 7u && !(en & 0x01u)) {
+					(void)chg_wr(CHG_EN_CMD, 0x01, 0x01, "charging enable");
+				}
+			}
+		}
+		chg_sleep(2000);
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_charger_init(void)
+{
+	static bool started;
+	(void)PE_parse_boot_argn("sweetcharge", &chg_mode, sizeof(chg_mode));
+	(void)PE_parse_boot_argn("sweetchgsdp", &chg_sdp_ma, sizeof(chg_sdp_ma));
+	(void)PE_parse_boot_argn("sweetchgmax", &chg_max_ma, sizeof(chg_max_ma));
+	if (chg_sdp_ma != 900 && chg_sdp_ma != 1500) {
+		chg_sdp_ma = 500;
+	}
+	if (chg_max_ma < 500 || chg_max_ma > 3000) {
+		chg_max_ma = 2000;
+	}
+	if (chg_mode <= 0 || started) {
+		return;
+	}
+	started = true;
+	thread_t th;
+	if (kernel_thread_start(chg_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+		printf("SWEET CHARGER: armed (30 s), sweetcharge=%d\n", chg_mode);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_dark.c b/bsd/dev/sweet_dark.c
new file mode 100644
index 0000000..5c8df9d
--- /dev/null
+++ b/bsd/dev/sweet_dark.c
@@ -0,0 +1,101 @@
+/*
+ * 0200: display-dark power state for sweet. Adapted from ios-flame (Pixel 4a "sunfish" port, MIT)
+ * xnu 0242 "display-dark idle" (itself after akshaynexus/iOSPlus10 0382 "power idle", MIT) and 0257
+ * "dark clocks".
+ *
+ * AppleCLCD's RequestPowerChange (SweetFramebuffer.cpp; backboardd sends it when the screen locks or
+ * wakes) calls sweet_dark_set(). While dark:
+ *   - the panel sleeps (DCS 28 display off, 10 sleep in; on wake 11 sleep out, 29 display on), see
+ *     SweetFramebuffer.cpp (sweetpanelsleep=1), instead of a CPU fade of a lit black frame
+ *   - USB ud_thread polls every 20 ms instead of 1 ms once the host link was quiet for 2 s (any
+ *     event or queued frame -> 1 ms at once); the USB log thread every 250 ms instead of 100 ms
+ *   - touch polling stops while no finger is down; keys poll every 40 ms instead of 20 ms
+ *   - the framebuffer tick runs every 500 ms after 5 s dark (instead of 120 Hz)
+ *   - CPU clocks: A55 at most ~1.25 GHz, A76 at most ~0.65 GHz (SweetCPU.cpp sweet_cpufreq_dark;
+ *     cpufreq-hw LUT rows), restored on wake
+ * Boot-arg sweetdark=0: nothing changes (the flag stays 0). sweetdarkclk=0 keeps the CPU clocks.
+ * kern.sweet_display_dark (read-only) shows the state.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+
+void sweet_dark_set(int dark);
+void sweet_dark_sleep(uint32_t ms);
+extern void sweet_cpufreq_dark(int dark);   /* iokit/Kernel/arm/SweetCPU.cpp */
+
+int sweet_display_dark;                 /* 1 while the display is off (and sweetdark=1) */
+const uint32_t sweet_dark_usb_ms = 20;
+const uint32_t sweet_dark_usblog_ms = 250;
+const uint32_t sweet_dark_keys_ms = 40;
+const uint32_t sweet_dark_fb_ms = 500;
+const uint32_t sweet_dark_fb_after_ms = 5000;
+static int sweet_dark_enabled = -1, sweet_dark_clk = 1;
+static unsigned sweet_dark_cycles;
+
+SYSCTL_INT(_kern, OID_AUTO, sweet_display_dark, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_display_dark, 0,
+    "SWEET: display off, kernel pollers slowed (0200)");
+
+void
+sweet_dark_set(int dark)
+{
+	if (sweet_dark_enabled < 0) {
+		int en = 1;
+		(void)PE_parse_boot_argn("sweetdark", &en, sizeof(en));
+		(void)PE_parse_boot_argn("sweetdarkclk", &sweet_dark_clk, sizeof(sweet_dark_clk));
+		sweet_dark_enabled = en != 0;
+	}
+	if (!sweet_dark_enabled) {
+		return;
+	}
+	int was = __atomic_exchange_n(&sweet_display_dark, dark ? 1 : 0, __ATOMIC_SEQ_CST);
+	if (!dark) {
+		thread_wakeup((event_t)&sweet_display_dark);    /* slowed pollers restart now */
+	}
+	if (was == !!dark) {
+		return;
+	}
+	if (sweet_dark_clk) {
+		sweet_cpufreq_dark(dark);
+	}
+	if (dark) {
+		sweet_dark_cycles++;
+	}
+	if (sweet_dark_cycles <= 20) {
+		if (dark) {
+			printf("SWEET DARK: on (%u): usb %u ms (no traffic 2 s), usblog %u ms, touch stopped, keys %u ms, "
+			    "fb %u ms after %u ms, cpu clocks %s\n", sweet_dark_cycles, sweet_dark_usb_ms, sweet_dark_usblog_ms,
+			    sweet_dark_keys_ms, sweet_dark_fb_ms, sweet_dark_fb_after_ms, sweet_dark_clk ? "low" : "kept");
+		} else {
+			printf("SWEET DARK: off: usb 1 ms, usblog 100 ms, touch 10 ms, keys 20 ms, fb full rate, cpu clocks %s\n",
+			    sweet_dark_clk ? "restored" : "kept");
+		}
+	}
+}
+
+/*
+ * Sleep up to ms (0 = until the display comes on) on the dark channel. Returns at once if the display
+ * is already on again (the check after assert_wait: a sweet_dark_set(0) in between is not lost).
+ */
+void
+sweet_dark_sleep(uint32_t ms)
+{
+	if (ms) {
+		uint64_t deadline;
+		clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline((event_t)&sweet_display_dark, THREAD_UNINT, deadline);
+	} else {
+		(void)assert_wait((event_t)&sweet_display_dark, THREAD_UNINT);
+	}
+	if (!__atomic_load_n(&sweet_display_dark, __ATOMIC_SEQ_CST)) {
+		clear_wait(current_thread(), THREAD_AWAKENED);
+		return;
+	}
+	thread_block(THREAD_CONTINUE_NULL);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_files.c b/bsd/dev/sweet_files.c
new file mode 100644
index 0000000..53f6a8d
--- /dev/null
+++ b/bsd/dev/sweet_files.c
@@ -0,0 +1,355 @@
+/*
+ * File server for the running iOS root, over USB Ethernet: TCP
+ * 192.168.7.2:2223 (on the Mac: 127.0.0.1:2223 through FlameBridge,
+ * tools/flame-files.py). One request per connection, a header line then
+ * data:
+ *
+ *   PUT <path> <mode-octal> <size>\n<size bytes>  -> "OK <size>\n"  (root:wheel)
+ *   GET <path>\n                                  -> "OK <size>\n<bytes>"
+ *   MKDIR <path> <mode-octal>\n                   -> "OK\n"
+ *   LINK <target> <path>\n                        -> "OK\n"  (symlink)
+ *   RM <path>\n                                   -> "OK\n"
+ *   CHMOD <path> <mode-octal>\n                   -> "OK\n"
+ *   SYNC\n                                        -> "OK\n"  (0168)
+ *
+ * Errors: "ERR <errno>\n". Paths have no spaces. Started with the USB
+ * gadget (sweet_usb.c) when the interface comes up.
+ *
+ * ios-sweet 0168 (from ios-flame/sunfish 0091, tools/flame-files.py): root file access to the running
+ * system over the USB cable only. Boot-arg sweetfiles=1 enables it; it binds 192.168.7.2 (ue0) instead
+ * of every address, so it is not reachable over Wi-Fi, and closes connections from outside
+ * 192.168.7.0/24.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kernel.h>
+#include <sys/kauth.h>
+#include <sys/proc_internal.h>
+#include <sys/kpi_socket.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <netinet/in.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+
+extern int sweet_vfs_mkdir(const char *path, int mode);
+extern int sweet_vfs_symlink(const char *target, const char *link);
+extern int sweet_vfs_unlink(const char *path);
+extern kern_return_t thread_terminate(thread_t);
+struct sync_args;
+extern int sync(proc_t p, struct sync_args *uap, int32_t *retval);
+void sweet_files_start(void);
+
+#define SF_BUF  (64 * 1024)
+
+static char *sf_buf;
+static int sf_chan;
+
+static void
+sf_sleep_ms(int ms)
+{
+	(void)tsleep(&sf_chan, PZERO, "sweetfiles", MAX(1, ms * hz / 1000));
+}
+
+static unsigned long long
+sf_dec(const char *p)
+{
+	unsigned long long v = 0;
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p >= '0' && *p <= '9') {
+		v = v * 10 + (unsigned)(*p++ - '0');
+	}
+	return v;
+}
+
+static int
+sf_recv(socket_t so, void *buf, size_t len, size_t *got, int flags)
+{
+	struct iovec iov = { .iov_base = buf, .iov_len = len };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	return sock_receive(so, &msg, flags, got);
+}
+
+static int
+sf_recv_all(socket_t so, void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		size_t got = 0;
+		int err = sf_recv(so, (char *)buf + off, len - off, &got, MSG_WAITALL);
+		if (err) {
+			return err;
+		}
+		if (got == 0) {
+			return ECONNRESET;
+		}
+		off += got;
+	}
+	return 0;
+}
+
+static int
+sf_send(socket_t so, const void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		struct iovec iov = { .iov_base = (char *)buf + off, .iov_len = len - off };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		int err = sock_send(so, &msg, 0, &sent);
+		if (err) {
+			return err;
+		}
+		off += sent;
+	}
+	return 0;
+}
+
+static void
+sf_reply(socket_t so, int err, uint64_t n, bool with_n)
+{
+	char line[48];
+	int len = err ? snprintf(line, sizeof(line), "ERR %d\n", err) :
+	    with_n ? snprintf(line, sizeof(line), "OK %llu\n", n) : snprintf(line, sizeof(line), "OK\n");
+	(void)sf_send(so, line, (size_t)len);
+}
+
+/* Header line: up to '\n', read byte by byte so data after it stays queued. */
+static int
+sf_line(socket_t so, char *line, size_t max)
+{
+	size_t n = 0;
+	while (n + 1 < max) {
+		size_t got = 0;
+		int err = sf_recv(so, line + n, 1, &got, MSG_WAITALL);
+		if (err || got == 0) {
+			return err ? err : ECONNRESET;
+		}
+		if (line[n] == '\n') {
+			break;
+		}
+		n++;
+	}
+	line[n] = 0;
+	return 0;
+}
+
+static int
+sf_setattr(const char *path, int mode, bool owner)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	if (owner) {
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+	}
+	err = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return err;
+}
+
+static int
+sf_put(socket_t so, const char *path, int mode, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	uint64_t off = 0;
+	while (off < size) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, size - off);
+		int rerr = sf_recv_all(so, sf_buf, chunk);
+		if (rerr) {
+			err = err ? err : rerr;
+			break;
+		}
+		if (!err) {
+			int resid = 0;
+			err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid) {
+				err = EIO;
+			}
+		}
+		off += chunk;
+	}
+	if (vp != NULLVP) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	if (!err) {
+		err = sf_setattr(path, mode, true);
+	}
+	return err;
+}
+
+static int
+sf_get(socket_t so, const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+	}
+	if (err) {
+		if (vp != NULLVP) {
+			vnode_close(vp, FREAD, ctx);
+		}
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	sf_reply(so, 0, (uint64_t)size, true);
+	for (off_t off = 0; off < size && !err;) {
+		int chunk = (int)MIN((off_t)SF_BUF, size - off), resid = 0;
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, off, UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err) {
+			err = sf_send(so, sf_buf, (size_t)(chunk - resid));
+		}
+		off += chunk;
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+static void
+sf_handle(socket_t so)
+{
+	static char line[1100];
+	char a[512], b[512];
+	unsigned long long n = 0;
+	int err = sf_line(so, line, sizeof(line));
+	if (err) {
+		return;
+	}
+	a[0] = b[0] = 0;
+	if (!strncmp(line, "PUT ", 4)) {
+		unsigned mode = 0644;
+		char *p = line + 4, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		mode = (unsigned)strtoul(sp + 1, &p, 8);
+		n = sf_dec(p);
+		err = sf_put(so, a, (int)mode, n);
+		printf("SWEET FILES: PUT %s %o %llu -> %d\n", a, mode, n, err);
+		sf_reply(so, err, n, true);
+		return;
+	}
+	if (!strncmp(line, "GET ", 4)) {
+		err = sf_get(so, line + 4);
+		printf("SWEET FILES: GET %s -> %d\n", line + 4, err);
+		return;
+	}
+	if (!strcmp(line, "SYNC")) {
+		/* flush written files before a forced reboot (0168) */
+		int32_t rv = 0;
+		err = sync(kernproc, NULL, &rv);
+		printf("SWEET FILES: SYNC -> %d\n", err);
+		sf_reply(so, err, 0, false);
+		return;
+	}
+	char *sp = strchr(line, ' ');
+	if (!sp) {
+		sf_reply(so, EINVAL, 0, false);
+		return;
+	}
+	*sp = 0;
+	char *arg1 = sp + 1, *arg2 = strchr(arg1, ' ');
+	if (arg2) {
+		*arg2++ = 0;
+	}
+	if (!strcmp(line, "MKDIR")) {
+		err = sweet_vfs_mkdir(arg1, arg2 ? (int)strtoul(arg2, NULL, 8) : 0755);
+		if (err == EEXIST) {
+			err = 0;
+		}
+	} else if (!strcmp(line, "LINK") && arg2) {
+		err = sweet_vfs_symlink(arg1, arg2);
+	} else if (!strcmp(line, "RM")) {
+		err = sweet_vfs_unlink(arg1);
+	} else if (!strcmp(line, "CHMOD") && arg2) {
+		err = sf_setattr(arg1, (int)strtoul(arg2, NULL, 8), false);
+	} else {
+		err = EINVAL;
+	}
+	printf("SWEET FILES: %s %s %s -> %d\n", line, arg1, arg2 ? arg2 : "", err);
+	sf_reply(so, err, 0, false);
+}
+
+static void
+sf_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t ls = NULL;
+	struct sockaddr_in me;
+	int one = 1;
+
+	sf_buf = kalloc_data(SF_BUF, Z_WAITOK);
+	for (;;) {
+		if (sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) == 0) {
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+			bzero(&me, sizeof(me));
+			me.sin_len = sizeof(me);
+			me.sin_family = AF_INET;
+			me.sin_port = htons(2223);
+			me.sin_addr.s_addr = htonl(0xc0a80702);   /* 192.168.7.2: ue0 only */
+			if (sock_bind(ls, (struct sockaddr *)&me) == 0 && sock_listen(ls, 4) == 0) {
+				break;
+			}
+			sock_close(ls);
+		}
+		ls = NULL;
+		sf_sleep_ms(1000);
+	}
+	printf("SWEET FILES: listening on tcp 2223\n");
+	for (;;) {
+		socket_t c = NULL;
+		struct sockaddr_in peer;
+		bzero(&peer, sizeof(peer));
+		if (sock_accept(ls, (struct sockaddr *)&peer, sizeof(peer), 0, NULL, NULL, &c) != 0 || c == NULL) {
+			sf_sleep_ms(100);
+			continue;
+		}
+		if (peer.sin_family != AF_INET || (ntohl(peer.sin_addr.s_addr) & 0xffffff00u) != 0xc0a80700u) {
+			printf("SWEET FILES: refused a connection from outside 192.168.7.0/24\n");
+			sock_close(c);
+			continue;
+		}
+		sf_handle(c);
+		sock_close(c);
+	}
+}
+
+void
+sweet_files_start(void)
+{
+	int on = 0;
+	PE_parse_boot_argn("sweetfiles", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(sf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
index 0000000..638a4d5
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,808 @@
+/*
+ * SWEET Adreno 618 bring-up. sweetgpu=1 reads GPUCC and command DB only.
+ * sweetgpu=2 adds deferred RPMh ARC READ transactions after touch power.
+ * sweetgpu=3 additionally raises only gfx.lvl and verifies the readback.
+ * sweetgpu=4 uses the new A618 core to power CX after fresh rail checks.
+ * sweetgpu=5 enables GMU/bus clocks and reads CX-side GMU/SMMU status.
+ * sweetgpu=6 additionally stages firmware while the M3 remains in reset.
+ * sweetgpu=7 additionally validates SMMU mappings and prepares HFI RAM.
+ * sweetgpu=8 cold-starts legacy GMU and exchanges real HFI messages.
+ * GX is firmware controlled. No CP/SQE or graphics submission yet.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/errno.h>
+#include "sweet_adreno.h"
+#include "sweet_adreno_cp.h"
+#include "sweet_adreno_dma.h"
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int sweet_rpmh_arc_probe(const char *res);
+extern int sweet_rpmh_arc_read(const char *res);
+extern int sweet_rpmh_arc_require(const char *res, unsigned minimum);
+extern int sweet_rpmh_arc_raise(const char *res, unsigned target_vlvl);
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_adreno_level_vote(unsigned level, uint32_t *vote, unsigned *mx_level);
+void sweet_gpu_probe(void);
+
+
+/* LOW_SVS is the first safe GPU corner; the write only raises gfx.lvl. */
+#define SWEET_GPU_GFX_TARGET 65u
+
+#define SWEET_GPUCC_PA       0x05090000u
+#define SWEET_GPUCC_SIZE     0x00009000u
+#define SWEET_GCC_PA         0x00100000u
+#define SWEET_GCC_SIZE       0x00072000u
+#define SWEET_GMU_PA         0x0506a000u
+#define SWEET_GMU_SIZE       0x00031000u
+#define SWEET_SMMU_PA        0x05040000u
+#define SWEET_SMMU_SIZE      0x00010000u
+#define GPU_CC_GX_BCR        0x1008u
+#define GPU_CC_GX_GDSCR      0x100cu
+#define GPU_CC_CX_GDSCR      0x106cu
+#define GPU_CC_CBCR_AHB      0x1078u
+#define GPU_CC_GX_DOMAIN     0x1508u
+#define GPU_CC_CX_HW_CTRL    0x1540u
+#define GDSC_PWR_ON          (1u << 31)
+#define GDSC_SW_COLLAPSE     (1u << 0)
+#define GDSC_HW_CONTROL      (1u << 1)
+#define GX_DOMAIN_CLAMP      (1u << 0)
+#define GX_BCR_BLK_ARES      (1u << 0)
+#define BRANCH_CLK_OFF       (1u << 31)
+#define BRANCH_CLK_ENABLE    (1u << 0)
+
+static vm_offset_t sweet_gpucc;
+static int sweet_gpu_probe_attempted;
+static int sweet_gpu_stage;
+
+/* All registers below are in GPUCC; none is in the Adreno/GMU aperture. */
+static const struct {
+	const char *name;
+	uint32_t offset;
+} sweet_gpu_branches[] = {
+	{ "AHB",          0x1078u },
+	{ "CX_APB",       0x1088u },
+	{ "CX_SNOC_DVM",  0x108cu },
+	{ "CX_GMU",       0x1098u },
+	{ "CXO",          0x109cu },
+	{ "CX_GFX3D",     0x10a4u },
+	{ "CX_GFX3D_SLV", 0x10a8u },
+	{ "GX_GFX3D",     0x1054u },
+	{ "GX_CXO",       0x1060u },
+	{ "GX_GMU",       0x1064u },
+};
+
+static uint32_t
+sweet_gpucc_read(uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(sweet_gpucc + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+/* XNU adapter: cookie is the mapped aperture base. */
+static uint32_t
+sweet_adreno_read(void *cookie, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)((vm_offset_t)cookie + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+sweet_adreno_write(void *cookie, uint32_t offset, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)((vm_offset_t)cookie + offset) = value;
+	__asm__ volatile("dsb oshst" ::: "memory");
+	(void)sweet_adreno_read(cookie, offset);
+}
+
+static uint64_t
+sweet_adreno_read64(void *cookie, uint32_t offset)
+{
+ uint64_t value = *(volatile uint64_t *)((vm_offset_t)cookie + offset);
+ __asm__ volatile("dmb oshld" ::: "memory");
+ return value;
+}
+static void
+sweet_adreno_write64(void *cookie, uint32_t offset, uint64_t value)
+{
+ __asm__ volatile("dmb oshst" ::: "memory");
+ *(volatile uint64_t *)((vm_offset_t)cookie + offset) = value;
+ __asm__ volatile("dsb oshst" ::: "memory");
+}
+static void
+sweet_adreno_barrier(void *cookie)
+{
+ (void)cookie;
+ __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sweet_adreno_delay(void *cookie, unsigned usec)
+{
+	(void)cookie;
+	delay(usec);
+}
+
+/*
+ * Pure metadata inspection; valid tables do not establish current votes.
+ */
+static int
+sweet_gpu_arc_tables(void)
+{
+	static const char *const names[] = { "mx.lvl", "cx.lvl", "gfx.lvl" };
+	for (unsigned i = 0; i < 3; ++i) {
+		int error = sweet_rpmh_arc_probe(names[i]);
+		if (error) {
+			printf("SWEET GPU: ARC probe %s failed %d\n", names[i], error);
+			return error;
+		}
+	}
+	printf("SWEET GPU: ARC tables read-only complete\n");
+	return 0;
+}
+
+/* Fresh resource checks belong to this boot, not to a previous stage.
+ * ARC table selectors are the current board interpretation, not a voltage
+ * measurement. Shared rails are never lowered or written by this driver.
+ */
+static int
+sweet_gpu_power_cx(void)
+{
+	struct a618_power_result result;
+	const struct a618_io io = {
+		.cookie = (void *)sweet_gpucc,
+		.read = sweet_adreno_read,
+		.write = sweet_adreno_write,
+		.delay_us = sweet_adreno_delay,
+	};
+	int error = sweet_rpmh_arc_require("mx.lvl", 65);
+	if (!error)
+		error = sweet_rpmh_arc_require("cx.lvl", 65);
+	if (error) {
+		printf("SWEET ADRENO: CX preconditions failed errno=%d; no GPUCC write\n", error);
+		return error;
+	}
+	error = a618_enable_cx(&io, &result);
+	printf("SWEET ADRENO: CX result errno=%d control=%#x status=%#x waited_us=%u\n",
+	    error, result.control, result.status, result.waited_us);
+	return error;
+}
+
+static uint32_t
+sweet_gpu_crc(const unsigned char *bytes, unsigned length)
+{
+ uint32_t crc = 0xffffffffu;
+ for (unsigned i = 0; i < length; ++i) {
+  crc ^= bytes[i];
+  for (unsigned b = 0; b < 8; ++b) crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1)));
+ }
+ return ~crc;
+}
+static int
+sweet_gpu_blob(DTEntry node, const char *name, const char *crc_name,
+ const unsigned char **bytes, unsigned *length)
+{
+ const uint32_t *crc;
+ unsigned size = 0;
+ if (SecureDTGetProperty(node, name, (const void **)bytes, length) != kSuccess ||
+     SecureDTGetProperty(node, crc_name, (const void **)&crc, &size) != kSuccess ||
+     size != 4 || *length > 0x8000 || !*length) return ENOENT;
+ return sweet_gpu_crc(*bytes, *length) == *crc ? 0 : EIO;
+}
+struct sweet_gpu_zap_request {
+ volatile uint32_t *reserved;
+ uint64_t physical;
+ const struct a618_dma_region *metadata;
+ const unsigned char *mdt, *code;
+ unsigned mdt_bytes, code_bytes;
+ struct a618_pas_result result;
+};
+static int
+sweet_gpu_zap_prepare(void *cookie)
+{
+ struct sweet_gpu_zap_request *request = cookie;
+ if (!request) return EINVAL;
+ return a618_zap_authenticate(request->reserved, request->physical,
+     request->metadata, request->mdt, request->mdt_bytes, request->code,
+     request->code_bytes, &request->result);
+}
+/*
+ * GPU performance levels from the pinned sm7150.dtsi gpu_opp_table, every
+ * one opp-supported-hw 0x1f (all speed bins): kHz and raw RPMh opp-level.
+ * Bring-up still runs at index 1 (267MHz, the proven corner). After the CP
+ * fence succeeds the APPS gfx/mx floors are raised for the chosen level, the
+ * GX clock is measured, DCVS selects it, and the clock is measured again.
+ * sweetgpukhz=267000 keeps the previous single-level behaviour.
+ */
+static const struct { uint32_t khz, level; } sweet_gpu_opps[] = {
+	{ 267000u, 64u },       /* LOW_SVS */
+	{ 355000u, 128u },      /* SVS */
+	{ 430000u, 192u },      /* SVS_L1 */
+	{ 565000u, 256u },      /* NOM */
+	/* 0132 telemetry: blur-heavy CoreAnimation commits are GPU-bound (13-14
+	 * passes, up to 15.5Mpx, 51-182ms at ~557MHz). OrangeFox KGSL on this
+	 * phone lists 650 and 800MHz; the pinned table pairs them with NOM_L1 and
+	 * TURBO (opp-supported-hw 0x1d / 0x19). */
+	{ 650000u, 320u },      /* NOM_L1 */
+	{ 800000u, 384u },      /* TURBO */
+};
+static unsigned sweet_gpu_opp_mx[6];
+
+static void
+sweet_gpu_levels_prepare(void)
+{
+	uint32_t target = 800000u;
+	PE_parse_boot_argn("sweetgpukhz", &target, sizeof(target));
+	a618_gpu_level_count = 0;
+	unsigned count = 0;
+	for (unsigned i = 0; i < sizeof(sweet_gpu_opps) / sizeof(sweet_gpu_opps[0]); ++i) {
+		if (sweet_gpu_opps[i].khz > target) {
+			break;
+		}
+		uint32_t vote = 0;
+		unsigned mx = 0;
+		int error = sweet_rpmh_adreno_level_vote(sweet_gpu_opps[i].level, &vote, &mx);
+		if (error) {
+			printf("SWEET ADRENO: OPP %u kHz vote errno=%d; single legacy level\n",
+			    sweet_gpu_opps[i].khz, error);
+			return;
+		}
+		a618_gpu_levels[count].vote = vote;
+		a618_gpu_levels[count].khz = sweet_gpu_opps[i].khz;
+		sweet_gpu_opp_mx[count] = mx;
+		++count;
+	}
+	/* Only a table that begins with the proven 267MHz/raw64 corner. */
+	if (count < 2 || (a618_gpu_levels[0].vote >> 16) != 64u) {
+		printf("SWEET ADRENO: OPP table count=%u first=%#x; single legacy level\n",
+		    count, count ? a618_gpu_levels[0].vote : 0);
+		return;
+	}
+	a618_gpu_level_count = count;
+	printf("SWEET ADRENO: OPP table %u levels up to %u kHz (target %u)\n",
+	    count, a618_gpu_levels[count - 1].khz, target);
+}
+
+/* RBBM_PERFCTR_RBBM_0 with countable PERF_RBBM_ALWAYS_COUNT (GX core clock
+ * cycles) against the architected 19.2MHz timer. 0 means not measurable. */
+static uint64_t
+sweet_gpu_counter(vm_offset_t core)
+{
+	uint32_t hi, lo, again;
+	do {
+		hi = sweet_adreno_read((void *)core, 0x41d * 4);
+		lo = sweet_adreno_read((void *)core, 0x41c * 4);
+		again = sweet_adreno_read((void *)core, 0x41d * 4);
+	} while (hi != again);
+	return ((uint64_t)hi << 32) | lo;
+}
+
+static uint32_t
+sweet_gpu_measure_khz(vm_offset_t core)
+{
+	sweet_adreno_write((void *)core, 0x500 * 4, 1);         /* RBBM_PERFCTR_CNTL */
+	sweet_adreno_write((void *)core, 0x507 * 4, 0);         /* RBBM_SEL_0: ALWAYS_COUNT */
+	sweet_adreno_barrier(NULL);
+	delay(100);
+	const uint64_t c0 = sweet_gpu_counter(core), t0 = mach_absolute_time();
+	delay(20000);
+	const uint64_t c1 = sweet_gpu_counter(core), t1 = mach_absolute_time();
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	if (!ns || c1 <= c0 || (c1 >> 63) || c0 == 0xffffffffffffffffULL) {
+		return 0;
+	}
+	return (uint32_t)(((c1 - c0) * 1000000ULL) / ns);
+}
+
+/* Read-only GPUCC view of the real GX clock (Lineage gpucc-sm6150.c): alpha
+ * PLLs at +0x0/+0x100 (L +4, ALPHA +8, ALPHA_U +0xc, USER_CTL +0x10) feed
+ * gpu_cc_gx_gfx3d_clk_src (CMD_RCGR 0x101c, CFG 0x1020: SRC_SEL [10:8],
+ * SRC_DIV [4:0]) through a CRC divider. Logged raw with the VCO estimate. */
+static void
+sweet_gpu_clock_regs(const char *tag)
+{
+	if (!sweet_gpucc) {
+		return;
+	}
+	for (unsigned pll = 0; pll < 2; ++pll) {
+		const uint32_t base = pll * 0x100u;
+		const uint32_t l = sweet_gpucc_read(base + 0x4) & 0xffffu;
+		const uint32_t alpha = sweet_gpucc_read(base + 0x8), alpha_u = sweet_gpucc_read(base + 0xc) & 0xffu;
+		const uint64_t frac = ((uint64_t)alpha_u << 32) | alpha;
+		const uint64_t khz = 19200ULL * l + ((19200ULL * frac) >> 40);
+		printf("SWEET ADRENO: %s GPU PLL%u mode=%#x L=%u alpha=%#llx user_ctl=%#x vco~%llu kHz\n", tag, pll,
+		    sweet_gpucc_read(base), l, (unsigned long long)frac, sweet_gpucc_read(base + 0x10), (unsigned long long)khz);
+	}
+	const uint32_t cmd = sweet_gpucc_read(0x101c), cfg = sweet_gpucc_read(0x1020);
+	printf("SWEET ADRENO: %s gfx3d RCG cmd=%#x cfg=%#x src_sel=%u src_div=%u crc_fsm=%#x crc_mnd=%#x\n", tag, cmd, cfg,
+	    (cfg >> 8) & 7, cfg & 0x1f, sweet_gpucc_read(0x1024), sweet_gpucc_read(0x1028));
+}
+
+static void
+sweet_gpu_raise_clock(vm_offset_t core, vm_offset_t gmu)
+{
+	sweet_gpu_clock_regs("before DCVS");
+	const uint32_t before = sweet_gpu_measure_khz(core);
+	printf("SWEET ADRENO: GX clock measured=%u kHz at perf index 1 (configured %u kHz)\n",
+	    before, a618_gpu_level_count ? a618_gpu_levels[0].khz : 267000u);
+	if (a618_gpu_level_count < 2) {
+		return;
+	}
+	const unsigned top = a618_gpu_level_count - 1;
+	const unsigned gfx_vlvl = (a618_gpu_levels[top].vote >> 16) + 1;   /* ARC consumer level */
+	const unsigned mx_vlvl = sweet_gpu_opp_mx[top] + 1;
+	int error = sweet_rpmh_arc_raise("mx.lvl", mx_vlvl);
+	if (!error) {
+		error = sweet_rpmh_arc_raise("gfx.lvl", gfx_vlvl);
+	}
+	if (error) {
+		printf("SWEET ADRENO: APPS rail floor errno=%d; GX stays at perf index 1\n", error);
+		return;
+	}
+	const struct a618_io gmu_io = {(void *)gmu,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+	error = a618_gmu_dcvs(&gmu_io, top + 1);
+	const uint32_t after = sweet_gpu_measure_khz(core);
+	printf("SWEET ADRENO: DCVS perf index %u (%u kHz, gfx vlvl %u, mx vlvl %u) errno=%d; GX clock measured=%u kHz\n",
+	    top + 1, a618_gpu_levels[top].khz, gfx_vlvl, mx_vlvl, error, after);
+	sweet_gpu_clock_regs("after DCVS");
+	if (error && error != ETIMEDOUT) {
+		/* Firmware refused: request the proven bring-up index again. */
+		int back = a618_gmu_dcvs(&gmu_io, 1);
+		printf("SWEET ADRENO: DCVS restore index 1 errno=%d measured=%u kHz\n",
+		    back, sweet_gpu_measure_khz(core));
+	}
+}
+
+static int
+sweet_gpu_cp_start(vm_offset_t gmu, vm_offset_t smmu)
+{
+ DTEntry node;
+ if (SecureDTLookupEntry(NULL, "/sweet-adreno", &node) != kSuccess) return ENOENT;
+ const unsigned char *sqe = NULL, *mdt = NULL, *code = NULL;
+ unsigned sqe_size = 0, mdt_size = 0, code_size = 0;
+ int error = sweet_gpu_blob(node, "sqe-firmware", "sqe-firmware-crc32", &sqe, &sqe_size);
+ if (!error) error = sweet_gpu_blob(node, "zap-metadata", "zap-metadata-crc32", &mdt, &mdt_size);
+ if (!error) error = sweet_gpu_blob(node, "zap-code", "zap-code-crc32", &code, &code_size);
+ const uint64_t *reserved_base = NULL;
+ const uint32_t *reserved_size = NULL;
+ unsigned length = 0;
+ if (!error && (SecureDTGetProperty(node, "zap-reserved-base", (const void **)&reserved_base,
+     &length) != kSuccess || length != 8 || *reserved_base != 0x97f15000ull)) error = EINVAL;
+ if (!error && (SecureDTGetProperty(node, "zap-reserved-size", (const void **)&reserved_size,
+     &length) != kSuccess || length != 4 || *reserved_size != 0x2000)) error = EINVAL;
+ printf("SWEET ADRENO: CP firmware properties errno=%d SQE=%u MDT=%u ZAP=%u\n",
+     error, sqe_size, mdt_size, code_size);
+ if (error) return error;
+ static struct a618_dma_region memory, metadata;
+ error = sweet_adreno_cp_allocate(&memory);
+ printf("SWEET ADRENO: CP DMA errno=%d PA=%#llx bytes=%u\n", error,
+     memory.physical, memory.bytes);
+ if (error) return error;
+ error = a618_cp_stage(&memory, sqe, sqe_size, sweet_adreno_barrier, NULL);
+ if (error) {
+  printf("SWEET ADRENO: SQE CPU staging/readback errno=%d\n", error);
+  return error;
+ }
+ /* Read the wired allocation through an independent physical IO mapping.
+  * Retain it with the wired storage for the boot lifetime. */
+ vm_offset_t physical_image = ml_io_map(memory.physical + A618_CP_SQE_OFFSET, 0x8000);
+ if (!physical_image) return ENOMEM;
+ volatile uint32_t *staged = (volatile uint32_t *)(memory.cpu + A618_CP_SQE_OFFSET);
+ unsigned verified = 0;
+ for (; verified < (sqe_size - 4) / 4; ++verified) {
+  if (sweet_adreno_read((void *)physical_image, verified * 4) != staged[verified]) {
+   error = EIO; break;
+  }
+ }
+ printf("SWEET ADRENO: SQE physical readback errno=%d words=%u first=%#x,%#x,%#x,%#x\n",
+     error, verified, sweet_adreno_read((void *)physical_image, 0),
+     sweet_adreno_read((void *)physical_image, 4), sweet_adreno_read((void *)physical_image, 8),
+     sweet_adreno_read((void *)physical_image, 12));
+ if (error) return error;
+ const struct a618_smmu_io smmu_io = {
+  {(void *)smmu, sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay},
+  sweet_adreno_read64, sweet_adreno_write64, sweet_adreno_barrier};
+ struct a618_smmu_result map;
+ bzero(&map, sizeof(map));
+ extern int sweet_native_adreno_prepare_vm(const struct a618_smmu_io *,
+     const struct a618_dma_region *, struct a618_smmu_result *);
+ error = sweet_native_adreno_prepare_vm(&smmu_io, &memory, &map);
+ printf("SWEET ADRENO: CP SMMU errno=%d CB=%u slot=%u pages=%u offset=%#x value=%#x PAR=%#llx FSR=%#x\n",
+     error, map.context, map.slot, map.translated, map.offset, map.value, map.par, map.fault);
+ if (error) return error;
+ vm_offset_t core = ml_io_map(0x05000000, 0x40000);
+ if (!core) return ENOMEM;
+ const struct a618_io gpu_io = {(void *)core,
+     sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+ const struct a618_io gmu_io = {(void *)gmu,
+     sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+ error = sweet_adreno_pas_allocate(&metadata);
+ if (error) return error;
+ vm_offset_t zap = ml_io_map(*reserved_base, *reserved_size);
+ if (!zap) return ENOMEM;
+ struct sweet_gpu_zap_request request = {
+  .reserved = (volatile uint32_t *)zap, .physical = *reserved_base,
+  .metadata = &metadata, .mdt = mdt, .code = code,
+  .mdt_bytes = mdt_size, .code_bytes = code_size,
+ };
+ struct a618_cp_result cp;
+ bzero(&cp, sizeof(cp));
+ error = a618_cp_start(&gpu_io, &gmu_io, &memory, sqe, sqe_size,
+     sweet_adreno_barrier, NULL, sweet_gpu_zap_prepare, &request, &cp);
+ printf("SWEET ADRENO: pre-SQE ZAP attempted=%u errno=%d phase=%u status=%lld response=%#llx\n",
+     cp.secure_prepare_attempted, cp.secure_prepare_error, request.result.phase,
+     request.result.status, request.result.response);
+ printf("SWEET ADRENO: CP initial TSB control=%#x base=%#llx size=%#x\n",
+     cp.initial_tsb_control, cp.initial_tsb_base, cp.initial_tsb_size);
+ printf("SWEET ADRENO: CP aperture errno=%d phase=%u status=%lld response=%#llx\n",
+     cp.aperture_error, cp.aperture_phase, cp.aperture_status, cp.aperture_response);
+ printf("SWEET ADRENO: SQE ME_INIT errno=%d phase=%u submitted=%u completed=%u RPTR=%#x WPTR=%#x status=%#x IRQ=%#x fault=%#x\n",
+     error, cp.phase, cp.submitted, cp.completed, cp.rptr, cp.wptr, cp.status,
+     cp.interrupt, cp.hw_fault);
+ printf("SWEET ADRENO: CP startup IRQ power=%#x before_auth=%#x after_auth=%#x bootstrap_us=%u CP2GMU=%#x ACTLR=%#x\n",
+     cp.irq_after_power, cp.irq_before_auth, cp.irq_after_auth, cp.bootstrap_wait_us,
+     sweet_adreno_read((void *)core, 0x2048), sweet_adreno_read((void *)smmu, 0x8004));
+ printf("SWEET ADRENO: CP startup initial SQECTL=%#x INSTR=%#x%08x RB_CNTL=%#x snapshots=%u first_fault=%s\n",
+     cp.initial_sqectl, cp.initial_instr_hi, cp.initial_instr_lo,
+     cp.initial_rb_cntl, cp.snapshots, cp.first_fault ? cp.first_fault : "none");
+ for (unsigned i = 0; i < cp.snapshots; ++i)
+  printf("SWEET ADRENO: CP SNAP[%s] IRQ=%#x SQECTL=%#x INSTR=%#x%08x CNTL=%#x CP2GMU=%#x\n",
+      cp.snapshot[i].tag, cp.snapshot[i].irq, cp.snapshot[i].sqectl,
+      cp.snapshot[i].instr_hi, cp.snapshot[i].instr_lo,
+      cp.snapshot[i].rb_cntl, cp.snapshot[i].cp2gmu);
+ printf("SWEET ADRENO: CP execution status local_irq=%#x sqe_started=%u\n", cp.cp_interrupt, cp.sqe_started);
+ printf("SWEET ADRENO: CP MMU CB0FSR=%#x CB1FSR=%#x\n",
+     sweet_adreno_read((void *)smmu, 0x8058), sweet_adreno_read((void *)smmu, 0x9058));
+ /* Snapshot the first hardware fault before any new translation probe or
+  * W1C operation. ATOS success does not prove the CP used the same VA. */
+ printf("SWEET ADRENO: CP fault FAR=%#llx FSYNR0=%#x FSYNR1=%#x SID=%#x TTBR0=%#llx TCR=%#x SCTLR=%#x\n",
+     sweet_adreno_read64((void *)smmu, 0x8060),
+     sweet_adreno_read((void *)smmu, 0x8068), sweet_adreno_read((void *)smmu, 0x806c),
+     sweet_adreno_read((void *)smmu, 0x1400),
+     sweet_adreno_read64((void *)smmu, 0x8020),
+     sweet_adreno_read((void *)smmu, 0x8030), sweet_adreno_read((void *)smmu, 0x8000));
+ printf("SWEET ADRENO: CP addresses SQE=%#llx RING=%#llx SHADOW=%#llx CNTL=%#x SQECTL=%#x\n",
+     ((uint64_t)sweet_adreno_read((void *)core, 0x20c4) << 32) | sweet_adreno_read((void *)core, 0x20c0),
+     ((uint64_t)sweet_adreno_read((void *)core, 0x2004) << 32) | sweet_adreno_read((void *)core, 0x2000),
+     ((uint64_t)sweet_adreno_read((void *)core, 0x2014) << 32) | sweet_adreno_read((void *)core, 0x2010),
+     sweet_adreno_read((void *)core, 0x2008), sweet_adreno_read((void *)core, 0x2020));
+ if (error && (cp.sqe_started || cp.first_fault)) {
+  /* Bounded failure-only indexed SQE state, same 0x33-word bank as A6xx
+   * Linux devcoredump. Each DATA read auto-increments the index. No resume
+   * follows a poisoned CP, so changing this diagnostic selector is harmless. */
+  uint32_t state[51];
+  sweet_adreno_write((void *)core, 0x2420, 0);
+  for (unsigned i = 0; i < 51; ++i)
+   state[i] = sweet_adreno_read((void *)core, 0x2424);
+  for (unsigned i = 0; i < 51; i += 3)
+   printf("SWEET ADRENO: SQE_STAT[%u]=%#x,%#x,%#x\n", i, state[i], state[i + 1], state[i + 2]);
+  printf("SWEET ADRENO: CP hardware RPTR=%#x STATUS1=%#x INTERRUPT=%#x\n",
+      sweet_adreno_read((void *)core, 0x2018), sweet_adreno_read((void *)core, 0x2094),
+      sweet_adreno_read((void *)core, 0x208c));
+  /* Halt the poisoned engine before the bounded instruction-cache capture.
+   * This does not reset it or attempt another submission. Never write a halt
+   * to an engine that did not start: 0106 tests whether that write itself
+   * launches a fetch from the current instruction base. */
+  if (cp.sqe_started) {
+   sweet_adreno_write((void *)core, 0x2020, 3);
+   uint32_t halt = sweet_adreno_read((void *)core, 0x2020);
+   printf("SWEET ADRENO: SQE failure halt=%#x ACTLR=%#x HOST_AP=%#x SQE_AP=%#x\n",
+       halt, sweet_adreno_read((void *)smmu, 0x8004),
+       sweet_adreno_read((void *)core, 0x2800), sweet_adreno_read((void *)core, 0x2804));
+   if (halt != 0xffffffffu && (halt & 3) == 3) {
+    static uint32_t cache[1024];
+    sweet_adreno_write((void *)core, 0x2440, 0);
+    for (unsigned i = 0; i < 1024; ++i)
+     cache[i] = sweet_adreno_read((void *)core, 0x2444);
+    for (unsigned i = 0; i < 1024; i += 8)
+     printf("SWEET ADRENO: SQE_CACHE[%u]=%#x,%#x,%#x,%#x,%#x,%#x,%#x,%#x\n",
+         i, cache[i], cache[i + 1], cache[i + 2], cache[i + 3],
+         cache[i + 4], cache[i + 5], cache[i + 6], cache[i + 7]);
+   }
+  } else {
+   printf("SWEET ADRENO: SQE halted=%#x; no pre-start halt write or cache capture\n",
+       sweet_adreno_read((void *)core, 0x2020));
+  }
+ }
+ if (error) return error;
+ error = a618_cp_leave_secure(&gpu_io, &gmu_io, &memory,
+     sweet_adreno_barrier, NULL, &cp);
+ printf("SWEET ADRENO: CP fence errno=%d phase=%u submitted=%u completed=%u RPTR=%#x WPTR=%#x IRQ=%#x fault=%#x fence=%#x value=%#x\n",
+     error, cp.phase, cp.submitted, cp.completed, cp.rptr, cp.wptr, cp.interrupt,
+     cp.hw_fault, cp.fence, cp.value);
+ printf("SWEET ADRENO: CP bootstrap complete errno=%d; iOS rendering ABI unavailable\n", error);
+ if (!error) {
+  sweet_gpu_raise_clock(core, gmu);
+  extern int sweet_native_adreno_adopt(const struct a618_dma_region *, uintptr_t, uintptr_t, uintptr_t, unsigned);
+  error = sweet_native_adreno_adopt(&memory, core, gmu, smmu, cp.fence);
+  printf("SWEET ADRENO: NativeAdreno A618 handoff errno=%d; no userspace rendering\n", error);
+ }
+ return error;
+}
+
+/* Matches postmarketOS SM7150: GMU firmware owns GX power-up. */
+static int
+sweet_gpu_gmu_prepare(int stage)
+{
+	vm_offset_t gcc = ml_io_map(SWEET_GCC_PA, SWEET_GCC_SIZE);
+	if (!gcc)
+		return ENOMEM;
+	const struct a618_io gpucc_io = { (void *)sweet_gpucc,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay };
+	const struct a618_io gcc_io = { (void *)gcc,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay };
+	struct a618_clock_result result;
+	printf("SWEET ADRENO: postmarketOS SM7150 GMU clocks v1 starting\n");
+	int error = a618_enable_gmu_clocks(&gpucc_io, &gcc_io, &result);
+	printf("SWEET ADRENO: GMU clocks errno=%d block=%u offset=%#x value=%#x completed=%u\n",
+	    error, result.block, result.offset, result.value, result.completed);
+	if (error)
+		return error;
+	vm_offset_t gmu = ml_io_map(SWEET_GMU_PA, SWEET_GMU_SIZE);
+	vm_offset_t smmu = ml_io_map(SWEET_SMMU_PA, SWEET_SMMU_SIZE);
+	if (!gmu || !smmu)
+		return ENOMEM;
+	const struct a618_io gmu_io = { (void *)gmu,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay };
+	uint32_t reset = sweet_adreno_read((void *)gmu, A618_GMU_SYSRESET);
+	uint32_t power = sweet_adreno_read((void *)gmu, A618_GMU_POWER_STATUS);
+	uint32_t fence = sweet_adreno_read((void *)gmu, A618_GMU_AHB_FENCE_STATUS);
+	printf("SWEET ADRENO: GMU SYSRESET=%#x POWER_STATUS=%#x AHB_FENCE_STATUS=%#x\n",
+	    reset, power, fence);
+	if (reset == 0xffffffffu || power == 0xffffffffu || fence == 0xffffffffu)
+		return EIO;
+	/* ID registers only: do not alter SMMU contexts or stream routing. */
+	uint32_t id0 = sweet_adreno_read((void *)smmu, 0x20);
+	uint32_t id1 = sweet_adreno_read((void *)smmu, 0x24);
+	uint32_t id2 = sweet_adreno_read((void *)smmu, 0x28);
+	printf("SWEET ADRENO: SMMU IDR0=%#x IDR1=%#x IDR2=%#x\n", id0, id1, id2);
+	if (id0 == 0xffffffffu || id1 == 0xffffffffu || id2 == 0xffffffffu || !id0)
+		return EIO;
+	if (stage >= 6) {
+		DTEntry node;
+		const unsigned char *firmware = NULL;
+		const uint32_t *crc = NULL;
+		unsigned int size = 0, crc_size = 0;
+		if (SecureDTLookupEntry(NULL, "/sweet-adreno", &node) != kSuccess ||
+		    SecureDTGetProperty(node, "gmu-firmware", (const void **)&firmware,
+		    &size) != kSuccess ||
+		    SecureDTGetProperty(node, "gmu-crc32", (const void **)&crc,
+		    &crc_size) != kSuccess || crc_size != sizeof(*crc)) {
+			printf("SWEET ADRENO: missing GMU firmware properties; no TCM write\n");
+			return ENOENT;
+		}
+		unsigned verified = 0;
+		error = a618_gmu_stage_legacy(&gmu_io, firmware, size, *crc, &verified);
+		printf("SWEET ADRENO: GMU TCM staging errno=%d verified_bytes=%u; M3 not released\n",
+		    error, verified);
+		if (error)
+			return error;
+	}
+	if (stage >= 7) {
+  (void)sweet_rpmh_arc_probe("xo.lvl");
+  /* Still no M3 release: verify the actual hardware translations first. */
+  if (sweet_adreno_read((void *)gmu, A618_GMU_SYSRESET) != 1 ||
+      !(sweet_gpucc_read(GPU_CC_GX_GDSCR) & GDSC_SW_COLLAPSE) ||
+      !(sweet_gpucc_read(GPU_CC_GX_DOMAIN) & GX_DOMAIN_CLAMP)) {
+   printf("SWEET ADRENO: DMA precondition failed: require M3 reset, GX collapse/clamp\n");
+   return EBUSY;
+  }
+  static struct a618_dma_region memory;
+  static struct a618_hfi hfi;
+  error = sweet_adreno_dma_allocate(&memory);
+  printf("SWEET ADRENO: DMA allocate errno=%d bytes=%u PA=%#llx uncached=%u\n",
+      error, memory.bytes, memory.physical, memory.uncached);
+  if (error) return error;
+  error = a618_hfi_init(&hfi, &memory, sweet_adreno_barrier, NULL);
+  printf("SWEET ADRENO: legacy HFI table errno=%d IOVA=%#x queues=3; firmware not executing\n",
+      error, A618_HFI_IOVA);
+  if (error) return error;
+  const struct a618_smmu_io ops = {
+   { (void *)smmu, sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay },
+   sweet_adreno_read64, sweet_adreno_write64, sweet_adreno_barrier };
+  struct a618_smmu_result result;
+  bzero(&result, sizeof(result));
+  error = a618_smmu_prepare(&ops, &memory, &result);
+  printf("SWEET ADRENO: SMMU map errno=%d CB=%u slot=%u translated=%u offset=%#x value=%#x PAR=%#llx FSR=%#x\n",
+      error, result.context, result.slot, result.translated, result.offset,
+      result.value, result.par, result.fault);
+  printf("SWEET ADRENO: SMMU mapping check complete; SYSRESET=%#x; no firmware execution\n",
+      sweet_adreno_read((void *)gmu, A618_GMU_SYSRESET));
+  if (error) return error;
+  if (stage >= 8) {
+   printf("SWEET ADRENO: GPU context baseline SCTLR0=%#x\n",
+       sweet_adreno_read((void *)smmu, 0x8000));
+   for (unsigned slot = 0; slot < 5; ++slot)
+    printf("SWEET ADRENO: stream slot=%u SMR=%#x S2CR=%#x\n", slot,
+        sweet_adreno_read((void *)smmu, 0x800 + slot * 4),
+        sweet_adreno_read((void *)smmu, 0xc00 + slot * 4));
+   uint32_t gpu_vote = 0, gmu_vote = 0;
+   sweet_gpu_levels_prepare();
+   error = sweet_rpmh_adreno_votes(&gpu_vote, &gmu_vote);
+   printf("SWEET ADRENO: MIN_SVS votes errno=%d GPU=%#x GMU=%#x\n",
+       error, gpu_vote, gmu_vote);
+   if (error) return error;
+   /* PDC apertures from the pinned SM7150 DT, shared by the live A618. */
+   vm_offset_t pdc = ml_io_map(0x0b290000, 0x10000);
+   vm_offset_t seq = ml_io_map(0x0b490000, 0x10000);
+   if (!pdc || !seq) return ENOMEM;
+   const struct a618_io pdc_io = {(void *)pdc,
+       sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+   const struct a618_io seq_io = {(void *)seq,
+       sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+   struct a618_gmu_boot_result boot;
+   bzero(&boot, sizeof(boot));
+   error = a618_gmu_boot_legacy(&gmu_io, &pdc_io, &seq_io, &hfi,
+       gpu_vote, gmu_vote, &boot);
+   printf("SWEET ADRENO: legacy GMU boot errno=%d phase=%u offset=%#x value=%#x FW=%#x; CP unavailable\n",
+       error, boot.phase, boot.offset, boot.value, boot.firmware_version);
+   printf("SWEET ADRENO: HFI request=%#x response=%#x fw_error=%#x packets=%u INFO=%#x HOST_RAW=%#x CB1FSR=%#x\n",
+       hfi.last_request, hfi.last_response, hfi.firmware_error, hfi.responses,
+       sweet_adreno_read((void *)gmu, 0x14648),
+       sweet_adreno_read((void *)gmu, 0x14658),
+       sweet_adreno_read((void *)smmu, 0x9058));
+   sweet_adreno_barrier(NULL);
+   for (unsigned q = 0; q < 3; ++q) {
+    volatile uint32_t *qh = hfi.table + 6 + q * 12;
+    printf("SWEET ADRENO: HFI queue=%u status=%#x dropped=%u RX=%u TX=%u RPTR=%u WPTR=%u\n",
+        q, qh[0], qh[5], qh[8], qh[9], qh[10], qh[11]);
+   }
+   if (!error && stage >= 9) return sweet_gpu_cp_start(gmu, smmu);
+   return error;
+  }
+ }
+	printf("SWEET ADRENO: GMU preparation complete; GX remains firmware controlled, no submission\n");
+	return 0;
+}
+
+static void
+sweet_gpu_arc_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	static int sleep_chan;
+	uint64_t deadline;
+	int stage = sweet_gpu_stage;
+	static const char *const names[] = { "mx.lvl", "cx.lvl", "gfx.lvl" };
+
+	/* Touch normally votes L11C at 45 s. The RPMh API also checks completion. */
+	clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	if (stage >= 4) {
+		printf("SWEET ADRENO: CX controller v2 starting; no GPU core access\n");
+		int error = sweet_gpu_power_cx();
+		printf("SWEET ADRENO: CX controller finished errno=%d; rendering unavailable\n", error);
+		if (!error && stage >= 5) {
+			error = sweet_gpu_gmu_prepare(stage);
+			printf("SWEET ADRENO: GMU stage=%d finished errno=%d; rendering unavailable\n",
+			    stage, error);
+		}
+		goto out;
+	}
+	if (stage == 3) {
+		printf("SWEET GPU: ARC gfx raise v1 starting; mx/cx read-only\n");
+		/* Snapshot the shared rails without writing them. */
+		for (unsigned i = 0; i < 2; ++i) {
+			int error = sweet_rpmh_arc_read(names[i]);
+			if (error) {
+				printf("SWEET GPU: ARC gfx raise stopped at %s errno=%d; no retry\n",
+				    names[i], error);
+				goto out;
+			}
+		}
+		int error = sweet_rpmh_arc_raise("gfx.lvl", SWEET_GPU_GFX_TARGET);
+		if (error) {
+			printf("SWEET GPU: ARC gfx raise v1 stopped errno=%d; no retry\n",
+			    error);
+			goto out;
+		}
+		printf("SWEET GPU: ARC gfx raise v1 complete; GPUCC power/clock writes remain disabled\n");
+		goto out;
+	}
+	printf("SWEET GPU: ARC readback v1 starting; no resource votes\n");
+	for (unsigned i = 0; i < 3; ++i) {
+		int error = sweet_rpmh_arc_read(names[i]);
+		if (error) {
+			printf("SWEET GPU: ARC readback stopped at %s errno=%d; no retry\n",
+			    names[i], error);
+			goto out;
+		}
+	}
+	printf("SWEET GPU: ARC readback v1 complete; power/clock writes remain disabled\n");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_probe(void)
+{
+	int enabled = 0;
+	uint32_t cx, cx_hw, gx, domain, reset;
+	unsigned int i;
+
+	if (sweet_gpu_probe_attempted) {
+		return;
+	}
+	sweet_gpu_probe_attempted = 1;
+	(void)PE_parse_boot_argn("sweetgpu", &enabled, sizeof(enabled));
+	if (enabled < 1 || enabled > 9) {
+		printf("SWEET GPU: audit disabled; sweetgpu=1 read-only, 2 reads ARC resources, 3 raises gfx.lvl, 4 powers CX, 5 GMU clocks/status, 6 firmware staging, 7 DMA/SMMU/HFI mappings, 8 legacy GMU/HFI startup, 9 SQE/CP commands\n");
+		return;
+	}
+
+	printf("SWEET GPU: GPUCC audit v2 at %#x; stage=%d; GMU access requires clock checks\n",
+	    SWEET_GPUCC_PA, enabled);
+	sweet_gpucc = ml_io_map(SWEET_GPUCC_PA, SWEET_GPUCC_SIZE);
+	if (sweet_gpucc == 0) {
+		printf("SWEET GPU: GPUCC mapping failed\n");
+		return;
+	}
+
+	/*
+	 * CX uses the separate HW-control status register in the live DT.
+	 * Preserve raw GX status: the DT also has qcom,poll-cfg-gdscr, whose
+	 * semantics differ across downstream kernels. These snapshots are not
+	 * permission to touch the core, even if a power/clock bit is set.
+	 */
+	cx = sweet_gpucc_read(GPU_CC_CX_GDSCR);
+	cx_hw = sweet_gpucc_read(GPU_CC_CX_HW_CTRL);
+	gx = sweet_gpucc_read(GPU_CC_GX_GDSCR);
+	domain = sweet_gpucc_read(GPU_CC_GX_DOMAIN);
+	reset = sweet_gpucc_read(GPU_CC_GX_BCR);
+	printf("SWEET GPU: CX_GDSCR=%#x CX_HW_CTRL=%#x GX_GDSCR=%#x GX_DOMAIN=%#x GX_BCR=%#x\n",
+	    cx, cx_hw, gx, domain, reset);
+	printf("SWEET GPU: CX pwr_on=%u collapse=%u hw_control=%u; GX bit31=%u collapse=%u hw_control=%u clamp=%u gmem_reset=%u block_reset=%u\n",
+	    !!(cx_hw & GDSC_PWR_ON), !!(cx & GDSC_SW_COLLAPSE),
+	    !!(cx & GDSC_HW_CONTROL), !!(gx & GDSC_PWR_ON),
+	    !!(gx & GDSC_SW_COLLAPSE), !!(gx & GDSC_HW_CONTROL),
+	    !!(domain & 1u), !!(domain & (1u << 4)), !!(reset & 1u));
+
+	for (i = 0; i < sizeof(sweet_gpu_branches) / sizeof(sweet_gpu_branches[0]); i++) {
+		uint32_t value = sweet_gpucc_read(sweet_gpu_branches[i].offset);
+		printf("SWEET GPU: CBCR %s @%#x=%#x enable=%u clk_off=%u fsm=%u\n",
+		    sweet_gpu_branches[i].name, sweet_gpu_branches[i].offset,
+		    value, !!(value & BRANCH_CLK_ENABLE),
+		    !!(value & BRANCH_CLK_OFF), (value >> 28) & 7u);
+	}
+	if (sweet_gpu_arc_tables()) {
+		printf("SWEET GPU: ARC stage stopped; no GPUCC power/clock/reset writes\n");
+		return;
+	}
+	if (enabled == 1) {
+		printf("SWEET GPU: read-only audit complete; sweetgpu=2 reads ARC resources, 3 raises gfx.lvl, 4 powers CX, 5 GMU clocks/status, 6 firmware staging, 7 DMA/SMMU/HFI mappings, 8 legacy GMU/HFI startup, 9 SQE/CP commands\n");
+		return;
+	}
+	sweet_gpu_stage = enabled;
+	thread_t thread;
+	kern_return_t kr = kernel_thread_start(sweet_gpu_arc_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		if (enabled >= 5) {
+			printf("SWEET ADRENO: GMU stage=%d scheduled in 60 s; CX and clock gates first\n", enabled);
+		} else if (enabled == 4) {
+			printf("SWEET ADRENO: CX controller v2 scheduled in 60 s; fresh rail checks required\n");
+		} else if (enabled == 3) {
+			printf("SWEET GPU: ARC gfx raise v1 scheduled in 60 s; gfx only\n");
+		} else {
+			printf("SWEET GPU: ARC readback v1 scheduled in 60 s; no resource votes\n");
+		}
+	} else {
+		printf("SWEET GPU: ARC worker thread failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_haptic.c b/bsd/dev/sweet_haptic.c
new file mode 100644
index 0000000..f4b3143
--- /dev/null
+++ b/bsd/dev/sweet_haptic.c
@@ -0,0 +1,807 @@
+/*
+ * Sweet (Redmi Note 10 Pro) haptics: the Awinic AW8624 LRA driver on QUP1 SE3 (global SE9,
+ * i2c@0xa8c000, address 0x5a, SDA/SCL GPIO 46/47 = qup13), reset TLMM GPIO 4 (low = reset),
+ * interrupt PM6150L GPIO 10 (not used: polled). Board values from the phone's DT
+ * (aw8624_haptic@5A): f0_pre 208.0 Hz, f0_coeff 260, cont drive 0x6a / overdrive 0x9b, cont_td
+ * 0xf06c, zero-cross 0x8f8, brake count 3, tset 0x11, sw brake 0x2c, bemf 00 08 03 f8.
+ * Register sequences from Xiaomi's sm6150 aw8624.c (continuous mode: the chip drives the motor at
+ * its resonance until GO is cleared). The GENI I2C core is the touch driver's (bsd/dev/sweet_touch.c).
+ *
+ *   sweethaptic=1  bus up, reset released, chip ID and status read; nothing written to the chip
+ *   sweethaptic=2  ... Android's init values, then three 80 ms buzzes about 45 s after boot
+ *   sweethaptic=3  ... and then the motor for iOS: /dev/sweet-haptic takes the mono 16-bit samples
+ *                  of the HAL plug-in's "Actuator" (userspace/audio, from HackiOS); the motor runs
+ *                  in continuous mode while they are not silence, at least 30 ms, at most 1 s, then
+ *                  rests as long (the model is HackiOS redwood_haptic.c haptic=5).
+ *
+ * Every write is read back; a NACK, an I2C error, a mismatch or a fault bit stops the driver and
+ * puts the chip back into reset.
+ *
+ * 0198: the motor worked (the three test buzzes are felt) but iOS never played on the Actuator (0195:
+ * "serving /dev/sweet-haptic (0 frames written so far)"): VirtualAudio was disabled (0196 enables it,
+ * sweetvaudio=1). Here: the continuous-mode configuration is written once (aw_cont_prepare) and each
+ * buzz only switches mode, clears SYSINT, sets the drive level and GO (about 5 I2C writes instead of
+ * 25: the tap starts ~20 ms sooner); who opens the device and what it writes is logged
+ * ("SWEET HAPTIC: open by ...", "first sound ...", a stats line every 60 s while frames arrive).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <mach/mach_time.h>
+#include <sys/proc.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_haptic_init(void);
+
+#define HAP_SE_PA        0x00a8c000u   /* QUP1 SE3 = global SE9 */
+#define HAP_GCC_PA       0x00100000u
+#define HAP_NORTH_PA     0x03900000u   /* TLMM NORTH tile: GPIO 4, 46, 47 */
+#define HAP_GCC_VOTE     0x5200cu
+#define HAP_RCG          0x183a8u      /* gcc_qupv3_wrap1_s3_clk_src */
+#define HAP_CBCR         0x183a4u      /* gcc_qupv3_wrap1_s3_clk, vote bit 25 */
+#define HAP_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define HAP_GPIO_IO(n)   (HAP_GPIO_CFG(n) + 4u)
+#define HAP_ADDR         0x5au
+#define HAP_RESET_GPIO   4u
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	bool started, dead, probing;
+	uint32_t irq_status, irq_last;
+	unsigned sent, got;
+	int stage;
+} hs;
+static int hap_sleep_chan;
+
+static uint32_t
+hap_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+hap_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+hap_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&hap_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+hap_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(hap_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+hap_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = HAP_GPIO_CFG(pin);
+	uint32_t cfg = hap_rd(hs.gpio, off);
+	if (out) {
+		/* Set the desired latch before enabling output (reset is active low). */
+		hap_wr(hs.gpio, HAP_GPIO_IO(pin),
+		    (hap_rd(hs.gpio, HAP_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	hap_wr(hs.gpio, off, cfg);
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+hap_abort(void)
+{
+	hap_wr(hs.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (hap_rd(hs.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !hap_wait_clear(hs.se, SE_STATUS, 1u)) {
+		hs.dead = true;
+		printf("SWEET HAPTIC: abort failed status=%#x irq=%#x; stopping\n",
+		    hap_rd(hs.se, SE_STATUS), hap_rd(hs.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (hap_rd(hs.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)hap_rd(hs.se, SE_RX);
+	}
+	hap_wr(hs.se, SE_IRQ_CLR, 0xffffffffu);
+	if (hap_rd(hs.se, SE_TX_COUNT) & 0xfffffffu) {
+		hs.dead = true;
+		printf("SWEET HAPTIC: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
+static uint32_t
+hap_irq(void)
+{
+	hs.irq_last = hap_rd(hs.se, SE_IRQ);
+	hs.irq_status |= hs.irq_last;
+	return hs.irq_last;
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+hap_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (hs.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!hap_wait_clear(hs.se, SE_STATUS, 1u)) {
+		hs.dead = true; /* no other SE9 owner is supported */
+		return EBUSY;
+	}
+	hap_wr(hs.se, SE_IRQ_CLR, 0xffffffffu);
+	hap_wr(hs.se, SE_TX_WM, nt ? 1u : 0u);
+	hap_wr(hs.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	hap_wr(hs.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = hap_irq();
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the other IC. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = hap_irq();
+			}
+			if ((irq & SE_DONE) && !(hap_rd(hs.se, SE_STATUS) & 1u) &&
+			    !(hap_rd(hs.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(hap_rd(hs.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				hap_wr(hs.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !hs.sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			hap_wr(hs.se, SE_TX, word);
+			hs.sent = nt;
+			hap_wr(hs.se, SE_TX_WM, 0);
+		}
+		uint32_t count = hap_rd(hs.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - hs.got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = hap_rd(hs.se, SE_RX);
+			for (unsigned j = 0; j < 4 && hs.got < nr; ++j) {
+				rx[hs.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			/* Re-sample after the final drain; a late error must beat DONE. */
+			irq = hap_irq();
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			hap_wr(hs.se, SE_IRQ_CLR, irq);
+			if (hs.got == nr && hs.sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		hap_wr(hs.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	hap_abort();
+	return err;
+}
+
+static int
+hap_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	hs.irq_status = hs.irq_last = 0;
+	hs.sent = hs.got = 0;
+	int err = hap_msg_run(addr, tx, nt, rx, nr, stretch);
+	if (hs.probing) {
+		printf("SWEET HAPTIC: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+		    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+		    err, hs.irq_last, hs.irq_status, hs.sent, hs.got,
+		    hap_rd(hs.se, SE_STATUS));
+	}
+	return err;
+}
+
+static int
+hap_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = hap_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
+	    NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return hap_msg(addr, NULL, 0, buf, len, false);
+}
+
+static bool
+hap_clocks(void)
+{
+	/* wrapper1 core/core2x/m_ahb/s_ahb (bits 18-21) and wrap1 s3 (bit 25), as the touch driver votes s1 */
+	uint32_t mask = (0x0fu << 18) | (1u << 25);
+	hap_wr(hs.gcc, HAP_GCC_VOTE, hap_rd(hs.gcc, HAP_GCC_VOTE) | mask);
+	uint32_t dfs = hap_rd(hs.gcc, HAP_RCG + 0x14u);
+	uint32_t cfg = hap_rd(hs.gcc, HAP_RCG + 4u);
+	printf("SWEET HAPTIC: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    hap_rd(hs.gcc, HAP_GCC_VOTE), hap_rd(hs.gcc, HAP_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		cfg = hap_rd(hs.gcc, HAP_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SWEET HAPTIC: DFS level0=%#x is not XO/1; stop\n", cfg);
+			return false;
+		}
+	} else {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;   /* XO, divider 1: 19.2 MHz */
+		hap_wr(hs.gcc, HAP_RCG + 4u, cfg);
+		hap_wr(hs.gcc, HAP_RCG, hap_rd(hs.gcc, HAP_RCG) | 1u);
+		if (!hap_wait_clear(hs.gcc, HAP_RCG, 1u)) {
+			printf("SWEET HAPTIC: RCG update timeout\n");
+			return false;
+		}
+	}
+	const uint32_t branches[] = {0x18004, 0x18008, 0x1800c, 0x18010, HAP_CBCR};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!hap_wait_clear(hs.gcc, branches[i], 1u << 31)) {
+			printf("SWEET HAPTIC: GCC branch %#x halted (%#x)\n", branches[i], hap_rd(hs.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+hap_se_init(void)
+{
+	uint32_t fw = hap_rd(hs.se, SE_FW);
+	uint32_t tx = hap_rd(hs.se, SE_HW_TX), rx = hap_rd(hs.se, SE_HW_RX);
+	printf("SWEET HAPTIC: se9 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, hap_rd(hs.se, SE_STATUS), tx, rx);
+	if (((fw >> 8) & 0xffu) != 3u || (hap_rd(hs.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET HAPTIC: SE9 has no ABL-loaded I2C firmware / 32-bit FIFOs; stop\n");
+		return false;
+	}
+	if (hap_rd(hs.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET HAPTIC: SE9 already busy; stop\n");
+		return false;
+	}
+	hap_wr(hs.se, 0xe18, 0);
+	hap_wr(hs.se, 0xe1c, 0);
+	hap_wr(hs.se, 0x644, 0);
+	hap_wr(hs.se, SE_IRQ_CLR, 0xffffffffu);
+	hap_wr(hs.se, 0x648, 0xffffffffu);
+	hap_wr(hs.se, SE_DMA, 0);
+	hap_wr(hs.se, 0x28, hap_rd(hs.se, 0x28) | 0x7fu);
+	hap_wr(hs.se, 0xe30, hap_rd(hs.se, 0xe30) | 0x0fu);
+	hap_wr(hs.se, 0x24, 0x7f);
+	hap_wr(hs.se, 0x20, 1);
+	hap_wr(hs.se, SE_CLK_SEL, 0);
+	hap_wr(hs.se, SE_MCLK, (7u << 4) | 1u);
+	hap_wr(hs.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	hap_wr(hs.se, 0x254, 0);
+	hap_wr(hs.se, 0x260, SE_PACK0);
+	hap_wr(hs.se, 0x264, SE_PACK1);
+	hap_wr(hs.se, 0x284, SE_PACK0);
+	hap_wr(hs.se, 0x288, SE_PACK1);
+	hap_wr(hs.se, SE_TX_WM, 0);
+	hap_wr(hs.se, 0x810, 0);
+	hap_wr(hs.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	hap_wr(hs.se, SE_IRQ_EN, SE_EVENTS);
+	if (hap_rd(hs.se, 0x260) != SE_PACK0 || hap_rd(hs.se, 0x264) != SE_PACK1 ||
+	    (hap_rd(hs.se, SE_TX_COUNT) & 0xfffffffu) || (hap_rd(hs.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET HAPTIC: SE9 setup readback mismatch / inherited FIFO data; stop\n");
+		return false;
+	}
+	return true;
+}
+
+/* ---------------------------------------------------------------- AW8624 */
+
+static int
+aw_rd(uint8_t reg, uint8_t *val)
+{
+	return hap_read(HAP_ADDR, reg, false, val, 1);
+}
+
+static int
+aw_wr_raw(uint8_t reg, uint8_t val)
+{
+	uint8_t tx[2] = {reg, val};
+	return hap_msg(HAP_ADDR, tx, 2, NULL, 0, false);
+}
+
+/* a write that must read back (registers that hold their value) */
+static bool
+aw_wr(uint8_t reg, uint8_t val)
+{
+	uint8_t rb = 0;
+	if (hs.dead || aw_wr_raw(reg, val) || aw_rd(reg, &rb)) {
+		printf("SWEET HAPTIC: write %#04x <- %#04x failed\n", reg, val);
+		hs.dead = true;
+		return false;
+	}
+	if (rb != val) {
+		printf("SWEET HAPTIC: write %#04x <- %#04x read back %#04x\n", reg, val, rb);
+		hs.dead = true;
+		return false;
+	}
+	return true;
+}
+
+/* the vendor driver's write_bits: keep = mask, then OR the field */
+static bool
+aw_bits(uint8_t reg, uint8_t keep, uint8_t field)
+{
+	uint8_t v = 0;
+	if (hs.dead || aw_rd(reg, &v)) {
+		hs.dead = true;
+		return false;
+	}
+	return aw_wr(reg, (uint8_t)((v & keep) | field));
+}
+
+static void
+hap_reset(bool run)
+{
+	/* GPIO 4 as output, function gpio, no pull, 2 mA; low holds the chip in reset */
+	hap_gpio(HAP_RESET_GPIO, 0, 0, 0, true, run);
+}
+
+static bool
+aw_status(const char *when)
+{
+	uint8_t sysst = 0, sysint = 0, glb = 0;
+	if (aw_rd(0x01, &sysst) || aw_rd(0x02, &sysint) || aw_rd(0x47, &glb)) {
+		hs.dead = true;
+		return false;
+	}
+	printf("SWEET HAPTIC: %s: SYSST %#04x SYSINT %#04x GLB_STATE %#04x\n", when, sysst, sysint, glb);
+	/*
+	 * SYSINT (clear on read): OV bit 6, UVLO bit 5, FIFO bits 4/3, OCD bit 2, OT bit 1, done bit 0
+	 * (aw8624_reg.h). 0151 hardware read SYSST/SYSINT 0x30 after reset: UVLO is latched at power-up
+	 * and reads live in standby, where the vendor driver masks it and only logs it. Stop on
+	 * over-voltage, over-current and over-temperature.
+	 */
+	if (sysint & 0x46u) {
+		printf("SWEET HAPTIC: fault bits %#04x: stop, chip back into reset\n", sysint & 0x46u);
+		hs.dead = true;
+		return false;
+	}
+	return true;
+}
+
+static bool
+aw_init(void)
+{
+	/* aw8624_haptic_init() without the f0 calibration (the DT's f0_pre is used) */
+	return aw_bits(0x03, (uint8_t)~(1u << 5), (1u << 5)) &&        /* SYSINTM: UVLO off (standby) */
+	    aw_bits(0x04, (uint8_t)~(1u << 0), (1u << 0)) &&           /* SYSCTRL: standby */
+	    aw_bits(0x20, (uint8_t)~(1u << 5), 0) &&                   /* DBGCTRL: trig enable */
+	    aw_bits(0x2e, (uint8_t)~(3u << 5), (2u << 5)) &&           /* PWMDBG: 24 kHz */
+	    aw_bits(0x5f, (uint8_t)~(1u << 5), (1u << 5)) &&           /* DETCTRL: protect, no action */
+	    aw_bits(0x2d, (uint8_t)~(1u << 7), 0) &&                   /* PWMPRC: off */
+	    aw_bits(0x3e, (uint8_t)~(1u << 7), 0) &&                   /* PRLVL: off */
+	    aw_bits(0x66, (uint8_t)~(1u << 6), (1u << 6)) &&           /* ADCTEST: vbat HW compensation */
+	    aw_bits(0x5d, (uint8_t)~(1u << 7), (1u << 7)) &&           /* R_SPARE */
+	    aw_wr(0x39, 0x2c) &&                                       /* SW_BRAKE (DT vib_sw_brake) */
+	    aw_wr(0x4f, 0x00) &&                                       /* THRS_BRA_END */
+	    aw_bits(0x31, (uint8_t)~(0xfu << 4), 0) &&                 /* WAVECTRL */
+	    aw_wr(0x72, 0x08) && aw_wr(0x73, 0xf8) &&                  /* zero cross 0x8f8 */
+	    aw_wr(0x4d, 0x11) &&                                       /* TSET */
+	    aw_wr(0x74, 0x00) && aw_wr(0x75, 0x08) && aw_wr(0x76, 0x03) && aw_wr(0x77, 0xf8);  /* BEMF thresholds */
+}
+
+/* 0198: the static part of aw8624_haptic_cont(), written once after init (the chip keeps it in standby) */
+static bool hap_prepared;
+
+static bool
+aw_cont_prepare(void)
+{
+	const unsigned f0_reg = 1000000000u / (2080u * 260u);   /* f0_pre 208.0 Hz, f0_coeff 260 */
+	hap_prepared = aw_wr(0x49, (uint8_t)(f0_reg >> 8)) && aw_wr(0x4a, (uint8_t)f0_reg) &&
+	    aw_bits(0x2b, (uint8_t)~(1u << 6), (3u << 6)) &&           /* DATCTRL: 1000 Hz LPF (vendor masks) */
+	    aw_bits(0x2b, (uint8_t)~(1u << 5), (1u << 5)) &&
+	    aw_wr(0x48, (uint8_t)((1u << 7) | (1u << 3) | (1u << 0))) &&   /* CONT_CTRL: ZC detect, closed loop, auto brake */
+	    aw_wr(0x4b, 0xf0) && aw_wr(0x4c, 0x6c) &&                  /* TD 0xf06c */
+	    aw_wr(0x4d, 0x11) &&
+	    aw_wr(0x72, 0x08) && aw_wr(0x73, 0xf8) &&
+	    aw_bits(0x78, (uint8_t)~0xfu, 3) &&                        /* BEMF_NUM: 3 brake periods */
+	    aw_wr(0x7a, 0x23) &&                                       /* TIME_NZC */
+	    aw_wr(0x7c, 0x9b);                                         /* overdrive level */
+	printf("SWEET HAPTIC: continuous mode prepared: %s\n", hap_prepared ? "ok" : "FAILED");
+	return hap_prepared;
+}
+
+/* 0198: per buzz only the dynamic part (mode, active, SYSINT clear, drive, GO) */
+static bool
+aw_cont_go(uint8_t drive)
+{
+	uint8_t clr = 0;
+	return aw_bits(0x04, (uint8_t)~((3u << 2) | 1u), (2u << 2)) &&   /* SYSCTRL: CONT, active */
+	    aw_rd(0x02, &clr) == 0 &&                                  /* clear SYSINT (aw8624_haptic_active) */
+	    aw_bits(0x03, (uint8_t)~(1u << 5), 0) &&                   /* UVLO interrupt on */
+	    aw_wr_raw(0x7b, drive) == 0 &&                             /* drive level (DT 0x6a) */
+	    aw_wr_raw(0x05, 0x01) == 0;                                /* GO */
+}
+
+/* aw8624_haptic_cont(): continuous drive at the preset f0 until GO is cleared */
+static bool
+aw_cont_start(uint8_t drive)
+{
+	if (hap_prepared) {
+		return aw_cont_go(drive);
+	}
+	const unsigned f0_reg = 1000000000u / (2080u * 260u);   /* f0_pre 208.0 Hz, f0_coeff 260 */
+	uint8_t clr = 0;
+	return aw_bits(0x04, (uint8_t)~(3u << 2), (2u << 2)) &&       /* SYSCTRL: play mode CONT */
+	    aw_bits(0x04, (uint8_t)~(1u << 0), 0) &&                   /* active */
+	    aw_rd(0x02, &clr) == 0 &&                                  /* clear SYSINT (aw8624_haptic_active) */
+	    aw_bits(0x03, (uint8_t)~(1u << 5), 0) &&                   /* UVLO interrupt on */
+	    aw_wr(0x49, (uint8_t)(f0_reg >> 8)) && aw_wr(0x4a, (uint8_t)f0_reg) &&
+	    aw_bits(0x2b, (uint8_t)~(1u << 6), (3u << 6)) &&           /* DATCTRL: 1000 Hz LPF (vendor masks) */
+	    aw_bits(0x2b, (uint8_t)~(1u << 5), (1u << 5)) &&
+	    aw_wr(0x48, (uint8_t)((1u << 7) | (1u << 3) | (1u << 0))) &&   /* CONT_CTRL: ZC detect, closed loop, auto brake */
+	    aw_wr(0x4b, 0xf0) && aw_wr(0x4c, 0x6c) &&                  /* TD 0xf06c */
+	    aw_wr(0x4d, 0x11) &&
+	    aw_wr(0x72, 0x08) && aw_wr(0x73, 0xf8) &&
+	    aw_bits(0x78, (uint8_t)~0xfu, 3) &&                        /* BEMF_NUM: 3 brake periods */
+	    aw_wr(0x7a, 0x23) &&                                       /* TIME_NZC */
+	    aw_wr(0x7b, drive) && aw_wr(0x7c, 0x9b) &&                 /* drive level (DT 0x6a) / overdrive */
+	    aw_wr_raw(0x05, 0x01) == 0;                                /* GO */
+}
+
+static void
+aw_cont_stop(void)
+{
+	(void)aw_wr_raw(0x05, 0x00);                                   /* GO off */
+	for (unsigned i = 0; i < 50; i++) {
+		uint8_t glb = 0;
+		if (aw_rd(0x47, &glb) || (glb & 0x0fu) == 0) {
+			break;
+		}
+		hap_wait(2);
+	}
+	(void)aw_bits(0x03, (uint8_t)~(1u << 5), (1u << 5));
+	(void)aw_bits(0x04, (uint8_t)~(1u << 0), (1u << 0));           /* standby */
+}
+
+/* ---- sweethaptic=3: the motor for iOS ---- */
+
+#define HAP_ACTIVE_US    30000u   /* a write that was not silence counts for this long */
+#define HAP_SILENT_BELOW 256u     /* of 32768 */
+#define HAP_MIN_US       hap_min_us /* shortest buzz: a tap (0198: 40 ms, boot-arg sweethapmin=MS, 10..200) */
+static uint64_t hap_min_us = 30000u;   /* 0203: 30 ms (USER: "a quick strong buzz would make it much better") */
+static int hap_scale;                 /* 0203: sweethapscale=1: drive follows the waveform peak (0198) */
+#define HAP_MAX_US       1000000u /* longest buzz; then it rests as long */
+#define HAP_DRIVE        0x6au    /* the DT's cont_drv_lvl: never exceeded */
+
+static volatile uint64_t hap_heard_us, hap_quiet_us;
+static volatile uint32_t hap_peak;
+static uint64_t hap_frames;
+static uint64_t hap_writes, hap_loud_writes;     /* 0198 */
+static unsigned hap_opens;
+static bool hap_first_loud;
+
+static uint64_t
+hap_now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+/* From the audio server's I/O thread: never waits, never touches the chip. */
+static int
+hap_dev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		uint32_t peak = 0;
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < bytes / 2; i++) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)-(int32_t)samples[i] : (uint32_t)samples[i];
+			peak = v > peak ? v : peak;
+		}
+		hap_frames += (uint64_t)bytes / 2;
+		hap_writes++;
+		if (peak > HAP_SILENT_BELOW) {
+			hap_loud_writes++;
+		}
+		uint64_t now = hap_now_us();
+		if (peak > HAP_SILENT_BELOW) {
+			if (hap_heard_us == 0 || hap_quiet_us > hap_heard_us || now - hap_heard_us >= HAP_ACTIVE_US) {
+				hap_peak = 0;
+			}
+			hap_heard_us = now;
+			if (peak > hap_peak) {
+				hap_peak = peak;
+			}
+		} else {
+			hap_quiet_us = now;
+		}
+	}
+	return error;
+}
+
+static int
+hap_dev_open(__unused dev_t dev, __unused int flags, __unused int type, struct proc *p)
+{
+	if (hap_opens++ < 16) {
+		printf("SWEET HAPTIC: open by %s[%d] flags %#x\n", p ? proc_best_name(p) : "?", p ? proc_pid(p) : -1, flags);
+	}
+	return 0;
+}
+
+static int
+hap_dev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw hap_cdevsw = {
+	.d_open       = hap_dev_open,
+	.d_close      = hap_dev_close,
+	.d_read       = eno_rdwrt,
+	.d_write      = hap_dev_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* the vendor drive level from a third of full scale up, five eighths of it for the softest */
+static uint8_t
+hap_drive_for(uint32_t peak)
+{
+	const uint32_t full = 32768u / 3u, low = HAP_DRIVE * 5u / 8u;
+	if (peak >= full) {
+		return HAP_DRIVE;
+	}
+	return (uint8_t)(low + (HAP_DRIVE - low) * peak / full);
+}
+
+static void
+hap_serve(void)
+{
+	bool on = false;
+	uint64_t began = 0, rest_until = 0;
+	unsigned buzzes = 0, capped = 0;
+	unsigned min_ms = 0;
+	(void)PE_parse_boot_argn("sweethapscale", &hap_scale, sizeof(hap_scale));
+	if (PE_parse_boot_argn("sweethapmin", &min_ms, sizeof(min_ms)) && min_ms >= 10 && min_ms <= 200) {
+		hap_min_us = (uint64_t)min_ms * 1000u;
+	}
+	printf("SWEET HAPTIC: serving /dev/sweet-haptic (%llu frames written so far), taps %llu ms\n", hap_frames,
+	    hap_min_us / 1000u);
+	(void)aw_cont_prepare();     /* 0198: a failed write stops the driver, as every other write */
+	uint64_t stats_at = hap_now_us() + 60000000ull, stats_frames = 0;
+	while (!hs.dead) {
+		uint64_t now = hap_now_us(), heard = hap_heard_us;
+		bool want = heard != 0 && now - heard < HAP_ACTIVE_US && hap_quiet_us <= heard;
+		if (want && !on && now >= rest_until) {
+			uint8_t drive = hap_scale ? hap_drive_for(hap_peak) : HAP_DRIVE;   /* 0203: full DT level */
+			if (!aw_cont_start(drive)) {
+				break;
+			}
+			on = true;
+			began = now;
+			if (++buzzes <= 24) {
+				printf("SWEET HAPTIC: buzz %u: peak %u of 32768, drive %#x\n", buzzes, hap_peak, drive);
+			}
+		} else if (on && (now - began >= HAP_MAX_US || (!want && now - began >= HAP_MIN_US))) {
+			bool cap = now - began >= HAP_MAX_US;
+			aw_cont_stop();
+			on = false;
+			if (cap) {
+				rest_until = now + HAP_MAX_US;
+				if (++capped <= 8) {
+					printf("SWEET HAPTIC: buzz %u capped at %u ms; resting\n", buzzes, HAP_MAX_US / 1000u);
+				}
+			}
+			uint8_t sysint = 0;
+			if (aw_rd(0x02, &sysint) || (sysint & 0x46u)) {
+				printf("SWEET HAPTIC: after buzz %u: SYSINT %#04x: stop, chip back into reset\n", buzzes, sysint);
+				hs.dead = true;
+			}
+		}
+		if (!hap_first_loud && hap_loud_writes) {
+			hap_first_loud = true;
+			printf("SWEET HAPTIC: first sound from iOS after %llu frames (%llu writes), peak %u\n",
+			    hap_frames, hap_writes, hap_peak);
+		}
+		if (now >= stats_at) {
+			if (hap_frames != stats_frames) {
+				printf("SWEET HAPTIC: 60 s: %llu frames total, %llu writes (%llu not silence), %u buzzes, %u capped\n",
+				    hap_frames, hap_writes, hap_loud_writes, buzzes, capped);
+			}
+			stats_frames = hap_frames;
+			stats_at = now + 60000000ull;
+		}
+		hap_wait(on ? 2 : 4);
+	}
+	if (on) {
+		aw_cont_stop();
+	}
+	printf("SWEET HAPTIC: service stopped after %u buzzes (%u capped), %llu frames\n", buzzes, capped, hap_frames);
+}
+
+static void
+hap_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	hap_wait(40000);    /* after the UI is up */
+	hs.gcc = ml_io_map(HAP_GCC_PA, 0x90000);
+	hs.gpio = ml_io_map(HAP_NORTH_PA, 0x30000);
+	hs.se = ml_io_map(HAP_SE_PA, 0x4000);
+	if (!hs.gcc || !hs.gpio || !hs.se || !hap_clocks()) {
+		goto out;
+	}
+	/* I2C pins: function qup13 (mux 1), bias disabled (board pull-ups), 2 mA */
+	hap_gpio(46, 1, 0, 0, false, false);
+	hap_gpio(47, 1, 0, 0, false, false);
+	if (!hap_se_init()) {
+		goto out;
+	}
+	hap_reset(false);
+	hap_wait(5);
+	hap_reset(true);
+	hap_wait(5);
+	uint8_t id = 0;
+	int err = aw_rd(0x00, &id);
+	printf("SWEET HAPTIC: AW8624 chip ID read -> %d, id %#04x (expect 0x24)\n", err, id);
+	if (err || id != 0x24) {
+		goto reset;
+	}
+	(void)aw_status("after reset");
+	if (hs.stage < 2) {
+		goto reset;
+	}
+	(void)aw_wr_raw(0x00, 0xaa);    /* soft reset (aw8624_haptic_softreset) */
+	hap_wait(2);
+	if (!aw_init() || !aw_status("after init")) {
+		goto reset;
+	}
+	for (unsigned n = 0; n < 3 && !hs.dead; n++) {
+		if (!aw_cont_start(0x6a)) {
+			break;
+		}
+		hap_wait(80);
+		aw_cont_stop();
+		if (!aw_status("after buzz")) {
+			break;
+		}
+		hap_wait(300);
+	}
+	printf("SWEET HAPTIC: test buzzes done%s\n", hs.dead ? " (stopped on an error)" : "");
+	if (hs.stage >= 3 && !hs.dead) {
+		hap_serve();
+	}
+reset:
+	hap_reset(false);
+	printf("SWEET HAPTIC: chip back in reset\n");
+out:
+	(void)thread_terminate(current_thread());
+}
+
+void
+sweet_haptic_init(void)
+{
+	int stage = 0;
+	(void)PE_parse_boot_argn("sweethaptic", &stage, sizeof(stage));
+	if (stage <= 0 || hs.started) {
+		return;
+	}
+	hs.started = true;
+	hs.stage = stage;
+	if (stage >= 3) {
+		/* now, before the plug-in first plays: it gives up on a device that is not there */
+		int major = cdevsw_add(-1, &hap_cdevsw);
+		if (major < 0) {
+			printf("SWEET HAPTIC: cdevsw_add failed (%d)\n", major);
+		} else {
+			devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweet-haptic");
+			printf("SWEET HAPTIC: /dev/sweet-haptic ready (major %d)\n", major);
+		}
+	}
+	thread_t th;
+	if (kernel_thread_start(hap_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+		printf("SWEET HAPTIC: stage %d armed (40 s)\n", stage);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_ipa.c b/bsd/dev/sweet_ipa.c
new file mode 100644
index 0000000..205497c
--- /dev/null
+++ b/bsd/dev/sweet_ipa.c
@@ -0,0 +1,633 @@
+/*
+ * Sweet (SM7150, IPA v4.2): the cellular data path. UniXNU QcomBaseband's IPA v4.2 code (bsd/dev/coachz_ipa/, BSD-2-Clause,
+ * from chiba233/Trogdor-ipadOS c6794008 via UniXNU/QcomBaseband 43d85fb08d) driven as its platform/coachz/coachz_modem.c does,
+ * with Sweet's differences:
+ *   - wland (userland) owns the modem link, SMP2P and the modem boot, so the steps arrive as /dev/sweet-bb records
+ *     (iokit/Kernel/arm/SweetBaseband.inc forwards them here): 7 configure, 8 firmware loaded, 9 modem starting, 10 IPA QMI in.
+ *     Answers go back as records 11 (IPA QMI to send) and 12 (status of a step).
+ *   - The GSI firmware is the AP's to load (stock DT qcom,ipa_fws, PAS 15, ips_fw_region 0x97f00000): wland loads it between
+ *     records 7 and 8, as mainline's IPA_LOADER_SELF does between ipa_config and ipa_setup. There is no ipa-setup-ready wait.
+ *   - The IPA core clock (BCM IP0) and its paths to DDR (SN11, SN0) and to its registers (CN0) are voted here; the apps SMMU
+ *     gets a bypass stream for the IPA (SID 0x520, 0x522 with mask 2), as 0153 does for the WLAN.
+ *   - DMA memory is low DRAM below 4 GB that XNU never maps (it uses only DDR above 4 GB) and wland does not use
+ *     (0xe0000000 WLAN pool, 0xe1000000 rmtfs): 0xe4000000..0xe4700000, mapped write-combined as upstream maps its ranges.
+ *   - A kernel thread polls the IPA/GSI interrupts (1 ms while packets move, 10 ms when idle) and drains the pdp_ip queues.
+ * Off unless the boot-arg sweetipa=1. Every failure is printed and turns the data path off; voice, SMS and Wi-Fi go on.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+
+#include "coachz_ipa/coachz_ipa_cmd.c"
+#include "coachz_ipa/coachz_ipa_rx.c"
+#include "coachz_ipa/coachz_ipa_modem.c"
+#include "coachz_ipa/coachz_ipa_qmi.h"
+
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+extern int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+extern int sweet_rpmh_bcm_clock(const char *res, uint64_t hz);
+extern int sweet_smmu_ipa_stream(void);
+extern void IOSleep(unsigned);
+extern void sweet_bb_pdp_poll(void);
+
+/* the entry points SweetBaseband.inc and coachz_bb_pdp.cpp use */
+int sweet_ipa_enabled(void);
+void sweet_ipa_record(uint32_t type, uint32_t a, uint32_t b, uint32_t c, uint32_t d, const void *data, uint32_t len);
+void sweet_ipa_new_server(uint32_t service, uint32_t version_instance, uint32_t node, uint32_t port);
+uint32_t sweet_ipa_drain(uint8_t *buf, uint32_t room);
+int sweet_ipa_polling(void);
+void coachz_modem_data_receiver(void (*receiver)(uint32_t, const uint8_t *, uint32_t, uint32_t));
+int coachz_modem_data_send(uint32_t mux, const uint8_t *ip, uint32_t length);
+
+#define SI_DMA_PA        0xe4000000ull
+#define SI_RX_PA         (SI_DMA_PA + 0x000000ull)   /* LAN RX buffers, 2 MB */
+#define SI_RX_BYTES      0x200000u
+#define SI_RING_PA       (SI_DMA_PA + 0x200000ull)   /* GSI rings, 64 KB; the command ring at +0xc000 */
+#define SI_RING_BYTES    0x10000u
+#define SI_CMD_OFFSET    0xc000u
+#define SI_CMD_BYTES     0x4000u
+#define SI_ZERO_PA       (SI_DMA_PA + 0x210000ull)   /* zeroed bytes for ipa_mem_zero, 8 KB */
+#define SI_ZERO_BYTES    0x2000u
+#define SI_MODEM_RX_PA   (SI_DMA_PA + 0x400000ull)   /* modem RX buffers, 2 MB */
+#define SI_MODEM_RX_BYTES 0x200000u
+#define SI_MODEM_TX_PA   (SI_DMA_PA + 0x600000ull)   /* modem TX buffers, 1 MB */
+#define SI_MODEM_TX_BYTES 0x100000u
+#define SI_CORE_HZ       100000000ull                /* ipa_data-v4.2.c core_clock_rate */
+
+enum { SI_OFF, SI_CONFIGURED, SI_SET_UP };
+enum { SI_REC_CONFIGURE = 7, SI_REC_FW_LOADED = 8, SI_REC_STARTING = 9, SI_REC_QMI_IN = 10, SI_REC_QMI_OUT = 11, SI_REC_STATUS = 12 };
+
+static LCK_GRP_DECLARE(si_lck_grp, "sweet-ipa");
+static LCK_MTX_DECLARE(si_mtx, &si_lck_grp);
+
+static int si_enabled = -1;
+static int si_state;
+static struct coachz_ipa si_ipa;
+static struct coachz_gsi si_gsi;
+static struct coachz_ipa_cmd si_cmd;
+static struct coachz_ipa_rx si_lan, si_modem_rx;
+static struct coachz_ipa_modem si_modem;
+static int si_modem_open;
+static void (*si_data_rx)(uint32_t, const uint8_t *, uint32_t, uint32_t);
+static struct ci_handshake si_hs;
+static uint32_t si_modem_node, si_modem_port, si_peer_node, si_peer_port;
+static int si_modem_known, si_peer_known, si_init_driver_sent, si_thread_started;
+static uint16_t si_txn;
+static volatile uint64_t si_activity;   /* bumped when packets move: the poll thread runs fast */
+
+/* records for wland (11, 12): a small ring of copies, drained by sweet_ipa_drain under si_mtx */
+#define SI_OUTQ 16u
+struct si_out { uint32_t type, a, b, c, len; uint8_t data[CI_INIT_DRIVER_REQ_MAX + 32]; };
+static struct si_out si_outq[SI_OUTQ];
+static uint32_t si_out_head, si_out_count, si_out_dropped;
+
+/* 0243 (diagnostic): 2401/2421 died 30-40 s after "configured", when si_thread's first 30 s report is due, and no report
+ * line reached the log. Boot-arg sweetipadiag: 0x1 = handshake only, the modem endpoints stay closed; 0x2 = no 30 s report.
+ * Always with sweetipa=1: a heartbeat every 2 s for the first 180 s of si_thread, and the first 3 reports print a marker
+ * before each step with a 300 ms pause after it (the USB log thread sends every 100 ms, so the last step shows). */
+static int si_diag = -1;
+static int
+si_diag_bits(void)
+{
+	if (si_diag < 0) {
+		int bits = 0;
+		PE_parse_boot_argn("sweetipadiag", &bits, sizeof(bits));
+		si_diag = bits;
+	}
+	return si_diag;
+}
+static uint64_t
+si_uptime_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
+
+int
+sweet_ipa_enabled(void)
+{
+	if (si_enabled < 0) {
+		int on = 0;
+		PE_parse_boot_argn("sweetipa", &on, sizeof(on));
+		si_enabled = on ? 1 : 0;
+	}
+	return si_enabled;
+}
+
+static void
+si_queue(uint32_t type, uint32_t a, uint32_t b, uint32_t c, const void *data, uint32_t len)
+{
+	if (si_out_count == SI_OUTQ || len > sizeof(si_outq[0].data)) {
+		si_out_dropped++;
+		return;
+	}
+	struct si_out *o = &si_outq[(si_out_head + si_out_count++) % SI_OUTQ];
+	o->type = type; o->a = a; o->b = b; o->c = c; o->len = len;
+	if (len) __builtin_memcpy(o->data, data, len);
+}
+
+static void
+si_status(uint32_t stage, int result)
+{
+	si_queue(SI_REC_STATUS, stage, (uint32_t)result, 0, NULL, 0);
+}
+
+/* upstream's send callback: an IPA QMI body from our client (1) or server (0) port to node:port; wland sends it */
+static int
+si_send(int client, uint32_t node, uint32_t port, const void *message, uint32_t length)
+{
+	const uint32_t before = si_out_dropped;
+	si_queue(SI_REC_QMI_OUT, client ? 1u : 0u, node, port, message, length);
+	return si_out_dropped != before ? ENOSPC : 0;
+}
+
+/* ---------------------------------------------------------------- data entry points (coachz_bb_pdp.cpp) */
+static void
+si_data_deliver(void *context, uint32_t mux, const uint8_t *ip, uint32_t length, uint32_t ip_version)
+{
+	(void)context;
+	si_activity++;
+	if (si_data_rx) si_data_rx(mux, ip, length, ip_version);
+}
+void
+coachz_modem_data_receiver(void (*receiver)(uint32_t, const uint8_t *, uint32_t, uint32_t))
+{
+	si_data_rx = receiver;
+}
+int
+coachz_modem_data_send(uint32_t mux, const uint8_t *ip, uint32_t length)
+{
+	if (!si_modem_open) return ENETDOWN;
+	lck_mtx_lock(&si_mtx);
+	const int result = si_modem_open ? coachz_ipa_modem_xmit(&si_modem, mux, ip, length) : -ENETDOWN;
+	lck_mtx_unlock(&si_mtx);
+	if (!result) si_activity++;
+	return result < 0 ? -result : result;
+}
+
+/* ---------------------------------------------------------------- the steps (si_mtx held) */
+static uint32_t
+si_channel_state(uint32_t id)
+{
+	return cgs_state(gsi_rd(&si_gsi, CGSI_CH_C_CNTXT_0 + id * CGSI_CH_C_CNTXT_0_STRIDE));
+}
+
+static void si_thread(void *arg, wait_result_t wr);
+
+/* record 7: power, SMMU, then mainline's ipa_config and the rings Linux allocates at probe (coachz_modem_configure) */
+static int
+si_configure(void)
+{
+	if (si_state != SI_OFF) return 0;
+	const int clk = sweet_rpmh_bcm_clock("IP0", SI_CORE_HZ);
+	const int sn11 = sweet_rpmh_bcm_vote("SN11", 1, 1), sn0 = sweet_rpmh_bcm_vote("SN0", 1, 1), cn0 = sweet_rpmh_bcm_vote("CN0", 1, 1);
+	printf("SWEET IPA: votes IP0 %d SN11 %d SN0 %d CN0 %d\n", clk, sn11, sn0, cn0);
+	if (clk) {
+		printf("SWEET IPA: no core clock: the IPA registers are not touched, cellular data stays off\n");
+		return EIO;
+	}
+	/* 0193: without both streams the IPA's DMA faults and its commands never complete; 0192 then reset the SoC ~70 s later. */
+	if (sweet_smmu_ipa_stream()) {
+		printf("SWEET IPA: no apps-SMMU stream: the IPA is not touched, cellular data stays off\n");
+		return ENXIO;
+	}
+	void *zero = (void *)ml_io_map_wcomb((vm_offset_t)SI_ZERO_PA, SI_ZERO_BYTES);
+	uint8_t *ring = (uint8_t *)ml_io_map_wcomb((vm_offset_t)SI_RING_PA, SI_RING_BYTES);
+	void *rx = (void *)ml_io_map_wcomb((vm_offset_t)SI_RX_PA, SI_RX_BYTES);
+	if (!zero || !ring || !rx) {
+		printf("SWEET IPA: no DMA mappings\n");
+		return ENOMEM;
+	}
+	__builtin_memset(ring, 0, SI_RING_BYTES);
+	int err = coachz_ipa_config(&si_ipa, zero, SI_ZERO_PA, NULL);
+	if (!err) err = coachz_gsi_init(&si_gsi, si_ipa.gsi, ring, SI_RING_PA, SI_RING_BYTES);
+	if (!err) err = coachz_ipa_cmd_init(&si_cmd, &si_ipa, &si_gsi, ring + SI_CMD_OFFSET, SI_RING_PA + SI_CMD_OFFSET, SI_CMD_BYTES);
+	if (!err) err = coachz_ipa_rx_init(&si_lan, &si_ipa, &si_gsi, CIPA_EP_AP_LAN_RX, rx, SI_RX_PA, SI_RX_BYTES);
+	if (err) {
+		printf("SWEET IPA: configuration failed (%d), cellular data stays off\n", err);
+		return err < 0 ? -err : err;
+	}
+	si_state = SI_CONFIGURED;
+	if (!si_thread_started) {
+		thread_t t = THREAD_NULL;
+		if (kernel_thread_start(si_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+			si_thread_started = 1;
+		}
+	}
+	printf("SWEET IPA: configured; GSI firmware next (wland, PAS 15)\n");
+	return 0;
+}
+
+static void
+si_init_driver(void)
+{
+	uint8_t message[CI_INIT_DRIVER_REQ_MAX];
+	if (si_state != SI_SET_UP || !si_modem_known || si_init_driver_sent) return;
+	const size_t length = ci_init_driver_req(message, sizeof message, ++si_txn, si_ipa.mem_offset, si_ipa.uc_loaded);
+	const int result = length ? si_send(1, si_modem_node, si_modem_port, message, (uint32_t)length) : -1;
+	si_init_driver_sent = !result;
+	printf("SWEET IPA: INIT_DRIVER %u bytes to %u:0x%x, mem_offset 0x%x, uc_loaded %d, queued %d\n", (unsigned)length, si_modem_node,
+	    si_modem_port, si_ipa.mem_offset, si_ipa.uc_loaded, result);
+}
+
+/* record 8: the GSI firmware runs; the rest of ipa_setup (coachz_modem_setup) */
+static int
+si_setup(void)
+{
+	if (si_state != SI_CONFIGURED) {
+		printf("SWEET IPA: firmware loaded, but the IPA is not configured\n");
+		return EINVAL;
+	}
+	int err = coachz_gsi_setup(&si_gsi);
+	if (!err) err = coachz_ipa_setup_commands(&si_cmd);
+	if (!err) err = coachz_ipa_setup_lan_rx(&si_lan);
+	if (err) {
+		printf("SWEET IPA: setup failed (%d), cellular data stays off\n", err);
+		si_state = SI_OFF;
+		return err < 0 ? -err : err;
+	}
+	si_state = SI_SET_UP;
+	ci_setup(&si_hs);
+	printf("SWEET IPA: set up; waiting for the modem's IPA service\n");
+	si_init_driver();
+	return 0;
+}
+
+/* ipa_modem_start and opening rmnet_ipa0 (cm_modem_start) */
+static void
+si_modem_start(void)
+{
+	void *rx = (void *)ml_io_map_wcomb((vm_offset_t)SI_MODEM_RX_PA, SI_MODEM_RX_BYTES);
+	void *tx = (void *)ml_io_map_wcomb((vm_offset_t)SI_MODEM_TX_PA, SI_MODEM_TX_BYTES);
+	printf("SWEET IPA: modem start: RX init\n");
+	int err = !rx || !tx ? -1 : coachz_ipa_rx_init(&si_modem_rx, &si_ipa, &si_gsi, CIPA_EP_AP_MODEM_RX, rx, SI_MODEM_RX_PA, SI_MODEM_RX_BYTES);
+	printf("SWEET IPA: modem start: RX init %d, modem init\n", err);
+	if (!err) err = coachz_ipa_modem_init(&si_modem, &si_ipa, &si_gsi, &si_modem_rx, tx, SI_MODEM_TX_PA, SI_MODEM_TX_BYTES);
+	printf("SWEET IPA: modem start: modem init %d, start\n", err);
+	if (!err) err = coachz_ipa_modem_start(&si_modem);
+	printf("SWEET IPA: modem start: start %d, open\n", err);
+	if (!err) err = coachz_ipa_modem_open(&si_modem);
+	if (err) {
+		printf("SWEET IPA: modem data path failed (%d); voice and Wi-Fi go on without it\n", err);
+		return;
+	}
+	for (uint32_t mux = 1; mux <= 4; mux++) coachz_ipa_modem_mux_add(&si_modem, mux);
+	si_modem.mux_deliver = si_data_deliver;
+	si_modem_open = 1;
+	printf("SWEET IPA: modem endpoints open, channel states TX 0:%u RX 3:%u; pdp_ip0..3 = mux 1..4\n", si_channel_state(0),
+	    si_channel_state(3));
+}
+
+static void
+si_step(void)
+{
+	for (;;) {
+		const struct ci_step step = ci_ready_step(&si_hs);
+		if (step.send_init_complete) {
+			uint8_t message[32];
+			const size_t length = ci_init_complete_ind(message, sizeof message, ++si_txn);
+			const int sent = si_peer_known && length && !si_send(0, si_peer_node, si_peer_port, message, (uint32_t)length);
+			printf("SWEET IPA: INIT_COMPLETE %s\n", sent ? "queued" : "not sent");
+			if (!sent) return;
+			ci_indication_sent(&si_hs);
+			continue;
+		}
+		if (step.start_modem && !si_modem_open) {
+			static int si_diag_skipped;
+			if (si_diag_bits() & 1) {
+				if (!si_diag_skipped++)
+					printf("SWEET IPA DIAG: handshake complete at %llu ms; modem endpoints NOT opened (sweetipadiag 0x1)\n",
+					    si_uptime_ms());
+				return;
+			}
+			printf("SWEET IPA: handshake complete, starting the modem endpoints\n");
+			si_modem_start();
+		}
+		return;
+	}
+}
+
+/* 0241: IPA QMI messages the modem sends after INIT_COMPLETE (ipa_qmi_service_v01.h) */
+#define SI_INSTALL_FILTER_RULE    0x23u
+#define SI_FILTER_INSTALLED_NOTIF 0x24u
+#define SI_CONFIG                 0x27u
+#define SI_FSPEC_EX_SIZE          173u     /* ipa_filter_spec_ex_type_v01; rule_id u32 at 168 (redfin/HakiOS) */
+#define SI_FSPEC_EX_RULE_ID       168u
+#define SI_MAX_RULES              32u
+
+static uint32_t
+si_rd32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* INSTALL_FILTER_RULE: result success + TLV 0x11 rule_id list echoed from TLV 0x15 (u8 count, count x 173-byte
+ * filter_spec_ex); then FILTER_INSTALLED_NOTIF (0x24) to the modem's IPA service: 0x01 source pipe = AP_MODEM_TX,
+ * 0x02 status u16 0, 0x03 empty filter_index_list, 0x17 rule ids (as Android ipa3_wwan_add_ul_flt_rule_to_ipa). */
+static void
+si_install_filter(uint32_t node, uint32_t port, const struct ci_msg *m)
+{
+	uint8_t ids[1 + 4 * SI_MAX_RULES];
+	unsigned k = 0;
+	uint16_t l = 0;
+	const uint8_t *p = ci_find(m, 0x15, &l);
+	ids[0] = 0;
+	if (p != NULL && l >= 1 && l == 1u + (unsigned)p[0] * SI_FSPEC_EX_SIZE) {
+		const unsigned cnt = p[0];
+		k = cnt > SI_MAX_RULES ? SI_MAX_RULES : cnt;
+		ids[0] = (uint8_t)k;
+		for (unsigned r = 0; r < cnt; r++) {
+			const uint8_t *e = p + 1 + r * SI_FSPEC_EX_SIZE;
+			if (r < 8)
+				printf("SWEET IPA: filter rule %u: ip %u action %u rt %u/%u mux %u/%u id 0x%x hash %u\n", r, si_rd32(e),
+				    si_rd32(e + 154), e[158], si_rd32(e + 159), e[163], si_rd32(e + 164), si_rd32(e + SI_FSPEC_EX_RULE_ID),
+				    e[172]);
+			if (r < k)
+				memcpy(ids + 1 + 4 * r, e + SI_FSPEC_EX_RULE_ID, 4);
+		}
+	} else {
+		printf("SWEET IPA: filter rules: TLV 0x15 %s (%u bytes): success alone\n", p ? "not 1 + n x 173" : "missing",
+		    (unsigned)l);
+	}
+	uint8_t out[16 + sizeof ids];
+	struct ci_buf b = { out, sizeof out, 0, 0 };
+	ci_header(&b, CI_QMI_RESPONSE, m->txn, m->id);
+	ci_u8(&b, 0x02); ci_u16(&b, 4); ci_u16(&b, 0); ci_u16(&b, 0);
+	if (k) {
+		ci_u8(&b, 0x11); ci_u16(&b, (uint16_t)(1 + 4 * k)); ci_put(&b, ids, 1 + 4 * k);
+	}
+	size_t n = ci_finish(&b);
+	int r1 = n ? si_send(0, node, port, out, (uint32_t)n) : -1;
+	int r2 = -1;
+	if (k && si_modem_known) {
+		uint8_t empty = 0;
+		ci_header(&b, CI_QMI_REQUEST, ++si_txn, SI_FILTER_INSTALLED_NOTIF);
+		ci_tlv_u32(&b, 0x01, CI_EP_AP_MODEM_TX);
+		ci_u8(&b, 0x02); ci_u16(&b, 2); ci_u16(&b, 0);
+		ci_u8(&b, 0x03); ci_u16(&b, 1); ci_put(&b, &empty, 1);
+		ci_u8(&b, 0x17); ci_u16(&b, (uint16_t)(1 + 4 * k)); ci_put(&b, ids, 1 + 4 * k);
+		n = ci_finish(&b);
+		r2 = n ? si_send(1, si_modem_node, si_modem_port, out, (uint32_t)n) : -1;
+	}
+	printf("SWEET IPA: install filter rule answered (%u ids) -> %d; FILTER_INSTALLED_NOTIF source ep %u -> %d\n", k, r1,
+	    CI_EP_AP_MODEM_TX, r2);
+}
+
+static void
+si_qmi(int client, uint32_t node, uint32_t port, const void *body, uint32_t length)
+{
+	struct ci_msg m;
+	printf("SWEET IPA: QMI in on the %s port, %u bytes from %u:0x%x\n", client ? "client" : "server", length, node, port);
+	if (!ci_parse(body, length, &m)) {
+		printf("SWEET IPA: bad QMI message of %u bytes from %u:0x%x\n", length, node, port);
+		return;
+	}
+	if (client) {
+		struct ci_init_driver_rsp r;
+		if (!ci_init_driver_rsp_parse(&m, &r)) {
+			printf("SWEET IPA: QMI type %u message 0x%x on the client port\n", m.type, m.id);
+			return;
+		}
+		printf("SWEET IPA: INIT_DRIVER answer: ok %d error %u, ctrl %d/%u default %d/%u pending %d/%u\n", r.ok, r.error, r.has_ctrl,
+		    r.ctrl_end_pt, r.has_default, r.default_end_pt, r.has_pending, r.pending);
+		if (r.ok) ci_on_init_driver_success(&si_hs);
+	} else {
+		uint8_t message[32];
+		/* 0241 (ios-redfin ipaqmi.c, Android ipa_qmi_service): also answer CONFIG 0x27 and FILTER_INSTALLED_NOTIF 0x24
+		 * with success, and INSTALL_FILTER_RULE 0x23 with the rule ids + a FILTER_INSTALLED_NOTIF to the modem (2401: both
+		 * left unanswered, then a kernel panic ~25 s later; redfin: without the notification the modem never sends DL). */
+		if (m.type == CI_QMI_REQUEST && m.id == SI_INSTALL_FILTER_RULE) {
+			printf("SWEET IPA: QMI type %u message 0x%x from %u:0x%x (install filter rule)\n", m.type, m.id, node, port);
+			si_install_filter(node, port, &m);
+			return;
+		}
+		const int known = m.type == CI_QMI_REQUEST && (m.id == CI_INDICATION_REGISTER || m.id == CI_DRIVER_INIT_COMPLETE ||
+		    m.id == SI_CONFIG || m.id == SI_FILTER_INSTALLED_NOTIF);
+		printf("SWEET IPA: QMI type %u message 0x%x from %u:0x%x%s\n", m.type, m.id, node, port, known ? "" : ", not handled");
+		if (!known) return;
+		if (m.id == SI_CONFIG || m.id == SI_FILTER_INSTALLED_NOTIF) {
+			const size_t sz = ci_success_rsp(message, sizeof message, m.txn, m.id);
+			const int r = sz ? si_send(0, node, port, message, (uint32_t)sz) : -1;
+			printf("SWEET IPA: 0x%x answered success -> %d\n", m.id, r);
+			return;
+		}
+		si_peer_node = node;
+		si_peer_port = port;
+		si_peer_known = 1;
+		const size_t size = ci_success_rsp(message, sizeof message, m.txn, m.id);
+		if (!size || si_send(0, node, port, message, (uint32_t)size)) {
+			printf("SWEET IPA: response to 0x%x not queued\n", m.id);
+			return;
+		}
+		if (m.id == CI_INDICATION_REGISTER) ci_on_indication_register_answered(&si_hs);
+		else ci_on_driver_init_complete_answered(&si_hs);
+	}
+	si_step();
+}
+
+/* the interrupts coachz_modem_poll handles: SPI ipa-irq, gsi-irq and the RX/TX event rings, polled */
+/* 0194: the 0193 boot panicked on CPU 3 right after INIT_DRIVER (no text in the logs); each new pending IPA/GSI interrupt
+   set is printed (first 64 changes) before it is handled, so the console shows what the hardware raised last. */
+static uint32_t si_irq_seen_ipa, si_irq_seen_gsi, si_irq_logs;
+static void
+si_irq_note(void)
+{
+	const uint32_t ipa = ipa_rd(&si_ipa, CIPA_IPA_IRQ_STTS);
+	const uint32_t gsi = si_state == SI_SET_UP ? gsi_rd(&si_gsi, CGSI_CNTXT_TYPE_IRQ) : 0;
+	if ((ipa & ~si_irq_seen_ipa) || (gsi & ~si_irq_seen_gsi)) {
+		si_irq_seen_ipa |= ipa;
+		si_irq_seen_gsi |= gsi;
+		if (si_irq_logs++ < 64)
+			printf("SWEET IPA: irq pending IPA 0x%x (enabled 0x%x) GSI type 0x%x (enabled 0x%x)\n", ipa, si_ipa.irq_enabled, gsi,
+			    si_gsi.type_enabled);
+	}
+}
+
+static void
+si_poll_locked(void)
+{
+	if (si_state == SI_OFF) return;
+	si_irq_note();
+	coachz_ipa_interrupt(&si_ipa);
+	if (si_state != SI_SET_UP) return;
+	coachz_gsi_interrupt(&si_gsi);
+	if (si_gsi.ieob_pending & (1u << si_lan.evt_ring)) {
+		si_gsi.ieob_pending &= ~(1u << si_lan.evt_ring);
+		coachz_ipa_rx_poll(&si_lan);
+	}
+	if (!si_modem_open) return;
+	if (si_gsi.ieob_pending & (1u << si_modem_rx.evt_ring)) {
+		si_gsi.ieob_pending &= ~(1u << si_modem_rx.evt_ring);
+		if (coachz_ipa_rx_poll(&si_modem_rx)) si_activity++;
+	}
+	if (si_gsi.ieob_pending & (1u << si_modem.tx_evt_ring)) {
+		si_gsi.ieob_pending &= ~(1u << si_modem.tx_evt_ring);
+		coachz_ipa_modem_tx_poll(&si_modem);
+	}
+}
+
+static unsigned si_reports;
+static void
+si_diag_step(const char *what)
+{
+	printf("SWEET IPA DIAG: report %u at %llu ms: %s\n", si_reports, si_uptime_ms(), what);
+	IOSleep(300);   /* under si_mtx: a QMI record from wland waits; diagnostic only */
+}
+
+static void
+si_report(unsigned second)
+{
+	const int steps = si_reports < 3;
+	if (steps) si_diag_step("start, first line next");
+	printf("SWEET IPA: %u s: state %d uc_loaded %d modem_ready %d uc_ready %d indication %d/%d, LAN RX %llu/%llu/%llu, out dropped %u\n",
+	    second, si_state, si_ipa.uc_loaded, si_hs.modem_ready, si_hs.uc_ready, si_hs.indication_requested, si_hs.indication_sent,
+	    si_lan.packets, si_lan.delivered, si_lan.dropped, si_out_dropped);
+	if (steps) si_diag_step(si_modem_open ? "first line done; reading GSI channel 0 state" : "first line done; modem closed");
+	if (si_modem_open && steps) {
+		const uint32_t c0 = si_channel_state(0);
+		printf("SWEET IPA DIAG: channel 0 state %u\n", c0);
+		si_diag_step("reading GSI channel 3 state");
+		const uint32_t c3 = si_channel_state(3);
+		printf("SWEET IPA DIAG: channel 3 state %u\n", c3);
+		si_diag_step("second line next");
+	}
+	if (si_modem_open)
+		printf("SWEET IPA: %u s: channels TX 0:%u RX 3:%u, modem RX %llu delivered %llu dropped %llu, TX %llu\n", second,
+		    si_channel_state(0), si_channel_state(3), si_modem_rx.packets, si_modem_rx.delivered, si_modem_rx.dropped, si_modem.tx_packets);
+	if (steps) si_diag_step("done");
+	si_reports++;
+}
+
+static void
+si_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	uint64_t last_activity = 0, quiet_rounds = 0, next_report = 0, loops = 0;
+	const uint64_t start_ms = si_uptime_ms();
+	uint64_t next_beat_ms = start_ms;
+	printf("SWEET IPA DIAG: poll thread up at %llu ms, sweetipadiag %#x\n", start_ms, si_diag_bits());
+	for (;;) {
+		lck_mtx_lock(&si_mtx);
+		si_poll_locked();
+		loops++;
+		{
+			const uint64_t ms = si_uptime_ms();
+			if (ms >= next_beat_ms && ms - start_ms <= 180000) {
+				next_beat_ms = ms + 2000;
+				printf("SWEET IPA DIAG: beat +%llu ms loops %llu activity %llu state %d open %d irq IPA 0x%x GSI 0x%x ieob 0x%x "
+				    "modem RX %llu TX %llu\n", ms - start_ms, loops, (unsigned long long)si_activity, si_state, si_modem_open,
+				    si_irq_seen_ipa, si_irq_seen_gsi, si_gsi.ieob_pending, si_modem_rx.packets, si_modem.tx_packets);
+			}
+		}
+		uint64_t now_s = 0;
+		{
+			uint64_t ns = 0;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			now_s = ns / 1000000000ull;
+		}
+		if (now_s >= next_report) {
+			if (next_report && !(si_diag_bits() & 2)) si_report((unsigned)now_s);
+			next_report = now_s + 30;
+		}
+		lck_mtx_unlock(&si_mtx);
+		sweet_bb_pdp_poll();   /* pdp_ip output queues -> coachz_modem_data_send; never under si_mtx */
+		if (si_activity != last_activity) {
+			last_activity = si_activity;
+			quiet_rounds = 0;
+		} else {
+			quiet_rounds++;
+		}
+		IOSleep(quiet_rounds < 100 ? 1 : 10);
+	}
+}
+
+/* ---------------------------------------------------------------- /dev/sweet-bb */
+void
+sweet_ipa_record(uint32_t type, uint32_t a, uint32_t b, uint32_t c, uint32_t d, const void *data, uint32_t len)
+{
+	(void)d;
+	if (type < SI_REC_CONFIGURE || type > SI_REC_QMI_IN) return;
+	lck_mtx_lock(&si_mtx);
+	if (!sweet_ipa_enabled()) {
+		if (type == SI_REC_CONFIGURE) {
+			printf("SWEET IPA: off (boot-arg sweetipa=1 turns the cellular data path on)\n");
+			si_status(type, ENODEV);
+		}
+		lck_mtx_unlock(&si_mtx);
+		return;
+	}
+	switch (type) {
+	case SI_REC_CONFIGURE:
+		si_status(type, si_configure());
+		break;
+	case SI_REC_FW_LOADED:
+		if (a) {
+			printf("SWEET IPA: wland could not load the GSI firmware (%d), cellular data stays off\n", (int)a);
+			si_state = SI_OFF;
+			si_status(type, (int)a);
+			break;
+		}
+		si_status(type, si_setup());
+		break;
+	case SI_REC_STARTING:
+		if (si_state != SI_OFF) coachz_ipa_modem_starting(&si_ipa);
+		break;
+	case SI_REC_QMI_IN:
+		if (si_state != SI_OFF) si_qmi(a != 0, b, c, data, len);
+		break;
+	}
+	lck_mtx_unlock(&si_mtx);
+}
+
+/* QRTR NEW_SERVER, whichever order it comes in relative to the setup (coachz_modem_new_server) */
+void
+sweet_ipa_new_server(uint32_t service, uint32_t version_instance, uint32_t node, uint32_t port)
+{
+	if (!ci_is_modem_service(service, version_instance)) return;   /* QRTR word: version | instance << 8 (0x201) */
+	lck_mtx_lock(&si_mtx);
+	si_modem_node = node;
+	si_modem_port = port;
+	si_modem_known = 1;
+	printf("SWEET IPA: modem IPA service at %u:0x%x\n", node, port);
+	si_init_driver();
+	lck_mtx_unlock(&si_mtx);
+}
+
+/* 1 once the poll thread drains the pdp_ip queues (SweetBaseband.inc then leaves bb_pdp_poll to it) */
+int
+sweet_ipa_polling(void)
+{
+	return si_thread_started;
+}
+
+/* records 11 and 12 for wland, little endian: u32 type, a, b, c, 0, len, then len bytes padded to 4 */
+uint32_t
+sweet_ipa_drain(uint8_t *buf, uint32_t room)
+{
+	uint32_t at = 0;
+	lck_mtx_lock(&si_mtx);
+	while (si_out_count) {
+		struct si_out *o = &si_outq[si_out_head];
+		const uint32_t padded = (o->len + 3u) & ~3u;
+		if (at + 24u + padded > room) break;
+		const uint32_t w[6] = { o->type, o->a, o->b, o->c, 0, o->len };
+		__builtin_memcpy(buf + at, w, 24);
+		if (o->len) __builtin_memcpy(buf + at + 24, o->data, o->len);
+		for (uint32_t i = o->len; i < padded; i++) buf[at + 24 + i] = 0;
+		at += 24u + padded;
+		si_out_head = (si_out_head + 1) % SI_OUTQ;
+		si_out_count--;
+	}
+	lck_mtx_unlock(&si_mtx);
+	return at;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
