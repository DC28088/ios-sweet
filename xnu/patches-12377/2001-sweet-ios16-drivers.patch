+bool AGXDeviceUserClient::mount(task_t task,void *securityID,UInt32 type,OSDictionary *properties,unsigned slot)
+{
+ if(!IOUserClient::initWithTask(task,securityID,type,properties))return false;
+ task_=task;slot_=slot;info_=backend.info;
+ if(slot) {
+  info_.va_start=ExtraWindowStart+(uint64_t)(slot-1)*ExtraWindowBytes;
+  info_.va_size=ExtraWindowBytes;
+  if(info_.va_start<backend.info.va_start+backend.info.va_size)return false;
+ }
+ core_=new NativeAdrenoUserClient;
+ if(!core_)return false;
+ IOReturn error=core_->open(NativeAdrenoAbiVersion,backend.vm,backend.submit,backend.ring,32,36);
+ if(!error)error=core_->setScope(slot*NativeAdrenoAbiMaxQueues,info_.va_start,info_.va_size);
+ if(!error)error=core_->attachTimer(&backend.timer);
+ if(!error)error=core_->attachStatus(&backend.status);
+ if(!error)error=core_->attachDeviceInfo(&info_);
+ if(error) {if(core_->close()!=kIOReturnSuccess)backend.lost=true;return false;}
+ mounted_=true;return true;
+}
+IOReturn AGXAccelerator::newUserClient(task_t task,void *securityID,UInt32 type,
+    OSDictionary *properties,IOUserClient **handler)
+{
+ if(!handler)return kIOReturnBadArgument;
+ *handler=nullptr;
+ if(type!=0x4147 || task!=current_task())return kIOReturnUnsupported;
+ char name[32]={};proc_selfname(name,sizeof name);
+ const bool compositor=!strcmp(name,"backboardd");
+ if(!compositor && !(backend.extra_slots && extra_client(name)))return kIOReturnNotPrivileged;
+ IOLockLock(backend.lock);
+ static unsigned open_traces=0;
+ if(open_traces<16) {++open_traces;IOLog("SWEET RENDER: %s open type=%#x\n",name,type); }
+ unsigned slot=0;
+ if(compositor) {
+  if(backend.opened || !healthy()) {IOLockUnlock(backend.lock);return kIOReturnBusy;}
+ } else {
+  for(slot=1;slot<=backend.extra_slots && backend.slot_open[slot];++slot) {}
+  if(slot>backend.extra_slots || !healthy()) {
+   IOLog("SWEET RENDER: %s refused: no free extra Metal slot\n",name);
+   IOLockUnlock(backend.lock);return kIOReturnBusy;
+  }
+ }
+ auto client=new AGXDeviceUserClient;
+ if(!client || !client->mount(task,securityID,type,properties,slot) || !client->attach(this) || !client->start(this)) {
+  if(client)client->release();
+  IOLockUnlock(backend.lock);return kIOReturnNoResources;
+ }
+ if(compositor)backend.opened=true;
+ backend.slot_open[slot]=true;*handler=client;
+ IOLog("SWEET RENDER: %s client connected ABI=%u slot=%u window=%#llx+%#llx\n",name,NativeAdrenoAbiVersion,
+   slot,slot?ExtraWindowStart+(uint64_t)(slot-1)*ExtraWindowBytes:backend.info.va_start,
+   slot?(uint64_t)ExtraWindowBytes:backend.info.va_size);
+ IOLockUnlock(backend.lock);return kIOReturnSuccess;
+}
+IOReturn AGXDeviceUserClient::clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory)
+{
+ if(!options || !memory)return kIOReturnBadArgument;
+ *memory=nullptr;
+ IOLockLock(backend.lock);
+ NativeAdrenoMemory *buffer=mounted_ && !closed_?core_->memoryForToken(type):nullptr;
+ auto descriptor=buffer?buffer->userDescriptor():nullptr;
+ if(!descriptor || buffer->quarantined()) {IOLockUnlock(backend.lock);return kIOReturnBadArgument;}
+ /* Return this same original descriptor on every map/unmap query. Its maps
+  * retain the BO allocation until the last user mapping really disappears. */
+ descriptor->retain();*memory=descriptor;*options=kIOMapDefaultCache;
+ IOLockUnlock(backend.lock);return kIOReturnSuccess;
+}
+/* 0176: the ADT gives XNU one homogeneous cluster: cpu0-5 are Cortex-A55
+ * (1.8 GHz), cpu6-7 Cortex-A76 (2.3 GHz, far higher IPC). With no AMP
+ * scheduler, CoreAnimation's render thread lands on an A55 whenever app
+ * launches keep other cores busy, and first app opens stutter. Bind the
+ * threads that submit GPU work to cpu7 and the framebuffer present thread to
+ * cpu6. Only when all eight processors are available; sweetbigbind=0 off. */
+extern "C" processor_t thread_bind(processor_t);
+extern "C" processor_t cpu_to_processor(int);
+extern "C" uint32_t processor_avail_count;
+extern "C" bool sweet_bind_current_thread(int cpu)
+{
+ static int enabled=-1;
+ if(enabled<0) {
+  int value=1;
+  PE_parse_boot_argn("sweetbigbind",&value,sizeof value);
+  enabled=value!=0;
+  IOLog("SWEET CPU: big-core binding %s (GPU submitters -> cpu7, present -> cpu6)\n",enabled?"on":"off (sweetbigbind=0)");
+ }
+ if(!enabled)return true;   /* nothing to retry */
+ if(processor_avail_count<8 || cpu<0 || cpu>=8)return false;
+ processor_t target=cpu_to_processor(cpu);
+ if(!target)return false;
+ if(thread_bind(target)!=target || cpu_number()!=cpu)thread_block(THREAD_CONTINUE_NULL);
+ return true;
+}
+IOReturn AGXDeviceUserClient::externalMethod(uint32_t selector,IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *,OSObject *,void *)
+{
+ if(selector==NativeAdrenoMethodSubmitResources)sweet_bind_current_thread(7);
+ if(!args || args->scalarInputCount || args->scalarOutputCount || args->structureOutputDescriptor)return kIOReturnBadArgument;
+ // Large residency lists arrive via IOKit's out-of-line descriptor. Snapshot
+ // once before validation; never dispatch directly from mutable task memory.
+ struct InputCopy {
+  void *data=nullptr;size_t bytes=0;
+  ~InputCopy(){if(data)IOFree(data,bytes);}
+ } copy;
+ IOExternalMethodArguments forwarded=*args;
+ if(args->structureInputDescriptor) {
+  if(selector!=NativeAdrenoMethodSubmitResources ||
+     args->structureInputDescriptor->getLength()!=sizeof(NativeAdrenoAbiSubmitResources))return kIOReturnBadArgument;
+  copy.bytes=sizeof(NativeAdrenoAbiSubmitResources);copy.data=IOMalloc(copy.bytes);
+  if(!copy.data)return kIOReturnNoMemory;
+  IOReturn prepare=args->structureInputDescriptor->prepare(kIODirectionOut);
+  if(prepare)return prepare;
+  const bool copied=args->structureInputDescriptor->readBytes(0,copy.data,copy.bytes)==copy.bytes;
+  IOReturn completed=args->structureInputDescriptor->complete(kIODirectionOut);
+  if(!copied)return kIOReturnVMError;
+  if(completed)return completed;
+  forwarded.structureInput=copy.data;forwarded.structureInputSize=copy.bytes;
+  forwarded.structureInputDescriptor=nullptr;args=&forwarded;
+ }
+ if(args->structureInput && args->structureInputSize>=8) {
+  uint32_t tunnel[2];memcpy(tunnel,args->structureInput,sizeof tunnel);
+  if(tunnel[0]==0x4e544e4c) {
+   if(tunnel[1]==UINT32_MAX) {
+    if(args->structureInputSize!=8 || args->structureOutputSize)return kIOReturnBadArgument;
+    IOLockLock(backend.lock);
+    const bool accepted=mounted_ && !closed_ && healthy();
+    IOLockUnlock(backend.lock);return accepted?kIOReturnSuccess:kIOReturnNotReady;
+   }
+   selector=tunnel[1];
+   forwarded.structureInput=static_cast<const unsigned char *>(args->structureInput)+8;
+   forwarded.structureInputSize-=8;args=&forwarded;
+  }
+ }
+ if(selector<1 || selector>NativeAdrenoMethodSubmitResources)return kIOReturnUnsupported;
+ const size_t input=NativeAdrenoUserClient::inputSize(selector),output=NativeAdrenoUserClient::outputSize(selector);
+ if(args->structureInputSize!=input || args->structureOutputSize!=output ||
+    (input && !args->structureInput) || (output && !args->structureOutput))return kIOReturnBadArgument;
+ /* Turnip waits in 1 ms WaitFence slices. Spinning one under the global lock
+  * stalled every Submit/BoMap/import of the next frame behind the GPU (and
+  * burned a core). Poll the same single check (timeout 0) with the lock
+  * taken only for that check, and block between polls. */
+ if(selector==NativeAdrenoMethodWaitFence && backend.wait_unlocked) {
+  NativeAdrenoAbiWaitFence request{};memcpy(&request,args->structureInput,sizeof request);
+  if(request.timeout_ns) {
+   NativeAdrenoAbiWaitFence poll=request;poll.timeout_ns=0;
+   const uint64_t limit_us=request.timeout_ns/1000?request.timeout_ns/1000:1;
+   const uint64_t began=backend.clock.now_us(backend.clock.cookie);
+   for(;;) {
+    lock_timed();
+    if(!mounted_ || closed_ || !healthy()) {IOLockUnlock(backend.lock);return kIOReturnNotReady;}
+    const IOReturn result=core_->dispatch(selector,&poll,sizeof poll,args->structureOutput,output,&backend.clock);
+    ++wait_polls;
+    const uint64_t now=backend.clock.now_us(backend.clock.cookie);
+    if(result!=kIOReturnTimeout || now-began>=limit_us) {
+     ++method_stats[selector].calls;method_stats[selector].us+=now-began;
+     method_window();
+     if(result && result!=kIOReturnTimeout && trace_errors_++<16)
+      IOLog("SWEET RENDER: method=%u result=%#x\n",selector,result);
+     IOLockUnlock(backend.lock);return result;
+    }
+    IOLockUnlock(backend.lock);
+    IODelay(20);
+   }
+  }
+ }
+ lock_timed();
+ if(!mounted_ || closed_ || !healthy()) {IOLockUnlock(backend.lock);return kIOReturnNotReady;}
+ const uint64_t began=backend.clock.now_us(backend.clock.cookie);
+ uint64_t quiesce_us=0;
+ IOReturn result=kIOReturnSuccess;
+ // BoFree must not unmap while legacy jobs (which hold only their IBs) may
+ // still reference the buffer, so it waits for the actual CP fences. Submit
+ // and BoMap only append: a new mapping uses previously unmapped IOVAs, the
+ // TLB invalidate and the full clean are safe beside running work, and every
+ // job keeps its own fence and references. Pipelining is what lets the CPU
+ // encode frame N+1 while the A618 executes frame N.
+ const bool drains=selector==NativeAdrenoMethodBoFree ||
+     (!backend.pipeline && (selector==NativeAdrenoMethodBoMap || selector==NativeAdrenoMethodSubmit ||
+      selector==NativeAdrenoMethodSubmitResources));
+ if(drains)
+ {
+  result=quiesce();
+  quiesce_us=backend.clock.now_us(backend.clock.cookie)-began;
+ }
+ if(!result && selector==NativeAdrenoMethodBoImport) {
+  NativeAdrenoAbiBoImport request{};NativeAdrenoAbiBoAllocReply reply{};
+  memcpy(&request,args->structureInput,sizeof request);
+  result=core_->importBo(&request,task_,&reply);
+  if(!result)memcpy(args->structureOutput,&reply,sizeof reply);
+ } else if(!result)result=core_->dispatch(selector,args->structureInput,input,args->structureOutput,output,&backend.clock);
+ if(!result)args->structureOutputSize=output;
+ if(selector==NativeAdrenoMethodBoMap) {
+  static unsigned maps=0;
+  if(++maps<=4 || maps%256==0 || result)
+   IOLog("SWEET RENDER: map %u objects=%lu/4128 spans=%lu/%lu total_us=%llu result=%#x\n",maps,
+    (unsigned long)backend.vm->objectCount(),(unsigned long)backend.vm->spanCount(),
+    (unsigned long)backend.vm->spanCapacity(),backend.clock.now_us(backend.clock.cookie)-began,result);
+ }
+ if((selector==NativeAdrenoMethodSubmit || selector==NativeAdrenoMethodSubmitResources) && !result)
+  proc_selfname(last_submitter,sizeof last_submitter);
+ if(selector==NativeAdrenoMethodSubmit) {
+  // Window of 120 legacy submits: kernel time per call and jobs still in
+  // flight after it, i.e. whether the CPU actually ran ahead of the GPU.
+  static unsigned submits=0,busy=0;static uint64_t window_us=0,max_us=0,in_flight=0;
+  const uint64_t spent=backend.clock.now_us(backend.clock.cookie)-began;
+  window_us+=spent;if(spent>max_us)max_us=spent;
+  in_flight+=result?0:backend.submit->outstanding();if(result==kIOReturnBusy)++busy;
+  if(++submits%120==0) {
+   // Full-VM cache publication inside those submits (NativeAdrenoSubmit).
+   const uint64_t ticks=__atomic_exchange_n(&native_adreno_publish_stats[0],0,__ATOMIC_RELAXED);
+   const uint64_t bytes=__atomic_exchange_n(&native_adreno_publish_stats[1],0,__ATOMIC_RELAXED);
+   const uint64_t objects=__atomic_exchange_n(&native_adreno_publish_stats[2],0,__ATOMIC_RELAXED);
+   uint64_t publish_ns=0;absolutetime_to_nanoseconds(ticks,&publish_ns);
+   IOLog("SWEET RENDER: legacy submits %u avg_us=%llu max_us=%llu avg_in_flight_x100=%llu busy=%u drain=%d publish_avg_us=%llu publish_avg_kib=%llu publish_avg_objects=%llu wc_audits=%u dirty=%u stale=%u fail=%#x reasserted=%u distrusted_at=%u\n",submits,
+     window_us/120,max_us,in_flight*100/120,busy,drains,publish_ns/1000/120,bytes/1024/120,objects/120,
+     native_adreno_wc_audit[0],native_adreno_wc_audit[2],native_adreno_wc_audit[3],native_adreno_wc_audit[4],
+     native_adreno_wc_audit[5],native_adreno_wc_distrusted);
+   window_us=max_us=in_flight=0;busy=0;
+  }
+ }
+ if(selector==NativeAdrenoMethodSubmitResources) {
+  static unsigned submissions=0;
+  if(++submissions<=8 || submissions%120==0) {
+   const auto *request=static_cast<const NativeAdrenoAbiSubmitResources *>(args->structureInput);
+   IOLog("SWEET RENDER: scoped submit %u IBs=%u BOs=%u total_us=%llu quiesce_us=%llu result=%#x\n",submissions,
+     request->commands.buffer_count,request->resource_count,
+     backend.clock.now_us(backend.clock.cookie)-began,quiesce_us,result);
+  }
+ }
+
+ bool pending_poll=false;
+ if(selector==NativeAdrenoMethodWaitFence && result==kIOReturnTimeout) {
+  NativeAdrenoAbiWaitFence request{};memcpy(&request,args->structureInput,sizeof request);
+  pending_poll=request.timeout_ns==0;
+ }
+ if(!pending_poll && (trace_calls_++<64 || (result && trace_errors_++<16)))
+  IOLog("SWEET RENDER: method=%u result=%#x\n",selector,result);
+ ++method_stats[selector].calls;method_stats[selector].us+=backend.clock.now_us(backend.clock.cookie)-began;
+ method_window();
+ IOLockUnlock(backend.lock);return result;
+}
+IOReturn AGXDeviceUserClient::clientClose()
+{
+ IOLockLock(backend.lock);
+ if(closed_) {IOLockUnlock(backend.lock);return kIOReturnSuccess;}
+ closed_=true;
+ IOReturn error=mounted_?quiesce():kIOReturnSuccess;
+ if(!error && mounted_)error=core_->releaseAll(&backend.clock,1000000);
+ if(error) {
+  backend.lost=true;
+  char why[64];snprintf(why,sizeof why,"client close %#x slot=%u",error,slot_);
+  sweet_native_adreno_fault_report(why);
+  // Keep uncertain GPU resources and their bookkeeping alive for this boot.
+  retain();
+ } else {
+  mounted_=false;backend.slot_open[slot_]=false;
+  if(!slot_)backend.opened=false;
+  if(slot_)IOLog("SWEET RENDER: extra Metal slot %u closed\n",slot_);
+ }
+ IOLockUnlock(backend.lock);
+ terminate();return error;
+}
+void AGXDeviceUserClient::free()
+{
+ if(core_) {
+  if(mounted_) {
+   // Partial open/start failure: no GPU job was submitted, but do not discard
+   // an object that still owns resources on a failed close.
+   if(core_->close()!=kIOReturnSuccess) {backend.lost=true;core_=nullptr;}
+  }
+  if(core_) {delete core_;core_=nullptr;}
+ }
+ IOUserClient::free();
+}
+/* The owned-BO pool (0146/0147): one physically contiguous block, taken from
+ * bsd init (sweet_ufs_init) while memory is still unfragmented. sweetbopool=MiB
+ * (default 384, 0 = off); halves until a block is found. Returns 1 if held. */
+extern "C" int sweet_native_adreno_reserve_pool(void)
+{
+ if(NativeAdrenoMemory::poolBytes())return 1;
+ uint32_t pool_mib=384;PE_parse_boot_argn("sweetbopool",&pool_mib,sizeof(pool_mib));
+ if(pool_mib>1024)pool_mib=1024;
+ /* Blocks of up to 64 MiB (0137: 48 MiB was the largest contiguous run), halving on refusal. */
+ uint32_t got=0,blocks=0,mib=64;IOReturn last=kIOReturnSuccess;
+ while(got<pool_mib && mib>=16) {
+  uint32_t want=pool_mib-got<mib?pool_mib-got:mib;
+  if(want<16)want=16;
+  last=NativeAdrenoMemory::reservePool(36,(size_t)want<<20);
+  if(last==kIOReturnNoResources)break;   /* every block slot used */
+  if(last) {mib/=2;continue;}
+  got+=want;++blocks;
+ }
+ if(pool_mib)IOLog("SWEET RENDER: owned BO pool reserved %u of %u MiB in %u blocks (%#x)\n",got,pool_mib,blocks,last);
+ return got!=0;
+}
+extern "C" int sweet_native_adreno_publish(NativeAdrenoVm *vm,NativeAdrenoSubmit *submit,
+    NativeAdrenoRing *ring,IOLock *gate,const NativeAdrenoRingClock *clock,
+    int (*health)(void *),int (*read)(void *,uint32_t,uint32_t *),const NativeAdrenoAbiDeviceInfo *info)
+{
+ if(backend.published || !vm || !submit || !ring || !gate || !clock || !clock->now_us || !health || !read || !info)return 1;
+ backend.vm=vm;backend.submit=submit;backend.ring=ring;backend.lock=gate;
+ backend.clock=*clock;backend.health=health;backend.info=*info;
+ const NativeAdrenoTimeIo timerIo={nullptr,read};
+ if(backend.timer.attach(&timerIo,NativeAdrenoTimeCp)!=kIOReturnSuccess || !healthy())return 1;
+ /* Turnip maps every owned BO kIOMapWriteCombineCache, so CPU writes never sit
+  * dirty in a cache; the owned pages are made write-combined to match (the
+  * UniXNU/Sunfish contract). The per-submit IB audit stays armed and on any
+  * dirty line distrusts WC for the rest of the boot (full maintenance again).
+  * 0130 hardware: with WC off the full-VM publish of owned BOs alone grew to
+  * 5.6ms/80MiB per submit. sweetwc=0 restores cacheable owned BOs. */
+ int wc=1;PE_parse_boot_argn("sweetwc",&wc,sizeof(wc));
+ native_adreno_wc_enabled=wc!=0;
+ IOLog("SWEET RENDER: owned BOs %s (sweetwc=%d)\n",wc?"write-combined, IB audit armed":"cacheable with full maintenance",wc);
+ /* 0135 hardware: BoAlloc averaged 22ms (a failing 2MiB contiguous scan of
+  * 255k pages, then one cache-attribute change per page) under the GPU lock.
+  * The UniXNU pool (one contiguous block, write-combined once) was never
+  * reserved here. Owned BOs come from it first; larger or overflow ones keep
+  * the old path. sweetbopool=MiB (0 = off). */
+ /* 0136 hardware: reserved here, only 48 of 192 MiB were still contiguous and
+  * the pool filled within seconds; sweet_native_adreno_reserve_pool() now
+  * takes it early in bsd init, and this only write-combines it. */
+ if(NativeAdrenoMemory::poolBytes() || sweet_native_adreno_reserve_pool()) {
+  const uint64_t began=clock->now_us(clock->cookie);
+  const IOReturn combined=wc?NativeAdrenoMemory::writeCombinePool():kIOReturnSuccess;
+  IOLog("SWEET RENDER: owned BO pool %lu MiB write-combine=%#x in %llu us\n",
+    (unsigned long)(NativeAdrenoMemory::poolBytes()>>20),combined,clock->now_us(clock->cookie)-began);
+ }
+ auto provider=new AGXAccelerator;
+ if(!provider || !provider->init() || !provider->attach(IOService::getPlatform())) {
+  if(provider)provider->release();return 1;
+ }
+ provider->setName("NativeAdrenoGpu");
+ int gles=0,mtl=0;
+ PE_parse_boot_argn("sweetgles",&gles,sizeof(gles));PE_parse_boot_argn("sweetmtl",&mtl,sizeof(mtl));
+ int native=0;PE_parse_boot_argn("sweetnative",&native,sizeof native);
+ if(gles!=1) {
+  // sweetnative=1 opts into the direct AIR/freedreno frontend.
+  // Existing sweetmtl values retain their previous plugin and row-layout behavior.
+  const char *plugin=native==1?"SweetNativeMetal":mtl==1?"NativeAdrenoMetal":"SweetMetal2";
+  provider->setProperty("MetalPluginName",plugin);
+  provider->setProperty("MetalPluginClassName",native==1?"SweetNativeMetalDevice":mtl==1?"SweetAdrenoMetalDevice":"SweetMTL2Device");
+  IOLog("SWEET RENDER: Metal plugin %s selected (sweetmtl=%d sweetnative=%d)\n",plugin,mtl,native);
+ } else IOLog("SWEET GLES: native A618 transport published; Metal discovery disabled for GLES boot\n");
+ provider->setProperty("model","Adreno 618");
+ provider->setProperty("NativeAdrenoABI",NativeAdrenoAbiVersion,32);
+ int extra=3;PE_parse_boot_argn("sweetm2extra",&extra,sizeof(extra));
+ backend.extra_slots=extra<0?0u:(extra>3?3u:(unsigned)extra);
+ int import_sync=0;PE_parse_boot_argn("sweetimportsync",&import_sync,sizeof(import_sync));
+ native_adreno_import_sync=import_sync!=0;
+ uint32_t below_kib=2048;PE_parse_boot_argn("sweetimportmin",&below_kib,sizeof(below_kib));
+ native_adreno_import_sync_below=(uint64_t)below_kib<<10;
+ IOLog("SWEET RENDER: imported BO cache sync by %s (sweetimportsync=%d), kernel still maintains imports below %u KiB\n",
+   import_sync?"kernel at every submit/completion":"client per command",import_sync,below_kib);
+ int swap_fence=0;PE_parse_boot_argn("sweetpresentfence",&swap_fence,sizeof(swap_fence));
+ backend.present_swap_fence=swap_fence!=0;
+ int present_locked=0;PE_parse_boot_argn("sweetpresentlock",&present_locked,sizeof(present_locked));
+ backend.present_locked=present_locked!=0;
+ int pipeline=1;PE_parse_boot_argn("sweetpipeline",&pipeline,sizeof(pipeline));
+ backend.pipeline=pipeline!=0;
+ int wait_locked=0;PE_parse_boot_argn("sweetwaitlock",&wait_locked,sizeof(wait_locked));
+ backend.wait_unlocked=wait_locked==0;
+ IOLog("SWEET RENDER: fence waits %s (sweetwaitlock=%d)\n",
+   backend.wait_unlocked?"poll with the lock dropped between checks":"spin under the lock",wait_locked);
+ IOLog("SWEET RENDER: submission pipelining %s (BoFree/close still drain); extra Metal slots=%u\n",
+   backend.pipeline?"enabled":"disabled",backend.extra_slots);
+ int present_wait=0;PE_parse_boot_argn("sweetpresentwait",&present_wait,sizeof(present_wait));
+ backend.cpu_present=mtl==2 && gles!=1 && present_wait==1;
+ __atomic_store_n(&presentation_ready,true,__ATOMIC_RELEASE);
+ if(backend.cpu_present)IOLog("SWEET RENDER: CPU presentation fence gate enabled\n");
+ backend.published=true;provider->registerService();
+ IOLog("SWEET RENDER: NativeAdreno ABI + Metal discovery published on live A618 context\n");
+ /* Metal.framework probes IOAcceleratorES once, when backboardd initializes
+    CoreAnimation, long before this asynchronous bring-up publishes the
+    service. Restart it once here (Sunfish's install script does the same by
+    hand) so the fresh process finds MetalPluginName. */
+ int restart=1;PE_parse_boot_argn("sweetm2restart",&restart,sizeof(restart));
+ if(gles!=1 && restart==1) {
+  for(int pid=1;pid<99999;pid++) {
+   proc_t p=proc_find(pid);
+   if(!p)continue;
+   const bool match=!strcmp(proc_best_name(p),"backboardd");
+   if(match)proc_signal(pid,SIGKILL);
+   proc_rele(p);
+   if(match) {
+    IOLog("SWEET RENDER: restarted backboardd for Metal discovery\n");
+    break;
+   }
+  }
+ }
+ return 0;
+}
diff --git a/iokit/Kernel/arm/SweetNativeAdrenoRender.cpp b/iokit/Kernel/arm/SweetNativeAdrenoRender.cpp
new file mode 100644
index 0000000..35cfdde
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNativeAdrenoRender.cpp
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MIT
+ * A618 render-engine setup from pinned SM7150 a6xx_gpu/catalog/XML and
+ * qcom_ubwc_cfg_data sm7150_data. Does not reset the working CP or GMU.
+ */
+#include <IOKit/IOLib.h>
+#include "unixnu/NativeAdrenoABI.h"
+extern "C" int sweet_native_adreno_render_profile(uintptr_t mapping,NativeAdrenoAbiDeviceInfo *info)
+{
+ if(!mapping || !info)return 1;
+ auto core=reinterpret_cast<volatile uint32_t *>(mapping);
+ /* Call only after the boot timestamp fence: no render IB is published yet.
+  * CP_PROTECT, SQE, trusted range and UCHE trap already have the proven boot
+  * values. Complete the previously missing 3D blocks and GMEM/UBWC layout. */
+ static const struct {unsigned reg,value,mask;} setup[]={
+  {0x0c01,1,1}, {0x8601,1,1}, {0x8e05,1,1}, {0x9e01,1,1},
+  {0xbe05,1,1}, {0xa601,1,1}, {0x9601,1,1}, {0xae01,1,1}, {0xb601,1,1},
+  {0x050b,0xffffffff,0}, {0x0500,1,1},
+  {0x0e0b,0x100000,0xffffffff}, {0x0e0c,0,0xffffffff},
+  /* A618 log0111: MAX reads 0x17f000 after Linux's 0x17ffff write.
+   * The inclusive limit's low 12 bits are RAZ; validate the page address.
+   * Keep Linux's inclusive-end programming and check all upper bits. */
+  {0x0e0d,0x17ffff,0xfffff000}, {0x0e0e,0,0xffffffff},
+  {0x9e00,0x00180000,0x00180000},
+  /* UBWC2: bank14 (hbb_lo1), min32B, four channels, levels2+3 swizzle. */
+  {0x8e08,2,0xffffffff}, {0xb604,2,0xffffffff}, {0xae02,2,0xffffffff},
+  {0x0e01,1u<<21,(1u<<23)|(3u<<21)},
+  /* Downstream A618 a6xx_start programs UCHE_CLIENT_PF=1. The XML calls
+   * this field PERFSEL, not a render-enable bit. On sweet0114 bit7 read
+   * zero after the generic mainline0x81 write. Use the vendor selector
+   * and validate its entire8-bit field instead of gating on that bit. */
+  {0x0e19,1,0xff},
+  /* A618 has no eight-channel macrotiling override. Downstream a6xx_start
+   * accesses RBBM_NC_MODE_CNTL only for channel==8. Preserve its reset
+   * setting here; 0112 hardware reads 0xdeafbead from 0x534. */
+ };
+ for(const auto &entry:setup) {
+  core[entry.reg]=entry.value;
+  __asm__ volatile("dsb sy":::"memory");
+  const uint32_t value=core[entry.reg];
+  if(value==0xdeafbead || (value==UINT32_MAX && entry.value!=UINT32_MAX)) {
+   IOLog("SWEET RENDER: invalid readback reg=%#x value=%#x\n",entry.reg,value);return 1;
+  }
+  if((value&entry.mask)!=(entry.value&entry.mask)) {
+   IOLog("SWEET RENDER: reg=%#x expected=%#x read=%#x\n",entry.reg,entry.value,value);return 1;
+  }
+ }
+ if(core[0x084f]!=0xb || core[0x0e09]!=0xfffff000 || core[0x0e0a]!=0x1ffff)return 1;
+ *info={0x06010800,512u*1024u,0x100000,UINT64_C(0x1fffffffff000),
+     UINT64_C(0x40000000),UINT64_C(0x30000000),14,6,0,2,NativeAdrenoDeviceClientIova,0};
+ IOLog("SWEET RENDER: A618 PERFSEL legacy selector=1 accepted\n");
+ IOLog("SWEET RENDER: A618 address modes/GMEM512K/UBWC2 programmed and read back\n");
+ return 0;
+}
diff --git a/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp b/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp
new file mode 100644
index 0000000..064cf15
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp
@@ -0,0 +1,259 @@
+/* SPDX-License-Identifier: MIT
+ * sweet/A618 live BO arena. Called before SQE release, under the boot GPU
+ * owner's lease. Never replaces an enabled CB0 or touches GMU CB1.
+ */
+#include <IOKit/IOLib.h>
+#include <sys/errno.h>
+#include "../../../bsd/dev/sweet_adreno_cp.h"
+#include "unixnu/NativeAdrenoVm.h"
+#include "unixnu/NativeAdrenoSubmit.h"
+#include "unixnu/NativeAdrenoABI.h"
+extern "C" int sweet_native_adreno_render_profile(uintptr_t,NativeAdrenoAbiDeviceInfo *);
+extern "C" volatile uint32_t native_adreno_force_wb;
+extern "C" int sweet_native_adreno_publish(NativeAdrenoVm *,NativeAdrenoSubmit *,NativeAdrenoRing *,IOLock *,
+    const NativeAdrenoRingClock *,int (*)(void *),int (*)(void *,uint32_t,uint32_t *),const NativeAdrenoAbiDeviceInfo *);
+
+namespace {
+constexpr unsigned PollBudget=100000, TableBytes=0x404000;
+constexpr uint64_t ArenaStart=0x40000000, ArenaBytes=0x80000000;
+struct BootVm {
+ NativeAdrenoMemory tables,firmware,ring,fence;
+ NativeAdrenoVm vm;
+ NativeAdrenoSubmit submit;
+ ArmSmmu4KLiveArena arena{};
+ ArmSmmu4KLiveState live{};
+ ArmSmmu4KLiveVisibility visibility{};
+ ArmSmmu4KContextConfig config{};
+ ArmSmmu4KStreamState streams{};
+ ArmSmmu4KIo io{};
+ a618_smmu_io hardware{};
+ uint64_t handles[3]{};
+ bool attempted=false,ready=false,connected=false,faultWriteQuirk=false;
+} state;
+int read32(void *,size_t offset,uint32_t *value)
+{
+ if(!value || (offset&3) || offset>0xfffc)return 1;
+ *value=state.hardware.registers.read(state.hardware.registers.cookie,(uint32_t)offset);
+ return *value==UINT32_MAX;
+}
+int read64(void *,size_t offset,uint64_t *value)
+{
+ if(!value || (offset&7) || offset>0xfff8)return 1;
+ *value=state.hardware.read64(state.hardware.registers.cookie,(uint32_t)offset);
+ return *value==UINT64_MAX;
+}
+int write32(void *,size_t offset,uint32_t value)
+{
+ /* Restrict the helper to its leased CB0 and one stream slot. The SMMU
+  * core does no global writes, and never accesses the GMU context bank. */
+ const unsigned slot=state.streams.streams[0].slot;
+ if((offset&3) || !((offset>=0x8000 && offset<=0x8ffc) || offset==0x1000 ||
+     offset==0x1800 || offset==0x800+4*slot || offset==0xc00+4*slot))return 1;
+ /* Qualcomm firmware can ignore FAULT writes and rewrite BYPASS to FAULT.
+  * This flag is probed ONLY while our exact leased SMR is still invalid.
+  * Never request a real bypass stream or change the GMU route. */
+ if(offset==0xc00+4*slot && value==(2u<<16) && state.faultWriteQuirk)value=(1u<<16)|0xffu;
+ state.hardware.registers.write(state.hardware.registers.cookie,(uint32_t)offset,value);
+ return 0;
+}
+int write64(void *,size_t offset,uint64_t value)
+{
+ if((offset&7) || offset<0x8000 || offset>0x8ff8)return 1;
+ state.hardware.write64(state.hardware.registers.cookie,(uint32_t)offset,value);
+ return 0;
+}
+int barrier(void *)
+{state.hardware.barrier(state.hardware.registers.cookie);return 0;}
+int failed(const char *where,IOReturn error)
+{
+ /* All descriptor and VM storage is retained on an uncertain failure. There
+  * is no fallback that clears active tables or restarts an already-run SQE. */
+ IOLog("SWEET NATIVE VM: %s failed=%#x; all resources retained\n",where,error);
+ state.ready=false;return EIO;
+}
+int translate(uint64_t iova,uint64_t *physical)
+{
+ if(write64(nullptr,0x8800,iova) || barrier(nullptr))return EIO;
+ for(unsigned i=0;i<1000;++i) {
+  uint32_t status=0;
+  if(read32(nullptr,0x88f0,&status))return EIO;
+  if(!(status&1))return read64(nullptr,0x8050,physical)?EIO:0;
+  state.hardware.registers.delay_us(state.hardware.registers.cookie,1);
+ }
+ return ETIMEDOUT;
+}
+}
+extern "C" int sweet_native_adreno_prepare_vm(const a618_smmu_io *hardware,
+    const a618_dma_region *memory,a618_smmu_result *result)
+{
+ if(!hardware || !memory || !result || !hardware->registers.read || !hardware->registers.write ||
+    !hardware->registers.delay_us || !hardware->read64 || !hardware->write64 || !hardware->barrier ||
+    !memory->cpu || !memory->uncached || memory->bytes!=A618_CP_DMA_BYTES ||
+    (memory->physical&0x3fff) || memory->physical>=(UINT64_C(1)<<36) ||
+    memory->bytes>(UINT64_C(1)<<36)-memory->physical)return EINVAL;
+ if(state.attempted)return EBUSY;
+ state.attempted=true;state.hardware=*hardware;*result={};result->slot=UINT32_MAX;
+ state.io={nullptr,0x10000,read32,read64,write32,write64,barrier,1};
+ uint32_t id0=0,id1=0,id2=0,control=0,sctlr=0,fsr=0;
+ if(read32(nullptr,0x20,&id0) || read32(nullptr,0x24,&id1) || read32(nullptr,0x28,&id2) ||
+    read32(nullptr,0,&control) || read32(nullptr,0x8000,&sctlr) || read32(nullptr,0x8058,&fsr))return EIO;
+ if(fsr&(1u<<30))return EBUSY;
+ if(id0!=0x48016605 || id1!=0x20008005 || id2!=0x7511 || (sctlr&1))return ENOTSUP;
+ /* Claim only an invalid slot. An active SID0 or any live CB0 route is a
+  * foreign owner, regardless of its apparent idle state. */
+ unsigned slot=UINT32_MAX;
+ for(unsigned i=0;i<5;++i) {
+  uint32_t smr=0,s2cr=0;
+  if(read32(nullptr,0x800+4*i,&smr) || read32(nullptr,0xc00+4*i,&s2cr))return EIO;
+  if(smr&(1u<<31)) {
+   const uint32_t mask=(smr>>16)&0x7fff;
+   if(((smr&0xffff)&~mask)==0 || (!(s2cr&(3u<<16)) && !(s2cr&255)))return EBUSY;
+  } else if(slot==UINT32_MAX)slot=i;
+ }
+ if(slot==UINT32_MAX)return ENOSPC;
+ result->slot=slot;result->context=0;result->control=control;
+ /* The boot GMU owner has already established enable/fault-on-unmatched,
+  * with global IRQ disabled. Preserve that policy and every other route. */
+ if((control&0x407)!=0x402)return ENOTSUP;
+ state.streams.streams[0]={slot,0};
+ /* Pinned Linux qcom_smmu_cfg_probe/qcom_smmu_write_s2cr quirk.
+  * Probe the claimed INVALID slot: global USFCFG faults unmatched traffic,
+  * and no valid SID or enabled CB0 exists here. Do not probe any live route. */
+ uint32_t invalidSmr=0,probe=0,faulted=0;
+ if(read32(nullptr,0x800+4*slot,&invalidSmr) || (invalidSmr&(1u<<31)))return EBUSY;
+ if(write32(nullptr,0xc00+4*slot,(1u<<16)|0xffu) || barrier(nullptr) ||
+    read32(nullptr,0xc00+4*slot,&probe))return EIO;
+ if((probe&~0xffu)==(2u<<16))state.faultWriteQuirk=true;
+ else if(probe!=((1u<<16)|0xffu))return failed("S2CR quirk probe",kIOReturnIOError);
+ if(write32(nullptr,0xc00+4*slot,2u<<16) || barrier(nullptr) ||
+    read32(nullptr,0xc00+4*slot,&faulted) || (faulted&~0xffu)!=(2u<<16))
+  return failed("S2CR fault readback",kIOReturnIOError);
+ IOLog("SWEET NATIVE VM: leased slot=%u S2CR probe=%#x fault=%#x qcom_quirk=%u\n",
+     slot,probe,faulted,(unsigned)state.faultWriteQuirk);
+ const ArmSmmu4KStream stream={slot,0};ArmSmmu4KStreamResult routes{};
+ ArmSmmu4KStatus status=ArmSmmu4KCheckFaultedStreams(&state.io,&stream,1,0,&routes);
+ if(status) {
+  IOLog("SWEET NATIVE VM: route detail ID0=%#x sCR0=%#x GFSR=%#x verified=%u SMR=%#x S2CR=%#x\n",
+      routes.id0,routes.scr0,routes.global_fault,routes.streams_verified,invalidSmr,faulted);
+  return failed("route preflight",(IOReturn)status);
+ }
+ IOReturn error=state.tables.allocate(TableBytes,36,true,8u*1024u*1024u);
+ if(error)return failed("table allocation",error);
+ error=NativeAdrenoPrepareSmmuMemory(&state.tables,32,36,ArenaStart,ArenaBytes,0,
+     ArenaBytes/4096,&state.arena,&state.live,&state.visibility);
+ if(error)return failed("table preparation",error);
+ uint32_t wb=0;
+ PE_parse_boot_argn("sweetgpuwb",&wb,sizeof(wb));
+ native_adreno_force_wb=wb?1:0;
+ printf("SWEET ADRENO: GPU mappings %s (sweetgpuwb=%u)\n",wb?"forced write-back":"as the client asks",wb);
+ uint32_t walk=0;
+ PE_parse_boot_argn("sweetsmmuwalk",&walk,sizeof(walk));
+ printf("SWEET ADRENO: GPU SMMU table walks %s (sweetsmmuwalk=%u)\n",walk?"cacheable (inner WBWA)":"outer non-cacheable",walk);
+ state.config={&state.arena.config,nullptr,&state.live.tables,nullptr,id0,id2,0x62,walk?1u:0u,0,1,1};
+ ArmSmmu4KProgramResult programmed{};
+ status=ArmSmmu4KProgramDisabledContext(&state.io,0,&state.config,PollBudget,&programmed);
+ if(status)return failed("context programming",(IOReturn)status);
+ status=ArmSmmu4KAttachStreams(&state.io,&state.streams,&stream,1,0,&state.config,&routes);
+ if(status)return failed("stream attachment",(IOReturn)status);
+ NativeAdrenoVmRegion region={&state.tables,&state.arena,&state.live};
+ error=state.vm.attach(&state.io,&state.config,&state.streams,&region,nullptr,65536,PollBudget);
+ if(error)return failed("VM attachment",error);
+ NativeAdrenoMemory *objects[]={&state.firmware,&state.ring,&state.fence};
+ const unsigned offsets[]={A618_CP_SQE_OFFSET,A618_CP_RING_OFFSET,A618_CP_FENCE_OFFSET};
+ const unsigned sizes[]={0x8000,0x8000,0x4000};
+ const uint64_t addresses[]={A618_CP_IOVA,A618_CP_RING_IOVA,A618_CP_FENCE_IOVA};
+ for(unsigned i=0;i<3;++i) {
+  error=objects[i]->borrowBootStorage(memory->cpu+offsets[i],memory->physical+offsets[i],sizes[i],36);
+  if(!error)error=state.vm.map(objects[i],0,addresses[i],ArmSmmu4KRead|
+      (i?ArmSmmu4KWrite:ArmSmmu4KExecute),0,2,&state.handles[i]);
+  if(error)return failed("bootstrap mapping",error);
+ }
+ /* Prove real translations for the unchanged firmware/ring/fence IOVAs,
+  * including the immediately following unmapped guard, before SQE starts. */
+ for(unsigned i=0;i<=20;++i) {
+  uint64_t translated=0;
+  const int failure=translate(A618_CP_IOVA+4096ull*i,&translated);
+  result->par=translated;
+  if(failure)return failure;
+  if(i==20) {if(!(translated&1))return EFAULT;}
+  else {
+   const uint64_t expected=memory->physical+A618_CP_SQE_OFFSET+4096ull*i;
+   if((translated&1) || (translated&UINT64_C(0xffffff000))!=expected)return EFAULT;
+   ++result->translated;
+  }
+ }
+ if(read32(nullptr,0x8058,&result->fault) || (result->fault&0xc00001feu))return EIO;
+ result->offset=0x800+4*slot;
+ if(read32(nullptr,result->offset,&result->value))return EIO;
+ state.ready=true;
+ IOLog("SWEET NATIVE VM: CB0 active ASID62 4K GPU /16K host, aperture=%#llx+%#llx tablePA=%#llx pages=%lu bootstrap=%u\n",
+     ArenaStart,ArenaBytes,state.tables.spans()[0].physical,state.live.tables.table_pages,result->translated);
+ return 0;
+}
+/*
+ * 0246: kernel-owned GPU mappings for the framebuffer's GPU present copy (SweetFramebuffer.cpp), in
+ * 0xb0000000..0xc0000000 of the arena: above backboardd's window, the CP firmware/ring/fence at 0x70000000 and
+ * the three 256 MiB extra client windows from 0x80000000, so no client IOVA can collide with them. Taken under
+ * the same gate as the userclient's BO maps and submissions. task != NULL: pin address..+bytes of that task
+ * (kernel_task for an IOSurface's kernel mapping); task == NULL: a physically contiguous range with its own CPU
+ * mapping (the scanout buffers in ABL's splash region). The caller unmaps only after its GPU work completed.
+ */
+static IOLock *sweet_kernel_gate;
+namespace {
+constexpr uint64_t KernelWindowStart=0xb0000000,KernelWindowEnd=0xc0000000;
+struct SweetKernelMap {NativeAdrenoMemory memory;uint64_t handle=0;};
+}
+extern "C" void *sweet_native_adreno_kmap(void *task,uint64_t address,uint64_t physical,size_t bytes,uint64_t iova,int writable)
+{
+ if(!state.ready || !state.connected || !sweet_kernel_gate || !address || !bytes || (bytes&4095) || (iova&4095) ||
+    iova<KernelWindowStart || bytes>KernelWindowEnd-KernelWindowStart || iova>KernelWindowEnd-bytes)return nullptr;
+ SweetKernelMap *m=new SweetKernelMap;
+ if(!m)return nullptr;
+ IOLockLock(sweet_kernel_gate);
+ IOReturn error=task?m->memory.importTask(task,address,bytes,36,bytes):
+     m->memory.borrowBootStorage(reinterpret_cast<void *>(address),physical,bytes,36);
+ const IOReturn backing=error;
+ if(!error)error=state.vm.map(&m->memory,0,iova,ArmSmmu4KRead|(writable?ArmSmmu4KWrite:0u),0,2,&m->handle);
+ const bool mapped=!error;
+ if(!error)error=state.vm.invalidateTlb();
+ IOLockUnlock(sweet_kernel_gate);
+ if(error) {
+  IOLog("SWEET NATIVE VM: kernel map %#llx+%#lx (%s) failed=%#x backing=%#x\n",iova,(unsigned long)bytes,
+      task?"task":"physical",error,backing);
+  if(!mapped) {
+   IOLockLock(sweet_kernel_gate);
+   const IOReturn released=backing?kIOReturnSuccess:m->memory.release();
+   IOLockUnlock(sweet_kernel_gate);
+   if(!released)delete m;   /* else retained: ownership uncertain */
+  }
+  return nullptr;
+ }
+ return m;
+}
+extern "C" int sweet_native_adreno_kunmap(void *cookie)
+{
+ SweetKernelMap *m=static_cast<SweetKernelMap *>(cookie);
+ if(!m || !sweet_kernel_gate)return EINVAL;
+ IOLockLock(sweet_kernel_gate);
+ IOReturn error=state.vm.unmap(m->handle);
+ if(!error)error=m->memory.release();
+ IOLockUnlock(sweet_kernel_gate);
+ if(error) {IOLog("SWEET NATIVE VM: kernel unmap failed=%#x; mapping retained\n",error);return EIO;}
+ delete m;
+ return 0;
+}
+extern "C" int sweet_native_adreno_connect_vm(NativeAdrenoRing *ring,IOLock *gate,const NativeAdrenoRingClock *clock,
+    uintptr_t core,int (*health)(void *),int (*read)(void *,uint32_t,uint32_t *))
+{
+ if(!state.ready || state.connected || !ring)return ENXIO;
+ const IOReturn error=state.submit.attach(&state.vm,ring);
+ if(error)return failed("submit attachment",error);
+ NativeAdrenoAbiDeviceInfo info{};
+ if(sweet_native_adreno_render_profile(core,&info))return failed("render profile",kIOReturnIOError);
+ if(sweet_native_adreno_publish(&state.vm,&state.submit,ring,gate,clock,health,read,&info))
+  return failed("userclient publication",kIOReturnIOError);
+ state.connected=true;
+ sweet_kernel_gate=gate;
+ IOLog("SWEET NATIVE VM: live BO/IB manager connected to compositor userclient\n");
+ return 0;
+}
