+		printf("SWEET SMMU: IPA stream: unexpected geometry smr=%u cb=%u\n", nsmr, ncb);
+		return ENODEV;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(0x15000000 + psize, psize);
+	if (!gr1) {
+		return ENOMEM;
+	}
+	uint64_t used[2] = {0, 0};
+	int have[2] = { -1, -1 }, cb = -1;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			continue;
+		}
+		if (((s2cr >> 16) & 3) == 0) {
+			used[(s2cr & 0xff) / 64] |= 1ull << ((s2cr & 0xff) % 64);
+		}
+		for (int k = 0; k < 2; k++) {
+			if (smmu_sid_match(smr, sids[k], 0)) {
+				have[k] = (int)i;
+				if (((s2cr >> 16) & 3) == 0) {
+					cb = (int)(s2cr & 0xff);
+				}
+				printf("SWEET SMMU: IPA stream %#x already in SMR%u %#x (S2CR %#x)\n", sids[k], i, smr, s2cr);
+			}
+		}
+	}
+	volatile uint32_t *cbp = NULL;
+	if (cb < 0) {
+		for (uint32_t c = 0; c < ncb && cb < 0; c++) {
+			if (used[c / 64] & (1ull << (c % 64)) || gr1[c] != 0) {
+				continue;
+			}
+			volatile uint32_t *page = (volatile uint32_t *)ml_io_map(0x15000000 + (npage + c) * psize, psize);
+			if (page && !(page[0] & 1)) {
+				cb = (int)c;
+				cbp = page;
+			}
+		}
+		if (cb < 0) {
+			printf("SWEET SMMU: IPA stream: no free context bank, sCR0 %#x\n", scr0);
+			return ENOSPC;
+		}
+		cbp[0x58 / 4] = 0xffffffff;     /* FSR clear */
+		cbp[0x20 / 4] = 0;              /* TTBR0 */
+		cbp[0x24 / 4] = 0;
+		cbp[0x30 / 4] = 0;              /* TCR */
+		cbp[0x10 / 4] = 0;              /* TCR2 */
+		cbp[0x38 / 4] = 0;              /* MAIR */
+		cbp[0x3c / 4] = 0;
+		gr1[(0x800 + 4 * cb) / 4] = 0x00000001;          /* CBA2R: AArch64 */
+		gr1[cb] = 0x0001f000;                             /* CBAR */
+		cbp[0] = 0x000000e0;                              /* SCTLR last: M=0, faults reported */
+	}
+	unsigned refused = 0;
+	for (int k = 0; k < 2; k++) {
+		for (uint32_t i = 0; i < nsmr && have[k] < 0; i++) {
+			if (gr0[(0x800 + 4 * i) / 4] >> 31) {
+				continue;
+			}
+			const uint32_t s2cr_before = gr0[(0xc00 + 4 * i) / 4];
+			const uint32_t want = (1u << 31) | sids[k];
+			gr0[(0xc00 + 4 * i) / 4] = (uint32_t)cb;  /* S2CR: translate via the bank */
+			gr0[(0x800 + 4 * i) / 4] = want;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			if (gr0[(0x800 + 4 * i) / 4] == want) {
