+                owned_spans_=IONew(NativeAdrenoPhysicalSpan,1);
+                if(!owned_spans_) {IODelete(spans_,NativeAdrenoPhysicalSpan,1);spans_=nullptr;poolGive(pool,offset,capacity);return kIOReturnNoMemory;}
+                owned_capacity_=owned_count_=1;owned_spans_[0]={0,physical,capacity};
+                span_capacity_=1;span_count_=1;spans_[0]={0,physical,bytes};
+                mapping_=pool.virt+offset;bytes_=bytes;allocated_bytes_=capacity;pooled_=true;pool_offset_=offset;pool_block_=b;prepared_=true;write_combined_=pool.write_combined;
+                /* Turnip CPU-maps every BO through clientMemoryForType; a pooled one has no descriptor of its own. */
+                pool_view_=IOSubMemoryDescriptor::withSubRange(pool.descriptor,offset,capacity,kIODirectionInOut);
+                if(!pool_view_) {(void)release();return kIOReturnNoMemory;}
+                zeroOwned(mapping_,capacity,pool.write_combined);
+                /* Through a write-combined pool's own mapping the zeros go to DRAM; the barrier completes them. */
+                if(pool.write_combined)__asm__ volatile("dsb sy":::"memory");
+                else status=NativeAdrenoMaintainOwnedPages(mapping_,capacity,NativeAdrenoClean);
+                if(status!=kIOReturnSuccess) {(void)release();return status;}
+                native_adreno_pool_stats[1]=native_adreno_pool_stats[1]+1;
+                return kIOReturnSuccess;
+            }
