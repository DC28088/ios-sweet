+/*
+ * Sweet 2023 (sweetfb_ec=1, copy mode with flipping): CoreAnimation's SwapWait(N) is held until swap N was copied
+ * (2011), and the copy ran only at the vsync tick: a frame whose GPU work missed a tick waited one more. On iOS 26 that
+ * was 16 ms average per frame, a quarter of the waits timed out, and the rate sat near 30 fps with the GPU mostly
+ * idle. The frame is now taken when its GPU fence has passed and the previous flip has latched (so drawing into the
+ * other back buffer never spins), from this timer, armed by swap() and while a frame is pending. Same work loop as the
+ * vsync timer, so the two never run at once.
+ */
+void
+AppleCLCD::copyFired(void)
+{
+	SweetSurface *taken[4] = {}, *dropped[4] = {};
+
+	if (fPowerOff) {
+		return;         /* the vsync tick redraws on power on */
+	}
+	IOLockLock(fLock);
+	if (!fDirty) {
+		IOLockUnlock(fLock);
+		return;
+	}
+	if (!flipLatched() || !takeFrame(fEarlyRec, taken, dropped, mach_absolute_time(), false)) {
+		IOLockUnlock(fLock);
+		fSwapTimer->setTimeoutUS(500);
+		return;
+	}
+	bool more = fDirty;
+	IOLockUnlock(fLock);
+	sweet_hold_release(dropped);
+	present(fEarlyRec);
+	__atomic_store_n(&fCopyDone, fCurSwapID, __ATOMIC_RELEASE);
+	sweet_hold_release(taken);      /* copied: CA may render into them again */
+	if (more) {
+		fSwapTimer->setTimeoutUS(500);
+	}
+}
