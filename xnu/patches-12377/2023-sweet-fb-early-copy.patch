+	}
 	if (fEarly && !fPowerOff) {
 		fSwapTimer->setTimeoutUS(1);    /* scan it now: the MDP latches at its next vsync */
 	}
@@ -1985,6 +2042,14 @@ AppleCLCD::flipSetup(void)
  * panel frame apart (sweetfb_hz >= ~40, or sweetfb_vsync=1): torn frames.
  * Wait (bounded, one vsync plus slack) for the latch before drawing.
  */
+/* 2023: the last queued flip has reached the panel */
+bool
+AppleCLCD::flipLatched(void)
+{
+	return fLastFlush == 0 ||
+	    (*(volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH) & fLastFlush) == 0;
+}
