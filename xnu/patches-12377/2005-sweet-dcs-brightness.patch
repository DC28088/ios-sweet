+/*
+ * Sweet 2005: sweet's panel (Xiaomi K6 38/0c/0a AMOLED, live FDT bl_ctrl_dcs, levels 8..2047) has no WLED: Bergamota's
+ * blInit finds none ("pixel fallback") and the brightness iOS sets on AppleARMBacklight was dropped. Here it is sent as
+ * a DCS long write 0x51 hi lo through DSI0's TPG DMA FIFO, exactly as our iOS 16 0130 (no memory fetch, so no display
+ * SMMU mapping; command engine on only for the transfer). From a thread call: a transfer polls up to 50 ms for DMA done,
+ * which must not stall the vsync timer. Boot-arg sweetfb_dcsbl=0 turns it off. Not used on beryllium.
+ */
+#define SWEET_DSI0_PA           0x0ae94000ULL
+#define DSI_REG_CTRL            0x004
+#define DSI_REG_DMA_CTRL        0x03c
+#define DSI_REG_DMA_LENGTH      0x04c
+#define DSI_REG_ACK_ERR         0x068
+#define DSI_REG_DMA_TRIGGER     0x090
+#define DSI_REG_TIMEOUT_STATUS  0x0c0
+#define DSI_REG_INT_CTRL        0x110
+#define DSI_REG_TPG_CTRL        0x15c
+#define DSI_REG_TPG_DMA_DATA    0x17c
+#define DSI_REG_TPG_FIFO_RESET  0x1ec
+#define DSI_REG_VERSION         0x1f4
+#define SWEET_DCS_BL_MIN        8u
+#define SWEET_DCS_BL_MAX        2047u
+static volatile uint32_t *sweet_dcs_dsi;
+static thread_call_t sweet_dcs_call;
+static uint32_t sweet_dcs_wanted, sweet_dcs_sent;
+static unsigned sweet_dcs_failures;
+
+static int
+sweet_dcs_send(uint32_t level)
+{
+	volatile uint32_t *dsi = sweet_dcs_dsi;
+	const uint32_t ctrl = dsi[DSI_REG_CTRL / 4];
+	if ((ctrl & 3) != 3) {
+		IOLog("SWEET BL: DSI0 left video mode (ctrl=%#x); level %u not sent\n", ctrl, level);
+		return ENODEV;
+	}
+	const uint32_t dma_ctrl = dsi[DSI_REG_DMA_CTRL / 4];
+	/* DCS long write: header {WC lsb, WC msb, data id 0x39, LAST|LONG}, then 0x51 hi lo, 0xff pad. */
+	const uint32_t words[2] = {
+		3u | (0x39u << 16) | (0xc0u << 24),
+		0x51u | ((level >> 8) << 8) | ((level & 0xff) << 16) | (0xffu << 24),
+	};
+	dsi[DSI_REG_CTRL / 4] = ctrl | (1u << 2);                       /* command engine on */
+	dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;    /* W1C stale DMA done */
+	dsi[DSI_REG_TPG_CTRL / 4] = (1u << 1) | (1u << 2) | (3u << 16);
+	dsi[DSI_REG_TPG_DMA_DATA / 4] = words[0];
+	dsi[DSI_REG_TPG_DMA_DATA / 4] = words[1];
+	dsi[DSI_REG_DMA_CTRL / 4] = (dma_ctrl & ~((1u << 31) | (1u << 30))) | (1u << 26) | (1u << 28);
+	dsi[DSI_REG_DMA_LENGTH / 4] = sizeof(words);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	dsi[DSI_REG_DMA_TRIGGER / 4] = 1;
+	unsigned us;
+	for (us = 0; us < 50000 && !(dsi[DSI_REG_INT_CTRL / 4] & 1u); us += 50) {
+		IODelay(50);
+	}
+	const bool done = (dsi[DSI_REG_INT_CTRL / 4] & 1u) != 0;
+	const uint32_t ack = dsi[DSI_REG_ACK_ERR / 4], timeout = dsi[DSI_REG_TIMEOUT_STATUS / 4];
+	if (done) {
+		dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	}
+	dsi[DSI_REG_TPG_CTRL / 4] = 0;
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 1;
+	IODelay(1);
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 0;
+	dsi[DSI_REG_DMA_CTRL / 4] = dma_ctrl;
+	if (!(ctrl & (1u << 2))) {
+		dsi[DSI_REG_CTRL / 4] = dsi[DSI_REG_CTRL / 4] & ~(1u << 2);
+	}
+	static unsigned sent_logs = 0;
+	if (!done || sent_logs < 16) {
+		++sent_logs;
+		IOLog("SWEET BL: DCS 0x51 level %u %s after %u us ack_err=%#x timeout=%#x\n",
+		    level, done ? "sent" : "NOT acknowledged", us, ack, timeout);
+	}
+	return done ? 0 : ETIMEDOUT;
+}
+
+static void
+sweet_dcs_apply(thread_call_param_t, thread_call_param_t)
+{
+	const uint32_t level = __atomic_load_n(&sweet_dcs_wanted, __ATOMIC_ACQUIRE);
+	if (level == 0 || level == sweet_dcs_sent || sweet_dcs_failures >= 4) {
+		return;
+	}
+	if (sweet_dcs_send(level) != 0) {
+		if (++sweet_dcs_failures >= 4) {
+			IOLog("SWEET BL: DCS brightness stopped after 4 failed transfers\n");
+		}
+	} else {
+		sweet_dcs_sent = level;
+	}
+}
+
+static bool
+sweet_dcs_init(void)
+{
+	int on = 1;
+	PE_parse_boot_argn("sweetfb_dcsbl", &on, sizeof(on));
+	if (!on || sweet_board_beryllium()) {
+		return false;
+	}
+	sweet_dcs_dsi = (volatile uint32_t *)ml_io_map(SWEET_DSI0_PA, 0x400);
+	sweet_dcs_call = thread_call_allocate(sweet_dcs_apply, NULL);
+	if (sweet_dcs_dsi == NULL || sweet_dcs_call == NULL) {
+		IOLog("SWEET BL: DCS brightness: no DSI0 mapping or thread call\n");
+		return false;
+	}
+	const uint32_t ctrl = sweet_dcs_dsi[DSI_REG_CTRL / 4];
+	IOLog("SWEET BL: DSI0 version=%#x ctrl=%#x dma_ctrl=%#x int=%#x\n", sweet_dcs_dsi[DSI_REG_VERSION / 4], ctrl,
+	    sweet_dcs_dsi[DSI_REG_DMA_CTRL / 4], sweet_dcs_dsi[DSI_REG_INT_CTRL / 4]);
+	if ((ctrl & 3) != 3) {
+		IOLog("SWEET BL: DSI0 is not enabled in video mode; no DCS brightness\n");
+		return false;
+	}
+	IOLog("SWEET BL: DCS brightness ready (0x51, levels %u..%u; sweetfb_dcsbl=0 disables)\n", SWEET_DCS_BL_MIN, SWEET_DCS_BL_MAX);
+	return true;
+}
+
+/* iOS's 0..4095 (AppleARMBacklight, as for the WLED) onto the panel's 8..2047; only the newest level is sent. */
+static void
+sweet_dcs_request(uint32_t level4095)
+{
+	const uint32_t level = SWEET_DCS_BL_MIN + (level4095 * (SWEET_DCS_BL_MAX - SWEET_DCS_BL_MIN)) / 4095u;
+	__atomic_store_n(&sweet_dcs_wanted, level, __ATOMIC_RELEASE);
+	thread_call_enter(sweet_dcs_call);
+}
