+/*
+ * Sweet 2003: Bergamota's display-controller paths (page flip, QSEED3 scaling, zero-copy, scan-out copy) were
+ * written for beryllium's SDM845 MDP and are gated on that board. Sweet's SM7150 MDP has the same DPU layout
+ * where these paths touch it (VIG0 0x5000, SSPP SRC0 +0x14, CTL0 0x2000 flush +0x18 VIG0|LM0|CTL, LM0 0x45000,
+ * INTF1 0x6b800 -- our iOS 16 0181/0244). Opt-in only: boot-arg sweetfb_mdp=1 opens the same gates on sweet.
+ */
+static inline bool
+sweet_fb_mdp_board(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		int mdp = 0;
+		PE_parse_boot_argn("sweetfb_mdp", &mdp, sizeof(mdp));
+		cached = sweet_board_beryllium() || mdp != 0 ? 1 : 0;
+	}
+	return cached == 1;
+}
