+/*
+ * Sweet 2027: SpringBoard's main thread, remembered at exec as a POINTER ONLY (2026 bound it there and hung the boot). Its dispatches and run time
+ * per CPU are counted in thread_dispatch() (sweet_sb_runs / sweet_sb_abs, read over /dev/pmem), and with sweet_sb_fast != 0 (boot-arg sweetsbfast,
+ * also writable at run time) it prefers an idle Cortex-A76 (cpu6-7) wherever it wakes. The pointer is only ever compared, never dereferenced.
+ */
+#include <string.h>
+thread_t volatile sweet_sb_main;
+int sweet_sb_fast;
