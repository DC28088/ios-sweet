+void
+sweet_exec_note(const char *name, thread_t thread)
+{
+	static bool parsed;
+	if (!parsed) {
+		parsed = true;
+		int v = 0;
+		PE_parse_boot_argn("sweetsbfast", &v, sizeof(v));
+		sweet_sb_fast = v;
+	}
+	if (name != NULL && thread != THREAD_NULL && strcmp(name, "SpringBoard") == 0) {
+		sweet_sb_main = thread;
+		printf("SWEET CPU: SpringBoard main thread noted (fast-core preference %s)\n", sweet_sb_fast ? "on" : "off");
+	}
+}
