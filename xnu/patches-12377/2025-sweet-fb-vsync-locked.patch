 /*
  * Early (direct) path: runs on the work loop right after a swap. Takes the pending
  * frame like vsyncFired does, scans it in place when it can, and otherwise puts it
@@ -2045,6 +2054,45 @@ AppleCLCD::flipSetup(void)
  * panel frame apart (sweetfb_hz >= ~40, or sweetfb_vsync=1): torn frames.
  * Wait (bounded, one vsync plus slack) for the latch before drawing.
  */
+/*
+ * Sweet 2025 (sweetfb_ec=3): the panel refreshes at ~120 Hz (INTF1 frame counter: 2408 frames in 20 s) while the vsync timer re-armed
+ * itself after each tick's work (16.67 ms + the handler: 58.4-59.0 ticks/s). CoreAnimation is paced by this timer, so on the 120 Hz
+ * grid most frames stayed up 2 refreshes and one or two per second 3: a regular hitch. Now the timer runs on absolute deadlines whose
+ * period is a whole number of panel frames (the one closest to sweetfb_hz), measured from the INTF1 frame counter: no drift.
+ */
+void
+AppleCLCD::armVsync(IOTimerEventSource *sender, uint32_t nextUS)
+{
+	if (!fVsyncLock || fMdp == 0) {
+		sender->setTimeoutUS(nextUS);
+		return;
+	}
+	uint64_t now = mach_absolute_time(), nominal, second;
+	nanoseconds_to_absolutetime((uint64_t)fVsyncUS * 1000, &nominal);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	uint32_t f = mdp_rd(fMdp + SWEET_MDP_INTF1, 0xac);
+	if (fVlT0 == 0 || f < fVlF0 || now - fVlT0 > 600 * second) {
+		fVlT0 = now;
+		fVlF0 = f;
+	} else if (now - fVlT0 > second && f - fVlF0 > 30) {
+		uint64_t panel = (now - fVlT0) / (uint64_t)(f - fVlF0);
+		uint64_t k = panel ? (nominal + panel / 2) / panel : 1;
+		if (k < 1) {
+			k = 1;
+		}
+		uint64_t per = panel * k;
+		if (per > nominal / 2 && per < nominal * 2) {
+			fVlPeriod = per;
+		}
+	}
+	uint64_t per = fVlPeriod ? fVlPeriod : nominal;
+	fVlNext = fVlNext ? fVlNext + per : now + per;
+	if (fVlNext <= now + per / 8) {
+		fVlNext = now + per;    /* late (or the display was off): start a new phase */
+	}
+	sender->wakeAtTime((AbsoluteTime)fVlNext);
+}
