 #define BT_COMPAT_PAD   16u             /* parameter bytes in a rewritten Command Complete */
+/*
+ * Sweet 2012: replies whose parser reads past 16 bytes. 0xfe3b (OCF 0x23b, sent when bluetoothd starts its discovery
+ * scan on iOS 26): "AssertFail bcm_vsc.c:1021 : ByteStream_NumReadBytesAvail(*pBs) >= 4" with 16 bytes, every
+ * bluetoothd start after the stack came up (26bFe, then SIGABRT). These get BT_COMPAT_PAD_LONG zero bytes.
+ */
+#define BT_COMPAT_PAD_LONG 64u
+static unsigned
+bt_compat_pad(unsigned op)
+{
+	return op == 0xfe3b ? BT_COMPAT_PAD_LONG : BT_COMPAT_PAD;
+}
 
 /* First parameter byte of the last few commands sent, by opcode (for rewritten replies). */
 static struct { uint16_t op; uint8_t p0; } bt_last_cmd[8];
