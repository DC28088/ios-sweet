+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -218,6 +218,8 @@ sweet_cpu_measure_khz(void)
 	return ns ? (iterations * 64 * 1000000ULL) / ns : 0;
 }
 
+extern "C" void sweet_amp_enable(uint64_t big, uint64_t little, int pri);
+
 static void
 sweet_cpufreq_domain(const ml_topology_info_t *topology, unsigned domain,
     uint64_t pa, unsigned first_cpu, int mode)
@@ -295,6 +297,16 @@ sweet_cpufreq_start(const ml_topology_info_t *topology)
 	int l3 = 1;
 	PE_parse_boot_argn("sweetl3", &l3, sizeof(l3));
 	sweet_cpufreq_domain(topology, 2, 0x18321000ULL, 0, l3 ? mode : 0);
+	/*
+	 * 2022: sweetsteer=N (default 0 = off) turns on the idle-core steering of osfmk/kern/sched_prim.c (Bergamota 0191):
+	 * user threads with base priority >= N take an idle Cortex-A76 (cpu6-7) first, everything else an idle A55 first.
+	 * 47 = interactive UI threads (SpringBoard's main thread); it steers only where a thread wakes up.
+	 */
+	int steer = 0;
+	if (PE_parse_boot_argn("sweetsteer", &steer, sizeof(steer)) && steer > 0 && topology->num_cpus == 8) {
+		sweet_amp_enable(0xc0, 0x3f, steer);
+		IOLog("SWEET CPU: steering on: base_pri >= %d wakes on an idle cpu6-7 first, the rest on cpu0-5\n", steer);
+	}
 }
 
