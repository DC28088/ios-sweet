@@ -270,6 +270,26 @@ IOReturn NativeAdrenoRing::detach()
     ring_iova_=fence_iova_=0;next_=rptr_shadow_=seqno_=completed_=submissions_=0;
     return kIOReturnSuccess;
 }
+IOReturn NativeAdrenoRing::diagnose(uint32_t out[8],bool kick)
+{
+    for(unsigned i=0;i<8;++i)out[i]=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    out[0]=seqno_;out[1]=completed_;out[2]=next_;
+    if(cache_.acquire(cache_.cookie,fence_,fence_bytes_))return kIOReturnIOError;
+    out[3]=fence_[fence_word_];
+    if(a6xx_shadow_) {
+        if(cache_.acquire(cache_.cookie,a6xx_shadow_,sizeof(*a6xx_shadow_)))return kIOReturnIOError;
+        out[4]=*a6xx_shadow_;
+    }
+    (void)io_.read32(io_.cookie,RingRptr,&out[5]);
+    (void)io_.read32(io_.cookie,RingWptr,&out[6]);
+    (void)io_.read32(io_.cookie,0x0210,&out[7]);   /* RBBM_STATUS */
+    if(kick) {
+        if(io_.barrier(io_.cookie))return kIOReturnIOError;
+        if(io_.write32(io_.cookie,RingWptr,next_))return kIOReturnIOError;
+    }
+    return kIOReturnSuccess;
+}
 IOReturn NativeAdrenoRing::submit(const uint32_t *words,size_t word_count,uint32_t *fence)
 {
     return submitWords(words,word_count,fence,false);
