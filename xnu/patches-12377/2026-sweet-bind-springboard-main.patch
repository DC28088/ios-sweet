+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <string.h>
+/*
+ * Sweet 2026: boot-arg sweetsbcpu=N binds SpringBoard's main thread to cpu N at exec (default -1 = off). On SM7150 only cpu6-7 are
+ * Cortex-A76; the timeline profile showed SpringBoard's main thread as the remaining cause of skipped frames, and nothing else keeps it
+ * off the A55s (the topology is one SMP cluster). The thread is new and not yet runnable here (posix_spawn / exec), so it can be bound.
+ */
+void sweet_exec_bind_hint(const char *name, thread_t thread);
+void
+sweet_exec_bind_hint(const char *name, thread_t thread)
+{
+	static int cpu = -2;
+	if (cpu == -2) {
+		int v = -1;
+		PE_parse_boot_argn("sweetsbcpu", &v, sizeof(v));
+		cpu = v;
+	}
+	if (cpu < 0 || cpu >= 8 || thread == THREAD_NULL || name == NULL || strcmp(name, "SpringBoard") != 0) {
+		return;
+	}
+	processor_t processor = cpu_to_processor(cpu);
+	if (processor == PROCESSOR_NULL || processor_avail_count < 8) {
+		return;
+	}
+	bool bound = false;
+	spl_t s = splsched();
+	thread_lock(thread);
+	if (thread_get_runq_locked(thread) == PROCESSOR_NULL && thread->sched_pri < BASEPRI_RTQUEUES) {
+		thread_bind_internal(thread, processor);
+		bound = true;
+	}
+	thread_unlock(thread);
+	splx(s);
+	printf("SWEET CPU: SpringBoard main thread %s cpu %d (sweetsbcpu)\n", bound ? "bound to" : "NOT bound to", cpu);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
